@model WeddingClosetHubs.Models.User

@{
    ViewData["Title"] = ViewBag.IsEvidenceUpdate == true
        ? "Update Verification Evidence"
        : "Register";

    bool isEvidenceUpdate = ViewBag.IsEvidenceUpdate == true;

    var shop = Model.Shop;
    var delivery = Model.DeliveryBoy;

    var savedCollections = (shop?.ShopCollections ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var savedPurchaseTypes = (shop?.ShopPurchaseTypes ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var collections = new[]
    {
        "Bridal Wear",
        "Groom Wear",
        "Formal Wear",
        "Wedding Guest Wear",
        "Footwear",
        "Jewellery",
        "Bridal Jewellery",
        "Accessories",
        "Bridal Accessories"
    };

    var purchaseTypes = new[]
    {
        "Buy",
        "Rent",
        "Customize"
    };
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow">
                <div class="card-header text-white text-center"
                     style="background-color:#800020;">
                    <h3 class="mb-0">
                        @(isEvidenceUpdate ? "Update Verification Evidence" : "Create Account")
                    </h3>
                    <small>Wedding Closet Hubs</small>
                </div>

                <div class="card-body">

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Error"]
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    @if (isEvidenceUpdate)
                    {
                        <div class="alert alert-warning">
                            <h5 class="mb-2">Admin Requested More Evidence</h5>

                            <p class="mb-0">
                                @if (ViewBag.AdminNotes != null &&
                                     !string.IsNullOrWhiteSpace((string)ViewBag.AdminNotes))
                                {
                                    @ViewBag.AdminNotes
                                }
                                else
                                {
                                    @:Please provide the requested verification evidence below.
                                }
                            </p>
                        </div>

                        <div class="alert alert-info">
                            Your existing account and shop details are saved.
                            You do not need to enter your password or fill in your
                            shop details again. Upload the missing or replacement
                            evidence below. Your account will remain disabled until
                            the Admin reviews your submission.
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post"
                          enctype="multipart/form-data"
                          id="registerForm">

                        @Html.AntiForgeryToken()

                        @if (!isEvidenceUpdate && !ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <strong>Registration failed.</strong>
                                <div asp-validation-summary="All" class="mt-2"></div>
                            </div>
                        }

                        @if (isEvidenceUpdate)
                        {
                            <h5 class="border-bottom pb-2 mb-3">
                                Existing Account Information
                            </h5>

                            <div class="mb-3">
                                <label class="form-label">Full Name</label>
                                <input class="form-control" value="@Model.Name" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input class="form-control" value="@Model.Email" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Phone Number</label>
                                <input class="form-control" value="@Model.Phone" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Address</label>
                                <textarea class="form-control" rows="2" readonly>@Model.Address</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Account Type</label>
                                <input class="form-control" value="@Model.Role?.RoleName" readonly />
                            </div>

                            @if (Model.Role?.RoleName == "Shopkeeper" && shop != null)
                            {
                                <h5 class="border-bottom pb-2 mb-3 mt-4">
                                    Existing Shop Information
                                </h5>

                                <div class="mb-3">
                                    <label class="form-label">Shop Name</label>
                                    <input class="form-control" value="@shop.ShopName" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Category</label>
                                    <input class="form-control" value="@shop.ShopCategory" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Collections</label>
                                    <textarea class="form-control" rows="2" readonly>@shop.ShopCollections</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Services Offered</label>
                                    <input class="form-control" value="@shop.ShopPurchaseTypes" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Phone</label>
                                    <input class="form-control" value="@shop.ShopPhone" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Address</label>
                                    <textarea class="form-control" rows="2" readonly>@shop.ShopAddress</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Description</label>
                                    <textarea class="form-control" rows="3" readonly>@shop.ShopDescription</textarea>
                                </div>
                            }

                            @if (Model.Role?.RoleName == "Delivery" && delivery != null)
                            {
                                <h5 class="border-bottom pb-2 mb-3 mt-4">
                                    Existing Delivery Information
                                </h5>

                                <div class="mb-3">
                                    <label class="form-label">Vehicle Type</label>
                                    <input class="form-control" value="Motorbike" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Motorbike Registration Number</label>
                                    <input class="form-control" value="@delivery.MotorbikeNumber" readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Preferred Delivery Zone</label>
                                    <input class="form-control" value="@delivery.PreferredZone" readonly />
                                </div>
                            }
                        }
                        else
                        {
                            <h5 class="border-bottom pb-2 mb-3">
                                Personal Information
                            </h5>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">
                                    Full Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name"
                                       class="form-control"
                                       minlength="3"
                                       maxlength="100"
                                       required
                                       autocomplete="name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">
                                    Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       maxlength="150"
                                       required
                                       autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                                <small class="text-muted">Use Gmail, Yahoo, Hotmail or Outlook.</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">
                                    Password <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       minlength="8"
                                       maxlength="100"
                                       required
                                       autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="text-muted">
                                    Minimum 8 characters with uppercase, lowercase and a number.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">
                                    Phone Number <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Phone"
                                       type="tel"
                                       class="form-control"
                                       maxlength="12"
                                       required
                                       placeholder="03XX-XXXXXXX" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label">
                                    Address <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Address"
                                          class="form-control"
                                          rows="3"
                                          maxlength="500"
                                          required
                                          placeholder="Enter your address in Rawalpindi"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <h5 class="border-bottom pb-2 mb-3 mt-4">
                                Account Type
                            </h5>

                            <div class="mb-3">
                                <label asp-for="RoleId" class="form-label">
                                    Select Account Type <span class="text-danger">*</span>
                                </label>
                                <select asp-for="RoleId" class="form-control" id="roleSelect" required>
                                    <option value="">-- Select Account Type --</option>
                                    @if (ViewBag.Roles != null)
                                    {
                                        foreach (var role in ViewBag.Roles)
                                        {
                                            <option value="@role.RoleId" data-role="@role.RoleName">
                                                @role.RoleName
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger"></span>
                            </div>

                            <div id="customerSection" style="display:none;">
                                <div class="alert alert-success">
                                    <h5>Customer Registration</h5>
                                    All personal information above is required.
                                </div>
                            </div>

                            <div id="shopkeeperSection" style="display:none;">
                                <div class="card border-primary mb-4">
                                    <div class="card-header text-white" style="background-color:#800020;">
                                        <h5 class="mb-0">Shopkeeper Registration</h5>
                                    </div>

                                    <div class="card-body">
                                        <h6 class="border-bottom pb-2 mb-3">Identity Verification</h6>

                                        <div class="mb-3">
                                            <label class="form-label">CNIC Number *</label>
                                            <input name="ShopkeeperCNIC"
                                                   id="shopkeeperCNIC"
                                                   class="form-control"
                                                   maxlength="15"
                                                   placeholder="XXXXX-XXXXXXX-X" />
                                            <span id="shopkeeperCNICError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">CNIC Front Image *</label>
                                            <input type="file"
                                                   name="ShopkeeperCNICFrontImage"
                                                   id="shopkeeperCNICFront"
                                                   class="form-control"
                                                   accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="shopkeeperCNICFrontError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">CNIC Back Image *</label>
                                            <input type="file"
                                                   name="ShopkeeperCNICBackImage"
                                                   id="shopkeeperCNICBack"
                                                   class="form-control"
                                                   accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="shopkeeperCNICBackError" class="text-danger"></span>
                                        </div>

                                        <h6 class="border-bottom pb-2 mb-3 mt-4">Shop Information</h6>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Name *</label>
                                            <input name="ShopName" id="shopName" class="form-control" minlength="3" maxlength="100" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Category *</label>
                                            <select name="ShopCategory" id="shopCategory" class="form-control">
                                                <option value="">-- Select Main Shop Category --</option>
                                                @foreach (var category in collections)
                                                {
                                                    <option value="@category">@category</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Collections *</label>
                                            <div class="row">
                                                @foreach (var collection in collections)
                                                {
                                                    <div class="col-md-6 mb-2">
                                                        <div class="form-check">
                                                            <input type="checkbox"
                                                                   class="form-check-input collection-checkbox"
                                                                   name="ShopCollections"
                                                                   value="@collection"
                                                                   id="collection_@collection.Replace(" ", "")" />
                                                            <label class="form-check-label"
                                                                   for="collection_@collection.Replace(" ", "")">
                                                                @collection
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <span id="shopCollectionsError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Services Offered *</label>
                                            @foreach (var service in purchaseTypes)
                                            {
                                                <div class="form-check">
                                                    <input type="checkbox"
                                                           class="form-check-input service-checkbox"
                                                           name="ShopPurchaseTypes"
                                                           value="@service"
                                                           id="service_@service" />
                                                    <label class="form-check-label" for="service_@service">
                                                        @service
                                                    </label>
                                                </div>
                                            }
                                            <span id="shopServicesError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Phone *</label>
                                            <input name="ShopPhone" id="shopPhone" class="form-control" maxlength="12" placeholder="03XX-XXXXXXX" />
                                            <span id="shopPhoneError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Address *</label>
                                            <textarea name="ShopAddress" id="shopAddress" class="form-control" rows="2"></textarea>
                                            <span id="shopAddressError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Description *</label>
                                            <textarea name="ShopDescription" id="shopDescription" class="form-control" rows="3" minlength="10" maxlength="1000"></textarea>
                                            <span id="shopDescriptionError" class="text-danger"></span>
                                        </div>

                                        <h6 class="border-bottom pb-2 mb-3 mt-4">Shop Verification</h6>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Front Photo *</label>
                                            <input type="file" name="ShopFrontPhoto" id="shopFrontPhoto" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="shopFrontPhotoError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Inside Photo *</label>
                                            <input type="file" name="ShopInsidePhoto" id="shopInsidePhoto" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="shopInsidePhotoError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Signboard Photo *</label>
                                            <input type="file" name="ShopSignboardPhoto" id="shopSignboardPhoto" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="shopSignboardPhotoError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Proof Type *</label>
                                            <select name="ShopProofType" id="shopProofType" class="form-control">
                                                <option value="">-- Select Proof Type --</option>
                                                <option value="Utility Bill">Utility Bill</option>
                                                <option value="Rental Agreement">Rental Agreement</option>
                                                <option value="Business Registration">Business Registration</option>
                                            </select>
                                            <span id="shopProofTypeError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Shop Proof Document *</label>
                                            <input type="file" name="ShopProofDocument" id="shopProofDocument" class="form-control" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" />
                                            <span id="shopProofDocumentError" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="deliverySection" style="display:none;">
                                <div class="card border-warning mb-4">
                                    <div class="card-header bg-warning">
                                        <h5 class="mb-0">Delivery Boy Registration</h5>
                                    </div>

                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">CNIC Number *</label>
                                            <input name="DeliveryCNIC" id="deliveryCNIC" class="form-control" maxlength="15" placeholder="XXXXX-XXXXXXX-X" />
                                            <span id="deliveryCNICError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">CNIC Front Image *</label>
                                            <input type="file" name="DeliveryCNICFrontImage" id="deliveryCNICFrontImage" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="deliveryCNICFrontImageError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">CNIC Back Image *</label>
                                            <input type="file" name="DeliveryCNICBackImage" id="deliveryCNICBackImage" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                            <span id="deliveryCNICBackImageError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Vehicle Type</label>
                                            <input class="form-control" value="Motorbike" readonly />
                                            <input type="hidden" name="VehicleType" value="Motorbike" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Motorbike Registration Number *</label>
                                            <input name="MotorbikeNumber" id="motorbikeNumber" class="form-control" minlength="3" maxlength="30" />
                                            <span id="motorbikeNumberError" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Preferred Delivery Zone *</label>
                                            <select name="PreferredZone" id="preferredZone" class="form-control">
                                                <option value="">-- Select Zone --</option>
                                                <option value="Saddar">Saddar</option>
                                                <option value="6th Road">6th Road</option>
                                                <option value="Liaqat Bagh">Liaqat Bagh</option>
                                            </select>
                                            <span id="preferredZoneError" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (isEvidenceUpdate)
                        {
                            <h5 class="border-bottom pb-2 mb-3 mt-4">
                                Upload or Replace Verification Evidence
                            </h5>

                            @if (Model.Role?.RoleName == "Shopkeeper" && shop != null)
                            {
                                <div class="mb-3">
                                    <label class="form-label">CNIC Number</label>
                                    <input name="ShopkeeperCNIC"
                                           class="form-control"
                                           value="@Model.CNIC"
                                           placeholder="Enter CNIC only if it needs correction" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">CNIC Front Image</label>
                                    @if (!string.IsNullOrWhiteSpace(shop.CNICFrontImage))
                                    {
                                        <p>
                                            <a href="@shop.CNICFrontImage" target="_blank">View current CNIC front image</a>
                                        </p>
                                    }
                                    <input type="file" name="ShopkeeperCNICFrontImage" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">CNIC Back Image</label>
                                    @if (!string.IsNullOrWhiteSpace(shop.CNICBackImage))
                                    {
                                        <p>
                                            <a href="@shop.CNICBackImage" target="_blank">View current CNIC back image</a>
                                        </p>
                                    }
                                    <input type="file" name="ShopkeeperCNICBackImage" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Front Photo</label>
                                    @if (!string.IsNullOrWhiteSpace(shop.ShopFrontPhoto))
                                    {
                                        <p>
                                            <a href="@shop.ShopFrontPhoto" target="_blank">View current shop front photo</a>
                                        </p>
                                    }
                                    <input type="file" name="ShopFrontPhoto" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Inside Photo</label>
                                    @if (!string.IsNullOrWhiteSpace(shop.ShopInsidePhoto))
                                    {
                                        <p>
                                            <a href="@shop.ShopInsidePhoto" target="_blank">View current shop inside photo</a>
                                        </p>
                                    }
                                    <input type="file" name="ShopInsidePhoto" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Signboard Photo</label>
                                    @if (!string.IsNullOrWhiteSpace(shop.ShopSignboardPhoto))
                                    {
                                        <p>
                                            <a href="@shop.ShopSignboardPhoto" target="_blank">View current shop signboard photo</a>
                                        </p>
                                    }
                                    <input type="file" name="ShopSignboardPhoto" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Proof Type</label>
                                    <select name="ShopProofType" class="form-control">
                                        <option value="">Keep existing proof type</option>
                                        <option value="Utility Bill">Utility Bill</option>
                                        <option value="Rental Agreement">Rental Agreement</option>
                                        <option value="Business Registration">Business Registration</option>
                                    </select>
                                    <small class="text-muted">Leave unchanged if the current proof type is correct.</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Shop Proof Document</label>
                                    @if (!string.IsNullOrWhiteSpace(shop.ShopProofDocument))
                                    {
                                        <p>
                                            <a href="@shop.ShopProofDocument" target="_blank">View current proof document</a>
                                        </p>
                                    }
                                    <input type="file" name="ShopProofDocument" class="form-control" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" />
                                </div>
                            }

                            @if (Model.Role?.RoleName == "Delivery" && delivery != null)
                            {
                                <div class="mb-3">
                                    <label class="form-label">CNIC Number</label>
                                    <input name="DeliveryCNIC" class="form-control" value="@delivery.CNIC" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">CNIC Front Image</label>
                                    @if (!string.IsNullOrWhiteSpace(delivery.CNICFrontImage))
                                    {
                                        <p>
                                            <a href="@delivery.CNICFrontImage" target="_blank">View current CNIC front image</a>
                                        </p>
                                    }
                                    <input type="file" name="DeliveryCNICFrontImage" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">CNIC Back Image</label>
                                    @if (!string.IsNullOrWhiteSpace(delivery.CNICBackImage))
                                    {
                                        <p>
                                            <a href="@delivery.CNICBackImage" target="_blank">View current CNIC back image</a>
                                        </p>
                                    }
                                    <input type="file" name="DeliveryCNICBackImage" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Vehicle Type</label>
                                    <input class="form-control" value="Motorbike" readonly />
                                    <input type="hidden" name="VehicleType" value="Motorbike" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Motorbike Registration Number</label>
                                    <input name="MotorbikeNumber" class="form-control" value="@delivery.MotorbikeNumber" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Preferred Delivery Zone</label>
                                    <select name="PreferredZone" class="form-control">
                                        <option value="">Keep existing zone</option>
                                        <option value="Saddar">Saddar</option>
                                        <option value="6th Road">6th Road</option>
                                        <option value="Liaqat Bagh">Liaqat Bagh</option>
                                    </select>
                                </div>
                            }

                            <div class="alert alert-secondary">
                                Only select files you want to replace. Existing files and shop information
                                will be retained when you leave their fields unchanged.
                            </div>

                            <button type="submit"
                                    class="btn btn-warning w-100"
                                    id="registerButton">
                                Submit Updated Evidence
                            </button>
                        }
                        else
                        {
                            <div class="alert alert-info" id="generalMessage">
                                Select an account type to see the registration requirements.
                            </div>

                            <button type="submit"
                                    class="btn w-100 text-white"
                                    id="registerButton"
                                    style="background-color:#800020;">
                                <i class="bi bi-person-plus"></i>
                                Register
                            </button>
                        }
                    </form>

                    <div class="text-center mt-3">
                        @if (!isEvidenceUpdate)
                        {
                            <span>Already have an account?</span>
                        }
                        <a asp-controller="Account" asp-action="Login">
                            @(isEvidenceUpdate ? "Return to Login" : "Login")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isEvidenceUpdate = @isEvidenceUpdate.ToString().ToLowerInvariant();
            const form = document.getElementById("registerForm");

            if (isEvidenceUpdate) {
                form.querySelectorAll("input[type=file]").forEach(function (input) {
                    input.required = false;
                });

                form.addEventListener("submit", function () {
                    const button = document.getElementById("registerButton");
                    button.disabled = true;
                    button.textContent = "Submitting Evidence...";
                });

                return;
            }

            const roleSelect = document.getElementById("roleSelect");
            const customerSection = document.getElementById("customerSection");
            const shopkeeperSection = document.getElementById("shopkeeperSection");
            const deliverySection = document.getElementById("deliverySection");
            const generalMessage = document.getElementById("generalMessage");

            const roleFields = {
                Customer: [],
                Shopkeeper: [
                    "shopkeeperCNIC",
                    "shopkeeperCNICFront",
                    "shopkeeperCNICBack",
                    "shopName",
                    "shopCategory",
                    "shopPhone",
                    "shopAddress",
                    "shopDescription",
                    "shopFrontPhoto",
                    "shopInsidePhoto",
                    "shopSignboardPhoto",
                    "shopProofType",
                    "shopProofDocument"
                ],
                Delivery: [
                    "deliveryCNIC",
                    "deliveryCNICFrontImage",
                    "deliveryCNICBackImage",
                    "motorbikeNumber",
                    "preferredZone"
                ]
            };

            function getRole() {
                return roleSelect.options[roleSelect.selectedIndex]?.dataset.role || "";
            }

            function showSection() {
                customerSection.style.display = "none";
                shopkeeperSection.style.display = "none";
                deliverySection.style.display = "none";
                generalMessage.style.display = "none";

                Object.values(roleFields).flat().forEach(function (id) {
                    const field = document.getElementById(id);
                    if (field) {
                        field.required = false;
                        field.disabled = true;
                    }
                });

                document.querySelectorAll(".collection-checkbox, .service-checkbox")
                    .forEach(function (checkbox) {
                        checkbox.disabled = true;
                    });

                const role = getRole();

                if (!role) {
                    generalMessage.style.display = "block";
                    return;
                }

                if (role === "Customer") {
                    customerSection.style.display = "block";
                } else if (role === "Shopkeeper") {
                    shopkeeperSection.style.display = "block";
                    document.querySelectorAll(".collection-checkbox, .service-checkbox")
                        .forEach(function (checkbox) {
                            checkbox.disabled = false;
                        });
                } else if (role === "Delivery") {
                    deliverySection.style.display = "block";
                } else {
                    generalMessage.style.display = "block";
                    return;
                }

                (roleFields[role] || []).forEach(function (id) {
                    const field = document.getElementById(id);
                    if (field) {
                        field.disabled = false;
                        field.required = true;
                    }
                });
            }

            roleSelect.addEventListener("change", showSection);
            showSection();

            function formatCNIC(input) {
                if (!input) return;

                input.addEventListener("input", function () {
                    let value = this.value.replace(/\D/g, "").substring(0, 13);

                    if (value.length > 12) {
                        value = value.substring(0, 5) + "-" +
                            value.substring(5, 12) + "-" + value.substring(12);
                    } else if (value.length > 5) {
                        value = value.substring(0, 5) + "-" + value.substring(5);
                    }

                    this.value = value;
                });
            }

            formatCNIC(document.getElementById("shopkeeperCNIC"));
            formatCNIC(document.getElementById("deliveryCNIC"));

            function formatPhone(input) {
                if (!input) return;

                input.addEventListener("input", function () {
                    let value = this.value.replace(/\D/g, "").substring(0, 11);

                    if (value.length > 4) {
                        value = value.substring(0, 4) + "-" + value.substring(4);
                    }

                    this.value = value;
                });
            }

            formatPhone(document.getElementById("Phone"));
            formatPhone(document.getElementById("shopPhone"));

            const maxFileSize = 5 * 1024 * 1024;

            function validateFile(input, proofDocument) {
                if (!input || !input.files || !input.files.length) return true;

                const file = input.files[0];
                const extension = file.name.toLowerCase().split(".").pop();
                const allowed = proofDocument
                    ? ["jpg", "jpeg", "png", "pdf"]
                    : ["jpg", "jpeg", "png"];

                if (!allowed.includes(extension) || file.size > maxFileSize) {
                    alert(proofDocument
                        ? "Choose a JPG, JPEG, PNG or PDF file no larger than 5 MB."
                        : "Choose a JPG, JPEG or PNG image no larger than 5 MB.");
                    input.value = "";
                    return false;
                }

                return true;
            }

            form.querySelectorAll('input[type="file"]').forEach(function (input) {
                input.addEventListener("change", function () {
                    validateFile(this, this.name === "ShopProofDocument");
                });
            });

            function validPhone(value) {
                return /^03\d{9}$/.test(value.replace(/\D/g, ""));
            }

            function validCNIC(value) {
                return /^\d{5}-\d{7}-\d$/.test(value);
            }

            function setError(id, message) {
                const element = document.getElementById(id);
                if (element) element.textContent = message;
            }

            form.addEventListener("submit", function (event) {
                let valid = true;
                const role = getRole();

                if (!role) {
                    valid = false;
                    roleSelect.setCustomValidity("Please select an account type.");
                } else {
                    roleSelect.setCustomValidity("");
                }

                const name = document.getElementById("Name");
                if (name && (!/^[A-Za-z ]+$/.test(name.value.trim()) ||
                    name.value.trim().length < 3)) {
                    name.setCustomValidity("Enter a valid name with at least 3 characters.");
                    valid = false;
                } else if (name) {
                    name.setCustomValidity("");
                }

                const password = document.getElementById("Password");
                if (password && (password.value.length < 8 ||
                    !/[A-Z]/.test(password.value) ||
                    !/[a-z]/.test(password.value) ||
                    !/\d/.test(password.value))) {
                    password.setCustomValidity(
                        "Use at least 8 characters with uppercase, lowercase and a number.");
                    valid = false;
                } else if (password) {
                    password.setCustomValidity("");
                }

                const phone = document.getElementById("Phone");
                if (phone && !validPhone(phone.value)) {
                    phone.setCustomValidity("Enter a valid Pakistani mobile number.");
                    valid = false;
                } else if (phone) {
                    phone.setCustomValidity("");
                }

                const address = document.getElementById("Address");
                if (address && !address.value.toLowerCase().includes("rawalpindi")) {
                    address.setCustomValidity("Enter an address in Rawalpindi.");
                    valid = false;
                } else if (address) {
                    address.setCustomValidity("");
                }

                if (role === "Shopkeeper") {
                    const cnic = document.getElementById("shopkeeperCNIC");
                    if (!validCNIC(cnic.value.trim())) {
                        setError("shopkeeperCNICError", "Enter CNIC in XXXXX-XXXXXXX-X format.");
                        valid = false;
                    }

                    if (!document.querySelector(".collection-checkbox:checked")) {
                        setError("shopCollectionsError", "Select at least one shop collection.");
                        valid = false;
                    }

                    if (!document.querySelector(".service-checkbox:checked")) {
                        setError("shopServicesError", "Select at least one service.");
                        valid = false;
                    }

                    const shopPhone = document.getElementById("shopPhone");
                    if (!validPhone(shopPhone.value)) {
                        setError("shopPhoneError", "Enter a valid Pakistani mobile number.");
                        valid = false;
                    }

                    const shopAddress = document.getElementById("shopAddress");
                    if (!shopAddress.value.toLowerCase().includes("rawalpindi")) {
                        setError("shopAddressError", "Shop address must be in Rawalpindi.");
                        valid = false;
                    }

                    const description = document.getElementById("shopDescription");
                    if (description.value.trim().length < 10) {
                        setError("shopDescriptionError", "Description must contain at least 10 characters.");
                        valid = false;
                    }

                    if (!validCNIC(cnic.value.trim())) valid = false;
                }

                if (role === "Delivery") {
                    const cnic = document.getElementById("deliveryCNIC");
                    if (!validCNIC(cnic.value.trim())) {
                        setError("deliveryCNICError", "Enter CNIC in XXXXX-XXXXXXX-X format.");
                        valid = false;
                    }
                }

                form.querySelectorAll('input[type="file"]').forEach(function (input) {
                    if (!input.disabled && !validateFile(input, input.name === "ShopProofDocument")) {
                        valid = false;
                    }
                });

                if (!valid) {
                    event.preventDefault();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                    return;
                }

                const button = document.getElementById("registerButton");
                button.disabled = true;
                button.textContent = "Registering...";
            });
        });
    </script>
}