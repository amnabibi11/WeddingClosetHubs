@model IEnumerable<WeddingClosetHubs.Models.Negotiation>

@{
    ViewData["Title"] = "Negotiations";
    Layout = null;

    var negotiations = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Negotiation>();

    string shopkeeperName =
        ViewBag.ShopkeeperName ?? "Shopkeeper";

    int pendingCount = negotiations.Count(n =>
        string.Equals(n.Status, "Pending",
            StringComparison.OrdinalIgnoreCase));

    int counterCount = negotiations.Count(n =>
        string.Equals(n.Status, "CounterOffer",
            StringComparison.OrdinalIgnoreCase));

    int acceptedCount = negotiations.Count(n =>
        string.Equals(n.Status, "Accepted",
            StringComparison.OrdinalIgnoreCase));

    int rejectedCount = negotiations.Count(n =>
        string.Equals(n.Status, "Rejected",
            StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Negotiations - WeddingClosetHubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>

        body {
            margin: 0;
            background: #f7f3f0;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #800020;
            position: fixed;
            left: 0;
            top: 0;
            padding: 25px 15px;
            color: white;
        }

        .brand {
            text-align: center;
            color: #d4af37;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .shopkeeper-name {
            text-align: center;
            margin-bottom: 25px;
        }

        .sidebar a {
            display: block;
            text-decoration: none;
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 7px;
        }

            .sidebar a:hover,
            .sidebar a.active {
                background: #d4af37;
                color: #800020;
                font-weight: 600;
            }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .page-header {
            background: white;
            border-radius: 14px;
            padding: 22px 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            margin-bottom: 25px;
        }

            .page-header h2 {
                color: #800020;
                font-weight: 700;
                margin: 0;
            }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 18px;
            box-shadow: 0 3px 10px rgba(0,0,0,.06);
        }

        .stat-number {
            font-size: 27px;
            font-weight: bold;
            color: #800020;
        }

        .stat-title {
            color: #666;
            font-size: 14px;
        }

        .negotiation-card {
            background: white;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,.07);
            border-left: 5px solid #800020;
        }

        .product-name {
            color: #800020;
            font-size: 20px;
            font-weight: 700;
        }

        .customer-name {
            font-weight: 600;
            color: #555;
        }

        .price-box {
            background: #faf6ee;
            border-radius: 10px;
            padding: 17px;
            margin-top: 17px;
        }

        .price-label {
            color: #777;
            font-size: 13px;
        }

        .price-value {
            color: #800020;
            font-size: 19px;
            font-weight: 700;
        }

        .counter-price {
            color: #198754;
            font-size: 20px;
            font-weight: 700;
        }

        .message-box {
            background: #f8f8f8;
            border-radius: 8px;
            padding: 12px;
            margin-top: 12px;
        }

        .status-badge {
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-counter {
            background: #cff4fc;
            color: #055160;
        }

        .status-accepted {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-rejected {
            background: #f8d7da;
            color: #842029;
        }

        .status-expired {
            background: #e2e3e5;
            color: #41464b;
        }

        .btn-maroon {
            background: #800020;
            color: white;
            border: none;
        }

            .btn-maroon:hover {
                background: #650019;
                color: white;
            }

        .btn-gold {
            background: #d4af37;
            color: #800020;
            border: none;
            font-weight: 600;
        }

            .btn-gold:hover {
                background: #bd982c;
                color: #800020;
            }

        .empty-box {
            background: white;
            border-radius: 14px;
            padding: 60px 20px;
            text-align: center;
            box-shadow: 0 3px 12px rgba(0,0,0,.07);
        }

            .empty-box i {
                font-size: 55px;
                color: #d4af37;
            }

        @@media (max-width: 768px) {

            .sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
                padding: 15px;
            }
        }

    </style>

</head>

<body>


    <div class="sidebar">

        <div class="brand">
            <i class="bi bi-gem"></i>
            WeddingClosetHubs
        </div>

        <div class="shopkeeper-name">

            <i class="bi bi-person-circle"></i>

            <div>
                @shopkeeperName
            </div>

            <small>
                Shopkeeper
            </small>

        </div>


        <a href="@Url.Action("Dashboard", "Shopkeeper")">
            <i class="bi bi-speedometer2 me-2"></i>
            Dashboard
        </a>

        <a href="@Url.Action("Products", "Shopkeeper")">
            <i class="bi bi-box-seam me-2"></i>
            Products
        </a>

        <a href="@Url.Action("Orders", "Shopkeeper")">
            <i class="bi bi-bag-check me-2"></i>
            Orders
        </a>

        <a href="@Url.Action("Negotiations", "Shopkeeper")"
           class="active">

            <i class="bi bi-chat-square-text me-2"></i>
            Negotiations

        </a>

        <a href="@Url.Action("Payments", "Shopkeeper")">
            <i class="bi bi-credit-card me-2"></i>
            Payments
        </a>

        <a href="@Url.Action("Notifications", "Shopkeeper")">
            <i class="bi bi-bell me-2"></i>
            Notifications
        </a>

        <a href="@Url.Action("Chat", "Shopkeeper")">
            <i class="bi bi-chat-dots me-2"></i>
            Chat
        </a>

        <hr />

        <a href="@Url.Action("Logout", "Account")">
            <i class="bi bi-box-arrow-right me-2"></i>
            Logout
        </a>

    </div>




    <div class="main-content">

        <div class="page-header">

            <h2>
                <i class="bi bi-chat-square-text me-2"></i>
                Customer Negotiations
            </h2>

            <p class="text-muted mb-0 mt-2">
                Review customer offers and respond with an acceptance,
                rejection or counter-offer.
            </p>

        </div>




        <div class="row g-3 mb-4">

            <div class="col-md-3">

                <div class="stat-card">

                    <div class="stat-number">
                        @negotiations.Count
                    </div>

                    <div class="stat-title">
                        Total Negotiations
                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="stat-card">

                    <div class="stat-number">
                        @pendingCount
                    </div>

                    <div class="stat-title">
                        Pending Offers
                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="stat-card">

                    <div class="stat-number">
                        @counterCount
                    </div>

                    <div class="stat-title">
                        Counter Offers
                    </div>

                </div>

            </div>


            <div class="col-md-3">

                <div class="stat-card">

                    <div class="stat-number">
                        @acceptedCount
                    </div>

                    <div class="stat-title">
                        Accepted
                    </div>

                </div>

            </div>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["Success"]

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">

                <i class="bi bi-exclamation-circle me-2"></i>

                @TempData["Error"]

            </div>
        }


        @if (!negotiations.Any())
        {
            <div class="empty-box">

                <i class="bi bi-chat-square-dots"></i>

                <h4 class="mt-3">
                    No Customer Negotiations
                </h4>

                <p class="text-muted">
                    No customers have made price offers on your products yet.
                </p>

            </div>
        }
        else
        {
            foreach (var negotiation in negotiations)
            {
                string status = negotiation.Status ?? "Pending";

                string statusClass =
                status.Equals("Accepted",
                StringComparison.OrdinalIgnoreCase)
                ? "status-accepted"
                : status.Equals("Rejected",
                StringComparison.OrdinalIgnoreCase)
                ? "status-rejected"
                : status.Equals("CounterOffer",
                StringComparison.OrdinalIgnoreCase)
                ? "status-counter"
                : status.Equals("Expired",
                StringComparison.OrdinalIgnoreCase)
                ? "status-expired"
                : "status-pending";


                <div class="negotiation-card">



                    <div class="d-flex justify-content-between
                                        align-items-start flex-wrap gap-2">

                        <div>

                            <div class="product-name">

                                @(negotiation.Product?.ProductName
                                                        ?? "Product")

                            </div>

                            <div class="customer-name mt-1">

                                <i class="bi bi-person me-1"></i>

                                Customer:
                                @(negotiation.Customer?.Name
                                                        ?? "Customer")

                    </div>

                            <small class="text-muted">

                                Negotiation #@negotiation.NegotiationId

                            </small>

                        </div>


                        <span class="status-badge @statusClass">

                            @status

                        </span>

                    </div>




                    <div class="price-box">

                        <div class="row g-3">

                            <div class="col-md-3">

                                <div class="price-label">
                                    Original Product Price
                                </div>

                                <div class="price-value">

                                    Rs.
                                    @negotiation.OriginalPrice.ToString("N0")

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="price-label">
                                    Customer Offer
                                </div>

                                <div class="price-value">

                                    Rs.
                                    @negotiation.RequestedPrice.ToString("N0")

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="price-label">
                                    Your Counter Offer
                                </div>

                                <div class="price-value">

                            @if (negotiation.CounterPrice.HasValue)
                                    {
                                        <span>
                                            Rs.
                                            @negotiation.CounterPrice.Value.ToString("N0")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Not given
                                        </span>
                                    }

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="price-label">
                                    Final Agreed Price
                                </div>

                                @if (negotiation.AgreedPrice.HasValue)
                                {
                                    <div class="counter-price">

                                        Rs.
                                        @negotiation.AgreedPrice.Value.ToString("N0")

                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted">
                                        Not agreed
                                    </div>
                                }

                            </div>

                        </div>

                    </div>



                    @if (!string.IsNullOrWhiteSpace(
                                negotiation.CustomerMessage))
                    {
                        <div class="message-box">

                            <strong>

                                <i class="bi bi-person me-1"></i>

                                Customer Message

                            </strong>

                            <div class="mt-1">

                                @negotiation.CustomerMessage

                            </div>

                        </div>
                    }




                    @if (!string.IsNullOrWhiteSpace(
                                negotiation.ShopkeeperMessage))
                    {
                        <div class="message-box">

                            <strong>

                                <i class="bi bi-shop me-1"></i>

                                Your Message

                            </strong>

                            <div class="mt-1">

                                @negotiation.ShopkeeperMessage

                            </div>

                        </div>
                    }


                    <div class="mt-3">

                        <small class="text-muted">

                            <i class="bi bi-calendar3 me-1"></i>

                            Created:
                            @negotiation.CreatedDate.ToString(
                            "dd MMM yyyy hh:mm tt")

                </small>

                @if (negotiation.RespondedDate.HasValue)
                        {
                            <small class="text-muted ms-3">

                                <i class="bi bi-clock me-1"></i>

                                Responded:
                                @negotiation.RespondedDate.Value.ToString(
                                "dd MMM yyyy hh:mm tt")

                </small>
                                }

                    </div>




                    @if (status.Equals("Pending",
                                StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="mt-4">

                            <div class="row g-3">



                                <div class="col-md-4">

                                    <form asp-action="AcceptNegotiation"
                                          asp-controller="Shopkeeper"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@negotiation.NegotiationId" />

                                        <button type="submit"
                                                class="btn btn-success w-100"
                                                onclick="return confirm('Accept the customer offer?');">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Accept Offer

                                        </button>

                                    </form>

                                </div>




                                <div class="col-md-4">

                                    <form asp-action="RejectNegotiation"
                                          asp-controller="Shopkeeper"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@negotiation.NegotiationId" />

                                        <button type="submit"
                                                class="btn btn-outline-danger w-100"
                                                onclick="return confirm('Reject this customer offer?');">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Reject Offer

                                        </button>

                                    </form>

                                </div>




                                <div class="col-md-4">

                                    <button type="button"
                                            class="btn btn-gold w-100"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#counter_@negotiation.NegotiationId">

                                        <i class="bi bi-arrow-left-right me-1"></i>

                                        Counter Offer

                                    </button>

                                </div>

                            </div>




                            <div class="collapse mt-3"
                                 id="counter_@negotiation.NegotiationId">

                                <div class="card card-body">

                                    <form asp-action="CounterNegotiation"
                                          asp-controller="Shopkeeper"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@negotiation.NegotiationId" />

                                        <div class="row g-3">

                                            <div class="col-md-5">

                                                <label class="form-label fw-bold">

                                                    Counter Price

                                                </label>

                                                <div class="input-group">

                                                    <span class="input-group-text">
                                                        Rs.
                                                    </span>

                                                    <input type="number"
                                                           name="counterPrice"
                                                           class="form-control"
                                                           min="1"
                                                           step="0.01"
                                                           required
                                                           value="@(negotiation.RequestedPrice)" />

                                                </div>

                                            </div>


                                            <div class="col-md-7">

                                                <label class="form-label fw-bold">

                                                    Message

                                                </label>

                                                <textarea name="shopkeeperMessage"
                                              class="form-control"
                                              rows="2"
                                              placeholder="Write a message for the customer..."></textarea>

                                            </div>

                                        </div>


                                        <button type="submit"
                                                class="btn btn-maroon mt-3">

                                            <i class="bi bi-send me-1"></i>

                                            Send Counter Offer

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }


                    @if (status.Equals("CounterOffer",
                                StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="alert alert-info mt-4 mb-0">

                            <i class="bi bi-hourglass-split me-2"></i>

                            Waiting for the customer to respond to your
                            counter-offer.

                            @if (negotiation.CounterPrice.HasValue)
                            {
                                <strong>
                                    Counter Price:
                                    Rs.
                                    @negotiation.CounterPrice.Value.ToString("N0")
                                </strong>
                            }

                        </div>
                    }


                    @if (status.Equals("Accepted",
                                StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="alert alert-success mt-4 mb-0">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            <strong>
                                Negotiation Accepted.
                            </strong>

                            Final agreed price:

                            <strong>
                                Rs.
                                @negotiation.AgreedPrice?.ToString("N0")
                            </strong>

                        </div>
                    }

                </div>
            }
        }

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>