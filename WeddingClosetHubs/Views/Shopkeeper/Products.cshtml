@model IEnumerable<WeddingClosetHubs.Models.Product>

@{
    ViewData["Title"] = "My Products";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>


    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>My Products - Wedding Closet Hub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f7f4f5;
            font-family: Arial, sans-serif;
            color: #333;
        }



        .navbar-custom {
            background: #800020;
            padding: 16px 35px;
            box-shadow: 0 3px 12px rgba(0,0,0,.12);
        }

        .brand {
            color: #d4af37;
            font-size: 24px;
            font-weight: bold;
            text-decoration: none;
        }

            .brand:hover {
                color: #d4af37;
            }



        .page-container {
            padding: 35px;
            max-width: 1500px;
            margin: auto;
        }



        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            color: #800020;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin: 0;
        }

        .add-btn {
            background: #800020;
            color: white;
            border: none;
            padding: 11px 20px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
            transition: .2s;
        }

            .add-btn:hover {
                background: #5f0018;
                color: white;
                transform: translateY(-1px);
            }



        .alert {
            border-radius: 8px;
            border: none;
        }



        .product-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 18px rgba(0,0,0,.08);
            overflow: hidden;
        }




        .table-heading {
            padding: 20px 25px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .table-heading h5 {
                margin: 0;
                color: #800020;
                font-weight: bold;
            }

        .product-count {
            background: #f8e9ed;
            color: #800020;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }



        .product-table {
            width: 100%;
            margin: 0;
            border-collapse: collapse;
        }

            .product-table thead {
                background: #800020;
                color: white;
            }

            .product-table th {
                padding: 15px 16px;
                font-size: 14px;
                font-weight: 600;
                white-space: nowrap;
                border: none;
            }

            .product-table td {
                padding: 14px 16px;
                vertical-align: middle;
                border-bottom: 1px solid #eee;
            }

            .product-table tbody tr {
                transition: .2s;
            }

                .product-table tbody tr:hover {
                    background: #fffafc;
                }

                .product-table tbody tr:last-child td {
                    border-bottom: none;
                }



        .product-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #eee;
        }

        .no-image {
            width: 70px;
            height: 70px;
            border-radius: 8px;
            background: #f1f1f1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #999;
        }



        .product-name {
            color: #800020;
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 4px;
        }

        .product-type {
            color: #888;
            font-size: 12px;
        }


        .category-main {
            font-weight: 600;
            color: #444;
        }

        .subcategory {
            color: #888;
            font-size: 13px;
            margin-top: 3px;
        }



        .price {
            color: #800020;
            font-size: 16px;
            font-weight: bold;
            white-space: nowrap;
        }



        .stock-number {
            font-weight: bold;
        }

        .stock-out {
            color: #dc3545;
            font-weight: bold;
            font-size: 13px;
        }

        .stock-available {
            color: #198754;
        }



        .status-badge {
            display: inline-block;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-active {
            background: #d1e7dd;
            color: #146c43;
        }

        .status-disabled {
            background: #f8d7da;
            color: #b02a37;
        }



        .actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .action-btn {
            border: none;
            border-radius: 6px;
            padding: 7px 10px;
            font-size: 13px;
            text-decoration: none;
            white-space: nowrap;
            transition: .2s;
        }

        .edit-btn {
            background: #d4af37;
            color: #222;
        }

            .edit-btn:hover {
                background: #b99520;
                color: #222;
            }

        .disable-btn {
            background: #dc3545;
            color: white;
        }

            .disable-btn:hover {
                background: #bb2d3b;
                color: white;
            }

        .enable-btn {
            background: #198754;
            color: white;
        }

            .enable-btn:hover {
                background: #157347;
                color: white;
            }

        .delete-btn {
            background: #343a40;
            color: white;
        }

            .delete-btn:hover {
                background: #212529;
                color: white;
            }




        .empty-box {
            background: white;
            border-radius: 12px;
            padding: 80px 20px;
            text-align: center;
            box-shadow: 0 4px 18px rgba(0,0,0,.08);
        }

        .empty-icon {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: #f8e9ed;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            font-size: 40px;
        }

        .empty-box h4 {
            color: #800020;
            margin-top: 20px;
            font-weight: bold;
        }




        @@media (max-width: 1100px) {

            .product-container {
                overflow-x: auto;
            }

            .product-table {
                min-width: 1050px;
            }
        }


        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 15px 20px;
            }

            .brand {
                font-size: 19px;
            }

            .page-container {
                padding: 20px 15px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .add-btn {
                width: 100%;
                text-align: center;
            }
        }

    </style>


</head>

<body>




    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center">

            <a asp-controller="Shopkeeper"
               asp-action="Dashboard"
               class="brand">

                <i class="bi bi-shop"></i>
                Wedding Closet Hub

            </a>


            <a asp-controller="Shopkeeper"
               asp-action="Dashboard"
               class="btn btn-light">

                <i class="bi bi-speedometer2"></i>
                Dashboard

            </a>

        </div>

    </nav>



    <div class="page-container">






        <div class="page-header">

            <div>

                <h2 class="page-title">

                    <i class="bi bi-box-seam"></i>
                    My Products

                </h2>

                <p class="page-subtitle">

                    Manage products available in your shop.

                </p>

            </div>


            <a asp-controller="Shopkeeper"
               asp-action="AddProduct"
               class="add-btn">

                <i class="bi bi-plus-circle"></i>
                Add Product

            </a>

        </div>




        @if (Model != null && Model.Any())
        {

            <div class="product-container">




                <div class="table-heading">

                    <h5>

                        <i class="bi bi-list-ul"></i>
                        Product Inventory

                    </h5>


                    <span class="product-count">

                        @Model.Count() Products

                    </span>

                </div>





                <div class="table-responsive">

                    <table class="product-table">

                        <thead>

                            <tr>

                                <th>
                                    Product
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Color
                                </th>

                                <th>
                                    Size
                                </th>

                                <th>
                                    Price
                                </th>

                                <th>
                                    Stock
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var product in Model)
                            {

                                <tr>



                                    <td>

                                        <div class="d-flex align-items-center gap-3">

                                            @if (!string.IsNullOrEmpty(product.Image))
                                            {

                                                <img src="@product.Image"
                                                     class="product-img"
                                                     alt="@product.ProductName" />

                                            }
                                            else
                                            {

                                                <div class="no-image">

                                                    <i class="bi bi-image fs-3"></i>

                                                </div>

                                            }


                                            <div>

                                                <div class="product-name">

                                                    @product.ProductName

                                                </div>


                                                @if (!string.IsNullOrWhiteSpace(product.ProductType))
                                                {

                                                    <div class="product-type">

                                                        @product.ProductType

                                                    </div>

                                                }

                                            </div>

                                        </div>

                                    </td>



                                    <td>

                                        <div class="category-main">

                                            @product.Category

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(product.Subcategory))
                                        {

                                            <div class="subcategory">

                                                @product.Subcategory

                                            </div>

                                        }

                                    </td>




                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(product.Color))
                                        {

                                            @product.Color

                                        }
                                        else
                                        {

                                            <span class="text-muted">
                                                —
                                            </span>

                                        }

                                    </td>




                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(product.Size))
                                        {

                                            <span class="badge bg-light text-dark border">

                                                @product.Size

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="text-muted">
                                                —
                                            </span>

                                        }

                                    </td>



                                    <td>

                                        <span class="price">

                                            Rs. @product.Price.ToString("N2")

                                        </span>

                                    </td>


                                    <td>

                                        @if (product.StockQuantity == 0)
                                        {

                                            <span class="stock-out">

                                                <i class="bi bi-exclamation-circle"></i>
                                                Out of Stock

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="stock-number stock-available">

                                                @product.StockQuantity

                                            </span>

                                        }

                                    </td>




                                    <td>

                                        @if (product.Status)
                                        {

                                            <span class="status-badge status-active">

                                                <i class="bi bi-check-circle"></i>
                                                Active

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="status-badge status-disabled">

                                                <i class="bi bi-x-circle"></i>
                                                Disabled

                                            </span>

                                        }

                                    </td>



                                    <td>

                                        <div class="actions">



                                            <a asp-controller="Shopkeeper"
                                               asp-action="EditProduct"
                                               asp-route-id="@product.ProductId"
                                               class="action-btn edit-btn">

                                                <i class="bi bi-pencil"></i>
                                                Edit

                                            </a>




                                            @if (product.Status)
                                            {

                                                <form asp-controller="Shopkeeper"
                                                      asp-action="DisableProduct"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@product.ProductId" />

                                                    <button type="submit"
                                                            class="action-btn disable-btn"
                                                            onclick="return confirm('Disable this product?');">

                                                        <i class="bi bi-eye-slash"></i>
                                                        Disable

                                                    </button>

                                                </form>

                                            }
                                            else
                                            {

                                                <form asp-controller="Shopkeeper"
                                                      asp-action="EnableProduct"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@product.ProductId" />

                                                    <button type="submit"
                                                            class="action-btn enable-btn">

                                                        <i class="bi bi-eye"></i>
                                                        Enable

                                                    </button>

                                                </form>

                                            }



                                            <form asp-controller="Shopkeeper"
                                                  asp-action="DeleteProduct"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@product.ProductId" />

                                                <button type="submit"
                                                        class="action-btn delete-btn"
                                                        onclick="return confirm('Are you sure you want to permanently delete this product?');">

                                                    <i class="bi bi-trash"></i>
                                                    Delete

                                                </button>

                                            </form>


                                        </div>

                                    </td>


                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        }

        else
        {


            <div class="empty-box">

                <div class="empty-icon">

                    <i class="bi bi-box-seam"></i>

                </div>


                <h4>
                    No Products Found
                </h4>


                <p class="text-muted">

                    You have not added any products to your shop yet.

                </p>


                <a asp-controller="Shopkeeper"
                   asp-action="AddProduct"
                   class="add-btn">

                    <i class="bi bi-plus-circle"></i>
                    Add Your First Product

                </a>

            </div>

        }

    </div>


</body>

</html>
