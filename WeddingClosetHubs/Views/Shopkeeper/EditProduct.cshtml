@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = null;

    string shopCategory =
        ViewBag.ShopCategory as string ?? "";

    string currentCategory =
        Model?.Category ?? "";

    string currentSubCategory =
        Model?.Subcategory ?? "";

    string categoryDataJson =
        ViewBag.CategoryDataJson as string ?? "{}";

    string currentSize =
        Model?.Size ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Edit Product - Wedding Closet Hub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        :root {
            --maroon: #800020;
            --maroon-dark: #5f0018;
            --gold: #d4af37;
            --light-bg: #f8f6f7;
            --text-dark: #30262a;
            --border-color: #eadfe3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--light-bg);
            font-family: "Segoe UI", Arial, sans-serif;
            margin: 0;
            color: var(--text-dark);
        }

        .navbar-custom {
            background: linear-gradient(
                135deg,
                var(--maroon-dark),
                var(--maroon)
            );
            padding: 18px 5%;
            box-shadow: 0 4px 15px rgba(60, 0, 20, .15);
        }

        .brand {
            color: var(--gold);
            font-size: 24px;
            font-weight: 800;
            letter-spacing: .3px;
        }

        .navbar-custom .btn {
            border: none;
            border-radius: 8px;
            padding: 10px 17px;
            font-weight: 600;
            transition: .25s ease;
        }

        .navbar-custom .btn:hover {
            background: var(--gold);
            color: var(--maroon);
            transform: translateY(-2px);
        }

        .main-container {
            width: min(1100px, 94%);
            margin: 40px auto;
        }

        .form-card {
            background: #fff;
            padding: 40px;
            border-radius: 18px;
            border: 1px solid #f0e6e9;
            box-shadow: 0 10px 35px rgba(70, 0, 25, .07);
        }

        .page-title {
            color: var(--maroon);
            font-size: 30px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .form-card > p {
            font-size: 15px;
            line-height: 1.7;
        }

        .category-info {
            background: linear-gradient(
                110deg,
                #fff4f6,
                #fffaf0
            );
            border: 1px solid #f0dce2;
            border-left: 5px solid var(--gold);
            padding: 20px 22px;
            border-radius: 12px;
            margin: 25px 0;
            line-height: 1.9;
        }

        .category-info strong {
            color: var(--text-dark);
        }

        .category-info .text-danger {
            color: var(--maroon) !important;
            margin-left: 5px;
        }

        .section-title {
            color: var(--maroon);
            font-size: 19px;
            font-weight: 750;
            border-bottom: 2px solid var(--gold);
            padding-bottom: 12px;
            margin-top: 35px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title::before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 23px;
            border-radius: 5px;
            background: var(--gold);
        }

        .form-label {
            font-weight: 650;
            color: #40343a;
            margin-bottom: 9px;
            font-size: 14px;
        }

        .required {
            color: #dc3545;
        }

        .form-control,
        .form-select {
            min-height: 46px;
            border: 1px solid #ded3d8;
            border-radius: 9px;
            padding: 11px 13px;
            color: #30262a;
            background-color: #fff;
            font-size: 14px;
            transition: border-color .2s, box-shadow .2s;
        }

        textarea.form-control {
            min-height: 115px;
            resize: vertical;
        }

        .form-control::placeholder {
            color: #aaa0a5;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--maroon);
            box-shadow: 0 0 0 .2rem rgba(128, 0, 32, .12);
        }

        .form-control[readonly] {
            background: #f7f1f3;
            color: var(--maroon);
            font-weight: 700;
        }

        .input-group-text {
            background: #f8edf0;
            border: 1px solid #ded3d8;
            color: var(--maroon);
            font-weight: 700;
            border-radius: 9px 0 0 9px;
            padding: 0 17px;
        }

        .input-group .form-control {
            border-radius: 0 9px 9px 0;
        }

        .text-danger.field-validation-error {
            display: block;
            font-size: 13px;
            margin-top: 6px;
        }

        .text-muted {
            color: #81767c !important;
            font-size: 13px;
        }

        .option-box,
        .sale-box,
        .rental-box {
            padding: 25px;
            border-radius: 14px;
            margin-top: 22px;
            transition: box-shadow .2s;
        }

        .option-box:hover,
        .sale-box:hover,
        .rental-box:hover {
            box-shadow: 0 5px 18px rgba(70, 0, 25, .06);
        }

        .buy-box {
            background: #fff5f7;
            border: 1px solid #edcbd5;
            border-left: 5px solid var(--maroon);
        }

        .sale-box {
            background: #fff9fa;
            border: 1px solid #efdae0;
            border-left: 5px solid #b34a66;
        }

        .rental-box {
            background: #fffbef;
            border: 1px solid #efdfac;
            border-left: 5px solid var(--gold);
        }

        .negotiation-box {
            background: #f7f8fa;
            border: 1px solid #dfe2e8;
            border-left: 5px solid #7b8794;
        }

        .option-title,
        .sale-title,
        .rental-title,
        .negotiation-title,
        .measurement-title {
            color: var(--maroon);
            font-weight: 750;
            font-size: 18px;
            margin-bottom: 12px;
        }

        .option-title i,
        .sale-title i,
        .rental-title i,
        .negotiation-title i,
        .measurement-title i {
            margin-right: 7px;
        }

        .info-badge {
            display: inline-block;
            background: var(--maroon);
            color: white;
            padding: 5px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-top: 12px;
        }

        .form-check {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding-left: 0;
        }

        .form-check-input {
            float: none;
            flex-shrink: 0;
            width: 19px;
            height: 19px;
            margin: 2px 0 0;
            cursor: pointer;
            border: 1px solid #b9aab0;
        }

        .form-check-input:checked {
            background-color: var(--maroon);
            border-color: var(--maroon);
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 .2rem rgba(128, 0, 32, .13);
        }

        .form-check-label {
            cursor: pointer;
            font-weight: 550;
            line-height: 1.6;
        }

        .measurement-box {
            background: #fffaf0;
            border: 1px solid #ead99d;
            border-left: 5px solid var(--gold);
            padding: 25px;
            border-radius: 14px;
            margin-top: 25px;
        }

        .current-image,
        .image-preview {
            width: 190px;
            height: 190px;
            object-fit: cover;
            border-radius: 13px;
            border: 2px solid #eadfe3;
            background: #fff;
            padding: 4px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, .07);
        }

        .current-image {
            margin-bottom: 15px;
        }

        .image-preview {
            display: none;
            margin-top: 15px;
        }

        input[type="file"].form-control {
            padding: 9px;
            background: #fcfafb;
        }

        .btn-save,
        .btn-cancel {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 24px;
            border-radius: 9px;
            font-weight: 700;
            text-decoration: none;
            transition: all .25s ease;
        }

        .btn-save {
            background: var(--maroon);
            color: #fff;
            border: 1px solid var(--maroon);
            box-shadow: 0 4px 12px rgba(128, 0, 32, .15);
        }

        .btn-save:hover {
            background: var(--maroon-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 7px 17px rgba(128, 0, 32, .2);
        }

        .btn-cancel {
            background: #fff;
            color: #62565c;
            border: 1px solid #d8cdd2;
        }

        .btn-cancel:hover {
            background: #f1edef;
            color: var(--maroon);
            transform: translateY(-2px);
        }

        .form-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            padding-top: 25px;
            margin-top: 35px;
            border-top: 1px solid #eee5e8;
        }

        @@media (max-width: 768px) {
            .navbar-custom {
                padding: 15px 4%;
            }

            .brand {
                font-size: 18px;
            }

            .navbar-custom .btn {
                padding: 9px 11px;
                font-size: 13px;
            }

            .main-container {
                width: 94%;
                margin: 22px auto;
            }

            .form-card {
                padding: 22px 18px;
                border-radius: 13px;
            }

            .page-title {
                font-size: 25px;
            }

            .section-title {
                font-size: 17px;
                margin-top: 28px;
            }

            .option-box,
            .sale-box,
            .rental-box,
            .measurement-box {
                padding: 19px;
            }

            .form-actions {
                flex-direction: column;
            }

            .form-actions .btn {
                width: 100%;
            }
        }

        @@media (max-width: 420px) {
            .brand {
                font-size: 15px;
            }

            .navbar-custom .btn {
                font-size: 11px;
                padding: 8px;
            }

            .form-card {
                padding: 18px 13px;
            }

            .current-image,
            .image-preview {
                width: 150px;
                height: 150px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar-custom">
        <div class="d-flex justify-content-between align-items-center gap-3">

            <span class="brand">
                <i class="bi bi-gem"></i>
                Wedding Closet Hub
            </span>

            <a asp-controller="Shopkeeper"
               asp-action="Products"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Back to Products
            </a>

        </div>
    </nav>

    <div class="main-container">

        <div class="form-card">

            <h2 class="page-title">
                <i class="bi bi-pencil-square"></i>
                Edit Product
            </h2>

            <p class="text-muted mb-4">
                Update your product information, availability,
                sale, rental and negotiation settings.
            </p>

            <div class="category-info">

                <strong>
                    <i class="bi bi-shop"></i>
                    Shop Category:
                </strong>

                <span class="text-danger fw-bold">
                    @shopCategory
                </span>

                <br />

                <small class="text-muted">
                    Product categories are automatically
                    based on your shop category.
                </small>

            </div>

            <form asp-controller="Shopkeeper"
                  asp-action="EditProduct"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ProductId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <h5 class="section-title">
                    <i class="bi bi-info-circle"></i>
                    Product Information
                </h5>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ProductName"
                               class="form-label">
                            Product Name
                            <span class="required">*</span>
                        </label>

                        <input asp-for="ProductName"
                               class="form-control"
                               placeholder="Enter product name" />

                        <span asp-validation-for="ProductName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Color"
                               class="form-label">
                            Color
                        </label>

                        <input asp-for="Color"
                               class="form-control"
                               placeholder="e.g. Maroon, Golden, Black" />

                        <span asp-validation-for="Color"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the product"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <h5 class="section-title">
                    <i class="bi bi-tags"></i>
                    Category
                </h5>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Category"
                               class="form-label">
                            Category
                            <span class="required">*</span>
                        </label>

                        <select asp-for="Category"
                                id="category"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>

                        <span asp-validation-for="Category"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Subcategory"
                               class="form-label">
                            Subcategory
                            <span class="required">*</span>
                        </label>

                        <select asp-for="Subcategory"
                                id="subCategory"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Subcategory --
                            </option>

                        </select>

                        <span asp-validation-for="Subcategory"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="ProductType"
                           class="form-label">
                        Product Type
                    </label>

                    <input asp-for="ProductType"
                           id="productType"
                           class="form-control"
                           readonly />

                    <small class="text-muted">
                        Product type is automatically determined
                        from the selected category.
                    </small>

                </div>

                <div id="normalSizeSection"
                     class="mb-3">

                    <label asp-for="Size"
                           class="form-label">
                        Size
                    </label>

                    <select asp-for="Size"
                            id="size"
                            class="form-select">

                        <option value="">-- Select Size --</option>
                        <option value="XS">XS</option>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="XXL">XXL</option>

                    </select>

                    <span asp-validation-for="Size"
                          class="text-danger">
                    </span>

                </div>

                <div id="shoeSizeSection"
                     class="mb-3"
                     style="display:none;">

                    <label class="form-label">
                        Shoe Size
                    </label>

                    <select name="Size"
                            id="shoeSize"
                            class="form-select"
                            disabled>

                        <option value="">
                            -- Select Shoe Size --
                        </option>

                        <option value="36">36</option>
                        <option value="37">37</option>
                        <option value="38">38</option>
                        <option value="39">39</option>
                        <option value="40">40</option>
                        <option value="41">41</option>
                        <option value="42">42</option>
                        <option value="43">43</option>
                        <option value="44">44</option>
                        <option value="45">45</option>

                    </select>

                </div>

                <h5 class="section-title">
                    <i class="bi bi-currency-rupee"></i>
                    Price & Stock
                </h5>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Price"
                               class="form-label">
                            Original Price
                            <span class="required">*</span>
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                Rs.
                            </span>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            This remains the original product price.
                        </small>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="StockQuantity"
                               class="form-label">
                            Stock Quantity
                            <span class="required">*</span>
                        </label>

                        <input asp-for="StockQuantity"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="Enter stock quantity" />

                        <span asp-validation-for="StockQuantity"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <h5 class="section-title">
                    <i class="bi bi-check2-circle"></i>
                    Product Availability
                </h5>

                <div class="option-box buy-box">

                    <div class="d-flex align-items-start gap-3">

                        <div class="form-check pt-1">

                            <input asp-for="IsAvailableForBuy"
                                   class="form-check-input"
                                   type="checkbox"
                                   id="isAvailableForBuy" />

                        </div>

                        <div>

                            <label class="option-title"
                                   for="isAvailableForBuy">

                                <i class="bi bi-cart-check"></i>
                                Available for Buy

                            </label>

                            <div class="text-muted">
                                Allow customers to purchase this product.
                            </div>

                            <span class="info-badge">
                                Buy
                            </span>

                        </div>

                    </div>

                </div>

                <div class="sale-box"
                     id="saleBox">

                    <h5 class="sale-title">
                        <i class="bi bi-tag-fill"></i>
                        Sale / Discount
                    </h5>

                    <p class="text-muted">
                        Offer this product at a special sale price.
                        The original price will remain unchanged.
                    </p>

                    <div class="form-check mb-3">

                        <input asp-for="IsOnSale"
                               class="form-check-input"
                               id="isOnSale" />

                        <label class="form-check-label"
                               for="isOnSale">
                            Enable Sale / Discount
                        </label>

                    </div>

                    <div id="saleFields">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="SalePrice"
                                       class="form-label">
                                    Sale Price
                                    <span class="required">*</span>
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        Rs.
                                    </span>

                                    <input asp-for="SalePrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="Enter sale price" />

                                </div>

                                <span asp-validation-for="SalePrice"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="SaleDetails"
                                       class="form-label">
                                    Sale Details
                                </label>

                                <input asp-for="SaleDetails"
                                       class="form-control"
                                       placeholder="e.g. Eid Sale, 20% Off" />

                                <span asp-validation-for="SaleDetails"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="rental-box">

                    <h5 class="rental-title">
                        <i class="bi bi-calendar2-check"></i>
                        Rental Settings
                    </h5>

                    <p class="text-muted">
                        Set your own rental price, refundable security,
                        rental duration and conditions.
                    </p>

                    <div class="form-check mb-3">

                        <input asp-for="IsAvailableForRent"
                               class="form-check-input"
                               id="isAvailableForRent" />

                        <label class="form-check-label"
                               for="isAvailableForRent">
                            Make this product available for rent
                        </label>

                    </div>

                    <div id="rentalFields">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="RentPrice"
                                       class="form-label">
                                    Rental Price
                                    <span class="required">*</span>
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        Rs.
                                    </span>

                                    <input asp-for="RentPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="Enter rental price" />

                                </div>

                                <span asp-validation-for="RentPrice"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="RentalSecurity"
                                       class="form-label">
                                    Refundable Security
                                    <span class="required">*</span>
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        Rs.
                                    </span>

                                    <input asp-for="RentalSecurity"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="Enter security amount" />

                                </div>

                                <span asp-validation-for="RentalSecurity"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="RentalDuration"
                                   class="form-label">
                                Rental Duration
                                <span class="required">*</span>
                            </label>

                            <input asp-for="RentalDuration"
                                   class="form-control"
                                   placeholder="e.g. 3 Days, 1 Week, 10 Days" />

                            <span asp-validation-for="RentalDuration"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="RentalConditions"
                                   class="form-label">
                                Rental Conditions
                                <span class="required">*</span>
                            </label>

                            <textarea asp-for="RentalConditions"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter rental conditions, return rules, damage policy etc."></textarea>

                            <span asp-validation-for="RentalConditions"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="negotiation-box option-box"
                     id="negotiationBox">

                    <h5 class="negotiation-title">
                        <i class="bi bi-chat-square-text"></i>
                        Price Negotiation
                    </h5>

                    <p class="text-muted">
                        Allow customers to request a lower price.
                        Negotiation applies only to products
                        available for buying.
                    </p>

                    <div class="form-check">

                        <input asp-for="AllowNegotiation"
                               class="form-check-input"
                               id="allowNegotiation" />

                        <label class="form-check-label"
                               for="allowNegotiation">
                            Allow customers to negotiate the price
                        </label>

                    </div>

                </div>

                <h5 class="section-title">
                    <i class="bi bi-image"></i>
                    Product Image
                </h5>

                @if (!string.IsNullOrWhiteSpace(Model?.Image))
                {
                    <div class="mb-3">

                        <p class="text-muted mb-2">
                            Current Image:
                        </p>

                        <img src="@Model.Image"
                             class="current-image"
                             alt="@Model.ProductName" />

                    </div>
                }

                <div class="mb-3">

                    <label class="form-label">
                        Change Product Image
                    </label>

                    <input type="file"
                           name="productImage"
                           id="productImage"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <small class="text-muted">
                        Allowed formats: JPG, JPEG, PNG, WEBP.
                        Maximum size: 5 MB.
                    </small>

                    <div>
                        <img id="imagePreview"
                             class="image-preview"
                             alt="New image preview" />
                    </div>

                </div>

                <div id="customMeasurementBox"
                     class="measurement-box"
                     style="display:none;">

                    <h5 class="measurement-title">
                        <i class="bi bi-rulers"></i>
                        Custom Measurement
                    </h5>

                    <p class="text-muted">
                        Customers can provide their own measurements
                        when ordering this product.
                    </p>

                    <div class="form-check">

                        <input asp-for="HasCustomMeasurement"
                               class="form-check-input"
                               id="hasCustomMeasurement" />

                        <label class="form-check-label"
                               for="hasCustomMeasurement">
                            Allow customer to provide custom measurements
                        </label>

                    </div>

                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn btn-save">

                        <i class="bi bi-check-circle-fill"></i>
                        Save Changes

                    </button>

                    <a asp-controller="Shopkeeper"
                       asp-action="Products"
                       class="btn btn-cancel">

                        <i class="bi bi-x-circle"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

    <script>
        "use strict";

        const categoryData =
            @Html.Raw(categoryDataJson);

        const databaseCategory =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    currentCategory
                )
            );

        const databaseSubCategory =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    currentSubCategory
                )
            );

        const databaseSize =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    currentSize
                )
            );

        const categorySelect =
            document.getElementById("category");

        const subCategorySelect =
            document.getElementById("subCategory");

        const productTypeInput =
            document.getElementById("productType");

        const customMeasurementBox =
            document.getElementById("customMeasurementBox");

        const hasCustomMeasurement =
            document.getElementById("hasCustomMeasurement");

        const normalSizeSection =
            document.getElementById("normalSizeSection");

        const shoeSizeSection =
            document.getElementById("shoeSizeSection");

        const sizeSelect =
            document.getElementById("size");

        const shoeSize =
            document.getElementById("shoeSize");

        const isAvailableForBuy =
            document.getElementById("isAvailableForBuy");

        const isOnSale =
            document.getElementById("isOnSale");

        const saleBox =
            document.getElementById("saleBox");

        const saleFields =
            document.getElementById("saleFields");

        const allowNegotiation =
            document.getElementById("allowNegotiation");

        const negotiationBox =
            document.getElementById("negotiationBox");

        const isAvailableForRent =
            document.getElementById("isAvailableForRent");

        const rentalFields =
            document.getElementById("rentalFields");

        const imageInput =
            document.getElementById("productImage");

        const imagePreview =
            document.getElementById("imagePreview");

        function normalize(value) {
            if (!value) {
                return "";
            }

            return value
                .toString()
                .trim()
                .toLowerCase()
                .replace(/\s+/g, " ");
        }

        function findCategory(value) {
            const normalized =
                normalize(value);

            return Object.keys(categoryData)
                .find(function (category) {
                    return normalize(category) === normalized;
                }) || "";
        }

        function findSubCategory(category, value) {
            if (!category) {
                return "";
            }

            const list =
                categoryData[category];

            if (!Array.isArray(list)) {
                return "";
            }

            const normalized =
                normalize(value);

            return list.find(function (item) {
                return normalize(item) === normalized;
            }) || "";
        }

        function updateBuyDependentOptions() {
            const buyEnabled =
                isAvailableForBuy.checked;

            saleBox.style.display =
                buyEnabled
                    ? "block"
                    : "none";

            negotiationBox.style.display =
                buyEnabled
                    ? "block"
                    : "none";

            if (!buyEnabled) {
                isOnSale.checked = false;
                allowNegotiation.checked = false;
            }

            updateSaleFields();
        }

        function updateSaleFields() {
            const saleEnabled =
                isAvailableForBuy.checked &&
                isOnSale.checked;

            saleFields.style.display =
                saleEnabled
                    ? "block"
                    : "none";
        }

        function updateRentalFields() {
            const rentalEnabled =
                isAvailableForRent.checked;

            rentalFields.style.display =
                rentalEnabled
                    ? "block"
                    : "none";
        }

        function setExistingNormalSize() {
            const existingSize =
                databaseSize.toString().trim();

            if (!existingSize) {
                return;
            }

            const matchingOption =
                Array.from(sizeSelect.options)
                    .find(function (option) {
                        return option.value === existingSize;
                    });

            if (matchingOption) {
                sizeSelect.value =
                    existingSize;
            }
        }

        function setExistingShoeSize() {
            const existingSize =
                databaseSize.toString().trim();

            if (!existingSize) {
                return;
            }

            const matchingOption =
                Array.from(shoeSize.options)
                    .find(function (option) {
                        return option.value === existingSize;
                    });

            if (matchingOption) {
                shoeSize.value =
                    existingSize;
            }
        }

        function loadCategories() {
            categorySelect.innerHTML =
                '<option value="">-- Select Category --</option>';

            Object.keys(categoryData).forEach(
                function (categoryName) {

                    const option =
                        document.createElement("option");

                    option.value =
                        categoryName;

                    option.textContent =
                        categoryName;

                    categorySelect.appendChild(
                        option
                    );
                }
            );

            const matchingCategory =
                findCategory(databaseCategory);

            if (matchingCategory) {
                categorySelect.value =
                    matchingCategory;
            }

            loadSubCategories(
                matchingCategory,
                databaseSubCategory
            );
        }

        function loadSubCategories(
            categoryName = null,
            selectedSubCategory = null
        ) {
            subCategorySelect.innerHTML =
                '<option value="">-- Select Subcategory --</option>';

            const selectedCategory =
                categoryName ||
                categorySelect.value;

            if (!selectedCategory) {
                updateProductOptions();
                return;
            }

            const subCategories =
                categoryData[selectedCategory];

            if (!Array.isArray(subCategories)) {
                updateProductOptions();
                return;
            }

            subCategories.forEach(
                function (subCategoryName) {

                    const option =
                        document.createElement("option");

                    option.value =
                        subCategoryName;

                    option.textContent =
                        subCategoryName;

                    subCategorySelect.appendChild(
                        option
                    );
                }
            );

            const matchingSubCategory =
                findSubCategory(
                    selectedCategory,
                    selectedSubCategory
                );

            if (matchingSubCategory) {
                subCategorySelect.value =
                    matchingSubCategory;
            }

            updateProductOptions();
        }

        function updateProductOptions() {
            const selectedCategory =
                normalize(
                    categorySelect.value
                );

            const selectedSubCategory =
                normalize(
                    subCategorySelect.value
                );

            customMeasurementBox.style.display =
                "none";

            shoeSizeSection.style.display =
                "none";

            normalSizeSection.style.display =
                "block";

            sizeSelect.disabled =
                false;

            shoeSize.disabled =
                true;

            if (
                selectedCategory === "footwear" ||
                selectedCategory === "shoes"
            ) {
                normalSizeSection.style.display =
                    "none";

                shoeSizeSection.style.display =
                    "block";

                productTypeInput.value =
                    "Footwear";

                sizeSelect.disabled =
                    true;

                shoeSize.disabled =
                    false;

                setExistingShoeSize();

                return;
            }

            if (
                selectedCategory === "jewellery" ||
                selectedCategory === "jewelry"
            ) {
                normalSizeSection.style.display =
                    "none";

                productTypeInput.value =
                    "Jewellery";

                sizeSelect.disabled =
                    true;

                shoeSize.disabled =
                    true;

                hasCustomMeasurement.checked =
                    false;

                return;
            }

            if (
                selectedCategory === "accessories" ||
                selectedCategory === "wedding accessories"
            ) {
                normalSizeSection.style.display =
                    "none";

                productTypeInput.value =
                    "Accessories";

                sizeSelect.disabled =
                    true;

                shoeSize.disabled =
                    true;

                hasCustomMeasurement.checked =
                    false;

                return;
            }

            if (
                selectedCategory === "wedding guest wear" ||
                selectedCategory === "guest wear"
            ) {
                normalSizeSection.style.display =
                    "block";

                productTypeInput.value =
                    "Wedding Guest Wear";

                customMeasurementBox.style.display =
                    "none";

                hasCustomMeasurement.checked =
                    false;

                sizeSelect.disabled =
                    false;

                shoeSize.disabled =
                    true;

                setExistingNormalSize();

                return;
            }

            const dressKeywords = [
                "dress",
                "lehenga",
                "gown",
                "maxi",
                "sharara",
                "gharara",
                "pishwas",
                "saree",
                "frock",
                "anarkali",
                "palazzo",
                "shalwar kameez",
                "kurta pajama",
                "suit",
                "tuxedo",
                "sherwani",
                "prince coat",
                "waistcoat",
                "blazer",
                "shirt & trouser"
            ];

            const isDress =
                dressKeywords.some(
                    function (keyword) {
                        return selectedSubCategory
                            .includes(keyword);
                    }
                );

            if (
                selectedCategory === "dress" ||
                isDress
            ) {
                normalSizeSection.style.display =
                    "block";

                customMeasurementBox.style.display =
                    "block";

                productTypeInput.value =
                    "Dress / Custom Size";

                sizeSelect.disabled =
                    false;

                shoeSize.disabled =
                    true;

                setExistingNormalSize();

                return;
            }

            productTypeInput.value =
                "Standard Product";

            sizeSelect.disabled =
                false;

            shoeSize.disabled =
                true;

            hasCustomMeasurement.checked =
                false;

            setExistingNormalSize();
        }

        categorySelect.addEventListener(
            "change",
            function () {
                loadSubCategories();
            }
        );

        subCategorySelect.addEventListener(
            "change",
            function () {
                updateProductOptions();
            }
        );

        isAvailableForBuy.addEventListener(
            "change",
            function () {
                updateBuyDependentOptions();
            }
        );

        isOnSale.addEventListener(
            "change",
            function () {
                updateSaleFields();
            }
        );

        isAvailableForRent.addEventListener(
            "change",
            function () {
                updateRentalFields();
            }
        );

        shoeSize.addEventListener(
            "change",
            function () {
                if (!shoeSize.disabled) {
                    sizeSelect.value = "";
                }
            }
        );

        sizeSelect.addEventListener(
            "change",
            function () {
                if (!sizeSelect.disabled) {
                    shoeSize.value = "";
                }
            }
        );

        imageInput.addEventListener(
            "change",
            function () {
                const file =
                    this.files[0];

                if (!file) {
                    imagePreview.src = "";
                    imagePreview.style.display =
                        "none";

                    return;
                }

                const allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (!allowedTypes.includes(file.type)) {
                    alert(
                        "Please select a JPG, JPEG, PNG, or WEBP image."
                    );

                    this.value = "";
                    imagePreview.src = "";
                    imagePreview.style.display =
                        "none";

                    return;
                }

                if (
                    file.size >
                    5 * 1024 * 1024
                ) {
                    alert(
                        "Product image must be 5 MB or smaller."
                    );

                    this.value = "";
                    imagePreview.src = "";
                    imagePreview.style.display =
                        "none";

                    return;
                }

                imagePreview.src =
                    URL.createObjectURL(file);

                imagePreview.style.display =
                    "block";
            }
        );

        document.querySelector("form")
            .addEventListener(
                "submit",
                function (event) {

                    if (
                        !isAvailableForBuy.checked &&
                        !isAvailableForRent.checked
                    ) {
                        event.preventDefault();

                        alert(
                            "Please select at least one option: Buy or Rent."
                        );

                        return;
                    }

                    if (!isAvailableForBuy.checked) {
                        isOnSale.checked =
                            false;

                        allowNegotiation.checked =
                            false;
                    }

                    if (
                        !shoeSize.disabled
                    ) {
                        sizeSelect.disabled =
                            true;
                    }
                    else if (
                        !sizeSelect.disabled
                    ) {
                        shoeSize.disabled =
                            true;
                    }
                }
            );

        loadCategories();

        updateBuyDependentOptions();

        updateRentalFields();
    </script>

</body>
</html>