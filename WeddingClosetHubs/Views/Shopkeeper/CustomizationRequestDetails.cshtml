@model WeddingClosetHubs.Models.CustomizationRequest

@{
    ViewData["Title"] = "Customization Request Details";

    var imagePaths =
        string.IsNullOrWhiteSpace(Model.ReferenceImages)
            ? new List<string>()
            : Model.ReferenceImages
                .Split(
                    '|',
                    StringSplitOptions.RemoveEmptyEntries)
                .ToList();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1"
                style="color:#800020;">
                Customization Request
            </h2>

            <p class="text-muted mb-0">
                Review the customer's customization requirements.
            </p>
        </div>

        <a asp-controller="Shopkeeper"
           asp-action="CustomizationRequests"
           class="btn"
           style="background:#800020;color:white;">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Requests
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-5">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header text-white"
                     style="background:#800020;">
                    <h5 class="mb-0">
                        <i class="bi bi-person me-2"></i>
                        Customer & Product
                    </h5>
                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Product?.Image))
                    {
                        <div class="text-center mb-3">

                            <img src="@Model.Product.Image"
                                 class="img-fluid rounded"
                                 style="max-height:280px;object-fit:contain;" />

                        </div>
                    }

                    <h4 style="color:#800020;">
                        @(Model.Product?.ProductName ?? "Product")
                    </h4>

                    <hr />

                    <p class="mb-2">
                        <strong>Customer:</strong>
                        @(Model.Customer?.Name ?? "Customer")
                    </p>

                    <p class="mb-2">
                        <strong>Email:</strong>
                        @(Model.Customer?.Email ?? "Not available")
                    </p>

                    <p class="mb-2">
                        <strong>Selected Size:</strong>
                        @(string.IsNullOrWhiteSpace(Model.SelectedSize)
                            ? "Not selected"
                            : Model.SelectedSize)
                    </p>

                    <p class="mb-2">
                        <strong>Request Date:</strong>
                        @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")
                    </p>

                    <p class="mb-0">
                        <strong>Status:</strong>

                        <span class="badge bg-info text-dark ms-1">
                            @Model.Status
                        </span>
                    </p>

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm border-0 mb-4">

                <div class="card-header"
                     style="background:#f8f1f3;color:#800020;">
                    <h5 class="mb-0">
                        <i class="bi bi-rulers me-2"></i>
                        Customer Measurements
                    </h5>
                </div>

                <div class="card-body">

                    @if (string.IsNullOrWhiteSpace(Model.Measurements))
                    {
                        <p class="text-muted mb-0">
                            No measurements provided.
                        </p>
                    }
                    else
                    {
                        var measurements =
                            Model.Measurements
                                .Split(
                                    '|',
                                    StringSplitOptions.RemoveEmptyEntries);

                        <div class="row g-2">

                            @foreach (var measurement in measurements)
                            {
                                var parts =
                                    measurement.Split(
                                        ':',
                                        2,
                                        StringSplitOptions.None);

                                <div class="col-md-6">

                                    <div class="border rounded p-3 bg-light">

                                        @if (parts.Length == 2)
                                        {
                                            <strong>
                                                @parts[0].Trim()
                                            </strong>

                                            <div class="mt-1">
                                                @parts[1].Trim()
                                            </div>
                                        }
                                        else
                                        {
                                            @measurement.Trim()
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>


            <div class="card shadow-sm border-0 mb-4">

                <div class="card-header"
                     style="background:#f8f1f3;color:#800020;">
                    <h5 class="mb-0">
                        <i class="bi bi-chat-left-text me-2"></i>
                        Customer Notes
                    </h5>
                </div>

                <div class="card-body">

                    @if (string.IsNullOrWhiteSpace(
                        Model.CustomerNotes))
                    {
                        <span class="text-muted">
                            No additional notes provided.
                        </span>
                    }
                    else
                    {
                        <p class="mb-0"
                           style="white-space:pre-wrap;">
                            @Model.CustomerNotes
                        </p>
                    }

                </div>

            </div>


            <div class="card shadow-sm border-0 mb-4">

                <div class="card-header"
                     style="background:#f8f1f3;color:#800020;">
                    <h5 class="mb-0">
                        <i class="bi bi-images me-2"></i>
                        Reference Images
                    </h5>
                </div>

                <div class="card-body">

                    @if (!imagePaths.Any())
                    {
                        <p class="text-muted mb-0">
                            No reference images were uploaded.
                        </p>
                    }
                    else
                    {
                        <div class="row g-3">

                            @foreach (var imagePath in imagePaths)
                            {
                                <div class="col-md-4">

                                    <a href="@imagePath"
                                       target="_blank">

                                        <img src="@imagePath"
                                             class="img-fluid rounded border"
                                             style="width:100%;height:180px;object-fit:cover;" />

                                    </a>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>


            @if (!string.Equals(
                Model.Status,
                "Accepted",
                StringComparison.OrdinalIgnoreCase)
                &&
                !string.Equals(
                    Model.Status,
                    "Cancelled",
                    StringComparison.OrdinalIgnoreCase))
            {
                <div class="card shadow-sm border-0">

                    <div class="card-header text-white"
                         style="background:#800020;">

                        <h5 class="mb-0">
                            <i class="bi bi-tag me-2"></i>
                            Send Customized Price
                        </h5>

                    </div>

                    <div class="card-body">

                        <form asp-controller="Shopkeeper"
                              asp-action="SendCustomizationPrice"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.CustomizationRequestId" />

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Customized Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        Rs.
                                    </span>

                                    <input type="number"
                                           name="price"
                                           class="form-control"
                                           min="1"
                                           step="0.01"
                                           value="@(Model.ShopkeeperPrice?.ToString("0.00"))"
                                           required />

                                </div>

                            </div>

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Note for Customer
                                    <span class="text-muted">
                                        (Optional)
                                    </span>
                                </label>

                                <textarea name="notes"
                                          class="form-control"
                                          rows="4"
                                          maxlength="2000"
                                          placeholder="Add any details about the customized price or customization...">@Model.ShopkeeperNotes</textarea>

                            </div>

                            <button type="submit"
                                    class="btn w-100"
                                    style="background:#800020;color:white;">

                                <i class="bi bi-send me-2"></i>
                                Send Customized Price

                            </button>

                        </form>

                    </div>

                </div>
            }
            else
            {
                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <div class="alert alert-success mb-0">

                            <strong>
                                Current Status:
                            </strong>

                            @Model.Status

                            @if (Model.ShopkeeperPrice.HasValue)
                            {
                                <div class="mt-2">
                                    Customized Price:
                                    <strong>
                                        Rs.
                                        @Model.ShopkeeperPrice.Value.ToString("N2")
                                    </strong>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(
                                Model.ShopkeeperNotes))
                            {
                                <div class="mt-2">
                                    <strong>Shopkeeper Note:</strong>
                                    <div>
                                        @Model.ShopkeeperNotes
                                    </div>
                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>