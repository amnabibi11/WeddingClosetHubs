@model IEnumerable<WeddingClosetHubs.Models.Order>

@{
    ViewData["Title"] = "Payments";
    Layout = null;

    // =========================================================
    // EXCLUDE CANCELLED ORDERS
    // Cancelled orders must not appear in shopkeeper payments.
    // =========================================================

    var orders = (Model?
        .Where(x => !string.Equals(
            x.OrderStatus,
            "Cancelled",
            StringComparison.OrdinalIgnoreCase))
        .ToList())
        ?? new List<WeddingClosetHubs.Models.Order>();


    // =========================================================
    // PAYMENT TOTALS
    // =========================================================

    decimal totalProductAmount =
        orders.Sum(x => x.ProductTotal);

    decimal totalServiceFee =
        orders.Sum(x => x.ServiceFee);

    decimal totalShopkeeperAmount =
        orders.Sum(x => x.ShopkeeperAmount);


    decimal paidAmount = orders
        .Where(x =>
            !string.IsNullOrWhiteSpace(
                x.ShopkeeperPaymentStatus)
            &&
            x.ShopkeeperPaymentStatus.Equals(
                "Paid",
                StringComparison.OrdinalIgnoreCase))
        .Sum(x => x.ShopkeeperPaidAmount);


    decimal pendingAmount = orders
        .Where(x =>
            string.IsNullOrWhiteSpace(
                x.ShopkeeperPaymentStatus)
            ||
            !x.ShopkeeperPaymentStatus.Equals(
                "Paid",
                StringComparison.OrdinalIgnoreCase))
        .Sum(x => x.ShopkeeperAmount);

}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Payments - Wedding Closet Hub
    </title>


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        body {
            background: #f7f7f7;
            font-family: Arial, sans-serif;
            margin: 0;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .page-header {
            background: #800020;
            color: white;
            padding: 25px 30px;
            margin-bottom: 25px;
        }

        .page-header h2 {
            margin: 0;
            font-weight: 600;
        }

        .page-header p {
            margin: 5px 0 0;
            opacity: .85;
        }


        /* =====================================================
           SUMMARY CARDS
        ===================================================== */

        .summary-card {
            background: white;
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            padding: 20px;
            height: 100%;
        }

        .summary-icon {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            background: #f4e8ec;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .summary-title {
            color: #777;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .summary-value {
            color: #800020;
            font-size: 21px;
            font-weight: bold;
        }


        /* =====================================================
           CARDS
        ===================================================== */

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            margin-bottom: 20px;
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #eee;
            padding: 16px 20px;
            color: #800020;
            font-weight: 600;
        }


        /* =====================================================
           TABLE
        ===================================================== */

        .table {
            margin-bottom: 0;
        }

        .table thead {
            background: #800020;
            color: white;
        }

        .table thead th {
            border: none;
            padding: 14px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 14px;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background: #fafafa;
        }


        /* =====================================================
           TRANSACTION ID
        ===================================================== */

        .transaction-id {
            display: inline-block;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 6px 9px;
            font-size: 12px;
            font-weight: 600;
            color: #495057;
            min-width: 100px;
            word-break: break-word;
        }


        /* =====================================================
           PAYMENT STATUS
        ===================================================== */

        .payment-badge {
            display: inline-block;
            padding: 6px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .payment-paid {
            background: #d1e7dd;
            color: #0f5132;
        }

        .payment-pending {
            background: #fff3cd;
            color: #856404;
        }


        /* =====================================================
           ORDER STATUS
        ===================================================== */

        .order-badge {
            display: inline-block;
            padding: 6px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: #e2e3ff;
            color: #373a8a;
        }


        /* =====================================================
           PAYMENT METHOD
        ===================================================== */

        .method-badge {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 6px;
            background: #f5f5f5;
            color: #444;
            font-size: 12px;
            font-weight: 600;
        }


        /* =====================================================
           VIEW BUTTON
        ===================================================== */

        .view-btn {
            background: #800020;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 7px 12px;
            text-decoration: none;
            font-size: 13px;
            display: inline-block;
        }

        .view-btn:hover {
            background: #650019;
            color: white;
        }


        /* =====================================================
           INFORMATION BOX
        ===================================================== */

        .payment-info {
            background: #fffdf5;
            border-left: 4px solid #d4af37;
            border-radius: 8px;
            padding: 18px;
        }

        .payment-info i {
            color: #d4af37;
        }


        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #777;
        }

        .empty-state i {
            font-size: 55px;
            color: #bbb;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @@media (max-width: 768px) {

            .page-header {
                padding: 20px;
            }

            .page-header h2 {
                font-size: 22px;
            }

            .summary-value {
                font-size: 18px;
            }

        }

    </style>

</head>

<body>

<!-- =========================================================
     PAGE HEADER
========================================================= -->

<div class="page-header">

    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h2>

                    <i class="bi bi-wallet2"></i>

                    Payments

                </h2>

                <p>

                    View payments received from the administrator.

                </p>

            </div>


            <div>

                <a asp-controller="Shopkeeper"
                   asp-action="Dashboard"
                   class="btn btn-light">

                    <i class="bi bi-arrow-left"></i>

                    Dashboard

                </a>

            </div>

        </div>

    </div>

</div>


<div class="container-fluid">

<!-- =========================================================
     SUMMARY CARDS
========================================================= -->

<div class="row g-4 mb-4">


    <!-- PRODUCT SALES -->

    <div class="col-lg-3 col-md-6">

        <div class="summary-card">

            <div class="d-flex align-items-center">

                <div class="summary-icon me-3">

                    <i class="bi bi-cart-check"></i>

                </div>

                <div>

                    <div class="summary-title">

                        Product Sales

                    </div>

                    <div class="summary-value">

                        Rs. @totalProductAmount.ToString("N2")

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- SERVICE FEE -->

    <div class="col-lg-3 col-md-6">

        <div class="summary-card">

            <div class="d-flex align-items-center">

                <div class="summary-icon me-3">

                    <i class="bi bi-percent"></i>

                </div>

                <div>

                    <div class="summary-title">

                        Service Fee

                    </div>

                    <div class="summary-value">

                        Rs. @totalServiceFee.ToString("N2")

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PAID -->

    <div class="col-lg-3 col-md-6">

        <div class="summary-card">

            <div class="d-flex align-items-center">

                <div class="summary-icon me-3">

                    <i class="bi bi-check-circle"></i>

                </div>

                <div>

                    <div class="summary-title">

                        Received

                    </div>

                    <div class="summary-value">

                        Rs. @paidAmount.ToString("N2")

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PENDING -->

    <div class="col-lg-3 col-md-6">

        <div class="summary-card">

            <div class="d-flex align-items-center">

                <div class="summary-icon me-3">

                    <i class="bi bi-clock-history"></i>

                </div>

                <div>

                    <div class="summary-title">

                        Pending

                    </div>

                    <div class="summary-value">

                        Rs. @pendingAmount.ToString("N2")

                    </div>

                </div>

            </div>

        </div>

    </div>


</div>




<!-- =========================================================
     PAYMENT SUMMARY
========================================================= -->

<div class="card">

    <div class="card-header">

        <i class="bi bi-calculator"></i>

        Earnings Summary

    </div>


    <div class="card-body">

        <div class="row text-center">


            <div class="col-md-4 mb-3 mb-md-0">

                <div class="text-muted">

                    Total Product Amount

                </div>

                <h4 class="mt-2">

                    Rs. @totalProductAmount.ToString("N2")

                </h4>

            </div>


            <div class="col-md-4 mb-3 mb-md-0">

                <div class="text-muted">

                    Platform Service Fee

                </div>

                <h4 class="mt-2">

                    Rs. @totalServiceFee.ToString("N2")

                </h4>

            </div>


            <div class="col-md-4">

                <div class="text-muted">

                    Shopkeeper Amount

                </div>

                <h4 class="mt-2 text-success">

                    Rs. @totalShopkeeperAmount.ToString("N2")

                </h4>

            </div>


        </div>

    </div>

</div>


<!-- =========================================================
     PAYMENT HISTORY
========================================================= -->

<div class="card">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center">

            <span>

                <i class="bi bi-receipt"></i>

                Payment History

            </span>


            <span class="text-muted">

                @orders.Count order(s)

            </span>

        </div>

    </div>


    <div class="card-body p-0">


        @if (orders.Any())
        {

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>

                        <tr>

                            <th>
                                Order
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Customer Payment
                            </th>

                            <th>
                                Product Amount
                            </th>

                            <th>
                                Service Fee
                            </th>

                            <th>
                                Shopkeeper Amount
                            </th>

                            <th>
                                Order Status
                            </th>

                            <th>
                                Payment Status
                            </th>

                            <th>
                                Payment Method
                            </th>

                            <th>
                                Payment Account
                            </th>

                            <th>
                                Transaction / Reference ID
                            </th>

                            <th>
                                Payment Date
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        @foreach (var order in orders
                            .OrderByDescending(x => x.CreatedDate))
                        {

                            string paymentStatus =
                                string.IsNullOrWhiteSpace(
                                    order.ShopkeeperPaymentStatus)
                                ? "Pending"
                                : order.ShopkeeperPaymentStatus;


                            string paymentClass =
                                paymentStatus.Equals(
                                    "Paid",
                                    StringComparison.OrdinalIgnoreCase)
                                ? "payment-paid"
                                : "payment-pending";


                            <tr>


                                <!-- ORDER ID -->

                                <td>

                                    <strong>

                                        #@order.OrderId

                                    </strong>

                                </td>


                                <!-- DATE -->

                                <td>

                                    @order.CreatedDate.ToString(
                                        "dd MMM yyyy")

                                </td>


                                <!-- CUSTOMER PAYMENT METHOD -->

                                <td>

                                    @{
                                        string customerPayment =
                                            string.IsNullOrWhiteSpace(
                                                order.PaymentMethod)
                                            ? "N/A"
                                            : order.PaymentMethod;
                                    }

                                    <span class="method-badge">

                                        @customerPayment

                                    </span>

                                </td>


                                <!-- PRODUCT AMOUNT -->

                                <td>

                                    Rs.
                                    @order.ProductTotal.ToString("N2")

                                </td>


                                <!-- SERVICE FEE -->

                                <td>

                                    Rs.
                                    @order.ServiceFee.ToString("N2")

                                </td>


                                <!-- SHOPKEEPER AMOUNT -->

                                <td>

                                    <strong>

                                        Rs.
                                        @order.ShopkeeperAmount.ToString("N2")
                                            

                                    </strong>

                                </td>


                                <!-- ORDER STATUS -->

                                <td>

                                    <span class="order-badge">

                                        @order.OrderStatus

                                    </span>

                                </td>


                                <!-- SHOPKEEPER PAYMENT STATUS -->

                                <td>

                                    <span class="payment-badge @paymentClass">

                                        @paymentStatus

                                    </span>

                                </td>


                                <!-- SHOPKEEPER PAYMENT METHOD -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        order.ShopkeeperPaymentMethod))
                                    {
                                        <span class="method-badge">

                                            @order.ShopkeeperPaymentMethod

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Not Paid

                                        </span>
                                    }

                                </td>


                                <!-- SHOPKEEPER PAYMENT ACCOUNT -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        order.ShopkeeperPaymentAccount))
                                    {
                                        <span>

                                            @order.ShopkeeperPaymentAccount

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Not Recorded

                                        </span>
                                    }

                                </td>


                                <!-- =================================================
                                     SHOPKEEPER TRANSACTION ID
                                ================================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        order.ShopkeeperTransactionId))
                                    {
                                        <span class="transaction-id">

                                            @order.ShopkeeperTransactionId

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Not Recorded

                                        </span>
                                    }

                                </td>


                                <!-- PAYMENT DATE -->

                                <td>

                                    @if (order.ShopkeeperPaymentDate.HasValue)
                                    {
                                        <span>

                                            @order.ShopkeeperPaymentDate.Value.ToString("dd MMM yyyy")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Not Paid

                                        </span>
                                    }

                                </td>


                                <!-- VIEW ORDER -->

                                <td>

                                    <a asp-controller="Shopkeeper"
                                       asp-action="OrderDetails"
                                       asp-route-id="@order.OrderId"
                                       class="view-btn">

                                        <i class="bi bi-eye"></i>

                                        View

                                    </a>

                                </td>


                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="empty-state">

                <i class="bi bi-wallet2"></i>

                <h5 class="mt-3">

                    No Payment Records

                </h5>

                <p class="mb-0">

                    Payment information will appear here after
                    customers place orders from your shop.

                </p>

            </div>

        }

    </div>

</div>





</div>

</body>

</html>