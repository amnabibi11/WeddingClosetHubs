@model WeddingClosetHubs.Models.Order

@{
    ViewData["Title"] = "Order Details";
    Layout = null;

    string orderStatus = Model.OrderStatus ?? "Pending";

    string statusClass = orderStatus.ToLowerInvariant() switch
    {
        "confirmed" => "status-confirmed",
        "processing" => "status-processing",
        "ready" => "status-ready",
        "ready for delivery" => "status-ready",
        "assigned" => "status-shipped",
        "picked up" => "status-shipped",
        "shipped" => "status-shipped",
        "out for delivery" => "status-shipped",
        "delivered" => "status-delivered",
        "completed" => "status-delivered",
        "cancelled" => "status-cancelled",
        "rejected" => "status-cancelled",
        _ => "status-pending"
    };

    bool canUpdateStatus =
        orderStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase) ||
        orderStatus.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ||
        orderStatus.Equals("Processing", StringComparison.OrdinalIgnoreCase);

    string[] nextStatuses = orderStatus.ToLowerInvariant() switch
    {
        "pending" => new[] { "Confirmed", "Cancelled" },
        "confirmed" => new[] { "Processing", "Cancelled" },
        "processing" => new[] { "Ready", "Cancelled" },
        _ => Array.Empty<string>()
    };

    string Normalize(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Trim();
    }

    bool IsCustomize(string? value)
    {
        return Normalize(value).Contains(
            "custom",
            StringComparison.OrdinalIgnoreCase);
    }

    bool IsRent(string? value)
    {
        return Normalize(value).Contains(
                   "rent",
                   StringComparison.OrdinalIgnoreCase)
               || Normalize(value).Contains(
                   "rental",
                   StringComparison.OrdinalIgnoreCase);
    }

    bool IsSale(string? value)
    {
        return Normalize(value).Contains(
                   "sale",
                   StringComparison.OrdinalIgnoreCase)
               || Normalize(value).Equals(
                   "Sell",
                   StringComparison.OrdinalIgnoreCase);
    }

    bool IsNegotiated(string? value)
    {
        return Normalize(value).Contains(
            "negotiat",
            StringComparison.OrdinalIgnoreCase);
    }

    bool IsBuy(string? value)
    {
        string type = Normalize(value);

        return string.IsNullOrWhiteSpace(type)
            || type.Contains("buy", StringComparison.OrdinalIgnoreCase)
            || type.Contains("purchase", StringComparison.OrdinalIgnoreCase);
    }

    string GetPurchaseType(string? value)
    {
        if (IsCustomize(value))
        {
            if (IsRent(value))
                return "Customize / Rent";

            if (IsSale(value))
                return "Customize / Sale";

            if (IsNegotiated(value))
                return "Customize / Negotiated";

            if (IsBuy(value))
                return "Customize / Buy";

            return "Customize";
        }

        if (IsRent(value))
            return "Rent";

        if (IsSale(value))
            return "Sale";

        if (IsNegotiated(value))
            return "Negotiated";

        return "Buy";
    }

    string GetTypeClass(string? value)
    {
        if (IsCustomize(value))
            return "type-customize";

        if (IsRent(value))
            return "type-rent";

        if (IsSale(value))
            return "type-sale";

        return "type-buy";
    }

    string GetTypeIcon(string? value)
    {
        if (IsCustomize(value))
            return "bi-rulers";

        if (IsRent(value))
            return "bi-arrow-repeat";

        if (IsSale(value))
            return "bi-tag";

        if (IsNegotiated(value))
            return "bi-handshake";

        return "bi-bag";
    }

    string FormatMoney(decimal amount)
    {
        return "Rs. " + amount.ToString("N2");
    }

    bool HasRental(OrderDetail detail)
    {
        return IsRent(detail.PurchaseType);
    }

    bool HasCustomization(OrderDetail detail)
    {
        return IsCustomize(detail.PurchaseType)
               || !string.IsNullOrWhiteSpace(detail.CustomMeasurements);
    }

    bool HasSale(OrderDetail detail)
    {
        return IsSale(detail.PurchaseType);
    }

    bool HasNegotiation(OrderDetail detail)
    {
        return IsNegotiated(detail.PurchaseType);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Order Details - Wedding Closet Hubs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --maroon: #800020;
            --maroon-dark: #650019;
            --gold: #d4af37;
            --light-bg: #f7f7f7;
        }

        body {
            background: var(--light-bg);
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .page-header {
            background: var(--maroon);
            color: white;
            padding: 22px 30px;
            margin-bottom: 25px;
        }

        .page-header h2 {
            font-weight: 700;
            margin: 0;
        }

        .page-header p {
            margin: 5px 0 0;
            opacity: .85;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #eee;
            padding: 16px 20px;
            font-weight: 700;
            color: var(--maroon);
        }

        .card-body {
            padding: 20px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #666;
            font-weight: 600;
        }

        .info-value {
            color: #222;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .status-badge,
        .type-badge {
            display: inline-block;
            padding: 6px 13px;
            border-radius: 25px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-pending { background: #fff3cd; color: #856404; }
        .status-confirmed { background: #cff4fc; color: #055160; }
        .status-processing { background: #e2e3ff; color: #373a8a; }
        .status-ready { background: #d4edda; color: #155724; }
        .status-shipped { background: #d1ecf1; color: #0c5460; }
        .status-delivered { background: #d1e7dd; color: #0f5132; }
        .status-cancelled { background: #f8d7da; color: #842029; }

        .type-buy { background: #e9ecef; color: #343a40; }
        .type-sale { background: #d1e7dd; color: #0f5132; }
        .type-rent { background: #fff3cd; color: #856404; }
        .type-customize { background: #e2d9f3; color: #4c3575; }

        .product-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
            flex-shrink: 0;
        }

        .table thead th {
            background: var(--maroon);
            color: white;
            padding: 13px;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 13px;
            vertical-align: middle;
        }

        .detail-box {
            padding: 15px;
            margin: 10px 0;
            border-radius: 9px;
        }

        .customize-box {
            background: #faf5ff;
            border: 1px solid #cbb7e9;
        }

        .rental-box {
            background: #fffaf0;
            border: 1px solid #ead9a6;
        }

        .sale-box {
            background: #f1fff7;
            border: 1px solid #b7dfc5;
        }

        .buy-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
        }

        .negotiated-box {
            background: #eef6ff;
            border: 1px solid #b6d4fe;
        }

        .detail-title {
            color: var(--maroon);
            font-weight: 700;
            font-size: 15px;
            margin-bottom: 10px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 7px 0;
            border-bottom: 1px solid rgba(0,0,0,.08);
            font-size: 13px;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: #666;
            font-weight: 600;
        }

        .detail-value {
            color: var(--maroon);
            text-align: right;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .measurement-box {
            background: white;
            border: 1px solid #eadfbd;
            border-radius: 8px;
            padding: 12px;
            margin-top: 10px;
        }

        .measurement-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 6px 0;
            border-bottom: 1px solid #eee;
            font-size: 13px;
        }

        .measurement-row:last-child {
            border-bottom: none;
        }

        .measurement-name {
            font-weight: 600;
            color: #555;
        }

        .measurement-value {
            font-weight: 600;
            color: var(--maroon);
            text-align: right;
        }

        .total-box {
            background: #fafafa;
            border-radius: 10px;
            padding: 18px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 9px 0;
        }

        .grand-total {
            border-top: 2px solid var(--maroon);
            margin-top: 8px;
            padding-top: 14px;
            font-size: 20px;
            font-weight: 700;
            color: var(--maroon);
        }

        .payment-box {
            background: #fffdf5;
            border-left: 4px solid var(--gold);
            padding: 15px;
            border-radius: 8px;
        }

        .status-update-box {
            background: #fffaf0;
            border: 1px solid #ead9a6;
            border-radius: 10px;
            padding: 20px;
        }

        .status-select {
            height: 45px;
            border-radius: 8px;
        }

        .update-status-btn,
        .back-btn {
            background: var(--maroon);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
            text-decoration: none;
        }

        .update-status-btn:hover,
        .back-btn:hover {
            background: var(--maroon-dark);
            color: white;
        }

        .print-btn {
            background: var(--gold);
            color: #222;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
        }

        .flow-container {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 18px;
        }

        .flow-item {
            background: #eee;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .empty-box {
            text-align: center;
            padding: 25px;
            color: #777;
        }

        .payment-summary-box {
            background: #fffaf0;
            border: 1px solid #ead9a6;
            border-radius: 10px;
            padding: 18px;
        }

        .delivery-summary-box {
            background: #f8fbff;
            border: 1px solid #cfe2ff;
            border-radius: 10px;
            padding: 18px;
        }

        .payment-summary-title {
            color: var(--maroon);
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ead9a6;
        }

        .delivery-summary-title {
            color: #0d6efd;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid #cfe2ff;
        }

        .payment-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 9px 0;
            border-bottom: 1px solid rgba(0,0,0,.08);
        }

        .payment-summary-row:last-child {
            border-bottom: none;
        }

        .payment-summary-row span:first-child {
            color: #666;
            font-weight: 600;
        }

        .payment-summary-row strong {
            color: var(--maroon);
            text-align: right;
            overflow-wrap: anywhere;
        }

        .delivery-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 9px 0;
            border-bottom: 1px solid rgba(0,0,0,.08);
        }

        .delivery-summary-row:last-child {
            border-bottom: none;
        }

        .delivery-summary-row span:first-child {
            color: #666;
            font-weight: 600;
        }

        .delivery-summary-row strong {
            color: #0d6efd;
            text-align: right;
            overflow-wrap: anywhere;
        }

        .payment-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .payment-status.paid {
            background: #d1e7dd;
            color: #0f5132;
        }

        .payment-status.pending {
            background: #fff3cd;
            color: #856404;
        }

        .cod-collection-box {
            background: #fafafa;
            border: 1px solid #e1e1e1;
            border-radius: 10px;
            padding: 18px;
            margin-top: 16px;
        }

        .cod-collection-title {
            color: var(--maroon);
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 12px;
            padding-bottom: 9px;
            border-bottom: 1px solid #e5e5e5;
        }

        .cod-information {
            background: #f8fbff;
            border: 1px solid #cfe2ff;
            border-left: 4px solid #0d6efd;
            border-radius: 8px;
            padding: 14px 16px;
            margin-top: 16px;
        }

        .cod-information-title {
            color: #0d6efd;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .cod-information p {
            color: #666;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 0;
        }

        @@media (max-width: 768px) {
            .info-row,
            .detail-row,
            .measurement-row,
            .payment-summary-row,
            .delivery-summary-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }

            .info-value,
            .detail-value,
            .measurement-value,
            .payment-summary-row strong,
            .delivery-summary-row strong {
                text-align: left;
            }

            .page-header {
                padding: 18px;
            }
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                background: white;
            }

            .card {
                box-shadow: none;
                border: 1px solid #ddd;
                break-inside: avoid;
            }

            .detail-box,
            .measurement-box,
            .payment-summary-box,
            .delivery-summary-box,
            .cod-collection-box {
                break-inside: avoid;
            }
        }
    </style>
</head>

<body>

<div class="page-header">
    <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2><i class="bi bi-receipt"></i> Order Details</h2>
            <p>Order #@Model.OrderId</p>
        </div>

        <div class="no-print">
            <button type="button" onclick="window.print()" class="print-btn me-2">
                <i class="bi bi-printer"></i> Print
            </button>

            <a asp-controller="Shopkeeper"
               asp-action="Orders"
               class="back-btn">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
        </div>
    </div>
</div>

<div class="container-fluid">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success no-print">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger no-print">
            @TempData["Error"]
        </div>
    }

    <div class="card">
        <div class="card-header">
            <i class="bi bi-info-circle"></i> Order Summary
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="info-row">
                        <span class="info-label">Order ID</span>
                        <span class="info-value">#@Model.OrderId</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-row">
                        <span class="info-label">Order Date</span>
                        <span class="info-value">
                            @Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt")
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-row">
                        <span class="info-label">Payment Method</span>
                        <span class="info-value">
                            @(Model.PaymentMethod ?? "Not specified")
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="info-row">
                        <span class="info-label">Order Status</span>
                        <span class="info-value">
                            <span class="status-badge @statusClass">
                                @orderStatus
                            </span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card no-print">
        <div class="card-header">
            <i class="bi bi-arrow-repeat"></i> Update Order Status
        </div>

        <div class="card-body">
            @if (canUpdateStatus && nextStatuses.Any())
            {
                <div class="status-update-box">
                    <h5 class="text-maroon">Change Order Status</h5>

                    <p>
                        Current status: <strong>@orderStatus</strong>
                    </p>

                    <form asp-controller="Shopkeeper"
                          asp-action="UpdateOrderStatus"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.OrderId" />

                        <div class="row align-items-end">
                            <div class="col-md-8">
                                <label for="status" class="form-label fw-semibold">
                                    Select New Status
                                </label>

                                <select name="status"
                                        id="status"
                                        class="form-select status-select"
                                        required>
                                    <option value="">-- Select Status --</option>

                                    @foreach (var nextStatus in nextStatuses)
                                    {
                                        <option value="@nextStatus">
                                            @nextStatus
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 mt-3 mt-md-0">
                                <button type="submit"
                                        class="update-status-btn w-100">
                                    <i class="bi bi-check-circle"></i>
                                    Update Status
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="flow-container">
                        <span class="flow-item">Pending</span>
                        →
                        <span class="flow-item">Confirmed</span>
                        →
                        <span class="flow-item">Processing</span>
                        →
                        <span class="flow-item">Ready</span>
                        →
                        <span class="flow-item">Admin / Delivery</span>
                    </div>
                </div>
            }
            else if (orderStatus.Equals("Ready", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-info mb-0">
                    Order is ready for the admin to assign a delivery person.
                </div>
            }
            else if (orderStatus.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-danger mb-0">
                    This order has been cancelled and cannot be updated.
                </div>
            }
            else if (orderStatus.Equals("Delivered", StringComparison.OrdinalIgnoreCase)
                     || orderStatus.Equals("Completed", StringComparison.OrdinalIgnoreCase))
            {
                <div class="alert alert-success mb-0">
                    This order has been delivered or completed.
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    Status updates are not available at this stage.
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-person"></i> Customer Information
                </div>

                <div class="card-body">
                    @if (Model.Customer != null)
                    {
                        <div class="info-row">
                            <span class="info-label">Name</span>
                            <span class="info-value">@Model.Customer.Name</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Email</span>
                            <span class="info-value">@Model.Customer.Email</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Phone</span>
                            <span class="info-value">@Model.Customer.Phone</span>
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">Customer information not available.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-shop"></i> Shop Information
                </div>

                <div class="card-body">
                    @if (Model.Shop != null)
                    {
                        <div class="info-row">
                            <span class="info-label">Shop Name</span>
                            <span class="info-value">@Model.Shop.ShopName</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Phone</span>
                            <span class="info-value">@Model.Shop.ShopPhone</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Email</span>
                            <span class="info-value">@Model.Shop.Email</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Address</span>
                            <span class="info-value">@Model.Shop.ShopAddress</span>
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">Shop information not available.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-truck"></i> Delivery Information
                </div>

                <div class="card-body">
                    @if (Model.Delivery != null)
                    {
                        <div class="info-row">
                            <span class="info-label">Delivery Person</span>
                            <span class="info-value">@Model.Delivery.Name</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Email</span>
                            <span class="info-value">@Model.Delivery.Email</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Phone</span>
                            <span class="info-value">@Model.Delivery.Phone</span>
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">No delivery person assigned yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-geo-alt"></i> Delivery Address
        </div>

        <div class="card-body">
            <div class="info-row">
                <span class="info-label">City</span>
                <span class="info-value">@Model.DeliveryCity</span>
            </div>

            <div class="info-row">
                <span class="info-label">Address</span>
                <span class="info-value">@Model.DeliveryAddress</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="mt-3">
                    <strong>Customer Notes</strong>
                    <div class="alert alert-light mt-2 mb-0">
                        @Model.Notes
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-bag"></i> Ordered Products and Complete Product Details
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Order Type</th>
                            <th>Unit Price</th>
                            <th>Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            int number = 1;

                            foreach (var detail in Model.OrderDetails)
                            {
                                string purchaseType = string.IsNullOrWhiteSpace(detail.PurchaseType)
                                    ? "Buy"
                                    : detail.PurchaseType.Trim();

                                bool isRental = HasRental(detail);
                                bool isCustomized = HasCustomization(detail);
                                bool isSale = HasSale(detail);
                                bool isNegotiated = HasNegotiation(detail);
                                bool isBuy = IsBuy(purchaseType);

                                string displayType = GetPurchaseType(purchaseType);

                                <tr>
                                    <td>@number</td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (detail.Product != null &&
                                                 !string.IsNullOrWhiteSpace(detail.Product.Image))
                                            {
                                                <img src="@detail.Product.Image"
                                                     class="product-img me-3"
                                                     alt="Product" />
                                            }
                                            else
                                            {
                                                <div class="product-img me-3 d-flex align-items-center justify-content-center">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }

                                            <div>
                                                <strong>
                                                    @(detail.Product?.ProductName ?? "Product unavailable")
                                                </strong>

                                                @if (detail.Product != null)
                                                {
                                                    <div class="small text-muted">
                                                        Product ID: @detail.ProductId
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(detail.Product.Category))
                                                    {
                                                        <div class="small text-muted">
                                                            Category: @detail.Product.Category
                                                        </div>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(detail.Product.Size))
                                                    {
                                                        <div class="small text-muted">
                                                            Product Size: @detail.Product.Size
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="type-badge @GetTypeClass(purchaseType)">
                                            <i class="bi @GetTypeIcon(purchaseType)"></i>
                                            @displayType
                                        </span>
                                    </td>

                                    <td>@FormatMoney(detail.UnitPrice)</td>
                                    <td>@detail.Quantity</td>

                                    <td class="text-end fw-bold">
                                        @FormatMoney(detail.UnitPrice * detail.Quantity)
                                    </td>
                                </tr>

                                <tr>
                                    <td></td>
                                    <td colspan="5">

                                        @if (isCustomized)
                                        {
                                            <div class="detail-box customize-box">
                                                <div class="detail-title">
                                                    <i class="bi bi-rulers"></i>
                                                    Customization Information
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Order Type</span>
                                                    <span class="detail-value">@displayType</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Customization</span>
                                                    <span class="detail-value">Customer-specific measurements</span>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(detail.CustomMeasurements))
                                                {
                                                    <div class="measurement-box">
                                                        <div class="detail-title">
                                                            <i class="bi bi-person-check"></i>
                                                            Customer Measurements
                                                        </div>

                                                        @foreach (var measurement in detail.CustomMeasurements.Split(
                                                            " | ",
                                                            StringSplitOptions.RemoveEmptyEntries))
                                                        {
                                                            var parts = measurement.Split(
                                                                ':',
                                                                2,
                                                                StringSplitOptions.RemoveEmptyEntries);

                                                            if (parts.Length == 2)
                                                            {
                                                                <div class="measurement-row">
                                                                    <span class="measurement-name">
                                                                        @parts[0].Trim()
                                                                    </span>

                                                                    <span class="measurement-value">
                                                                        @parts[1].Trim()
                                                                    </span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="measurement-row">
                                                                    <span class="measurement-name">
                                                                        @measurement.Trim()
                                                                    </span>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning mt-2 mb-0">
                                                        Customization is indicated, but measurements were not saved
                                                        with this order.
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (isRental)
                                        {
                                            <div class="detail-box rental-box">
                                                <div class="detail-title">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                    Rental Information
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Rental Price Per Unit</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Quantity</span>
                                                    <span class="detail-value">@detail.Quantity</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Rental Subtotal</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice * detail.Quantity)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Security Per Unit</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.RentalSecurity)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Total Rental Security</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.RentalSecurity * detail.Quantity)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Rental Duration</span>
                                                    <span class="detail-value">
                                                        @(string.IsNullOrWhiteSpace(detail.RentalDuration)
                                                            ? "Not specified"
                                                            : detail.RentalDuration)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Rental Conditions</span>
                                                    <span class="detail-value">
                                                        @(string.IsNullOrWhiteSpace(detail.RentalConditions)
                                                            ? "Not specified"
                                                            : detail.RentalConditions)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Return Status</span>
                                                    <span class="detail-value">
                                                        @(string.IsNullOrWhiteSpace(detail.RentalReturnStatus)
                                                            ? "Awaiting Return"
                                                            : detail.RentalReturnStatus)
                                                    </span>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(detail.ReturnMethod))
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Return Method</span>
                                                        <span class="detail-value">@detail.ReturnMethod</span>
                                                    </div>
                                                }

                                                @if (detail.ReturnRequestedDate.HasValue)
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Return Requested Date</span>
                                                        <span class="detail-value">
                                                            @detail.ReturnRequestedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                                        </span>
                                                    </div>
                                                }

                                                @if (detail.DressReturnedDate.HasValue)
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Dress Returned Date</span>
                                                        <span class="detail-value">
                                                            @detail.DressReturnedDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                                        </span>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(detail.InspectionResult))
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Inspection Result</span>
                                                        <span class="detail-value">@detail.InspectionResult</span>
                                                    </div>
                                                }

                                                <div class="detail-row">
                                                    <span class="detail-label">Security Refund Status</span>
                                                    <span class="detail-value">
                                                        @if (detail.SecurityRefunded)
                                                        {
                                                            <span class="text-success">Refund Completed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-warning">Refund Pending</span>
                                                        }
                                                    </span>
                                                </div>

                                                @if (detail.SecurityRefunded)
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Refund Amount</span>
                                                        <span class="detail-value">
                                                            @FormatMoney(detail.RefundAmount)
                                                        </span>
                                                    </div>

                                                    <div class="detail-row">
                                                        <span class="detail-label">Refund Method</span>
                                                        <span class="detail-value">
                                                            @(detail.SecurityRefundMethod ?? "Not specified")
                                                        </span>
                                                    </div>

                                                    <div class="detail-row">
                                                        <span class="detail-label">Refund Account</span>
                                                        <span class="detail-value">
                                                            @(detail.SecurityRefundAccount ?? "Not specified")
                                                        </span>
                                                    </div>

                                                    @if (detail.SecurityRefundDate.HasValue)
                                                    {
                                                        <div class="detail-row">
                                                            <span class="detail-label">Refund Date</span>
                                                            <span class="detail-value">
                                                                @detail.SecurityRefundDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                                            </span>
                                                        </div>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(detail.SecurityRefundTransactionId))
                                                    {
                                                        <div class="detail-row">
                                                            <span class="detail-label">Refund Transaction ID</span>
                                                            <span class="detail-value">
                                                                @detail.SecurityRefundTransactionId
                                                            </span>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Customer Refund Preference</span>
                                                        <span class="detail-value">
                                                            @(detail.RefundPreferenceMethod ?? "Not specified")
                                                        </span>
                                                    </div>

                                                    <div class="detail-row">
                                                        <span class="detail-label">Refund Account</span>
                                                        <span class="detail-value">
                                                            @(detail.RefundPreferenceAccount ?? "Not specified")
                                                        </span>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(detail.SecurityRefundNotes))
                                                {
                                                    <div class="detail-row">
                                                        <span class="detail-label">Refund / Inspection Notes</span>
                                                        <span class="detail-value">
                                                            @detail.SecurityRefundNotes
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (isSale)
                                        {
                                            <div class="detail-box sale-box">
                                                <div class="detail-title text-success">
                                                    <i class="bi bi-tag-fill"></i>
                                                    Sale Information
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Purchase Type</span>
                                                    <span class="detail-value">@displayType</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Sale Unit Price at Order</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Sale Quantity</span>
                                                    <span class="detail-value">@detail.Quantity</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Sale Subtotal</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.SubTotal)
                                                    </span>
                                                </div>

                                                <div class="small text-muted mt-2">
                                                    The unit price and subtotal above are the values saved
                                                    when the order was placed.
                                                </div>
                                            </div>
                                        }

                                        @if (isNegotiated)
                                        {
                                            <div class="detail-box negotiated-box">
                                                <div class="detail-title">
                                                    <i class="bi bi-handshake"></i>
                                                    Negotiated Purchase Information
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Agreed Unit Price</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Quantity</span>
                                                    <span class="detail-value">@detail.Quantity</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Agreed Subtotal</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice * detail.Quantity)
                                                    </span>
                                                </div>

                                                <div class="small text-muted mt-2">
                                                    This is the agreed product price saved for this order.
                                                    The platform service fee is calculated separately.
                                                </div>
                                            </div>
                                        }

                                        @if (!isRental && !isSale && !isNegotiated)
                                        {
                                            <div class="detail-box buy-box">
                                                <div class="detail-title">
                                                    <i class="bi bi-bag-fill"></i>
                                                    Regular Purchase Information
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Purchase Type</span>
                                                    <span class="detail-value">@displayType</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Unit Price</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice)
                                                    </span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Quantity</span>
                                                    <span class="detail-value">@detail.Quantity</span>
                                                </div>

                                                <div class="detail-row">
                                                    <span class="detail-label">Subtotal</span>
                                                    <span class="detail-value">
                                                        @FormatMoney(detail.UnitPrice * detail.Quantity)
                                                    </span>
                                                </div>
                                            </div>
                                        }

                                    </td>
                                </tr>

                                number++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    No products found for this order.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-credit-card"></i> Payment Information
                </div>

                <div class="card-body">
                    <div class="payment-box">
                        <div class="info-row">
                            <span class="info-label">Payment Method</span>
                            <span class="info-value">
                                @(Model.PaymentMethod ?? "Not specified")
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Payment Status</span>
                            <span class="info-value">
                                @(Model.PaymentStatus ?? "Pending")
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Payment Received</span>
                            <span class="info-value">
                                @(Model.PaymentReceived ? "Yes" : "No")
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                        {
                            <div class="info-row">
                                <span class="info-label">Transaction ID</span>
                                <span class="info-value">@Model.TransactionId</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.TransactionImage))
                        {
                            <div class="mt-3">
                                <strong>Payment Screenshot</strong>

                                <div class="mt-2">
                                    <a href="@Model.TransactionImage"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        View Payment Screenshot
                                    </a>
                                </div>
                            </div>
                        }

                        @if (Model.PaymentDate.HasValue)
                        {
                            <div class="info-row">
                                <span class="info-label">Payment Date</span>
                                <span class="info-value">
                                    @Model.PaymentDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-calculator"></i> Order Amount
                </div>

                <div class="card-body">
                    <div class="total-box">
                        <div class="total-row">
                            <span>Product Total</span>
                            <strong>@FormatMoney(Model.ProductTotal)</strong>
                        </div>

                        <div class="total-row">
                            <span>Delivery Charges</span>
                            <strong>@FormatMoney(Model.DeliveryCharges)</strong>
                        </div>

                        <div class="total-row">
                            <span>Service Fee</span>
                            <strong>@FormatMoney(Model.ServiceFee)</strong>
                        </div>

                        @if (Model.RefundableSecurity > 0)
                        {
                            <div class="total-row">
                                <span>Refundable Rental Security</span>
                                <strong>@FormatMoney(Model.RefundableSecurity)</strong>
                            </div>
                        }

                        <div class="total-row grand-total">
                            <span>Total Amount</span>
                            <span>@FormatMoney(Model.TotalAmount)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-wallet2"></i> Shopkeeper Payment
        </div>

        <div class="card-body">
            <div class="payment-summary-box">

                <div class="payment-summary-title">
                    <i class="bi bi-person-badge"></i>
                    Shopkeeper Settlement
                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="payment-summary-row">
                            <span>Shopkeeper Amount</span>
                            <strong>
                                @FormatMoney(Model.ShopkeeperAmount)
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="payment-summary-row">
                            <span>Amount Paid</span>
                            <strong>
                                @FormatMoney(Model.ShopkeeperPaidAmount)
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="payment-summary-row">
                            <span>Payment Status</span>
                            <strong>
                                @if (string.Equals(
                                    Model.ShopkeeperPaymentStatus,
                                    "Paid",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="payment-status paid">
                                        <i class="bi bi-check-circle"></i>
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="payment-status pending">
                                        <i class="bi bi-clock"></i>
                                        @(Model.ShopkeeperPaymentStatus ?? "Pending")
                                    </span>
                                }
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="payment-summary-row">
                            <span>Payment Method</span>
                            <strong>
                                @(Model.ShopkeeperPaymentMethod ?? "Not specified")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="payment-summary-row">
                            <span>Payment Account</span>
                            <strong>
                                @(Model.ShopkeeperPaymentAccount ?? "Not specified")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="payment-summary-row">
                            <span>Payment Date</span>
                            <strong>
                                @(Model.ShopkeeperPaymentDate.HasValue
                                    ? Model.ShopkeeperPaymentDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                    : "Not paid yet")
                            </strong>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-cash-stack"></i> Delivery and COD Collection
        </div>

        <div class="card-body">

            <div class="delivery-summary-box">

                <div class="delivery-summary-title">
                    <i class="bi bi-truck"></i>
                    Delivery Person Payment
                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="delivery-summary-row">
                            <span>Delivery Charges</span>
                            <strong>
                                @FormatMoney(Model.DeliveryCharges)
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="delivery-summary-row">
                            <span>Amount Paid</span>
                            <strong>
                                @FormatMoney(Model.DeliveryPaidAmount)
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="delivery-summary-row">
                            <span>Payment Status</span>
                            <strong>
                                @if (string.Equals(
                                    Model.DeliveryPaymentStatus,
                                    "Paid",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="payment-status paid">
                                        <i class="bi bi-check-circle"></i>
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="payment-status pending">
                                        <i class="bi bi-clock"></i>
                                        @(Model.DeliveryPaymentStatus ?? "Pending")
                                    </span>
                                }
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="delivery-summary-row">
                            <span>Payment Method</span>
                            <strong>
                                @(Model.DeliveryPaymentMethod ?? "Not specified")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="delivery-summary-row">
                            <span>Payment Account</span>
                            <strong>
                                @(Model.DeliveryPaymentAccount ?? "Not specified")
                            </strong>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="delivery-summary-row">
                            <span>Payment Date</span>
                            <strong>
                                @(Model.DeliveryPaymentDate.HasValue
                                    ? Model.DeliveryPaymentDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                    : "Not paid yet")
                            </strong>
                        </div>
                    </div>

                </div>

            </div>

            <div class="cod-collection-box">

                <div class="cod-collection-title">
                    <i class="bi bi-cash-coin"></i>
                    COD Collection
                </div>

                <div class="row">

                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">Collected Amount</span>
                            <span class="info-value">
                                @FormatMoney(Model.DeliveryCollectedAmount)
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">Collection Date</span>
                            <span class="info-value">
                                @(Model.DeliveryCollectionDate.HasValue
                                    ? Model.DeliveryCollectionDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                    : "Not collected")
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-row">
                            <span class="info-label">Cash Handover to Admin</span>
                            <span class="info-value">
                                @(Model.DeliveryCashHandedToAdmin ? "Confirmed" : "Not Confirmed")
                            </span>
                        </div>
                    </div>

                    @if (Model.DeliveryCashHandoverDate.HasValue)
                    {
                        <div class="col-md-4">
                            <div class="info-row">
                                <span class="info-label">Handover Date</span>
                                <span class="info-value">
                                    @Model.DeliveryCashHandoverDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                </span>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.DeliveryCashHandoverNotes))
                    {
                        <div class="col-md-8">
                            <div class="info-row">
                                <span class="info-label">Handover Notes</span>
                                <span class="info-value">
                                    @Model.DeliveryCashHandoverNotes
                                </span>
                            </div>
                        </div>
                    }

                </div>

                <div class="cod-information">
                    <div class="cod-information-title">
                        <i class="bi bi-info-circle"></i>
                        Payment Flow
                    </div>

                    <p>
                        COD Collection shows the amount collected from the customer
                        by the delivery person. Delivery Payment shows the amount
                        paid by Admin to the delivery person. These are separate
                        payment records.
                    </p>
                </div>

            </div>

        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-arrow-repeat"></i> Current Order Status
        </div>

        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5>Order #@Model.OrderId</h5>
                    <p class="text-muted mb-0">
                        Current processing status of this order.
                    </p>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <span class="status-badge @statusClass">
                        @orderStatus
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mb-4 no-print">
        <a asp-controller="Shopkeeper"
           asp-action="Orders"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>

        <button type="button"
                onclick="window.print()"
                class="btn btn-warning">
            <i class="bi bi-printer"></i> Print Order
        </button>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>