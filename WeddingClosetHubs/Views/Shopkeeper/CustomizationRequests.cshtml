@model IEnumerable<WeddingClosetHubs.Models.CustomizationRequest>

@{
    ViewData["Title"] = "Customization Requests";

    var shopkeeperName =
        ViewBag.ShopkeeperName as string ?? "Shopkeeper";

    var shopName =
        ViewBag.ShopName as string ?? "My Shop";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#800020;">
                Customization Requests
            </h2>

            <p class="text-muted mb-0">
                Review customer customization requests and send customized prices.
            </p>
        </div>

        <a asp-controller="Shopkeeper"
           asp-action="Index"
           class="btn"
           style="background:#800020;color:white;">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header text-white"
             style="background:#800020;">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-scissors me-2"></i>
                    @shopName
                </h5>

                <span class="badge"
                      style="background:#d4af37;color:#000;">
                    @Model.Count() Requests
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-scissors"
                       style="font-size:60px;color:#d4af37;"></i>

                    <h4 class="mt-3" style="color:#800020;">
                        No Customization Requests
                    </h4>

                    <p class="text-muted mb-0">
                        Customers have not submitted any customization requests yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead style="background:#f8f1f3;">
                            <tr>
                                <th class="px-3">Product</th>
                                <th>Customer</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th>Price</th>
                                <th>Date</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var request in Model)
                            {
                                string badgeClass =
                                    request.Status switch
                                    {
                                        "Pending" => "bg-warning text-dark",
                                        "PriceSent" => "bg-info text-dark",
                                        "ChangeRequested" => "bg-warning text-dark",
                                        "RevisedPriceSent" => "bg-primary",
                                        "Accepted" => "bg-success",
                                        "Rejected" => "bg-danger",
                                        _ => "bg-secondary"
                                    };

                                <tr>

                                    <td class="px-3">
                                        <strong>
                                            @(request.Product?.ProductName
                                                ?? "Product")
                                        </strong>
                                    </td>

                                    <td>
                                        @(request.Customer?.Name
                                            ?? "Customer")
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(
                                            request.SelectedSize))
                                        {
                                            <span class="text-muted">
                                                Not selected
                                            </span>
                                        }
                                        else
                                        {
                                            @request.SelectedSize
                                        }
                                    </td>

                                    <td>
                                        <span class="badge @badgeClass">
                                            @request.Status
                                        </span>
                                    </td>

                                    <td>
                                        @if (request.ShopkeeperPrice.HasValue)
                                        {
                                            <strong>
                                                Rs.
                                                @request.ShopkeeperPrice.Value.ToString("N2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not quoted
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @request.CreatedDate.ToString(
                                            "dd MMM yyyy")
                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="Shopkeeper"
                                           asp-action="CustomizationRequestDetails"
                                           asp-route-id="@request.CustomizationRequestId"
                                           class="btn btn-sm"
                                           style="background:#800020;color:white;">
                                            <i class="bi bi-eye me-1"></i>
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

<style>
    .table th {
        white-space: nowrap;
        color: #800020;
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }

    .btn:hover {
        opacity: .9;
    }
</style>
