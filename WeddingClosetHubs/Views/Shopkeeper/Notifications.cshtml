@model IEnumerable<WeddingClosetHubs.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = null;


    var notifications = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Notification>();

    int unreadCount = notifications.Count(x => !x.IsRead);

}

<!DOCTYPE html>

<html lang="en">

<head>


    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Notifications - Wedding Closet Hub
    </title>



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />




    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        body {
            background: #f7f7f7;
            font-family: Arial, sans-serif;
            margin: 0;
        }



        .page-header {
            background: #800020;
            color: white;
            padding: 25px 30px;
            margin-bottom: 25px;
        }

            .page-header h2 {
                margin: 0;
                font-weight: 600;
            }

            .page-header p {
                margin: 5px 0 0;
                opacity: .85;
            }


        .summary-box {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            padding: 18px 22px;
            margin-bottom: 20px;
        }

        .summary-number {
            color: #800020;
            font-size: 22px;
            font-weight: bold;
        }



        .notification-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            margin-bottom: 15px;
            padding: 18px;
            border-left: 4px solid #800020;
            transition: .2s;
        }

            .notification-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 16px rgba(0,0,0,.12);
            }



        .notification-unread {
            background: #fffafc;
            border-left-color: #d4af37;
        }



        .notification-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 50%;
            background: #f4e8ec;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }



        .notification-title {
            font-size: 17px;
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
        }

        .notification-message {
            color: #666;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .notification-date {
            color: #999;
            font-size: 12px;
        }


        .type-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 600;
        }

        .type-order {
            background: #cff4fc;
            color: #055160;
        }

        .type-payment {
            background: #d1e7dd;
            color: #0f5132;
        }

        .type-delivery {
            background: #e2e3ff;
            color: #373a8a;
        }

        .type-system {
            background: #f8d7da;
            color: #842029;
        }

        .type-general {
            background: #e9ecef;
            color: #495057;
        }





        .order-btn {
            background: #800020;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 12px;
            text-decoration: none;
            font-size: 12px;
        }

            .order-btn:hover {
                background: #650019;
                color: white;
            }

        .read-btn {
            background: transparent;
            border: 1px solid #ddd;
            color: #666;
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 12px;
        }

            .read-btn:hover {
                border-color: #800020;
                color: #800020;
            }



        .empty-state {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            text-align: center;
            padding: 70px 20px;
            color: #777;
        }

            .empty-state i {
                font-size: 60px;
                color: #bbb;
            }


        @@media (max-width: 768px) {

            .page-header {
                padding: 20px;
            }

                .page-header h2 {
                    font-size: 22px;
                }

            .notification-card {
                padding: 15px;
            }
        }

    </style>


</head>

<body>


    <div class="page-header">


        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2>

                        <i class="bi bi-bell"></i>

                        Notifications

                    </h2>

                    <p>

                        Stay updated about your orders, deliveries and payments.

                    </p>

                </div>


                <div>

                    <a asp-controller="Shopkeeper"
                       asp-action="Dashboard"
                       class="btn btn-light">

                        <i class="bi bi-arrow-left"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>


    </div>

    <div class="container-fluid">



        <div class="summary-box">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <span class="text-muted">

                        Total Notifications

                    </span>

                    <span class="summary-number ms-2">

                        @notifications.Count

                    </span>

                </div>


                <div>

                    <span class="text-muted">

                        Unread

                    </span>

                    <span class="summary-number ms-2">

                        @unreadCount

                    </span>

                </div>

            </div>

        </div>




        @if (notifications.Any())
        {

            foreach (var notification in notifications
            .OrderByDescending(x => x.CreatedDate))
            {

                string iconClass = "bi-info-circle";

                string typeClass = "type-general";


                if (!string.IsNullOrEmpty(notification.Type))
                {
                    switch (notification.Type.ToLower())
                    {
                        case "order":

                            iconClass = "bi-bag-check";
                            typeClass = "type-order";

                            break;


                        case "payment":

                            iconClass = "bi-wallet2";
                            typeClass = "type-payment";

                            break;


                        case "delivery":

                            iconClass = "bi-truck";
                            typeClass = "type-delivery";

                            break;


                        case "system":

                            iconClass = "bi-gear";
                            typeClass = "type-system";

                            break;


                        default:

                            iconClass = "bi-info-circle";
                            typeClass = "type-general";

                            break;
                    }
                }



        <div class="notification-card
                    @(notification.IsRead
                                     ? ""
                                     : "notification-unread")">


            <div class="d-flex align-items-start">



                        <div class="notification-icon me-3">

                            <i class="bi @iconClass"></i>

                        </div>





                        <div class="flex-grow-1">


                            <div class="d-flex justify-content-between
                                        align-items-start flex-wrap">


                                <div>

                                    <div class="notification-title">

                                        @notification.Title

                                    </div>


                                    <span class="type-badge @typeClass">

                                        @notification.Type

                                    </span>

                                </div>


                        @if (!notification.IsRead)
                                {

                                    <span class="badge bg-warning text-dark">

                                        New

                                    </span>

                                }

                    </div>



                    <div class="notification-message mt-2">

                        @notification.Message

                    </div>



                    <div class="notification-date">

                        <i class="bi bi-clock"></i>

                        @(notification.CreatedDate
                                                .ToString("dd MMM yyyy hh:mm tt"))

                    </div>





                            <div class="mt-3 d-flex gap-2 flex-wrap">


                        @if (notification.OrderId.HasValue)
                                {

                                    <a asp-controller="Shopkeeper"
                                       asp-action="OrderDetails"
                                       asp-route-id="@notification.OrderId.Value"
                                       class="order-btn">

                                        <i class="bi bi-eye"></i>

                                        View Order

                                    </a>

                                }


                                @if (!notification.IsRead)
                                {

                                    <form asp-controller="Shopkeeper"
                                          asp-action="MarkNotificationRead"
                                          asp-route-id="@notification.NotificationId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="read-btn">

                                            <i class="bi bi-check2"></i>

                                            Mark as Read

                                        </button>

                                    </form>

                                }

                            </div>

                        </div>

                    </div>

                </div>

            }

        }
        else
        {



            <div class="empty-state">

                <i class="bi bi-bell-slash"></i>

                <h5 class="mt-3">

                    No Notifications

                </h5>

                <p class="mb-0">

                    You don't have any notifications right now.

                </p>

            </div>

        }





        <div class="card border-0 shadow-sm mt-4 mb-4">

            <div class="card-body">

                <div class="d-flex align-items-start">

                    <i class="bi bi-info-circle text-primary fs-3 me-3"></i>

                    <div>

                        <h6>

                            Notification Information

                        </h6>

                        <p class="text-muted mb-0">

                            You will receive notifications when a customer
                            places an order, when an order is ready for
                            delivery, when a delivery boy is assigned, and
                            when the administrator processes your payment.

                        </p>

                    </div>

                </div>

            </div>

        </div>


    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>
