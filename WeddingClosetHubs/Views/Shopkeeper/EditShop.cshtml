@model WeddingClosetHubs.Models.Shop

@{
    ViewData["Title"] = "Edit Shop";
    Layout = null;

    var collections =
        (Model.ShopCollections ?? "")
        .Split(
            ',',
            StringSplitOptions.RemoveEmptyEntries |
            StringSplitOptions.TrimEntries);
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Edit Shop - Wedding Closet Hub</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
        }

        .page-wrapper {
            padding: 30px;
        }

        .page-header {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 0;
        }

        .custom-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            margin-bottom: 25px;
        }

        .card-header-custom {
            background: #800020;
            color: white;
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 600;
        }

        .card-body-custom {
            padding: 25px;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control,
        .form-select {
            padding: 11px 14px;
            border-radius: 7px;
        }

        .current-image {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
            margin-bottom: 10px;
        }

        .photo-preview {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .optional-label {
            color: #777;
            font-size: 13px;
            font-weight: normal;
        }

        .social-input-icon {
            min-width: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #800020;
            color: white;
            border-radius: 7px 0 0 7px;
        }

        .social-input-group .form-control {
            border-radius: 0 7px 7px 0;
        }

        .optional-note {
            background: #fff8e6;
            border-left: 4px solid #d4af37;
            padding: 12px 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            color: #555;
        }

        .collection-box {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 8px;
            padding: 12px 15px;
            height: 100%;
        }

        .service-box {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 8px;
            padding: 15px;
            height: 100%;
        }

        .service-box .form-check-label {
            font-weight: 600;
        }

        .btn {
            border-radius: 7px;
            padding: 10px 18px;
        }

        @@media (max-width: 768px) {

            .page-wrapper {
                padding: 15px;
            }

            .page-title {
                font-size: 23px;
            }
        }

    </style>

</head>

<body>

    <div class="page-wrapper">

        <div class="page-header">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="page-title">

                        <i class="bi bi-pencil-square"></i>

                        Edit Shop

                    </h2>

                    <p class="page-subtitle">

                        Update your shop information, categories and services.

                    </p>

                </div>

                <div class="col-md-4 text-md-end">

                    <a asp-controller="Shopkeeper"
                       asp-action="MyShop"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Back to My Shop

                    </a>

                </div>

            </div>

        </div>


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <form asp-controller="Shopkeeper"
              asp-action="EditShop"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="ShopId" />

            <input type="hidden"
                   asp-for="ShopkeeperId" />


            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-shop"></i>

                    Shop Information

                </div>

                <div class="card-body-custom">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="ShopName"
                                   class="form-label">

                                Shop Name

                            </label>

                            <input asp-for="ShopName"
                                   class="form-control"
                                   placeholder="Enter shop name" />

                            <span asp-validation-for="ShopName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="ShopCategory"
                                   class="form-label">

                                Main Shop Category

                            </label>

                            <select asp-for="ShopCategory"
                                    class="form-select">

                                <option value="">
                                    Select Main Category
                                </option>

                                <option value="Bridal Wear">
                                    Bridal Wear
                                </option>

                                <option value="Groom Wear">
                                    Groom Wear
                                </option>

                                <option value="Formal Wear">
                                    Formal Wear
                                </option>

                                <option value="Wedding Guest Wear">
                                    Wedding Guest Wear
                                </option>

                                <option value="Footwear">
                                    Footwear
                                </option>

                                <option value="Jewellery">
                                    Jewellery
                                </option>

                                <option value="Accessories">
                                    Accessories
                                </option>

                                <option value="Bridal Accessories">
                                   Bridal Accessories
                                </option>

                                <option value="Bridal Jewellery">
                                   Bridal Jewellery
                                </option>

                            </select>

                            <span asp-validation-for="ShopCategory"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-12 mb-3">

                            <label asp-for="ShopDescription"
                                   class="form-label">

                                Shop Description

                            </label>

                            <textarea asp-for="ShopDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your shop"></textarea>

                            <span asp-validation-for="ShopDescription"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-grid-3x3-gap"></i>

                    Shop Collections & Services

                </div>

                <div class="card-body-custom">

                    <div class="mb-4">

                        <label class="form-label">
                            Shop Collections
                        </label>

                        <p class="text-muted small">
                            Select all categories and collections that your shop currently offers.
                        </p>

                        <div class="row">

                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Bridal Wear"
                                               @(collections.Contains("Bridal Wear")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Bridal Wear
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Groom Wear"
                                               @(collections.Contains("Groom Wear")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Groom Wear
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Formal Wear"
                                               @(collections.Contains("Formal Wear")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Formal Wear
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Wedding Guest Wear"
                                               @(collections.Contains("Wedding Guest Wear")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Wedding Guest Wear
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Footwear"
                                               @(collections.Contains("Footwear")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Footwear
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Jewellery"
                                               @(collections.Contains("Jewellery")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Jewellery
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Accessories"
                                               @(collections.Contains("Accessories")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                            Accessories
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Bridal Accessories"
                                               @(collections.Contains("Bridal Accessories")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                           Bridal Accessories
                                        </label>

                                    </div>

                                </div>

                            </div>

                             <div class="col-md-6 col-lg-4 mb-3">

                                <div class="collection-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="selectedCollections"
                                               value="Bridal Jewellery"
                                               @(collections.Contains("Bridal Jewellery")
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">
                                         Bridal Jewellery
                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <div>

                        <label class="form-label">
                            Services Offered
                        </label>

                        <p class="text-muted small">
                            You can change the services your shop offers at any time.
                        </p>

                        <div class="row">

                            <div class="col-md-4 mb-3">

                                <div class="service-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="OffersBuy"
                                               value="true"
                                               @(Model.OffersBuy
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">

                                            <i class="bi bi-cart-check me-1"></i>

                                            Buy / Sale

                                        </label>

                                    </div>

                                    <small class="text-muted d-block mt-2">
                                        Customers can buy products from your shop.
                                    </small>

                                </div>

                            </div>


                            <div class="col-md-4 mb-3">

                                <div class="service-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="OffersRent"
                                               value="true"
                                               @(Model.OffersRent
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">

                                            <i class="bi bi-arrow-repeat me-1"></i>

                                            Rent

                                        </label>

                                    </div>

                                    <small class="text-muted d-block mt-2">
                                        Customers can rent eligible products from your shop.
                                    </small>

                                </div>

                            </div>


                            <div class="col-md-4 mb-3">

                                <div class="service-box">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="OffersCustomization"
                                               value="true"
                                               @(Model.OffersCustomization
                                                   ? "checked"
                                                   : "") />

                                        <label class="form-check-label">

                                            <i class="bi bi-scissors me-1"></i>

                                            Customize

                                        </label>

                                    </div>

                                    <small class="text-muted d-block mt-2">
                                        Customers can submit customization requests.
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-telephone"></i>

                    Contact Information

                </div>

                <div class="card-body-custom">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="ShopPhone"
                                   class="form-label">

                                Shop Phone

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <input asp-for="ShopPhone"
                                   class="form-control"
                                   placeholder="03XX-XXXXXXX" />

                            <span asp-validation-for="ShopPhone"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Email"
                                   class="form-label">

                                Email

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="shop@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-12 mb-3">

                            <label asp-for="ShopAddress"
                                   class="form-label">

                                Shop Address

                            </label>

                            <textarea asp-for="ShopAddress"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter complete shop address"></textarea>

                            <span asp-validation-for="ShopAddress"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-share"></i>

                    Social Media & Online Contact

                </div>

                <div class="card-body-custom">

                    <div class="optional-note">

                        <i class="bi bi-info-circle"></i>

                        All fields in this section are optional.
                        Customers will only see the contact or social
                        links that you provide.

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="WhatsAppNumber"
                                   class="form-label">

                                WhatsApp Number

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group social-input-group">

                                <span class="social-input-icon">

                                    <i class="bi bi-whatsapp"></i>

                                </span>

                                <input asp-for="WhatsAppNumber"
                                       class="form-control"
                                       placeholder="923XXXXXXXXX" />

                            </div>

                            <small class="text-muted">

                                Use country code, for example:
                                923001234567

                            </small>

                            <span asp-validation-for="WhatsAppNumber"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="FacebookUrl"
                                   class="form-label">

                                Facebook

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group social-input-group">

                                <span class="social-input-icon">

                                    <i class="bi bi-facebook"></i>

                                </span>

                                <input asp-for="FacebookUrl"
                                       class="form-control"
                                       placeholder="https://facebook.com/yourshop" />

                            </div>

                            <span asp-validation-for="FacebookUrl"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="InstagramUrl"
                                   class="form-label">

                                Instagram

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group social-input-group">

                                <span class="social-input-icon">

                                    <i class="bi bi-instagram"></i>

                                </span>

                                <input asp-for="InstagramUrl"
                                       class="form-control"
                                       placeholder="https://instagram.com/yourshop" />

                            </div>

                            <span asp-validation-for="InstagramUrl"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="TikTokUrl"
                                   class="form-label">

                                TikTok

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group social-input-group">

                                <span class="social-input-icon">

                                    <i class="bi bi-tiktok"></i>

                                </span>

                                <input asp-for="TikTokUrl"
                                       class="form-control"
                                       placeholder="https://www.tiktok.com/@@yourshop" />

                            </div>

                            <span asp-validation-for="TikTokUrl"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-12 mb-3">

                            <label asp-for="WebsiteUrl"
                                   class="form-label">

                                Website

                                <span class="optional-label">
                                    (Optional)
                                </span>

                            </label>

                            <div class="input-group social-input-group">

                                <span class="social-input-icon">

                                    <i class="bi bi-globe"></i>

                                </span>

                                <input asp-for="WebsiteUrl"
                                       class="form-control"
                                       placeholder="https://www.example.com" />

                            </div>

                            <span asp-validation-for="WebsiteUrl"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-image"></i>

                    Shop Logo

                </div>

                <div class="card-body-custom">

                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <div class="mb-3">

                            <p class="fw-bold">
                                Current Logo
                            </p>

                            <img src="@Model.Logo"
                                 class="current-image"
                                 alt="Current Logo" />

                        </div>
                    }

                    <label class="form-label">
                        Change Logo
                    </label>

                    <input type="file"
                           name="LogoFile"
                           class="form-control"
                           accept="image/*" />

                    <small class="text-muted">

                        Leave empty if you do not want to change the logo.

                    </small>

                </div>

            </div>


            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-images"></i>

                    Shop Photos

                </div>

                <div class="card-body-custom">

                    <div class="row">

                        <div class="col-md-4 mb-4">

                            <label class="form-label">
                                Shop Front Photo
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ShopFrontPhoto))
                            {
                                <img src="@Model.ShopFrontPhoto"
                                     class="photo-preview mb-2"
                                     alt="Shop Front" />
                            }

                            <input type="file"
                                   name="ShopFrontPhoto"
                                   class="form-control"
                                   accept="image/*" />

                        </div>


                        <div class="col-md-4 mb-4">

                            <label class="form-label">
                                Shop Inside Photo
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ShopInsidePhoto))
                            {
                                <img src="@Model.ShopInsidePhoto"
                                     class="photo-preview mb-2"
                                     alt="Shop Inside" />
                            }

                            <input type="file"
                                   name="ShopInsidePhoto"
                                   class="form-control"
                                   accept="image/*" />

                        </div>


                        <div class="col-md-4 mb-4">

                            <label class="form-label">
                                Shop Signboard Photo
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ShopSignboardPhoto))
                            {
                                <img src="@Model.ShopSignboardPhoto"
                                     class="photo-preview mb-2"
                                     alt="Shop Signboard" />

                            }

                            <input type="file"
                                   name="ShopSignboardPhoto"
                                   class="form-control"
                                   accept="image/*" />

                        </div>

                    </div>

                </div>

            </div>


            <div class="custom-card">

                <div class="card-body-custom">

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle"></i>

                            Save Changes

                        </button>

                        <a asp-controller="Shopkeeper"
                           asp-action="MyShop"
                           class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>

                            Cancel

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>