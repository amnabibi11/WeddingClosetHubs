@model WeddingClosetHubs.Models.Shop

@{
    ViewData["Title"] = "Edit Shop";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Edit Shop - Wedding Closet Hub</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
        }

        .page-wrapper {
            padding: 30px;
        }

        .page-header {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 0;
        }

        .custom-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            margin-bottom: 25px;
        }

        .card-header-custom {
            background: #800020;
            color: white;
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 600;
        }

        .card-body-custom {
            padding: 25px;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control,
        .form-select {
            padding: 11px 14px;
            border-radius: 7px;
        }

        .current-image {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
            margin-bottom: 10px;
        }

        .photo-preview {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .btn {
            border-radius: 7px;
            padding: 10px 18px;
        }

        @@media (max-width: 768px) {

            .page-wrapper {
                padding: 15px;
            }

            .page-title {
                font-size: 23px;
            }
        }

    </style>

</head>

<body>

    <div class="page-wrapper">



        <div class="page-header">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="page-title">

                        <i class="bi bi-pencil-square"></i>

                        Edit Shop

                    </h2>

                    <p class="page-subtitle">

                        Update your shop information.

                    </p>

                </div>

                <div class="col-md-4 text-md-end">

                    <a asp-controller="Shopkeeper"
                       asp-action="MyShop"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Back to My Shop

                    </a>

                </div>

            </div>

        </div>




        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <form asp-controller="Shopkeeper"
              asp-action="EditShop"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="ShopId" />

            <input type="hidden"
                   asp-for="ShopkeeperId" />




            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-shop"></i>

                    Shop Information

                </div>

                <div class="card-body-custom">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="ShopName"
                                   class="form-label">

                                Shop Name

                            </label>

                            <input asp-for="ShopName"
                                   class="form-control"
                                   placeholder="Enter shop name" />

                            <span asp-validation-for="ShopName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="ShopCategory"
                                   class="form-label">

                                Shop Category

                            </label>

                            <select asp-for="ShopCategory"
                                    class="form-select">

                                <option value="">
                                    Select Category
                                </option>

                                <option value="Bridal Dresses">
                                    Bridal Dresses
                                </option>

                                <option value="Groom Dresses">
                                    Groom Dresses
                                </option>

                                <option value="Party Wear">
                                    Party Wear
                                </option>

                                <option value="Wedding Accessories">
                                    Wedding Accessories
                                </option>

                                <option value="Jewellery">
                                    Jewellery
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                            <span asp-validation-for="ShopCategory"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-12 mb-3">

                            <label asp-for="ShopDescription"
                                   class="form-label">

                                Shop Description

                            </label>

                            <textarea asp-for="ShopDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your shop"></textarea>

                            <span asp-validation-for="ShopDescription"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>




            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-telephone"></i>

                    Contact Information

                </div>

                <div class="card-body-custom">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="ShopPhone"
                                   class="form-label">

                                Shop Phone

                            </label>

                            <input asp-for="ShopPhone"
                                   class="form-control"
                                   placeholder="03XX-XXXXXXX" />

                            <span asp-validation-for="ShopPhone"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Email"
                                   class="form-label">

                                Email

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="shop@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-12 mb-3">

                            <label asp-for="ShopAddress"
                                   class="form-label">

                                Shop Address

                            </label>

                            <textarea asp-for="ShopAddress"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter complete shop address"></textarea>

                            <span asp-validation-for="ShopAddress"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>



            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-image"></i>

                    Shop Logo

                </div>

                <div class="card-body-custom">

                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <div class="mb-3">

                            <p class="fw-bold">
                                Current Logo
                            </p>

                            <img src="@Model.Logo"
                                 class="current-image"
                                 alt="Current Logo" />

                        </div>
                    }

                    <label class="form-label">
                        Change Logo
                    </label>

                    <input type="file"
                           name="LogoFile"
                           class="form-control"
                           accept="image/*" />

                    <small class="text-muted">

                        Leave empty if you do not want to change the logo.

                    </small>

                </div>

            </div>




            <div class="custom-card">

                <div class="card-header-custom">

                    <i class="bi bi-images"></i>

                    Shop Photos

                </div>

                <div class="card-body-custom">

                    <div class="row">

                        <div class="col-md-4 mb-4">

                            <label class="form-label">
                                Shop Front Photo
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ShopFrontPhoto))
                            {
                                <img src="@Model.ShopFrontPhoto"
                                     class="photo-preview mb-2"
                                     alt="Shop Front" />
                            }

                            <input type="file"
                                   name="ShopFrontFile"
                                   class="form-control"
                                   accept="image/*" />

                        </div>


                        <div class="col-md-4 mb-4">

                            <label class="form-label">
                                Shop Inside Photo
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ShopInsidePhoto))
                            {
                                <img src="@Model.ShopInsidePhoto"
                                     class="photo-preview mb-2"
                                     alt="Shop Inside" />
                            }

                            <input type="file"
                                   name="ShopInsideFile"
                                   class="form-control"
                                   accept="image/*" />

                        </div>


                        <div class="col-md-4 mb-4">

                            <label class="form-label">
                                Shop Signboard Photo
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ShopSignboardPhoto))
                            {
                                <img src="@Model.ShopSignboardPhoto"
                                     class="photo-preview mb-2"
                                     alt="Shop Signboard" />
                            }

                            <input type="file"
                                   name="ShopSignboardFile"
                                   class="form-control"
                                   accept="image/*" />

                        </div>

                    </div>

                </div>

            </div>




            <div class="custom-card">

                <div class="card-body-custom">

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle"></i>

                            Save Changes

                        </button>

                        <a asp-controller="Shopkeeper"
                           asp-action="MyShop"
                           class="btn btn-secondary">

                            <i class="bi bi-x-circle"></i>

                            Cancel

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>