        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="summary-box status-card-delivered">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-house-check"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @deliveredOrders
                            </div>

                            <div class="summary-label">
                                Delivered
                            </div>

                            <div class="summary-description">
                                Order delivered to customer
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box status-card-completed">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @completedOrders
                            </div>

                            <div class="summary-label">
                                Completed
                            </div>

                            <div class="summary-description">
                                Fully completed orders
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box status-card-cancelled">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-x-circle"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @cancelledOrders
                            </div>

                            <div class="summary-label">
                                Cancelled
                            </div>

                            <div class="summary-description">
                                Cancelled orders
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-list-check"></i>
                        </div>

                        <div>

                            <div class="summary-number">

                                @(pendingOrders +
                                                                confirmedOrders +
                                                                processingOrders +
                                                                readyOrders +
                                                                assignedOrders +
                                                                pickedUpOrders +
                                                                outForDeliveryOrders +
                                                                deliveredOrders +
                                                                completedOrders +
                                                                cancelledOrders)

                            </div>

                            <div class="summary-label">
                                Status-Tracked Orders
                            </div>

                            <div class="summary-description">
                                Orders covered by status cards
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="summary-section-title">

            <i class="bi bi-tags me-1"></i>

            Order Types

        </div>

        <div class="section-note">

            Customize orders are counted separately even when their purchase type also contains Buy, Rent or Sale.

        </div>

        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="summary-box type-buy">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-bag-fill"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @buyOrders
                            </div>

                            <div class="summary-label">
                                Buy Orders
                            </div>

                            <div class="summary-description">
                                Orders containing Buy items
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box type-sale">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-tag-fill"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @saleOrders
                            </div>

                            <div class="summary-label">
                                Sale Orders
                            </div>

                            <div class="summary-description">
                                Orders containing Sale items
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box type-customize">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @customizeOrders
                            </div>

                            <div class="summary-label">
                                Customize Orders
                            </div>

                            <div class="summary-description">
                                Customize / Buy / Rent / Sale
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box type-rent">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-calendar-heart"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @rentOrders
                            </div>

                            <div class="summary-label">
                                Rental Orders
                            </div>

                            <div class="summary-description">
                                Orders containing Rent items
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="summary-section-title">

            <i class="bi bi-credit-card me-1"></i>

            Payment & Delivery

        </div>

        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="summary-box payment-paid-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-cash-stack"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @paidOrders
                            </div>

                            <div class="summary-label">
                                Paid / Received
                            </div>

                            <div class="summary-description">
                                Orders with payment received
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box payment-unpaid-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @unpaidOrders
                            </div>

                            <div class="summary-label">
                                Unpaid / Pending
                            </div>

                            <div class="summary-description">
                                Orders awaiting payment
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box delivery-assigned-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-person-check-fill"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @assignedDeliveryOrders
                            </div>

                            <div class="summary-label">
                                Delivery Assigned
                            </div>

                            <div class="summary-description">
                                Orders assigned to delivery
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box delivery-unassigned-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-person-dash"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @unassignedDeliveryOrders
                            </div>

                            <div class="summary-label">
                                Delivery Not Assigned
                            </div>

                            <div class="summary-description">
                                Orders without delivery assignment
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="summary-section-title">

            <i class="bi bi-wallet2 me-1"></i>

            Amount Summary

        </div>

        <div class="row g-3 mb-4">

            <div class="col-xl-4 col-md-6">

                <div class="amount-summary">

                    <div class="amount-summary-title">
                        PRODUCT AMOUNT
                    </div>

                    <div class="amount-summary-value">
                        Rs. @totalProductAmount.ToString("N2")
                    </div>

                    <div class="amount-summary-label">
                        Total product value across all orders
                    </div>

                </div>

            </div>

            <div class="col-xl-4 col-md-6">

                <div class="amount-summary">

                    <div class="amount-summary-title">
                        TOTAL ORDER VALUE
                    </div>

                    <div class="amount-summary-value">
                        Rs. @totalOrderAmount.ToString("N2")
                    </div>

                    <div class="amount-summary-label">
                        Total customer order value
                    </div>

                </div>

            </div>

            <div class="col-xl-4 col-md-12">

                <div class="amount-summary">

                    <div class="amount-summary-title">
                        SHOPKEEPER AMOUNT
                    </div>

                    <div class="amount-summary-value">
                        Rs. @totalShopkeeperAmount.ToString("N2")
                    </div>

                    <div class="amount-summary-label">
                        Total shopkeeper settlement amount
                    </div>

                </div>

            </div>

        </div>

        <div class="orders-box">

            <div class="orders-header">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div>

                        <h5>

                            <i class="bi bi-list-check me-1"></i>

                            All Orders

                        </h5>

                        <small class="text-muted">
                            Orders received by your shop
                        </small>

                    </div>

                    <div class="orders-count">
                        @totalOrders Orders
                    </div>

                </div>

            </div>

            @if (orders.Any())
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>Order</th>
                                <th>Customer</th>
                                <th>Order Type</th>
                                <th>Products</th>
                                <th>Date</th>
                                <th>Product Amount</th>
                                <th>Total</th>
                                <th>Payment</th>
                                <th>Order Status</th>
                                <th>Delivery</th>
                                <th>Shopkeeper Amount</th>
                                <th>Payment Status</th>
                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in orders)
                            {

                                string currentStatus =
                                string.IsNullOrWhiteSpace(order.OrderStatus)
                                ? "Unknown"
                                : order.OrderStatus.Trim();

                                string statusClass = "status-other";

                                if (IsPendingStatus(currentStatus))
                                {
                                    statusClass = "status-pending";
                                }
                                else if (IsCancelledStatus(currentStatus))
                                {
                                    statusClass = "status-cancelled";
                                }
                                else if (IsCompletedStatus(currentStatus))
                                {
                                    statusClass = "status-completed";
                                }
                                else if (IsDeliveredStatus(currentStatus))
                                {
                                    statusClass = "status-delivered";
                                }
                                else if (IsOutForDeliveryStatus(currentStatus))
                                {
                                    statusClass = "status-out";
                                }
                                else if (IsPickedUpStatus(currentStatus))
                                {
                                    statusClass = "status-picked";
                                }
                                else if (IsAssignedStatus(currentStatus))
                                {
                                    statusClass = "status-assigned";
                                }
                                else if (IsReadyStatus(currentStatus))
                                {
                                    statusClass = "status-ready";
                                }
                                else if (IsProcessingStatus(currentStatus))
                                {
                                    statusClass = "status-processing";
                                }
                                else if (IsConfirmedStatus(currentStatus))
                                {
                                    statusClass = "status-confirmed";
                                }

                                bool paymentReceived =
                                order.PaymentReceived ||
                                IsPaid(order.PaymentStatus);

                                <tr>

                                    <td>

                                        <span class="order-id">
                                            #@order.OrderId
                                        </span>

                                    </td>

                                    <td>

                                        @if (order.Customer != null)
                                        {
                                            <div class="customer-name">
                                                @order.Customer.Name
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(order.Customer.Email))
                                            {
                                                <div class="customer-email">
                                                    @order.Customer.Email
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Customer unavailable
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="type-container">

                                            @if (order.OrderDetails != null &&
                                                                                order.OrderDetails.Any())
                                            {
                                                var purchaseTypes =
                                                order.OrderDetails
                                                .Select(d =>
                                                string.IsNullOrWhiteSpace(d.PurchaseType)
                                                ? "Buy"
                                                : d.PurchaseType.Trim())
                                                .Distinct(
                                                StringComparer.OrdinalIgnoreCase)
                                                .ToList();

                                                foreach (var type in purchaseTypes)
                                                {
                                                    bool customize =
                                                    IsCustomizeType(type);

                                                    bool buy =
                                                    IsBuyType(type);

                                                    bool rent =
                                                    IsRentType(type);

                                                    bool sale =
                                                    IsSaleType(type);

                                                    if (customize)
                                                    {
                                                        <span class="type-badge type-customize-badge">
                                                            <i class="bi bi-pencil-square me-1"></i>
                                                            Customize
                                                        </span>
                                                    }

                                                    if (buy)
                                                    {
                                                        <span class="type-badge type-buy-badge">
                                                            <i class="bi bi-bag me-1"></i>
                                                            Buy
                                                        </span>
                                                    }

                                                    if (sale)
                                                    {
                                                        <span class="type-badge type-sale-badge">
                                                            <i class="bi bi-tag me-1"></i>
                                                            Sale
                                                        </span>
                                                    }

                                                    if (rent)
                                                    {
                                                        <span class="type-badge type-rent-badge">
                                                            <i class="bi bi-calendar-heart me-1"></i>
                                                            Rent
                                                        </span>
                                                    }

                                                    if (!customize &&
                                                    !buy &&
                                                    !sale &&
                                                    !rent)
                                                    {
                                                        <span class="type-badge type-buy-badge">
                                                            @type
                                                        </span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="type-badge type-buy-badge">
                                                    <i class="bi bi-bag me-1"></i>
                                                    Buy
                                                </span>
                                            }

                                        </div>

                                    </td>

                                    <td>

                                        <div class="order-products">

                                            @if (order.OrderDetails != null &&
                                                                                order.OrderDetails.Any())
                                            {
                                                foreach (var detail in order.OrderDetails)
                                                {
                                                    string productType =
                                                    string.IsNullOrWhiteSpace(detail.PurchaseType)
                                                    ? "Buy"
                                                    : detail.PurchaseType.Trim();

                                                    <div class="product-line">

                                                        <strong>
                                                            @(detail.Product?.ProductName ?? "Product")
                                                        </strong>

                                                        <span>
                                                            × @detail.Quantity
                                                        </span>

                                                        <br />

                                                        @if (IsCustomizeType(productType))
                                                        {
                                                            <span class="text-primary">
                                                                <i class="bi bi-pencil-square me-1"></i>
                                                                Customize
                                                            </span>

                                                            @if (IsBuyType(productType))
                                                            {
                                                                <span class="text-muted ms-1">
                                                                    / Buy
                                                                </span>
                                                            }

                                                            @if (IsSaleType(productType))
                                                            {
                                                                <span class="text-warning ms-1">
                                                                    / Sale
                                                                </span>
                                                            }

                                                            @if (IsRentType(productType))
                                                            {
                                                                <span class="text-success ms-1">
                                                                    / Rent
                                                                </span>
                                                            }
                                                        }
                                                        else if (IsRentType(productType))
                                                        {
                                                            <span class="text-success">
                                                                <i class="bi bi-calendar-heart me-1"></i>
                                                                Rent
                                                            </span>

                                                            @if (!string.IsNullOrWhiteSpace(detail.RentalReturnStatus))
                                                            {
                                                                <span class="rental-return">
                                                                    @detail.RentalReturnStatus
                                                                </span>
                                                            }
                                                        }
                                                        else if (IsSaleType(productType))
                                                        {
                                                            <span class="text-warning">
                                                                <i class="bi bi-tag me-1"></i>
                                                                Sale
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">
                                                                <i class="bi bi-bag me-1"></i>
                                                                Buy
                                                            </span>
                                                        }

                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    No products
                                                </span>
                                            }

                                        </div>

                                    </td>

                                    <td>

                                        <div class="date-text">

                                            <strong>
                                                @order.CreatedDate.ToString("dd MMM yyyy")
                                            </strong>

                                            <br />

                                            <small class="text-muted">
                                                @order.CreatedDate.ToString("hh:mm tt")
                                            </small>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="amount">
                                            Rs. @order.ProductTotal.ToString("N2")
                                        </span>

                                    </td>

                                    <td>

                                        <span class="amount">
                                            Rs. @order.TotalAmount.ToString("N2")
                                        </span>

                                    </td>

                                    <td>

                                        <div class="payment-method">

                                            @if (string.Equals(
                                                                                order.PaymentMethod,
                                                                                "Cash on Delivery",
                                                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-cash me-1"></i>
                                                <span>COD</span>
                                            }
                                            else if (string.Equals(
                                            order.PaymentMethod,
                                            "Easypaisa",
                                            StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-phone me-1"></i>
                                                <span>Easypaisa</span>
                                            }
                                            else if (string.Equals(
                                            order.PaymentMethod,
                                            "JazzCash",
                                            StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-phone me-1"></i>
                                                <span>JazzCash</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(
                                            order.PaymentMethod))
                                            {
                                                @order.PaymentMethod
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Not Selected
                                                </span>
                                            }

                                        </div>

                                        @if (paymentReceived)
                                        {
                                            <small class="payment-paid">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Received

                                            </small>
                                        }
                                        else
                                        {
                                            <small class="payment-pending">

                                                <i class="bi bi-clock me-1"></i>

                                                Pending

                                            </small>
                                        }

                                    </td>

                                    <td>

                                        <span class="status-badge @statusClass">
                                            @currentStatus
                                        </span>

                                    </td>

                                    <td>

                                        @if (order.Delivery != null)
                                        {
                                            <span class="delivery-assigned">

                                                <i class="bi bi-person-check-fill me-1"></i>

                                                @order.Delivery.Name

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="delivery-none">

                                                <i class="bi bi-person-dash me-1"></i>

                                                Not Assigned

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <span class="amount">
                                            Rs. @order.ShopkeeperAmount.ToString("N2")
                                        </span>

                                    </td>

                                    <td>

                                        <div class="payment-status">

                                            @if (IsPaid(order.ShopkeeperPaymentStatus))
                                            {
                                                <span class="payment-paid">

                                                    <i class="bi bi-check-circle-fill me-1"></i>

                                                    Paid

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="payment-pending">

                                                    <i class="bi bi-clock me-1"></i>

                                                    @(string.IsNullOrWhiteSpace(
                                                                                            order.ShopkeeperPaymentStatus)
                                                                                            ? "Pending"
                                                                                            : order.ShopkeeperPaymentStatus)

                                    </span>
                                                                        }

                                        </div>

                                    </td>

                                    <td>

                                        <a asp-controller="Shopkeeper"
                                           asp-action="OrderDetails"
                                           asp-route-id="@order.OrderId"
                                           class="view-btn">

                                            <i class="bi bi-eye me-1"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-box">

                    <i class="bi bi-bag-x"></i>

                    <h4>
                        No Orders Found
                    </h4>

                    <p class="mb-0">
                        There are currently no orders for your shop.
                    </p>

                </div>

            }

        </div>

        @if (actualPurchaseTypes.Any())
        {
            <div class="orders-box">

                <div class="orders-header">

                    <div>

                        <h5>
                            <i class="bi bi-database-check me-1"></i>
                            Purchase Type Check
                        </h5>

                        <small class="text-muted">
                            These are the actual PurchaseType values stored in OrderDetails.
                        </small>

                    </div>

                </div>

                <div class="p-4">

                    <div class="type-check">

                        <div class="type-check-title">
                            Database Purchase Types
                        </div>

                        @foreach (var type in actualPurchaseTypes)
                        {
                            <span class="raw-type">

                                @type.Name

                                <strong>
                                    (@type.Count)
                                </strong>

                                @if (IsCustomizeType(type.Name))
                                {
                                    <span class="text-primary ms-1">
                                        → Customize
                                    </span>
                                }

                            </span>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</body>

</html>

