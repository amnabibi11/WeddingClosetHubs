</head>

<body>

    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center gap-3">

            <a asp-controller="Shopkeeper"
               asp-action="Dashboard"
               class="brand">

                <i class="bi bi-gem me-2"></i>

                Wedding Closet Hubs

            </a>

            <a asp-controller="Shopkeeper"
               asp-action="Dashboard"
               class="btn btn-light dashboard-btn">

                <i class="bi bi-speedometer2 me-1"></i>

                Dashboard

            </a>

        </div>

    </nav>

    <div class="page-container">



        <div class="mb-4">

            <h2 class="page-title">

                <i class="bi bi-bag-check me-2"></i>

                Orders

            </h2>

            <p class="page-subtitle">

                View and manage all Buy, Sale, Customize and Rent orders received by your shop.

            </p>

        </div>

        <div class="summary-section-title">

            <i class="bi bi-bar-chart-fill me-1"></i>

            Overall Orders

        </div>

        <div class="row g-3 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="summary-box">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-bag"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @totalOrders
                            </div>

                            <div class="summary-label">
                                Total Orders
                            </div>

                            <div class="summary-description">
                                All orders received by your shop
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box status-card-pending">

                    <div class="d-flex align-items-center gap-3">

                        <div class="summary-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <div>

                            <div class="summary-number">
                                @pendingOrders
                            </div>

                            <div class="summary-label">
                                Pending Orders
                            </div>

                            <div class="summary-description">
                                Waiting for shopkeeper action
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="summary-box status-card-confirmed">

                    <div class="d-flex align-items-center gap-3">

