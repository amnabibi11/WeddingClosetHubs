@model IEnumerable<WeddingClosetHubs.Models.Order>

@{
    ViewData["Title"] = "Orders";
    Layout = null;

    var orders = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Order>();

    string Normalize(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? ""
            : value.Trim();
    }

    bool ContainsText(string? value, string text)
    {
        string current = Normalize(value);

        return current.Contains(
            text,
            StringComparison.OrdinalIgnoreCase);
    }

    bool IsStatus(string? value, params string[] statuses)
    {
        string current = Normalize(value);

        return statuses.Any(status =>
            current.Equals(
                status,
                StringComparison.OrdinalIgnoreCase));
    }

    bool IsPendingStatus(string? value)
    {
        return IsStatus(
            value,
            "Pending",
            "Awaiting Confirmation",
            "Waiting for Confirmation");
    }

    bool IsConfirmedStatus(string? value)
    {
        return IsStatus(
            value,
            "Confirmed",
            "Accepted",
            "Order Confirmed",
            "Confirmed by Shopkeeper",
            "Confirmed By Shopkeeper",
            "Accepted by Shopkeeper");
    }

    bool IsProcessingStatus(string? value)
    {
        return IsStatus(
            value,
            "Processing",
            "In Processing",
            "Order Processing");
    }

    bool IsReadyStatus(string? value)
    {
        return IsStatus(
            value,
            "Ready",
            "Ready for Delivery",
            "Ready For Delivery");
    }

    bool IsAssignedStatus(string? value)
    {
        return IsStatus(
            value,
            "Assigned",
            "Delivery Assigned",
            "Assigned to Delivery");
    }

    bool IsPickedUpStatus(string? value)
    {
        return IsStatus(
            value,
            "Picked Up",
            "PickedUp",
            "Order Picked Up");
    }

    bool IsOutForDeliveryStatus(string? value)
    {
        return IsStatus(
            value,
            "Out for Delivery",
            "Out For Delivery",
            "Shipped");
    }

    bool IsDeliveredStatus(string? value)
    {
        return IsStatus(
            value,
            "Delivered",
            "Order Delivered");
    }

    bool IsCompletedStatus(string? value)
    {
        return IsStatus(
            value,
            "Completed",
            "Order Completed");
    }

    bool IsCancelledStatus(string? value)
    {
        return IsStatus(
            value,
            "Cancelled",
            "Canceled",
            "Order Cancelled",
            "Order Canceled");
    }

    bool IsCustomizeType(string? value)
    {
        string current = Normalize(value);

        if (string.IsNullOrWhiteSpace(current))
            return false;

        return current.Contains(
            "custom",
            StringComparison.OrdinalIgnoreCase)
            ||
            current.Contains(
                "customize",
                StringComparison.OrdinalIgnoreCase)
            ||
            current.Contains(
                "customized",
                StringComparison.OrdinalIgnoreCase)
            ||
            current.Contains(
                "customization",
                StringComparison.OrdinalIgnoreCase);
    }

    bool IsBuyType(string? value)
    {
        string current = Normalize(value);

        if (string.IsNullOrWhiteSpace(current))
            return true;

        if (IsCustomizeType(current))
        {
            return current.Contains(
                "buy",
                StringComparison.OrdinalIgnoreCase)
                ||
                current.Contains(
                    "purchase",
                    StringComparison.OrdinalIgnoreCase);
        }

        return current.Equals(
                   "Buy",
                   StringComparison.OrdinalIgnoreCase)
               ||
               current.Equals(
                   "Purchase",
                   StringComparison.OrdinalIgnoreCase)
               ||
               current.Equals(
                   "Purchase Order",
                   StringComparison.OrdinalIgnoreCase);
    }

    bool IsSaleType(string? value)
    {
        string current = Normalize(value);

        if (string.IsNullOrWhiteSpace(current))
            return false;

        return current.Equals(
                   "Sale",
                   StringComparison.OrdinalIgnoreCase)
               ||
               current.Equals(
                   "Sell",
                   StringComparison.OrdinalIgnoreCase)
               ||
               current.Equals(
                   "Sale Order",
                   StringComparison.OrdinalIgnoreCase)
               ||
               (
                   IsCustomizeType(current)
                   &&
                   current.Contains(
                       "sale",
                       StringComparison.OrdinalIgnoreCase)
               )
               ||
               (
                   IsCustomizeType(current)
                   &&
                   current.Contains(
                       "sell",
                       StringComparison.OrdinalIgnoreCase)
               );
    }

    bool IsRentType(string? value)
    {
        string current = Normalize(value);

        if (string.IsNullOrWhiteSpace(current))
            return false;

        return current.Equals(
                   "Rent",
                   StringComparison.OrdinalIgnoreCase)
               ||
               current.Equals(
                   "Rental",
                   StringComparison.OrdinalIgnoreCase)
               ||
               current.Equals(
                   "Rental Order",
                   StringComparison.OrdinalIgnoreCase)
               ||
               (
                   IsCustomizeType(current)
                   &&
                   (
                       current.Contains(
                           "rent",
                           StringComparison.OrdinalIgnoreCase)
                       ||
                       current.Contains(
                           "rental",
                           StringComparison.OrdinalIgnoreCase)
                   )
               );
    }

    string GetTypeLabel(string? value)
    {
        string current = Normalize(value);

        if (string.IsNullOrWhiteSpace(current))
            return "Buy";

        bool customize = IsCustomizeType(current);
        bool rent = IsRentType(current);
        bool sale = IsSaleType(current);
        bool buy = IsBuyType(current);

        if (customize)
        {
            if (rent && buy)
                return "Customize / Buy / Rent";

            if (rent && sale)
                return "Customize / Sale / Rent";

            if (rent)
                return "Customize / Rent";

            if (sale && buy)
                return "Customize / Buy / Sale";

            if (sale)
                return "Customize / Sale";

            if (buy)
                return "Customize / Buy";

            return "Customize";
        }

        if (rent)
            return "Rent";

        if (sale)
            return "Sale";

        if (buy)
            return "Buy";

        return current;
    }

    bool IsPaid(string? value)
    {
        return IsStatus(
            value,
            "Paid",
            "Received",
            "Payment Received",
            "Payment Completed",
            "Completed");
    }

    int totalOrders = orders.Count;

    int pendingOrders = orders.Count(o =>
        IsPendingStatus(o.OrderStatus));

    int confirmedOrders = orders.Count(o =>
        IsConfirmedStatus(o.OrderStatus));

    int processingOrders = orders.Count(o =>
        IsProcessingStatus(o.OrderStatus));

    int readyOrders = orders.Count(o =>
        IsReadyStatus(o.OrderStatus));

    int assignedOrders = orders.Count(o =>
        IsAssignedStatus(o.OrderStatus));

    int pickedUpOrders = orders.Count(o =>
        IsPickedUpStatus(o.OrderStatus));

    int outForDeliveryOrders = orders.Count(o =>
        IsOutForDeliveryStatus(o.OrderStatus));

    int deliveredOrders = orders.Count(o =>
        IsDeliveredStatus(o.OrderStatus));

    int completedOrders = orders.Count(o =>
        IsCompletedStatus(o.OrderStatus));

    int cancelledOrders = orders.Count(o =>
        IsCancelledStatus(o.OrderStatus));

    int buyOrders = orders.Count(o =>
        o.OrderDetails != null &&
        o.OrderDetails.Any(d =>
            IsBuyType(d.PurchaseType)));

    int saleOrders = orders.Count(o =>
        o.OrderDetails != null &&
        o.OrderDetails.Any(d =>
            IsSaleType(d.PurchaseType)));

    int rentOrders = orders.Count(o =>
        o.OrderDetails != null &&
        o.OrderDetails.Any(d =>
            IsRentType(d.PurchaseType)));

    int customizeOrders = orders.Count(o =>
        o.OrderDetails != null &&
        o.OrderDetails.Any(d =>
            IsCustomizeType(d.PurchaseType)));

    int paidOrders = orders.Count(o =>
        o.PaymentReceived ||
        IsPaid(o.PaymentStatus));

    int unpaidOrders = Math.Max(
        0,
        totalOrders - paidOrders);
    int assignedDeliveryOrders = orders.Count(o =>
        o.DeliveryId.HasValue && o.DeliveryId.Value > 0);


    int unassignedDeliveryOrders = Math.Max(
        0,
        totalOrders - assignedDeliveryOrders);

    decimal totalProductAmount = orders.Sum(o =>
        o.ProductTotal);

    decimal totalOrderAmount = orders.Sum(o =>
        o.TotalAmount);

    decimal totalShopkeeperAmount = orders.Sum(o =>
        o.ShopkeeperAmount);

    var actualPurchaseTypes = orders
        .Where(o => o.OrderDetails != null)
        .SelectMany(o => o.OrderDetails!)
        .Select(d =>
            string.IsNullOrWhiteSpace(d.PurchaseType)
                ? "[NULL / EMPTY]"
                : d.PurchaseType.Trim())
        .GroupBy(
            value => value,
            StringComparer.OrdinalIgnoreCase)
        .Select(group => new
        {
            Name = group.First(),
            Count = group.Count()
        })
        .OrderByDescending(x => x.Count)
        .ToList();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

