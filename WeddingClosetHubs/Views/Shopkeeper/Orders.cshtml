        .type-sale .summary-icon {
            background: #fff3cd;
            color: #856404;
        }

        .type-customize .summary-icon {
            background: #e2d9f3;
            color: #432874;
        }

        .type-rent .summary-icon {
            background: #d1e7dd;
            color: #0f5132;
