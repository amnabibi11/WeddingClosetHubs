@model IEnumerable<WeddingClosetHubs.Models.ChatMessage>

@{
    ViewData["Title"] = "Chat";
    Layout = null;

    var messages = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.ChatMessage>();

    int? selectedUserId =
        ViewBag.SelectedUserId as int?;

    string selectedUserName =
        ViewBag.SelectedUserName as string
        ?? "Select a conversation";

    var unreadCounts =
        ViewBag.UnreadCounts as Dictionary<int, int>
        ?? new Dictionary<int, int>();

    int currentUserId = 0;

    if (ViewBag.CurrentUserId != null)
    {
        currentUserId =
            Convert.ToInt32(ViewBag.CurrentUserId);
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Chat - Wedding Closet Hub
    </title>


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        body {
            background: #f7f7f7;
            font-family: Arial, sans-serif;
            margin: 0;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .page-header {
            background: #800020;
            color: white;
            padding: 22px 30px;
        }

        .page-header h2 {
            margin: 0;
            font-weight: 600;
        }

        .page-header p {
            margin: 5px 0 0;
            opacity: .85;
        }


        /* =====================================================
           CHAT CONTAINER
        ===================================================== */

        .chat-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 3px 15px rgba(0,0,0,.10);
            overflow: hidden;
            height: calc(100vh - 145px);
            min-height: 600px;
        }


        /* =====================================================
           CONTACT SIDEBAR
        ===================================================== */

        .contacts {
            border-right: 1px solid #eee;
            height: 100%;
            overflow-y: auto;
        }

        .contacts-header {
            padding: 18px;
            border-bottom: 1px solid #eee;
            font-weight: 600;
            color: #800020;
        }


        .contact {
            display: flex;
            align-items: center;
            padding: 14px 16px;
            text-decoration: none;
            color: #333;
            border-bottom: 1px solid #f1f1f1;
            transition: .2s;
        }

        .contact:hover {
            background: #faf3f5;
            color: #800020;
        }

        .contact.active {
            background: #f7e9ed;
            border-left: 4px solid #800020;
        }


        /* =====================================================
           CONTACT ICON
        ===================================================== */

        .contact-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
            border-radius: 50%;
            background: #800020;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        .customer-icon {
            background: #6f42c1;
        }

        .admin-icon {
            background: #343a40;
        }

        .delivery-icon {
            background: #198754;
        }


        .contact-content {
            flex: 1;
            min-width: 0;
        }

        .contact-name {
            font-weight: 600;
            font-size: 14px;
        }

        .contact-role {
            font-size: 12px;
            color: #888;
        }

        .unread-badge {
            margin-left: auto;
            background: #dc3545;
            color: white;
            font-size: 11px;
            min-width: 20px;
            height: 20px;
            padding: 2px 6px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        /* =====================================================
           CHAT AREA
        ===================================================== */

        .chat-area {
            height: 100%;
            display: flex;
            flex-direction: column;
        }


        .chat-header {
            padding: 16px 20px;
            border-bottom: 1px solid #eee;
            background: white;
        }

        .chat-header-name {
            font-weight: 600;
            color: #800020;
            font-size: 17px;
        }

        .chat-header-role {
            color: #888;
            font-size: 12px;
        }


        /* =====================================================
           MESSAGES
        ===================================================== */

        .messages {
            flex: 1;
            overflow-y: auto;
            padding: 25px;
            background: #fafafa;
        }


        .message-wrapper {
            display: flex;
            margin-bottom: 15px;
        }

        .message-wrapper.sent {
            justify-content: flex-end;
        }

        .message-wrapper.received {
            justify-content: flex-start;
        }


        .message {
            max-width: 70%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            position: relative;
            word-break: break-word;
        }


        .message.sent {
            background: #800020;
            color: white;
            border-bottom-right-radius: 3px;
        }


        .message.received {
            background: white;
            color: #333;
            border: 1px solid #eee;
            border-bottom-left-radius: 3px;
        }


        .message-text {
            display: inline;
        }


        /* =====================================================
           DELETE MESSAGE
        ===================================================== */

        .delete-form {
            display: inline-flex;
            margin: 0;
            padding: 0;
        }

        .delete-message-btn {
            border: none;
            background: transparent;
            color: inherit;
            padding: 0;
            margin-left: 8px;
            cursor: pointer;
            font-size: 12px;
            opacity: .70;
        }

        .delete-message-btn:hover {
            opacity: 1;
            color: #d4af37;
        }

        .deleted-message {
            font-style: italic;
            opacity: .65;
        }


        /* =====================================================
           MESSAGE INPUT
        ===================================================== */

        .message-input {
            border-top: 1px solid #eee;
            padding: 15px;
            background: white;
        }


        .message-input form {
            display: flex;
            gap: 10px;
            align-items: stretch;
        }


        .message-input textarea {
            resize: none;
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 10px 12px;
        }

        .message-input textarea:focus {
            border-color: #800020;
            box-shadow: 0 0 0 .15rem rgba(128,32,0,.10);
        }


        .send-btn {
            background: #800020;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 0 20px;
        }

        .send-btn:hover {
            background: #650019;
            color: white;
        }


        /* =====================================================
           EMPTY CHAT
        ===================================================== */

        .empty-chat {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #888;
        }

        .empty-chat i {
            font-size: 65px;
            color: #ccc;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @@media (max-width: 768px) {

            .chat-container {
                height: auto;
                min-height: 700px;
            }

            .contacts {
                height: auto;
                max-height: 250px;
                border-right: none;
                border-bottom: 1px solid #eee;
            }

            .chat-area {
                height: 600px;
            }

            .message {
                max-width: 85%;
            }

            .message-input form {
                flex-direction: column;
            }

            .send-btn {
                padding: 10px;
            }

        }

    </style>

</head>


<body>


    <!-- =========================================================
         PAGE HEADER
    ========================================================= -->

    <div class="page-header">

        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2>

                        <i class="bi bi-chat-dots"></i>

                        Chat

                    </h2>

                    <p>

                        Communicate with customers, admin and delivery boys.

                    </p>

                </div>


                <div>

                    <a asp-controller="Shopkeeper"
                       asp-action="Dashboard"
                       class="btn btn-light">

                        <i class="bi bi-arrow-left"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>


    <div class="container-fluid py-3">


        <!-- =====================================================
             CHAT CONTAINER
        ===================================================== -->

        <div class="chat-container">

            <div class="row g-0 h-100">


                <!-- =================================================
                     CONTACT LIST
                ================================================= -->

                <div class="col-md-4 col-lg-3 contacts">


                    <div class="contacts-header">

                        <i class="bi bi-people"></i>

                        Conversations

                    </div>


                    <!-- =================================================
                         CUSTOMERS
                    ================================================= -->

                    @if (ViewBag.Customers != null)
                    {

                        foreach (var customer in ViewBag.Customers)
                        {

                            <a asp-controller="Shopkeeper"
                               asp-action="Conversation"
                               asp-route-userId="@customer.UserId"
                               class="contact
                               @(selectedUserId == customer.UserId
                                   ? "active"
                                   : "")">


                                <div class="contact-icon customer-icon">

                                    <i class="bi bi-person"></i>

                                </div>


                                <div class="contact-content">

                                    <div class="contact-name">

                                        @customer.Name

                                    </div>

                                    <div class="contact-role">

                                        Customer

                                    </div>

                                </div>


                                @if (unreadCounts.TryGetValue(
                                        customer.UserId,
                                        out int customerUnread)
                                    && customerUnread > 0)
                                {

                                    <span class="unread-badge">

                                        @customerUnread

                                    </span>

                                }

                            </a>

                        }

                    }


                    <!-- =================================================
                         ADMIN
                    ================================================= -->

                    @if (ViewBag.Admin != null)
                    {
                        var admin =
                            ViewBag.Admin as WeddingClosetHubs.Models.User;

                        if (admin != null)
                        {

                            <a asp-controller="Shopkeeper"
                               asp-action="Conversation"
                               asp-route-userId="@admin.UserId"
                               class="contact
                               @(selectedUserId == admin.UserId
                                   ? "active"
                                   : "")">


                                <div class="contact-icon admin-icon">

                                    <i class="bi bi-person-badge"></i>

                                </div>


                                <div class="contact-content">

                                    <div class="contact-name">

                                        @admin.Name

                                    </div>

                                    <div class="contact-role">

                                        Administrator

                                    </div>

                                </div>


                                @if (unreadCounts.TryGetValue(
                                        admin.UserId,
                                        out int adminUnread)
                                    && adminUnread > 0)
                                {

                                    <span class="unread-badge">

                                        @adminUnread

                                    </span>

                                }

                            </a>

                        }
                    }


                    <!-- =================================================
                         DELIVERY BOYS
                    ================================================= -->

                    @if (ViewBag.DeliveryBoys != null)
                    {

                        foreach (var delivery in ViewBag.DeliveryBoys)
                        {

                            <a asp-controller="Shopkeeper"
                               asp-action="Conversation"
                               asp-route-userId="@delivery.UserId"
                               class="contact
                               @(selectedUserId == delivery.UserId
                                   ? "active"
                                   : "")">


                                <div class="contact-icon delivery-icon">

                                    <i class="bi bi-truck"></i>

                                </div>


                                <div class="contact-content">

                                    <div class="contact-name">

                                        @delivery.Name

                                    </div>

                                    <div class="contact-role">

                                        Delivery Boy

                                    </div>

                                </div>


                                @if (unreadCounts.TryGetValue(
                                        delivery.UserId,
                                        out int deliveryUnread)
                                    && deliveryUnread > 0)
                                {

                                    <span class="unread-badge">

                                        @deliveryUnread

                                    </span>

                                }

                            </a>

                        }

                    }


                </div>


                <!-- =================================================
                     CHAT AREA
                ================================================= -->

                <div class="col-md-8 col-lg-9 chat-area">


                    @if (selectedUserId.HasValue)
                    {


                        <!-- CHAT HEADER -->

                        <div class="chat-header">

                            <div class="chat-header-name">

                                <i class="bi bi-chat-left-text me-2"></i>

                                @selectedUserName

                            </div>

                            <div class="chat-header-role">

                                Conversation

                            </div>

                        </div>


                        <!-- =================================================
                             MESSAGES
                        ================================================= -->

                        <div class="messages"
                             id="messagesContainer">


                            @if (messages.Any())
                            {

                                foreach (var message in messages
                                    .OrderBy(x => x.SentDate))
                                {

                                    bool isSent =
                                        message.SenderId ==
                                        currentUserId;


                                    <div class="message-wrapper
                                                @(isSent
                                                    ? "sent"
                                                    : "received")">


                                        <div class="message
                                                    @(isSent
                                                        ? "sent"
                                                        : "received")">


                                            @if (message.IsDeleted)
                                            {

                                                <span class="deleted-message">

                                                    <i class="bi bi-trash me-1"></i>

                                                    This message was deleted.

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="message-text">

                                                    @message.Message

                                                </span>


                                                @if (isSent)
                                                {

                                                    <form asp-controller="Shopkeeper"
                                                          asp-action="DeleteMessage"
                                                          method="post"
                                                          class="delete-form">

                                                        @Html.AntiForgeryToken()


                                                        <input type="hidden"
                                                               name="messageId"
                                                               value="@message.ChatMessageId" />


                                                        <input type="hidden"
                                                               name="receiverId"
                                                               value="@message.ReceiverId" />


                                                        <button type="submit"
                                                                class="delete-message-btn"
                                                                title="Delete message"
                                                                onclick="return confirm('Delete this message?');">

                                                            <i class="bi bi-trash"></i>

                                                        </button>

                                                    </form>

                                                }

                                            }

                                        </div>

                                    </div>

                                }

                            }
                            else
                            {

                                <div class="empty-chat">

                                    <div>

                                        <i class="bi bi-chat-square-text"></i>

                                        <h5 class="mt-3">

                                            No Messages Yet

                                        </h5>

                                        <p>

                                            Start the conversation by
                                            sending a message.

                                        </p>

                                    </div>

                                </div>

                            }

                        </div>


                        <!-- =================================================
                             MESSAGE INPUT
                        ================================================= -->

                        <div class="message-input">

                            <form asp-controller="Shopkeeper"
                                  asp-action="SendMessage"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <input type="hidden"
                                       name="receiverId"
                                       value="@selectedUserId.Value" />


                                <textarea name="message"
                                          class="form-control flex-grow-1"
                                          rows="2"
                                          maxlength="2000"
                                          placeholder="Type your message..."
                                          required></textarea>


                                <button type="submit"
                                        class="send-btn">

                                    <i class="bi bi-send"></i>

                                    Send

                                </button>

                            </form>

                        </div>

                    }
                    else
                    {


                        <!-- =================================================
                             NO CONVERSATION
                        ================================================= -->

                        <div class="empty-chat">

                            <div>

                                <i class="bi bi-chat-dots"></i>

                                <h4 class="mt-3">

                                    Welcome to Chat

                                </h4>

                                <p>

                                    Select a customer, administrator,
                                    or delivery boy to start chatting.

                                </p>

                            </div>

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         AUTO SCROLL
    ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const container =
                document.getElementById("messagesContainer");

            if (container) {

                container.scrollTop =
                    container.scrollHeight;

            }

        });

    </script>


</body>

</html>

