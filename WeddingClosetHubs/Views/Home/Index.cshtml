@{
    ViewData["Title"] = "Wedding Closet Hubs";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Wedding Closet Hubs | Wedding Fashion Marketplace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        :root {
            --maroon: #800020;
            --deep-maroon: #260009;
            --dark-maroon: #42000f;
            --gold: #d4af37;
            --light-gold: #f5e7a8;
            --cream: #fffaf5;
            --soft: #f8f3ef;
            --white: #ffffff;
            --dark: #24191b;
            --muted: #76696b;
            --border: rgba(128, 0, 32, .10);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--cream);
            color: var(--dark);
            font-family: "Segoe UI", Arial, sans-serif;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

    

        .navbar-custom {
            background: rgba(38, 0, 9, .96);
            backdrop-filter: blur(15px);
            padding: 14px 0;
            box-shadow: 0 8px 30px rgba(0,0,0,.15);
            z-index: 9999;
        }

        .brand {
            color: white !important;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 25px;
            font-weight: 700;
            letter-spacing: .2px;
        }

        .brand span {
            color: var(--gold);
        }

        .navbar-custom .nav-link {
            color: rgba(255,255,255,.88) !important;
            font-size: 14px;
            font-weight: 600;
            margin: 0 5px;
            padding: 9px 10px !important;
            transition: .25s;
        }

        .navbar-custom .nav-link:hover {
            color: var(--gold) !important;
        }

        .btn-login {
            color: white;
            border: 1px solid rgba(212,175,55,.7);
            border-radius: 50px;
            padding: 8px 19px;
            font-weight: 700;
            transition: .3s;
        }

        .btn-login:hover {
            background: var(--gold);
            color: var(--maroon);
        }

        .btn-gold {
            background: var(--gold);
            color: var(--maroon);
            border: 2px solid var(--gold);
            border-radius: 50px;
            padding: 11px 24px;
            font-weight: 800;
            transition: .3s;
            box-shadow: 0 8px 22px rgba(212,175,55,.18);
        }

        .btn-gold:hover {
            background: white;
            border-color: white;
            color: var(--maroon);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(0,0,0,.18);
        }

        .btn-outline-light-custom {
            color: white;
            border: 1px solid rgba(255,255,255,.55);
            border-radius: 50px;
            padding: 11px 24px;
            font-weight: 700;
            transition: .3s;
        }

        .btn-outline-light-custom:hover {
            background: white;
            color: var(--maroon);
        }

     
        .hero {
            min-height: 91vh;
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;

            background:
                linear-gradient(
                    90deg,
                    rgba(27,0,7,.97) 0%,
                    rgba(54,0,15,.90) 35%,
                    rgba(67,0,18,.57) 65%,
                    rgba(67,0,18,.18) 100%
                ),
                url("/images/landing/hero-1.jpg");

            background-size: cover;
            background-position: center;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 620px;
            height: 620px;
            right: -230px;
            top: -240px;
            border: 1px solid rgba(212,175,55,.28);
            border-radius: 50%;
            box-shadow:
                0 0 0 55px rgba(212,175,55,.035),
                0 0 0 110px rgba(212,175,55,.025);
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            left: -180px;
            bottom: -200px;
            border: 1px solid rgba(212,175,55,.18);
            border-radius: 50%;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 720px;
            color: white;
            padding: 80px 0;
        }

        .hero-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 9px 17px;
            border: 1px solid rgba(212,175,55,.6);
            border-radius: 50px;
            color: var(--light-gold);
            background: rgba(0,0,0,.18);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 24px;
        }

        .hero-label i {
            color: var(--gold);
        }

        .hero h1 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(52px, 7vw, 88px);
            line-height: 1;
            font-weight: 700;
            margin-bottom: 25px;
            letter-spacing: -2px;
        }

        .hero h1 span {
            color: var(--gold);
            font-style: italic;
            display: block;
        }

        .hero-text {
            max-width: 650px;
            color: #f3e9eb;
            font-size: 17px;
            line-height: 1.85;
            margin-bottom: 32px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;
        }

        .hero-card {
            position: absolute;
            right: 7%;
            bottom: 12%;
            z-index: 3;
            width: 300px;
            padding: 26px;
            border-radius: 24px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.25);
            backdrop-filter: blur(18px);
            color: white;
            box-shadow: 0 20px 50px rgba(0,0,0,.16);
        }

        .hero-card-icon {
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: var(--gold);
            color: var(--maroon);
            font-size: 22px;
            margin-bottom: 17px;
        }

        .hero-card h5 {
            font-weight: 800;
            margin-bottom: 9px;
        }

        .hero-card p {
            color: #eee;
            font-size: 13px;
            line-height: 1.7;
            margin: 0;
        }

   

        .quick-section {
            margin-top: -45px;
            position: relative;
            z-index: 10;
        }

        .quick-box {
            background: white;
            border-radius: 24px;
            padding: 27px;
            box-shadow: 0 22px 65px rgba(60,0,15,.13);
            border: 1px solid var(--border);
        }

        .quick-item {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .quick-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: rgba(212,175,55,.14);
            color: var(--maroon);
            font-size: 22px;
        }

        .quick-item strong {
            display: block;
            color: var(--maroon);
            font-size: 14px;
        }

        .quick-item span {
            display: block;
            color: var(--muted);
            font-size: 12px;
            margin-top: 4px;
        }

        /* =========================
           GENERAL
        ========================= */

        .section {
            padding: 105px 0;
        }

        .section-soft {
            background: var(--soft);
        }

        .section-white {
            background: white;
        }

        .section-heading {
            text-align: center;
            max-width: 740px;
            margin: 0 auto 55px;
        }

        .section-heading small {
            display: block;
            color: var(--maroon);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .section-heading h2 {
            color: var(--maroon);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(36px, 4vw, 50px);
            margin-bottom: 15px;
            font-weight: 700;
        }

        .section-heading p {
            color: var(--muted);
            line-height: 1.85;
            margin: 0;
        }

        /* =========================
           CATEGORY CARDS
        ========================= */

        .category-card {
            height: 360px;
            position: relative;
            overflow: hidden;
            border-radius: 24px;
            background: #ddd;
            box-shadow: 0 14px 40px rgba(55,0,15,.10);
            transition: .4s;
        }

        .category-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 55px rgba(55,0,15,.18);
        }

        .category-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .7s;
        }

        .category-card:hover img {
            transform: scale(1.08);
        }

        .category-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(
                    to top,
                    rgba(25,0,7,.97),
                    rgba(25,0,7,.60) 42%,
                    rgba(25,0,7,.05) 82%
                );
        }

        .category-content {
            position: absolute;
            z-index: 2;
            left: 24px;
            right: 24px;
            bottom: 23px;
            color: white;
        }

        .category-number {
            color: var(--light-gold);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .category-content h4 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 25px;
            margin: 8px 0 7px;
        }

        .category-content p {
            color: #eee;
            font-size: 12px;
            line-height: 1.6;
            margin: 0;
            padding-right: 45px;
        }

        .category-arrow {
            position: absolute;
            right: 0;
            bottom: 1px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(212,175,55,.75);
            border-radius: 50%;
            color: var(--gold);
            transition: .3s;
        }

        .category-card:hover .category-arrow {
            background: var(--gold);
            color: var(--maroon);
        }

 

        .service-card {
            height: 100%;
            padding: 36px;
            border-radius: 24px;
            background: white;
            border: 1px solid var(--border);
            box-shadow: 0 10px 35px rgba(60,0,15,.06);
            transition: .35s;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 22px 48px rgba(60,0,15,.12);
            border-color: rgba(212,175,55,.35);
        }

        .service-icon {
            width: 62px;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: rgba(212,175,55,.14);
            color: var(--maroon);
            font-size: 26px;
            margin-bottom: 22px;
        }

        .service-card h4 {
            color: var(--maroon);
            font-weight: 800;
            margin-bottom: 11px;
        }

        .service-card p {
            color: var(--muted);
            line-height: 1.8;
            margin: 0;
        }

    

        .option-card {
            min-height: 300px;
            position: relative;
            overflow: hidden;
            padding: 37px;
            border-radius: 25px;
            background: linear-gradient(145deg, #800020, #590014);
            color: white;
            transition: .4s;
            box-shadow: 0 12px 35px rgba(50,0,15,.10);
        }

        .option-card.rent {
            background: linear-gradient(145deg, #680018, #4a000f);
        }

        .option-card.customize {
            background: linear-gradient(145deg, #500012, #300008);
        }

        .option-card:hover {
            transform: translateY(-9px);
            box-shadow: 0 25px 55px rgba(50,0,15,.23);
        }

        .option-card::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -105px;
            top: -105px;
            border: 1px solid rgba(212,175,55,.28);
            border-radius: 50%;
        }

        .option-card::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            right: -55px;
            top: -55px;
            border: 1px solid rgba(212,175,55,.16);
            border-radius: 50%;
        }

        .option-icon {
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: rgba(212,175,55,.14);
            color: var(--gold);
            font-size: 25px;
            margin-bottom: 22px;
        }

        .option-card h4 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 30px;
            margin-bottom: 12px;
        }

        .option-card p {
            color: #eee;
            line-height: 1.75;
            margin-bottom: 23px;
            max-width: 340px;
        }

        .option-link {
            color: var(--gold);
            font-weight: 800;
        }

       

        .stats-section {
            background:
                radial-gradient(circle at top right,
                    rgba(212,175,55,.12),
                    transparent 35%),
                linear-gradient(135deg,
                    var(--deep-maroon),
                    var(--maroon));
            color: white;
        }

        .stat {
            text-align: center;
            padding: 15px;
        }

        .stat i {
            display: block;
            color: var(--gold);
            font-size: 30px;
            margin-bottom: 13px;
        }

        .stat h3 {
            font-size: 29px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .stat p {
            color: #e8dcdf;
            margin: 0;
            font-size: 12px;
        }

        

        .step {
            position: relative;
            text-align: center;
            padding: 10px;
        }

        .step-number {
            width: 68px;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 19px;
            border-radius: 50%;
            background: var(--maroon);
            border: 3px solid var(--gold);
            color: var(--gold);
            font-size: 21px;
            font-weight: 800;
            box-shadow: 0 10px 25px rgba(128,0,32,.12);
        }

        .step h5 {
            color: var(--maroon);
            font-weight: 800;
            margin-bottom: 9px;
        }

        .step p {
            color: var(--muted);
            line-height: 1.75;
            font-size: 13px;
        }

        .step-line {
            position: absolute;
            top: 43px;
            left: calc(50% + 50px);
            width: calc(100% - 100px);
            height: 1px;
            background: rgba(212,175,55,.45);
        }

        /* =========================
           CTA
        ========================= */

        .cta {
            position: relative;
            overflow: hidden;
            padding: 105px 0;
            text-align: center;
            color: white;

            background:
                linear-gradient(
                    rgba(67,0,18,.94),
                    rgba(67,0,18,.94)
                ),
                url("/images/landing/hero-3.jpg");

            background-size: cover;
            background-position: center;
        }

        .cta::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border: 1px solid rgba(212,175,55,.18);
            border-radius: 50%;
            left: -220px;
            top: -150px;
        }

        .cta-content {
            position: relative;
            z-index: 2;
            max-width: 780px;
            margin: auto;
        }

        .cta small {
            color: var(--gold);
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .cta h2 {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(38px, 5vw, 56px);
            margin: 14px 0 18px;
        }

        .cta p {
            color: #f0e5e7;
            line-height: 1.85;
            margin-bottom: 30px;
        }

       

        footer {
            background: var(--deep-maroon);
            color: #ddd;
            padding: 70px 0 25px;
        }

        .footer-brand {
            color: white;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 28px;
            font-weight: 700;
        }

        .footer-brand span {
            color: var(--gold);
        }

        footer h5 {
            color: var(--gold);
            font-weight: 800;
            margin-bottom: 18px;
        }

        footer p {
            color: #cfc4c6;
            line-height: 1.75;
            font-size: 13px;
        }

        footer a {
            display: block;
            color: #ddd;
            margin-bottom: 10px;
            font-size: 13px;
            transition: .25s;
        }

        footer a:hover {
            color: var(--gold);
            transform: translateX(3px);
        }

        .copyright {
            border-top: 1px solid rgba(255,255,255,.10);
            margin-top: 42px;
            padding-top: 22px;
            text-align: center;
            color: #aaa;
            font-size: 12px;
        }

      

        @@media (max-width: 991px) {

            .hero {
                min-height: 82vh;
            }

            .hero-card {
                display: none;
            }

            .step-line {
                display: none;
            }

            .quick-section {
                margin-top: -28px;
            }
        }

        @@media (max-width: 767px) {

            .section {
                padding: 78px 0;
            }

            .hero {
                min-height: 88vh;
                background-position: 62% center;
            }

            .hero-content {
                padding: 55px 0;
            }

            .hero h1 {
                font-size: 49px;
                letter-spacing: -1px;
            }

            .hero-text {
                font-size: 15px;
                line-height: 1.75;
            }

            .hero-buttons {
                display: flex;
                flex-direction: column;
            }

            .hero-buttons .btn {
                width: 100%;
            }

            .category-card {
                height: 330px;
            }

            .quick-item {
                margin-bottom: 7px;
            }

            .quick-box {
                padding: 22px;
            }
        }

        @@media (max-width: 575px) {

            .brand {
                font-size: 21px;
            }

            .hero {
                min-height: 91vh;
            }

            .hero h1 {
                font-size: 43px;
            }

            .hero-label {
                font-size: 9px;
                letter-spacing: 1.5px;
            }

            .section-heading h2 {
                font-size: 35px;
            }

            .category-card {
                height: 310px;
            }

            .option-card {
                min-height: 275px;
                padding: 30px 25px;
            }

            .cta {
                padding: 78px 20px;
            }
        }

    </style>

</head>

<body>



    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">

        <div class="container">

            <a class="navbar-brand brand"
               asp-controller="Home"
               asp-action="Index">

                Wedding <span>Closet</span> Hubs

            </a>

            <button class="navbar-toggler bg-light"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Shops">
                            Shops
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           href="#categories">
                            Categories
                        </a>
                    </li>

                    
                    <li class="nav-item">
                        <a class="nav-link"
                           href="#how-it-works">
                            How It Works
                        </a>
                    </li>

                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">

                        <a class="btn btn-login"
                           asp-controller="Account"
                           asp-action="Login">

                            <i class="bi bi-person me-1"></i>
                            Login

                        </a>

                    </li>

                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">

                        <a class="btn btn-gold"
                           asp-controller="Account"
                           asp-action="Register">

                            Register

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>




    <section class="hero">

        <div class="container">

            <div class="hero-content">

                <div class="hero-label">

                    <i class="bi bi-stars"></i>

                    WEDDING FASHION MARKETPLACE

                </div>

                <h1>
                    Your Wedding.
                    <span>Your Style.</span>
                </h1>

                <p class="hero-text">

                    Discover beautiful bridal wear, groom wear,
                    formal outfits, jewellery, footwear and
                    accessories from multiple wedding shops —
                    all in one elegant marketplace.

                </p>

                <div class="hero-buttons">

                    <a asp-controller="Customer"
                       asp-action="Shops"
                       class="btn btn-gold">

                        <i class="bi bi-shop me-2"></i>
                        Explore Shops

                    </a>

                    <a href="#categories"
                       class="btn btn-outline-light-custom">

                        Discover Categories
                        <i class="bi bi-arrow-down ms-2"></i>

                    </a>

                </div>

            </div>

        </div>

        <div class="hero-card">

            <div class="hero-card-icon">
                <i class="bi bi-heart-fill"></i>
            </div>

            <h5>
                Everything in One Place
            </h5>

            <p>
                Discover products from different wedding shops,
                compare your options and create the perfect
                look for your special day.
            </p>

        </div>

    </section>


  

    <section class="quick-section">

        <div class="container">

            <div class="quick-box">

                <div class="row g-4">

                    <div class="col-md-4">

                        <div class="quick-item">

                            <div class="quick-icon">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>
                                <strong>Multiple Wedding Shops</strong>
                                <span>Discover different collections</span>
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="quick-item">

                            <div class="quick-icon">
                                <i class="bi bi-bag-heart"></i>
                            </div>

                            <div>
                                <strong>Buy or Rent</strong>
                                <span>Choose what suits your occasion</span>
                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="quick-item">

                            <div class="quick-icon">
                                <i class="bi bi-rulers"></i>
                            </div>

                            <div>
                                <strong>Customization</strong>
                                <span>Customize selected wedding wear</span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


   

    <section class="section section-white" id="categories">

        <div class="container">

