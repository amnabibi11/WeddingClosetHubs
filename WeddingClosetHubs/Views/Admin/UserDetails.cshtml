@model WeddingClosetHubs.Models.User

@{
    ViewData["Title"] = "User Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>User Details - Wedding Closet Hubs</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f6fa;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-container {
            padding: 30px;
        }

        /* HEADER */

        .page-header {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .page-title {
            margin: 0;
            font-weight: 700;
            color: #343a40;
        }

        .page-subtitle {
            color: #777;
            margin-top: 7px;
            margin-bottom: 0;
        }

        /* CARD */

        .custom-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 25px;
            border: none;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .custom-card-header {
            padding: 17px 22px;
            font-size: 18px;
            font-weight: 700;
        }

        .header-primary {
            background: #0d6efd;
            color: white;
        }

        .header-dark {
            background: #212529;
            color: white;
        }

        .header-success {
            background: #198754;
            color: white;
        }

        .custom-card-body {
            padding: 25px;
        }

        /* INFORMATION */

        .info-group {
            margin-bottom: 20px;
        }

        .info-label {
            display: block;
            font-weight: 600;
            color: #555;
            margin-bottom: 7px;
            font-size: 14px;
        }

        .info-value {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 8px;
            padding: 12px 15px;
            min-height: 46px;
            display: flex;
            align-items: center;
        }

        /* PROFILE */

        .profile-section {
            text-align: center;
            padding: 10px 0 25px;
        }

        .profile-icon {
            width: 100px;
            height: 100px;
            margin: auto;
            border-radius: 50%;
            background: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            color: #6c757d;
        }

        .profile-name {
            margin-top: 15px;
            margin-bottom: 10px;
            font-weight: 700;
        }

        /* ROLE */

        .role-badge {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        /* STATUS */

        .status-badge {
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        /* ACTIONS */

        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .action-buttons .btn {
            padding: 10px 18px;
            border-radius: 7px;
        }

        .btn i {
            margin-right: 5px;
        }

        /* RESPONSIVE */

        @@media (max-width: 768px) {

            .page-container {
                padding: 15px;
            }

            .page-header {
                padding: 18px;
            }

            .custom-card-body {
                padding: 18px;
            }

            .page-title {
                font-size: 23px;
            }

        }

    </style>

</head>


<body>

<div class="page-container">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="page-header">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h2 class="page-title">

                    <i class="bi bi-person-vcard"></i>

                    User Details

                </h2>

                <p class="page-subtitle">

                    View user information and manage account status.

                </p>

            </div>


            <div class="col-md-4 text-md-end">

                <a asp-controller="Admin"
                   asp-action="UserAccounts"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back to User Accounts

                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PROFILE
    ====================================================== -->

    <div class="custom-card">

        <div class="custom-card-header header-primary">

            <i class="bi bi-person-circle"></i>

            User Profile

        </div>


        <div class="custom-card-body">

            <div class="profile-section">

                <div class="profile-icon">

                    <i class="bi bi-person-fill"></i>

                </div>


                <h3 class="profile-name">

                    @(string.IsNullOrEmpty(Model.Name)
                        ? "N/A"
                        : Model.Name)

                </h3>


                <!-- ROLE -->

                <div>

                    <span class="role-badge bg-primary text-white">

                        <i class="bi bi-person-badge"></i>

                        @(Model.Role?.RoleName ?? "N/A")

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PERSONAL INFORMATION
    ====================================================== -->

    <div class="custom-card">

        <div class="custom-card-header header-dark">

            <i class="bi bi-person"></i>

            Personal Information

        </div>


        <div class="custom-card-body">

            <div class="row">


                <!-- USER ID -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            User ID

                        </label>

                        <div class="info-value">

                            @Model.UserId

                        </div>

                    </div>

                </div>


                <!-- NAME -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Full Name

                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Name)
                                ? "N/A"
                                : Model.Name)

                        </div>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Email

                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Email)
                                ? "N/A"
                                : Model.Email)

                        </div>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Phone Number

                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Phone)
                                ? "N/A"
                                : Model.Phone)

                        </div>

                    </div>

                </div>


                <!-- ADDRESS -->

                <div class="col-md-12">

                    <div class="info-group">

                        <label class="info-label">

                            Address

                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.Address)
                                ? "N/A"
                                : Model.Address)

                        </div>

                    </div>

                </div>


                <!-- ROLE -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            User Role

                        </label>

                        <div class="info-value">

                            <span class="role-badge bg-primary text-white">

                                @(Model.Role?.RoleName ?? "N/A")

                            </span>

                        </div>

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Account Status

                        </label>

                        <div class="info-value">

                            @if (Model.Status)
                            {

                                <span class="status-badge bg-success text-white">

                                    <i class="bi bi-check-circle"></i>

                                    Active

                                </span>

                            }
                            else
                            {

                                <span class="status-badge bg-danger text-white">

                                    <i class="bi bi-x-circle"></i>

                                    Disabled

                                </span>

                            }

                        </div>

                    </div>

                </div>


                <!-- APPROVAL STATUS -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Approval Status

                        </label>

                        <div class="info-value">

                            @if (Model.IsApproved)
                            {

                                <span class="status-badge bg-success text-white">

                                    <i class="bi bi-check-circle"></i>

                                    Approved

                                </span>

                            }
                            else
                            {

                                <span class="status-badge bg-warning text-dark">

                                    <i class="bi bi-clock"></i>

                                    Pending Approval

                                </span>

                            }

                        </div>

                    </div>

                </div>


                <!-- CREATED DATE -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Registration Date

                        </label>

                        <div class="info-value">

                            @Model.CreatedDate.ToString("dd MMMM yyyy")

                        </div>

                    </div>

                </div>


                <!-- APPROVED DATE -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">

                            Approved Date

                        </label>

                        <div class="info-value">

                            @(Model.ApprovedDate.HasValue
                                ? Model.ApprovedDate.Value.ToString("dd MMMM yyyy")
                                : "Not Approved")

                        </div>

                    </div>

                </div>


            </div>

        </div>

    </div>


    <!-- =====================================================
         ACCOUNT MANAGEMENT
    ====================================================== -->

    <div class="custom-card">

        <div class="custom-card-header header-success">

            <i class="bi bi-gear"></i>

            Account Management

        </div>


        <div class="custom-card-body">

            <div class="action-buttons">


                <!-- BACK -->

                <a asp-controller="Admin"
                   asp-action="UserAccounts"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>


                <!-- DISABLE -->

                @if (Model.Status)
                {

                    <form asp-controller="Admin"
                          asp-action="DisableUser"
                          asp-route-id="@Model.UserId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger"
                                onclick="return confirm('Are you sure you want to disable this user account?');">

                            <i class="bi bi-person-x"></i>

                            Disable Account

                        </button>

                    </form>

                }


                <!-- ENABLE -->

                @if (!Model.Status)
                {

                    <form asp-controller="Admin"
                          asp-action="EnableUser"
                          asp-route-id="@Model.UserId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-success">

                            <i class="bi bi-person-check"></i>

                            Enable Account

                        </button>

                    </form>

                }


            </div>

        </div>

    </div>


</div>


<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>