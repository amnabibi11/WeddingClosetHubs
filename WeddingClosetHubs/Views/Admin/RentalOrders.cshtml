@model IEnumerable<WeddingClosetHubs.Models.OrderDetail>

@{
ViewData["Title"] = "Rental Orders";
Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


<title>Rental Orders - Wedding Closet Hubs</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
    :root {
        --maroon: #800020;
        --gold: #d4af37;
        --light-gold: #f8f1d8;
        --light-maroon: #f9eef1;
        --dark: #292929;
    }

    body {
        background: #f7f7f7;
        font-family: Arial, sans-serif;
        color: var(--dark);
    }

    .navbar {
        background: var(--maroon);
        min-height: 70px;
    }

    .navbar-brand {
        color: var(--gold) !important;
        font-weight: 700;
        font-size: 22px;
    }

    .page-wrapper {
        padding: 30px;
    }

    .page-title {
        color: var(--maroon);
        font-weight: 700;
    }

    .page-subtitle {
        color: #777;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        border-left: 5px solid var(--gold);
        box-shadow: 0 4px 15px rgba(0,0,0,.07);
        height: 100%;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--light-maroon);
        color: var(--maroon);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .summary-number {
        font-size: 25px;
        font-weight: 700;
        color: var(--maroon);
    }

    .summary-label {
        color: #777;
        font-size: 14px;
    }

    .rental-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
        margin-bottom: 25px;
        overflow: hidden;
        border: 1px solid #eee;
    }

    .rental-header {
        background: var(--maroon);
        color: white;
        padding: 18px 22px;
    }

    .rental-header h5 {
        margin: 0;
        font-weight: 700;
    }

    .order-number {
        color: var(--gold);
        font-weight: 700;
    }

    .rental-body {
        padding: 22px;
    }

    .product-image {
        width: 110px;
        height: 130px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #ddd;
        background: #f5f5f5;
    }

    .product-placeholder {
        width: 110px;
        height: 130px;
        border-radius: 10px;
        background: var(--light-maroon);
        color: var(--maroon);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
    }

    .info-title {
        color: var(--maroon);
        font-weight: 700;
        margin-bottom: 10px;
        font-size: 15px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
        border-bottom: 1px solid #eee;
        font-size: 14px;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: #777;
    }

    .info-value {
        font-weight: 600;
        text-align: right;
    }

    .security-box {
        background: var(--light-gold);
        border: 1px solid #eadca7;
        border-radius: 12px;
        padding: 16px;
    }

    .security-amount {
        color: var(--maroon);
        font-size: 23px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .status-awaiting {
        background: #fff3cd;
        color: #856404;
    }

    .status-returned {
        background: #cfe2ff;
        color: #084298;
    }

    .status-inspected {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-refunded {
        background: #d1e7dd;
        color: #0f5132;
    }

    .status-not-required {
        background: #e9ecef;
        color: #495057;
    }

    .action-box {
        background: #fafafa;
        border-radius: 12px;
        padding: 18px;
        border: 1px solid #eee;
    }

    .action-box h6 {
        color: var(--maroon);
        font-weight: 700;
    }

    .btn-maroon {
        background: var(--maroon);
        color: white;
        border: none;
    }

    .btn-maroon:hover {
        background: #650019;
        color: white;
    }

    .btn-gold {
        background: var(--gold);
        color: #222;
        border: none;
        font-weight: 600;
    }

    .btn-gold:hover {
        background: #bd9828;
        color: #222;
    }

    .refund-completed {
        background: #e8f5e9;
        border: 1px solid #b7dfba;
        border-radius: 12px;
        padding: 16px;
    }

    .refund-completed h6 {
        color: #198754;
        font-weight: 700;
    }

    .inspection-result {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .inspection-passed {
        background: #d1e7dd;
        color: #0f5132;
    }

    .inspection-damaged {
        background: #f8d7da;
        color: #842029;
    }

    .empty-box {
        background: white;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,.06);
    }

    .empty-box i {
        font-size: 55px;
        color: var(--gold);
    }

    .alert {
        border-radius: 10px;
    }

    .form-label {
        font-weight: 600;
        color: #555;
        font-size: 13px;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--gold);
        box-shadow: 0 0 0 .15rem rgba(212,175,55,.15);
    }

    .back-btn {
        color: var(--maroon);
        border: 1px solid var(--maroon);
        background: white;
        font-weight: 600;
    }

    .back-btn:hover {
        background: var(--maroon);
        color: white;
    }

    .refund-warning {
        background: #fff3cd;
        border: 1px solid #ffe69c;
        color: #664d03;
        border-radius: 10px;
        padding: 12px 15px;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .page-wrapper {
            padding: 15px;
        }

        .product-image,
        .product-placeholder {
            width: 85px;
            height: 105px;
        }

        .info-row {
            flex-direction: column;
            gap: 3px;
        }

        .info-value {
            text-align: left;
        }
    }
</style>


</head>

<body>


<nav class="navbar navbar-dark">
    <div class="container-fluid px-4">
        <a class="navbar-brand" href="@Url.Action("Dashboard", "Admin")">
            <i class="bi bi-gem me-2"></i>
            Wedding Closet Hubs
        </a>

        <a href="@Url.Action("Dashboard", "Admin")" class="btn back-btn">
            <i class="bi bi-arrow-left me-1"></i>
            Dashboard
        </a>
    </div>
</nav>

<div class="page-wrapper">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-2">
        <div>
            <h2 class="page-title mb-1">
                <i class="bi bi-arrow-repeat me-2"></i>
                Rental Orders
            </h2>

            <div class="page-subtitle">
                Manage rented dresses, returns, inspections and refundable security.
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @{
        var rentalList = Model?.ToList()
            ?? new List<WeddingClosetHubs.Models.OrderDetail>();

        var totalRentals = rentalList.Count;

        var awaitingReturn = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Awaiting Return",
                StringComparison.OrdinalIgnoreCase));

        var returned = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Returned",
                StringComparison.OrdinalIgnoreCase));

        var inspected = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Inspected",
                StringComparison.OrdinalIgnoreCase));

        var refunded = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Refunded",
                StringComparison.OrdinalIgnoreCase));

        var totalSecurity = rentalList.Sum(x =>
            x.RentalSecurity * x.Quantity);

        var pendingSecurity = rentalList
            .Where(x => !x.SecurityRefunded)
            .Sum(x => x.RentalSecurity * x.Quantity);
    }

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="summary-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="summary-number">
                            @totalRentals
                        </div>

                        <div class="summary-label">
                            Total Rentals
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-bag-heart"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="summary-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="summary-number">
                            @awaitingReturn
                        </div>

                        <div class="summary-label">
                            Awaiting Return
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="summary-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="summary-number">
                            @inspected
                        </div>

                        <div class="summary-label">
                            Ready for Refund
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-search"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="summary-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="summary-number">
                            Rs. @pendingSecurity.ToString("N0")
                        </div>

                        <div class="summary-label">
                            Pending Security
                        </div>
                    </div>

                    <div class="summary-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (!rentalList.Any())
    {
        <div class="empty-box">

            <i class="bi bi-bag-x"></i>

            <h4 class="mt-3" style="color: var(--maroon);">
                No Rental Orders
            </h4>

            <p class="text-muted mb-0">
                There are currently no rental orders in the system.
            </p>

        </div>
    }
    else
    {
        foreach (var item in rentalList)
        {
            var order = item.Order;
            var product = item.Product;

            var securityAmount =
                item.RentalSecurity * item.Quantity;

            var status =
                string.IsNullOrWhiteSpace(item.RentalReturnStatus)
                    ? "Awaiting Return"
                    : item.RentalReturnStatus;

            var statusClass = status switch
            {
                "Awaiting Return" => "status-awaiting",
                "Returned" => "status-returned",
                "Inspected" => "status-inspected",
                "Refunded" => "status-refunded",
                _ => "status-not-required"
            };

            var inspectionResult =
                item.InspectionResult ?? "";

            var inspectionClass =
                string.Equals(
                    inspectionResult,
                    "Passed",
                    StringComparison.OrdinalIgnoreCase)
                        ? "inspection-passed"
                        : "inspection-damaged";

            <div class="rental-card">

                <div class="rental-header">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>
                            <h5>
                                Order
                                <span class="order-number">
                                    #@order?.OrderId
                                </span>
                            </h5>

                            <small>
                                @order?.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")
                            </small>
                        </div>

                        <div>
                            <span class="status-badge @statusClass">
                                @status
                            </span>
                        </div>

                    </div>

                </div>

                <div class="rental-body">

                    <div class="row g-4">

                        <div class="col-lg-5">

                            <div class="info-title">
                                <i class="bi bi-bag-heart me-1"></i>
                                Rental Product
                            </div>

                            <div class="d-flex gap-3">

                                @if (product != null &&
                                    !string.IsNullOrWhiteSpace(product.Image))
                                {
                                    <img src="@product.Image"
                                         alt="@product.ProductName"
                                         class="product-image" />
                                }
                                else
                                {
                                    <div class="product-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                                <div class="flex-grow-1">

                                    <h5 class="mb-2"
                                        style="color: var(--maroon);">
                                        @product?.ProductName
                                    </h5>

                                    @if (!string.IsNullOrWhiteSpace(product?.Category))
                                    {
                                        <div class="small text-muted mb-1">
                                            <strong>Category:</strong>
                                            @product.Category
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(product?.Subcategory))
                                    {
                                        <div class="small text-muted mb-1">
                                            <strong>Subcategory:</strong>
                                            @product.Subcategory
                                        </div>
                                    }

                                    <div class="small text-muted mb-1">
                                        <strong>Quantity:</strong>
                                        @item.Quantity
                                    </div>

                                    <div class="small text-muted">
                                        <strong>Rental Price:</strong>
                                        Rs. @item.UnitPrice.ToString("N0")
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-lg-3">

                            <div class="info-title">
                                <i class="bi bi-person me-1"></i>
                                Customer
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    Name
                                </span>

                                <span class="info-value">
                                    @order?.Customer?.Name
                                </span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    Phone
                                </span>

                                <span class="info-value">
                                    @order?.Customer?.Phone
                                </span>
                            </div>

                            <div class="info-row">
                                <span class="info-label">
                                    Shop
                                </span>

                                <span class="info-value">
                                    @order?.Shop?.ShopName
                                </span>
                            </div>

                        </div>

                        <div class="col-lg-4">

                            <div class="security-box">

                                <div class="info-title mb-2">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Refundable Security
                                </div>

                                <div class="security-amount">
                                    Rs. @securityAmount.ToString("N0")
                                </div>

                                <div class="small text-muted mt-1">
                                    Rs. @item.RentalSecurity.ToString("N0")
                                    × @item.Quantity
                                </div>

                                <hr />

                                <div class="info-row">
                                    <span class="info-label">
                                        Duration
                                    </span>

                                    <span class="info-value">
                                        @(string.IsNullOrWhiteSpace(item.RentalDuration)
                                            ? "Not specified"
                                            : item.RentalDuration)
                                    </span>
                                </div>

                                <div class="info-row">
                                    <span class="info-label">
                                        Return Status
                                    </span>

                                    <span class="info-value">
                                        @status
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(inspectionResult))
                                {
                                    <div class="info-row">
                                        <span class="info-label">
                                            Inspection
                                        </span>

                                        <span class="info-value">
                                            <span class="inspection-result @inspectionClass">
                                                @inspectionResult
                                            </span>
                                        </span>
                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

                    @if (string.Equals(
                        status,
                        "Awaiting Return",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="action-box">

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                <div>
                                    <h6 class="mb-1">
                                        <i class="bi bi-box-arrow-in-down me-1"></i>
                                        Rental Return
                                    </h6>

                                    <div class="small text-muted">
                                        The rented dress must be returned before it can be inspected.
                                    </div>
                                </div>

                                <form asp-controller="Admin"
                                      asp-action="MarkRentalReturned"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.OrderDetailId" />

                                    <button type="submit"
                                            class="btn btn-maroon"
                                            onclick="return confirm('Confirm that this rented dress has been returned?');">

                                        <i class="bi bi-check2-circle me-1"></i>
                                        Mark Returned

                                    </button>

                                </form>

                            </div>

                        </div>
                    }
                    else if (string.Equals(
                        status,
                        "Returned",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="action-box">

                            <h6>
                                <i class="bi bi-search me-1"></i>
                                Inspect Returned Dress
                            </h6>

                            <div class="small text-muted mb-3">
                                Returned on:
                                @(item.DressReturnedDate?.ToString("dd MMM yyyy, hh:mm tt")
                                    ?? "Not recorded")
                            </div>

                            <form asp-controller="Admin"
                                  asp-action="InspectRental"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.OrderDetailId" />

                                <div class="row g-3">

                                    <div class="col-md-4">

                                        <label class="form-label">
                                            Inspection Result
                                        </label>

                                        <select name="inspectionResult"
                                                class="form-select"
                                                required>

                                            <option value="">
                                                Select Result
                                            </option>

                                            <option value="Passed">
                                                Passed - No Damage
                                            </option>

                                            <option value="Damaged">
                                                Damaged
                                            </option>

                                        </select>

                                    </div>

                                    <div class="col-md-5">

                                        <label class="form-label">
                                            Inspection Notes
                                        </label>

                                        <textarea name="adminNotes"
                                                  class="form-control"
                                                  rows="2"
                                                  placeholder="Enter inspection details..."></textarea>

                                    </div>

                                    <div class="col-md-3 d-flex align-items-end">

                                        <button type="submit"
                                                class="btn btn-maroon w-100">

                                            <i class="bi bi-clipboard-check me-1"></i>
                                            Record Inspection

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>
                    }
                    else if (string.Equals(
                        status,
                        "Inspected",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="action-box">

                            <h6>
                                <i class="bi bi-wallet2 me-1"></i>
                                Process Security Refund
                            </h6>

                            <div class="mb-3">

                                <span class="small text-muted me-2">
                                    Inspection Result:
                                </span>

                                @if (string.Equals(
                                    inspectionResult,
                                    "Passed",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="inspection-result inspection-passed">
                                        Passed - No Damage
                                    </span>
                                }
                                else
                                {
                                    <span class="inspection-result inspection-damaged">
                                        @inspectionResult
                                    </span>
                                }

                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.SecurityRefundNotes))
                            {
                                <div class="alert alert-light border small">
                                    <strong>Inspection / Refund Notes:</strong>
                                    @item.SecurityRefundNotes
                                </div>
                            }

                            <div class="refund-warning mb-3">
                                <i class="bi bi-info-circle-fill me-1"></i>
                                Only Easypaisa and JazzCash refunds are allowed.
                                The admin should complete the actual transfer first
                                and then record the transaction details here.
                            </div>

                            <form asp-controller="Admin"
                                  asp-action="RefundRentalSecurity"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.OrderDetailId" />

                                <div class="row g-3">

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Refund Amount
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               value="Rs. @securityAmount.ToString("N0")"
                                               readonly />

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Refund Method
                                        </label>

                                        <select name="refundMethod"
                                                id="refundMethod_@item.OrderDetailId"
                                                class="form-select"
                                                onchange="toggleRefundAccount(@item.OrderDetailId)"
                                                required>

                                            <option value="">
                                                Select Method
                                            </option>

                                            <option value="Easypaisa">
                                                Easypaisa
                                            </option>

                                            <option value="JazzCash">
                                                JazzCash
                                            </option>

                                        </select>

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Account / Mobile Number
                                        </label>

                                        <input type="text"
                                               name="refundAccount"
                                               id="refundAccount_@item.OrderDetailId"
                                               class="form-control"
                                               placeholder="Easypaisa/JazzCash number"
                                               disabled />

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Transaction ID
                                        </label>

                                        <input type="text"
                                               name="transactionId"
                                               class="form-control"
                                               placeholder="Enter transaction ID" />

                                    </div>

                                    <div class="col-12">

                                        <label class="form-label">
                                            Refund Notes
                                        </label>

                                        <textarea name="refundNotes"
                                                  class="form-control"
                                                  rows="2"
                                                  placeholder="Enter refund details..."></textarea>

                                    </div>

                                    <div class="col-12 text-end">

                                        <button type="submit"
                                                class="btn btn-gold px-4"
                                                onclick="return confirm('Confirm that the refundable security has actually been transferred to the customer through Easypaisa or JazzCash?');">

                                            <i class="bi bi-cash-coin me-1"></i>
                                            Record Security Refund

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>
                    }
                    else if (string.Equals(
                        status,
                        "Refunded",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="refund-completed">

                            <h6>
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Security Refund Completed
                            </h6>

                            <div class="row g-3 mt-1">

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Amount
                                    </div>

                                    <strong>
                                        Rs. @securityAmount.ToString("N0")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Method
                                    </div>

                                    <strong>
                                        @(item.SecurityRefundMethod ?? "Not recorded")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Date
                                    </div>

                                    <strong>
                                        @(item.SecurityRefundDate?.ToString("dd MMM yyyy, hh:mm tt")
                                            ?? "Not recorded")
                                    </strong>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.SecurityRefundAccount))
                                {
                                    <div class="col-md-4">

                                        <div class="small text-muted">
                                            Account / Mobile
                                        </div>

                                        <strong>
                                            @item.SecurityRefundAccount
                                        </strong>

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.SecurityRefundTransactionId))
                                {
                                    <div class="col-md-4">

                                        <div class="small text-muted">
                                            Transaction ID
                                        </div>

                                        <strong>
                                            @item.SecurityRefundTransactionId
                                        </strong>

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.SecurityRefundNotes))
                                {
                                    <div class="col-12">

                                        <div class="small text-muted">
                                            Refund Notes
                                        </div>

                                        <div>
                                            @item.SecurityRefundNotes
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function toggleRefundAccount(id) {
        const method =
            document.getElementById("refundMethod_" + id);

        const account =
            document.getElementById("refundAccount_" + id);

        if (!method || !account) {
            return;
        }

        if (
            method.value === "Easypaisa" ||
            method.value === "JazzCash"
        ) {
            account.disabled = false;
            account.required = true;
        }
        else {
            account.disabled = true;
            account.required = false;
            account.value = "";
        }
    }
</script>


</body>
</html>
