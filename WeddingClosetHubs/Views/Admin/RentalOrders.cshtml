@model IEnumerable<WeddingClosetHubs.Models.OrderDetail>

@{
    ViewData["Title"] = "Rental Orders";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Rental Orders - Wedding Closet Hubs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <style>

        :root {
            --maroon: #800020;
            --gold: #d4af37;
            --light-gold: #f8f1d8;
            --light-maroon: #f9eef1;
            --dark: #292929;
        }

        body {
            background: #f7f7f7;
            font-family: Arial, sans-serif;
            color: var(--dark);
        }

        .navbar {
            background: var(--maroon);
            min-height: 70px;
        }

        .navbar-brand {
            color: var(--gold) !important;
            font-weight: 700;
            font-size: 22px;
        }

        .page-wrapper {
            padding: 30px;
        }

        .page-title {
            color: var(--maroon);
            font-weight: 700;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 25px;
        }

        .summary-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            border-left: 5px solid var(--gold);
            box-shadow: 0 4px 15px rgba(0,0,0,.07);
            height: 100%;
        }

        .summary-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--light-maroon);
            color: var(--maroon);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .summary-number {
            font-size: 25px;
            font-weight: 700;
            color: var(--maroon);
        }

        .summary-label {
            color: #777;
            font-size: 14px;
        }

        .rental-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 18px rgba(0,0,0,.08);
            margin-bottom: 25px;
            overflow: hidden;
            border: 1px solid #eee;
        }

        .rental-header {
            background: var(--maroon);
            color: white;
            padding: 18px 22px;
        }

        .rental-header h5 {
            margin: 0;
            font-weight: 700;
        }

        .order-number {
            color: var(--gold);
            font-weight: 700;
        }

        .rental-body {
            padding: 22px;
        }

        .product-image {
            width: 110px;
            height: 130px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #f5f5f5;
        }

        .product-placeholder {
            width: 110px;
            height: 130px;
            border-radius: 10px;
            background: var(--light-maroon);
            color: var(--maroon);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 35px;
        }

        .info-title {
            color: var(--maroon);
            font-weight: 700;
            margin-bottom: 10px;
            font-size: 15px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 7px 0;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            color: #777;
        }

        .info-value {
            font-weight: 600;
            text-align: right;
        }

        .security-box {
            background: var(--light-gold);
            border: 1px solid #eadca7;
            border-radius: 12px;
            padding: 16px;
        }

        .security-amount {
            color: var(--maroon);
            font-size: 23px;
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
        }

        .status-awaiting {
            background: #fff3cd;
            color: #856404;
        }

        .status-requested {
            background: #fff3cd;
            color: #856404;
        }

        .status-picked {
            background: #cff4fc;
            color: #055160;
        }

        .status-shop {
            background: #e2d9f3;
            color: #59359a;
        }

        .status-returned {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-inspected {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-refunded {
            background: #cfe2ff;
            color: #084298;
        }

        .status-issue {
            background: #f8d7da;
            color: #842029;
        }

        .status-no-refund {
            background: #e9ecef;
            color: #495057;
        }

        .status-not-required {
            background: #e9ecef;
            color: #495057;
        }

        .action-box {
            background: #fafafa;
            border-radius: 12px;
            padding: 18px;
            border: 1px solid #eee;
        }

        .action-box h6 {
            color: var(--maroon);
            font-weight: 700;
        }

        .btn-maroon {
            background: var(--maroon);
            color: white;
            border: none;
        }

        .btn-maroon:hover {
            background: #650019;
            color: white;
        }

        .btn-gold {
            background: var(--gold);
            color: #222;
            border: none;
            font-weight: 600;
        }

        .btn-gold:hover {
            background: #bd9828;
            color: #222;
        }

        .refund-completed {
            background: #e8f5e9;
            border: 1px solid #b7dfba;
            border-radius: 12px;
            padding: 16px;
        }

        .refund-completed h6 {
            color: #198754;
            font-weight: 700;
        }

        .no-refund-completed {
            background: #f1f3f5;
            border: 1px solid #ced4da;
            border-radius: 12px;
            padding: 16px;
        }

        .no-refund-completed h6 {
            color: #495057;
            font-weight: 700;
        }

        .inspection-result {
            display: inline-block;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .inspection-passed {
            background: #d1e7dd;
            color: #0f5132;
        }

        .inspection-damaged {
            background: #f8d7da;
            color: #842029;
        }

        .issue-box {
            background: #fff1f2;
            border: 1px solid #f1b8bf;
            border-radius: 12px;
            padding: 18px;
        }

        .issue-box h6 {
            color: #842029;
            font-weight: 700;
        }

        .issue-label {
            color: #777;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .issue-value {
            color: #333;
            font-size: 14px;
        }

        .empty-box {
            background: white;
            border-radius: 16px;
            padding: 60px 20px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,.06);
        }

        .empty-box i {
            font-size: 55px;
            color: var(--gold);
        }

        .alert {
            border-radius: 10px;
        }

        .form-label {
            font-weight: 600;
            color: #555;
            font-size: 13px;
        }

        .form-control,
        .form-select {
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 .15rem rgba(212,175,55,.15);
        }

        .back-btn {
            color: var(--maroon);
            border: 1px solid var(--maroon);
            background: white;
            font-weight: 600;
        }

        .back-btn:hover {
            background: var(--maroon);
            color: white;
        }

        .refund-warning {
            background: #fff3cd;
            border: 1px solid #ffe69c;
            color: #664d03;
            border-radius: 10px;
            padding: 12px 15px;
            font-size: 13px;
        }

        .flow-box {
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 15px;
        }

        .flow-title {
            color: var(--maroon);
            font-weight: 700;
            margin-bottom: 12px;
        }

        .flow-step {
            font-size: 13px;
            margin-bottom: 7px;
        }

        .flow-step:last-child {
            margin-bottom: 0;
        }

        .flow-complete {
            color: #198754;
            font-weight: 600;
        }

        .flow-active {
            color: var(--maroon);
            font-weight: 700;
        }

        .flow-pending {
            color: #777;
        }

        .issue-action {
            background: #fff8f8;
            border: 1px solid #f1b8bf;
            border-radius: 12px;
            padding: 18px;
        }

        .issue-action-title {
            color: #842029;
            font-weight: 700;
        }

        .resolution-form {
            background: white;
            border: 1px solid #eadca7;
            border-radius: 12px;
            padding: 18px;
        }

        .resolution-title {
            color: var(--maroon);
            font-weight: 700;
        }

        .partial-refund-box {
            background: #fff8e6;
            border: 1px solid #eadca7;
            border-radius: 10px;
            padding: 12px;
        }

        .no-refund-box {
            background: #f1f3f5;
            border: 1px solid #ced4da;
            border-radius: 10px;
            padding: 12px;
        }

        @@media (max-width: 768px) {

            .page-wrapper {
                padding: 15px;
            }

            .product-image,
            .product-placeholder {
                width: 85px;
                height: 105px;
            }

            .info-row {
                flex-direction: column;
                gap: 3px;
            }

            .info-value {
                text-align: left;
            }

        }

    </style>

</head>

<body>

<nav class="navbar navbar-dark">

    <div class="container-fluid px-4">

        <a class="navbar-brand"
           href="@Url.Action("Dashboard", "Admin")">

            <i class="bi bi-gem me-2"></i>

            Wedding Closet Hubs

        </a>

        <a href="@Url.Action("Dashboard", "Admin")"
           class="btn back-btn">

            <i class="bi bi-arrow-left me-1"></i>

            Dashboard

        </a>

    </div>

</nav>

<div class="page-wrapper">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-2">

        <div>

            <h2 class="page-title mb-1">

                <i class="bi bi-arrow-repeat me-2"></i>

                Rental Orders

            </h2>

            <div class="page-subtitle">

                Manage rented dresses, returns, inspection and refundable security.

            </div>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @{
        var rentalList = Model?.ToList()
            ?? new List<WeddingClosetHubs.Models.OrderDetail>();

        var totalRentals = rentalList.Count;

        var awaitingReturn = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Awaiting Return",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(
                x.RentalReturnStatus,
                "Return Requested",
                StringComparison.OrdinalIgnoreCase));

        var returnPickedUpCount = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Return Picked Up",
                StringComparison.OrdinalIgnoreCase));

        var returnedToShopCount = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Returned to Shop",
                StringComparison.OrdinalIgnoreCase));

        var inspected = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Inspected",
                StringComparison.OrdinalIgnoreCase));

        var returnIssues = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Return Issue",
                StringComparison.OrdinalIgnoreCase));

        var refunded = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Refunded",
                StringComparison.OrdinalIgnoreCase));

        var resolvedNoRefund = rentalList.Count(x =>
            string.Equals(
                x.RentalReturnStatus,
                "Resolved - No Refund",
                StringComparison.OrdinalIgnoreCase));

        var totalSecurity = rentalList.Sum(x =>
            x.RentalSecurity * x.Quantity);

        var pendingSecurity = rentalList
            .Where(x =>
                !x.SecurityRefunded &&
                !string.Equals(
                    x.RentalReturnStatus,
                    "Resolved - No Refund",
                    StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.RentalSecurity * x.Quantity);
    }

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @totalRentals
                        </div>

                        <div class="summary-label">
                            Total Rentals
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-bag-heart"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @awaitingReturn
                        </div>

                        <div class="summary-label">
                            Awaiting Return
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-clock-history"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @inspected
                        </div>

                        <div class="summary-label">
                            Ready for Refund
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-wallet2"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-3">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @returnIssues
                        </div>

                        <div class="summary-label">
                            Return Issues
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-exclamation-triangle"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @returnPickedUpCount
                        </div>

                        <div class="summary-label">
                            Return Picked Up
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-truck"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @returnedToShopCount
                        </div>

                        <div class="summary-label">
                            Returned to Shop
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-shop"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            Rs. @pendingSecurity.ToString("N0")
                        </div>

                        <div class="summary-label">
                            Pending Security
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-shield-exclamation"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @refunded
                        </div>

                        <div class="summary-label">
                            Security Refunded
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-cash-coin"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="summary-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <div class="summary-number">
                            @resolvedNoRefund
                        </div>

                        <div class="summary-label">
                            Resolved - No Refund
                        </div>

                    </div>

                    <div class="summary-icon">

                        <i class="bi bi-shield-x"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    @if (!rentalList.Any())
    {
        <div class="empty-box">

            <i class="bi bi-bag-x"></i>

            <h4 class="mt-3"
                style="color: var(--maroon);">

                No Rental Orders

            </h4>

            <p class="text-muted mb-0">

                There are currently no rental orders in the system.

            </p>

        </div>
    }
    else
    {
        foreach (var item in rentalList)
        {
            var order = item.Order;

            var product = item.Product;

            var securityAmount =
                item.RentalSecurity * item.Quantity;

            var status =
                string.IsNullOrWhiteSpace(item.RentalReturnStatus)
                    ? "Awaiting Return"
                    : item.RentalReturnStatus.Trim();

            string statusClass;

            if (string.Equals(
                status,
                "Return Requested",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-requested";
            }
            else if (string.Equals(
                status,
                "Return Picked Up",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-picked";
            }
            else if (string.Equals(
                status,
                "Returned to Shop",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-shop";
            }
            else if (string.Equals(
                status,
                "Returned",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-returned";
            }
            else if (string.Equals(
                status,
                "Inspected",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-inspected";
            }
            else if (string.Equals(
                status,
                "Refunded",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-refunded";
            }
            else if (string.Equals(
                status,
                "Return Issue",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-issue";
            }
            else if (string.Equals(
                status,
                "Resolved - No Refund",
                StringComparison.OrdinalIgnoreCase))
            {
                statusClass = "status-no-refund";
            }
            else
            {
                statusClass = "status-not-required";
            }

            bool returnRequested =
                string.Equals(
                    status,
                    "Return Requested",
                    StringComparison.OrdinalIgnoreCase);

            bool returnPickedUp =
                string.Equals(
                    status,
                    "Return Picked Up",
                    StringComparison.OrdinalIgnoreCase);

            bool returnedToShop =
                string.Equals(
                    status,
                    "Returned to Shop",
                    StringComparison.OrdinalIgnoreCase);

            bool rentalReturned =
                string.Equals(
                    status,
                    "Returned",
                    StringComparison.OrdinalIgnoreCase);

            bool rentalInspected =
                string.Equals(
                    status,
                    "Inspected",
                    StringComparison.OrdinalIgnoreCase);

            bool rentalRefunded =
                string.Equals(
                    status,
                    "Refunded",
                    StringComparison.OrdinalIgnoreCase);

            bool returnIssue =
                string.Equals(
                    status,
                    "Return Issue",
                    StringComparison.OrdinalIgnoreCase);

            bool resolvedNoRefundItem =
                string.Equals(
                    status,
                    "Resolved - No Refund",
                    StringComparison.OrdinalIgnoreCase);

            var inspectionResult =
                item.InspectionResult ?? "";

            <div class="rental-card">

                <div class="rental-header">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>

                            <h5>

                                Order

                                <span class="order-number">
                                    #@order?.OrderId
                                </span>

                            </h5>

                            <small>

                                @order?.CreatedDate.ToString(
                                    "dd MMM yyyy, hh:mm tt")

                            </small>

                        </div>

                        <div>

                            <span class="status-badge @statusClass">

                                @status

                            </span>

                        </div>

                    </div>

                </div>

                <div class="rental-body">

                    <div class="row g-4">

                        <div class="col-lg-5">

                            <div class="info-title">

                                <i class="bi bi-bag-heart me-1"></i>

                                Rental Product

                            </div>

                            <div class="d-flex gap-3">

                                @if (product != null &&
                                     !string.IsNullOrWhiteSpace(product.Image))
                                {
                                    <img src="@product.Image"
                                         alt="@product.ProductName"
                                         class="product-image" />
                                }
                                else
                                {
                                    <div class="product-placeholder">

                                        <i class="bi bi-image"></i>

                                    </div>
                                }

                                <div class="flex-grow-1">

                                    <h5 class="mb-2"
                                        style="color: var(--maroon);">

                                        @product?.ProductName

                                    </h5>

                                    @if (!string.IsNullOrWhiteSpace(
                                        product?.Category))
                                    {
                                        <div class="small text-muted mb-1">

                                            <strong>
                                                Category:
                                            </strong>

                                            @product.Category

                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        product?.Subcategory))
                                    {
                                        <div class="small text-muted mb-1">

                                            <strong>
                                                Subcategory:
                                            </strong>

                                            @product.Subcategory

                                        </div>
                                    }

                                    <div class="small text-muted mb-1">

                                        <strong>
                                            Quantity:
                                        </strong>

                                        @item.Quantity

                                    </div>

                                    <div class="small text-muted">

                                        <strong>
                                            Rental Price:
                                        </strong>

                                        Rs. @item.UnitPrice.ToString("N0")

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-lg-3">

                            <div class="info-title">

                                <i class="bi bi-person me-1"></i>

                                Customer

                            </div>

                            <div class="info-row">

                                <span class="info-label">
                                    Name
                                </span>

                                <span class="info-value">
                                    @order?.Customer?.Name
                                </span>

                            </div>

                            <div class="info-row">

                                <span class="info-label">
                                    Phone
                                </span>

                                <span class="info-value">
                                    @order?.Customer?.Phone
                                </span>

                            </div>

                            <div class="info-row">

                                <span class="info-label">
                                    Shop
                                </span>

                                <span class="info-value">
                                    @order?.Shop?.ShopName
                                </span>

                            </div>

                        </div>

                        <div class="col-lg-4">

                            <div class="security-box">

                                <div class="info-title mb-2">

                                    <i class="bi bi-shield-check me-1"></i>

                                    Refundable Security

                                </div>

                                <div class="security-amount">

                                    Rs. @securityAmount.ToString("N0")

                                </div>

                                <div class="small text-muted mt-1">

                                    Rs. @item.RentalSecurity.ToString("N0")
                                    × @item.Quantity

                                </div>

                                <hr />

                                <div class="info-row">

                                    <span class="info-label">
                                        Duration
                                    </span>

                                    <span class="info-value">

                                        @(string.IsNullOrWhiteSpace(
                                            item.RentalDuration)
                                            ? "Not specified"
                                            : item.RentalDuration)

                                    </span>

                                </div>

                                <div class="info-row">

                                    <span class="info-label">
                                        Return Status
                                    </span>

                                    <span class="info-value">
                                        @status
                                    </span>

                                </div>

                                @if (item.DressReturnedDate.HasValue)
                                {
                                    <div class="info-row">

                                        <span class="info-label">
                                            Returned Date
                                        </span>

                                        <span class="info-value">

                                            @item.DressReturnedDate.Value.ToString(
                                                "dd MMM yyyy")

                                        </span>

                                    </div>
                                }

                                @if (item.DressReceivedDate.HasValue)
                                {
                                    <div class="info-row">

                                        <span class="info-label">
                                            Shop Received
                                        </span>

                                        <span class="info-value">

                                            @item.DressReceivedDate.Value.ToString(
                                                "dd MMM yyyy")

                                        </span>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                    @if (returnIssue)
                    {
                        <div class="issue-box mt-4">

                            <h6>

                                <i class="bi bi-exclamation-triangle-fill me-1"></i>

                                Rental Return Issue / Damage Report

                            </h6>

                            <div class="row g-3 mt-1">

                                <div class="col-md-4">

                                    <div class="issue-label">
                                        Inspection Result
                                    </div>

                                    <div>

                                        <span class="inspection-result inspection-damaged">

                                            @(string.IsNullOrWhiteSpace(inspectionResult)
                                                ? "Failed"
                                                : inspectionResult)

                                        </span>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="issue-label">
                                        Return Status
                                    </div>

                                    <div class="issue-value">

                                        <strong>
                                            Return Issue
                                        </strong>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="issue-label">
                                        Security Amount
                                    </div>

                                    <div class="issue-value">

                                        <strong>
                                            Rs. @securityAmount.ToString("N0")
                                        </strong>

                                    </div>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.ReturnNotes))
                                {
                                    <div class="col-12">

                                        <div class="issue-label">
                                            Shopkeeper's Damage / Return Notes
                                        </div>

                                        <div class="issue-value">

                                            @item.ReturnNotes

                                        </div>

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.SecurityRefundNotes))
                                {
                                    <div class="col-12">

                                        <div class="issue-label">
                                            Additional Notes
                                        </div>

                                        <div class="issue-value">

                                            @item.SecurityRefundNotes

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                    <hr class="my-4" />

                    <div class="flow-box mb-4">

                        <div class="flow-title">

                            <i class="bi bi-diagram-3 me-1"></i>

                            Rental Return Process

                        </div>

                        <div class="flow-step
                            @(returnRequested ||
                              returnPickedUp ||
                              returnedToShop ||
                              rentalReturned ||
                              rentalInspected ||
                              rentalRefunded ||
                              returnIssue ||
                              resolvedNoRefundItem
                                ? "flow-complete"
                                : "flow-pending")">

                            @if (returnRequested ||
                                 returnPickedUp ||
                                 returnedToShop ||
                                 rentalReturned ||
                                 rentalInspected ||
                                 rentalRefunded ||
                                 returnIssue ||
                                 resolvedNoRefundItem)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle"></i>
                            }

                            Return Requested

                        </div>

                        <div class="flow-step
                            @(returnPickedUp ||
                              returnedToShop ||
                              rentalReturned ||
                              rentalInspected ||
                              rentalRefunded ||
                              returnIssue ||
                              resolvedNoRefundItem
                                ? "flow-complete"
                                : returnRequested
                                    ? "flow-active"
                                    : "flow-pending")">

                            @if (returnPickedUp ||
                                 returnedToShop ||
                                 rentalReturned ||
                                 rentalInspected ||
                                 rentalRefunded ||
                                 returnIssue ||
                                 resolvedNoRefundItem)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle"></i>
                            }

                            Delivery Pickup

                        </div>

                        <div class="flow-step
                            @(rentalReturned ||
                              rentalInspected ||
                              rentalRefunded ||
                              returnIssue ||
                              resolvedNoRefundItem
                                ? "flow-complete"
                                : returnedToShop
                                    ? "flow-active"
                                    : "flow-pending")">

                            @if (rentalReturned ||
                                 rentalInspected ||
                                 rentalRefunded ||
                                 returnIssue ||
                                 resolvedNoRefundItem)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (returnedToShop)
                            {
                                <i class="bi bi-hourglass-split"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle"></i>
                            }

                            Shopkeeper Receipt & Inspection

                        </div>

                        <div class="flow-step
                            @(rentalRefunded || resolvedNoRefundItem
                                ? "flow-complete"
                                : rentalInspected || returnIssue
                                    ? "flow-active"
                                    : "flow-pending")">

                            @if (rentalRefunded || resolvedNoRefundItem)
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (rentalInspected)
                            {
                                <i class="bi bi-hourglass-split"></i>
                            }
                            else if (returnIssue)
                            {
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle"></i>
                            }

                            Admin Security Refund / Review

                        </div>

                    </div>

                    @if (returnRequested)
                    {
                        <div class="alert alert-warning mb-0">

                            <i class="bi bi-hourglass-split me-1"></i>

                            <strong>
                                Waiting for Delivery Pickup
                            </strong>

                            <br />

                            The customer has requested the rental return.
                            The delivery person must pick up the dress
                            from the customer.

                        </div>
                    }
                    else if (returnPickedUp)
                    {
                        <div class="alert alert-info mb-0">

                            <i class="bi bi-truck me-1"></i>

                            <strong>
                                Return Picked Up
                            </strong>

                            <br />

                            The delivery person has picked up the returned
                            dress from the customer and must deliver it
                            to the shop.

                        </div>
                    }
                    else if (returnedToShop)
                    {
                        <div class="alert alert-warning mb-0">

                            <i class="bi bi-shop me-1"></i>

                            <strong>
                                Returned to Shop
                            </strong>

                            <br />

                            The delivery person has delivered the dress
                            to the shop. The shopkeeper must receive and
                            inspect it before the security can be processed.

                        </div>
                    }
                    else if (rentalReturned)
                    {
                        <div class="alert alert-info mb-0">

                            <i class="bi bi-clipboard-check me-1"></i>

                            <strong>
                                Shopkeeper Receipt Completed
                            </strong>

                            <br />

                            The shopkeeper has received the returned dress.
                            The rental is waiting for the inspection status
                            to be completed.

                        </div>
                    }
                    else if (returnIssue)
                    {
                        <div class="issue-action">

                            <div class="issue-action-title mb-2">

                                <i class="bi bi-exclamation-octagon-fill me-1"></i>

                                Admin Review Required

                            </div>

                            <div class="small text-muted mb-3">

                                The shopkeeper has reported a problem with
                                the returned rental dress. Review the
                                damage notes and decide how the refundable
                                security should be handled.

                            </div>

                            <div class="refund-warning mb-3">

                                <i class="bi bi-info-circle-fill me-1"></i>

                                Security amount:

                                <strong>
                                    Rs. @securityAmount.ToString("N0")
                                </strong>

                                <br />

                                You can approve a full refund, partial refund,
                                or no refund depending on the verified return
                                condition.

                            </div>

                            <div class="resolution-form">

                                <div class="resolution-title mb-3">

                                    <i class="bi bi-shield-check me-1"></i>

                                    Admin Return Issue Resolution

                                </div>

                                <form asp-controller="Admin"
                                      asp-action="ResolveRentalReturnIssue"
                                      method="post"
                                      onsubmit="return validateRentalResolution(@item.OrderDetailId);">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.OrderDetailId" />

                                    <div class="row g-3">

                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Resolution
                                            </label>

                                            <select name="resolution"
                                                    id="resolution_@item.OrderDetailId"
                                                    class="form-select"
                                                    onchange="toggleIssueRefundFields(@item.OrderDetailId)"
                                                    required>

                                                <option value="">
                                                    Select Resolution
                                                </option>

                                                <option value="Full Refund">
                                                    Full Refund
                                                </option>

                                                <option value="Partial Refund">
                                                    Partial Refund
                                                </option>

                                                <option value="No Refund">
                                                    No Refund
                                                </option>

                                            </select>

                                        </div>

                                        <div class="col-md-4"
                                             id="partialRefundBox_@item.OrderDetailId"
                                             style="display:none;">

                                            <label class="form-label">
                                                Refund Amount
                                            </label>

                                            <input type="number"
                                                   name="refundAmount"
                                                   id="refundAmount_@item.OrderDetailId"
                                                   class="form-control"
                                                   min="0.01"
                                                   max="@(securityAmount - 0.01m)"
                                                   step="0.01"
                                                   placeholder="Enter partial refund amount" />

                                            <div class="small text-muted mt-1">

                                                Must be less than
                                                Rs. @securityAmount.ToString("N0")

                                            </div>

                                        </div>

                                        <div class="col-md-4"
                                             id="resolutionSecurityBox_@item.OrderDetailId">

                                            <label class="form-label">
                                                Total Security
                                            </label>

                                            <input type="text"
                                                   class="form-control"
                                                   value="Rs. @securityAmount.ToString("N0")"
                                                   readonly />

                                        </div>

                                        <div class="col-12"
                                             id="resolutionRefundDetails_@item.OrderDetailId"
                                             style="display:none;">

                                            <div class="partial-refund-box">

                                                <div class="row g-3">

                                                    <div class="col-md-4">

                                                        <label class="form-label">
                                                            Refund Method
                                                        </label>

                                                        <select name="refundMethod"
                                                                id="issueRefundMethod_@item.OrderDetailId"
                                                                class="form-select"
                                                                onchange="toggleIssueRefundAccount(@item.OrderDetailId)">

                                                            <option value="">
                                                                Select Method
                                                            </option>

                                                            <option value="Easypaisa">
                                                                Easypaisa
                                                            </option>

                                                            <option value="JazzCash">
                                                                JazzCash
                                                            </option>

                                                        </select>

                                                    </div>

                                                    <div class="col-md-4">

                                                        <label class="form-label">
                                                            Account / Mobile Number
                                                        </label>

                                                        <input type="text"
                                                               name="refundAccount"
                                                               id="issueRefundAccount_@item.OrderDetailId"
                                                               class="form-control"
                                                               placeholder="Easypaisa/JazzCash number"
                                                               disabled />

                                                    </div>

                                                    <div class="col-md-4">

                                                        <label class="form-label">
                                                            Transaction ID
                                                        </label>

                                                        <input type="text"
                                                               name="transactionId"
                                                               id="issueTransactionId_@item.OrderDetailId"
                                                               class="form-control"
                                                               placeholder="Enter transaction ID" />

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="col-12"
                                             id="noRefundBox_@item.OrderDetailId"
                                             style="display:none;">

                                            <div class="no-refund-box">

                                                <div class="fw-semibold mb-1">

                                                    <i class="bi bi-shield-x me-1"></i>

                                                    No Refund Selected

                                                </div>

                                                <div class="small text-muted">

                                                    The full security amount will be
                                                    recorded as damage deduction and
                                                    no payment will be sent to the
                                                    customer.

                                                </div>

                                            </div>

                                        </div>

                                        <div class="col-12">

                                            <label class="form-label">
                                                Admin Resolution Notes
                                            </label>

                                            <textarea name="refundNotes"
                                                      id="resolutionNotes_@item.OrderDetailId"
                                                      class="form-control"
                                                      rows="3"
                                                      placeholder="Enter the reason for the selected resolution..."></textarea>

                                        </div>

                                        <div class="col-12">

                                            <div class="refund-warning mb-3">

                                                <i class="bi bi-exclamation-circle-fill me-1"></i>

                                                For Full Refund or Partial Refund,
                                                complete the actual Easypaisa/JazzCash
                                                transfer first and then enter the
                                                transaction ID.

                                            </div>

                                        </div>

                                        <div class="col-12 text-end">

                                            <button type="submit"
                                                    class="btn btn-gold px-4">

                                                <i class="bi bi-check2-circle me-1"></i>

                                                Resolve Return Issue

                                            </button>

                                        </div>

                                    </div>

                                </form>

                            </div>

                        </div>
                    }
                    else if (rentalInspected)
                    {
                        <div class="action-box">

                            <h6>

                                <i class="bi bi-wallet2 me-1"></i>

                                Process Security Refund

                            </h6>

                            <div class="small text-muted mb-3">

                                The shopkeeper has received and inspected
                                the returned dress successfully.

                                @if (string.Equals(
                                    inspectionResult,
                                    "Passed",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>

                                        The inspection result is marked as
                                        <strong>Passed</strong>.

                                    </span>
                                }

                                Admin can now process the refundable security.

                            </div>

                            <div class="refund-warning mb-3">

                                <i class="bi bi-info-circle-fill me-1"></i>

                                Only Easypaisa and JazzCash refunds are
                                allowed. Complete the actual transfer first,
                                then enter the transaction ID below.

                            </div>

                            <form asp-controller="Admin"
                                  asp-action="RefundRentalSecurity"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.OrderDetailId" />

                                <div class="row g-3">

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Refund Amount
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               value="Rs. @securityAmount.ToString("N0")"
                                               readonly />

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Refund Method
                                        </label>

                                        <select name="refundMethod"
                                                id="refundMethod_@item.OrderDetailId"
                                                class="form-select"
                                                onchange="toggleRefundAccount(@item.OrderDetailId)"
                                                required>

                                            <option value="">
                                                Select Method
                                            </option>

                                            <option value="Easypaisa">
                                                Easypaisa
                                            </option>

                                            <option value="JazzCash">
                                                JazzCash
                                            </option>

                                        </select>

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Account / Mobile Number
                                        </label>

                                        <input type="text"
                                               name="refundAccount"
                                               id="refundAccount_@item.OrderDetailId"
                                               class="form-control"
                                               placeholder="Easypaisa/JazzCash number"
                                               disabled />

                                    </div>

                                    <div class="col-md-3">

                                        <label class="form-label">
                                            Transaction ID
                                        </label>

                                        <input type="text"
                                               name="transactionId"
                                               class="form-control"
                                               placeholder="Enter transaction ID"
                                               required />

                                    </div>

                                    <div class="col-12">

                                        <label class="form-label">
                                            Refund Notes
                                        </label>

                                        <textarea name="refundNotes"
                                                  class="form-control"
                                                  rows="2"
                                                  placeholder="Enter refund details..."></textarea>

                                    </div>

                                    <div class="col-12 text-end">

                                        <button type="submit"
                                                class="btn btn-gold px-4"
                                                onclick="return confirm('Confirm that the refundable security has actually been transferred to the customer through Easypaisa or JazzCash?');">

                                            <i class="bi bi-cash-coin me-1"></i>

                                            Record Security Refund

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>
                    }
                    else if (rentalRefunded)
                    {
                        var actualRefundAmount =
                            item.RefundAmount > 0
                                ? item.RefundAmount
                                : securityAmount;

                        <div class="refund-completed">

                            <h6>

                                <i class="bi bi-check-circle-fill me-1"></i>

                                Security Refund Completed

                            </h6>

                            <div class="row g-3 mt-1">

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Amount
                                    </div>

                                    <strong>
                                        Rs. @actualRefundAmount.ToString("N0")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Damage Deduction
                                    </div>

                                    <strong>
                                        Rs. @item.DamageDeduction.ToString("N0")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Method
                                    </div>

                                    <strong>
                                        @(item.SecurityRefundMethod
                                            ?? "Not recorded")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Date
                                    </div>

                                    <strong>

                                        @(item.SecurityRefundDate?.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                            ?? "Not recorded")

                                    </strong>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.SecurityRefundAccount))
                                {
                                    <div class="col-md-4">

                                        <div class="small text-muted">
                                            Account / Mobile
                                        </div>

                                        <strong>
                                            @item.SecurityRefundAccount
                                        </strong>

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    item.SecurityRefundTransactionId))
                                {
                                    <div class="col-md-4">

                                        <div class="small text-muted">
                                            Transaction ID
                                        </div>

                                        <strong>
                                            @item.SecurityRefundTransactionId
                                        </strong>

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    item.SecurityRefundNotes))
                                {
                                    <div class="col-12">

                                        <div class="small text-muted">
                                            Refund Notes
                                        </div>

                                        <div>
                                            @item.SecurityRefundNotes
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }
                    else if (resolvedNoRefundItem)
                    {
                        <div class="no-refund-completed">

                            <h6>

                                <i class="bi bi-shield-x me-1"></i>

                                Return Issue Resolved - No Refund

                            </h6>

                            <div class="row g-3 mt-1">

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Security Amount
                                    </div>

                                    <strong>
                                        Rs. @securityAmount.ToString("N0")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Damage Deduction
                                    </div>

                                    <strong>
                                        Rs. @item.DamageDeduction.ToString("N0")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Refund Amount
                                    </div>

                                    <strong>
                                        Rs. @item.RefundAmount.ToString("N0")
                                    </strong>

                                </div>

                                <div class="col-md-4">

                                    <div class="small text-muted">
                                        Resolution Date
                                    </div>

                                    <strong>

                                        @(item.SecurityRefundDate?.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                            ?? "Not recorded")

                                    </strong>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.SecurityRefundNotes))
                                {
                                    <div class="col-12">

                                        <div class="small text-muted">
                                            Admin Resolution Notes
                                        </div>

                                        <div>
                                            @item.SecurityRefundNotes
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0">

                            <i class="bi bi-info-circle me-1"></i>

                            Current rental return status:

                            <strong>
                                @status
                            </strong>

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>

    function toggleRefundAccount(id) {

        const method =
            document.getElementById("refundMethod_" + id);

        const account =
            document.getElementById("refundAccount_" + id);

        if (!method || !account) {
            return;
        }

        if (
            method.value === "Easypaisa" ||
            method.value === "JazzCash"
        ) {
            account.disabled = false;
            account.required = true;
        }
        else {
            account.disabled = true;
            account.required = false;
            account.value = "";
        }
    }


    function toggleIssueRefundFields(id) {

        const resolution =
            document.getElementById("resolution_" + id);

        const partialBox =
            document.getElementById("partialRefundBox_" + id);

        const refundDetails =
            document.getElementById("resolutionRefundDetails_" + id);

        const noRefundBox =
            document.getElementById("noRefundBox_" + id);

        const refundAmount =
            document.getElementById("refundAmount_" + id);

        const refundMethod =
            document.getElementById("issueRefundMethod_" + id);

        const refundAccount =
            document.getElementById("issueRefundAccount_" + id);

        const transactionId =
            document.getElementById("issueTransactionId_" + id);

        if (!resolution ||
            !partialBox ||
            !refundDetails ||
            !noRefundBox ||
            !refundAmount ||
            !refundMethod ||
            !refundAccount ||
            !transactionId) {

            return;
        }

        partialBox.style.display = "none";
        refundDetails.style.display = "none";
        noRefundBox.style.display = "none";

        refundAmount.required = false;

        refundMethod.required = false;

        refundAccount.required = false;

        transactionId.required = false;

        refundAccount.disabled = true;

        if (resolution.value === "Full Refund") {

            refundDetails.style.display = "block";

            refundMethod.required = true;

            refundAccount.disabled = true;

            transactionId.required = true;

            toggleIssueRefundAccount(id);
        }
        else if (resolution.value === "Partial Refund") {

            partialBox.style.display = "block";

            refundDetails.style.display = "block";

            refundAmount.required = true;

            refundMethod.required = true;

            refundAccount.disabled = true;

            transactionId.required = true;

            toggleIssueRefundAccount(id);
        }
        else if (resolution.value === "No Refund") {

            noRefundBox.style.display = "block";

            refundAmount.value = "";

            refundMethod.value = "";

            refundAccount.value = "";

            transactionId.value = "";

        }
        else {

            refundAmount.value = "";

            refundMethod.value = "";

            refundAccount.value = "";

            transactionId.value = "";

        }
    }


    function toggleIssueRefundAccount(id) {

        const method =
            document.getElementById("issueRefundMethod_" + id);

        const account =
            document.getElementById("issueRefundAccount_" + id);

        if (!method || !account) {
            return;
        }

        if (
            method.value === "Easypaisa" ||
            method.value === "JazzCash"
        ) {
            account.disabled = false;
            account.required = true;
        }
        else {
            account.disabled = true;
            account.required = false;
            account.value = "";
        }
    }


    function validateRentalResolution(id) {

        const resolution =
            document.getElementById("resolution_" + id);

        const refundAmount =
            document.getElementById("refundAmount_" + id);

        const refundMethod =
            document.getElementById("issueRefundMethod_" + id);

        const refundAccount =
            document.getElementById("issueRefundAccount_" + id);

        const transactionId =
            document.getElementById("issueTransactionId_" + id);

        if (!resolution || !resolution.value) {

            alert("Please select a resolution.");

            return false;
        }

        if (
            resolution.value === "Full Refund" ||
            resolution.value === "Partial Refund"
        ) {

            if (!refundMethod || !refundMethod.value) {

                alert("Please select Easypaisa or JazzCash as the refund method.");

                return false;
            }

            if (!refundAccount ||
                !refundAccount.value.trim()) {

                alert("Please enter the Easypaisa or JazzCash account/mobile number.");

                return false;
            }

            if (!transactionId ||
                !transactionId.value.trim()) {

                alert("Please enter the refund transaction ID.");

                return false;
            }
        }

        if (resolution.value === "Partial Refund") {

            const amount =
                parseFloat(refundAmount.value);

            const max =
                parseFloat(refundAmount.max);

            if (
                isNaN(amount) ||
                amount <= 0 ||
                amount >= max
            ) {

                alert(
                    "Enter a valid partial refund amount that is greater than zero and less than the total security amount."
                );

                return false;
            }
        }

        if (resolution.value === "Full Refund") {

            return confirm(
                "Confirm that the full refundable security has actually been transferred to the customer through Easypaisa or JazzCash?"
            );
        }

        if (resolution.value === "Partial Refund") {

            return confirm(
                "Confirm that the partial refund amount has actually been transferred to the customer through Easypaisa or JazzCash?"
            );
        }

        if (resolution.value === "No Refund") {

            return confirm(
                "Confirm that no security refund will be paid to the customer and the full security amount will be recorded as damage deduction?"
            );
        }

        return false;
    }

</script>

</body>

</html>