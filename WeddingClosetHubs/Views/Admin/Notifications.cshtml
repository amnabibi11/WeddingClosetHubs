@model IEnumerable<WeddingClosetHubs.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    Layout = null;

    var notifications = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Notification>();

    int unreadCount = ViewBag.UnreadNotificationCount ?? 0;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Notifications - Wedding Closet Hub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f7f7f7;
            font-family: Arial, sans-serif;
        }

        .page-header {
            background: #800020;
            color: white;
            padding: 25px 30px;
            margin-bottom: 25px;
        }

            .page-header h2 {
                margin: 0;
                font-weight: 600;
            }

            .page-header p {
                margin: 5px 0 0;
                opacity: .85;
            }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            overflow: hidden;
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #eee;
            padding: 16px 20px;
            color: #800020;
            font-weight: 600;
        }


        .notification-item {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
            transition: .2s;
            background: white;
        }

            .notification-item:last-child {
                border-bottom: none;
            }

            .notification-item:hover {
                background: #fff8fa;
            }

            .notification-item.unread {
                background: #fffaf0;
                border-left: 4px solid #d4af37;
            }

        .notification-icon {
            width: 48px;
            min-width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #800020;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .notification-title {
            font-weight: 600;
            color: #333;
        }

        .notification-message {
            color: #666;
            font-size: 14px;
            margin-top: 5px;
            line-height: 1.5;
        }

        .notification-time {
            font-size: 12px;
            color: #999;
            white-space: nowrap;
            margin-left: 15px;
        }

        .unread-badge {
            background: #d4af37;
            color: #222;
            padding: 5px 9px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: 600;
            display: inline-block;
        }

        .type-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 600;
            margin-top: 7px;
            background: #f1f1f1;
            color: #666;
        }

        .read-btn {
            background: #6c757d;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 12px;
        }

            .read-btn:hover {
                background: #5c636a;
                color: white;
            }

        .mark-all-btn {
            background: #800020;
            color: white;
            border: none;
            border-radius: 7px;
            padding: 8px 15px;
        }

            .mark-all-btn:hover {
                background: #650019;
                color: white;
            }

            .mark-all-btn:disabled {
                opacity: .6;
                cursor: not-allowed;
            }

        .back-btn {
            background: white;
            color: #800020;
            border: none;
            border-radius: 7px;
            padding: 9px 18px;
            text-decoration: none;
        }

            .back-btn:hover {
                background: #f1f1f1;
                color: #650019;
            }

        .empty-state {
            padding: 70px 20px;
            text-align: center;
            color: #777;
        }

            .empty-state i {
                font-size: 60px;
                color: #d4af37;
            }

        .order-reference {
            display: inline-block;
            margin-top: 7px;
            color: #800020;
            font-size: 12px;
            font-weight: 600;
        }

        @@media(max-width: 768px) {

            .page-header {
                padding: 20px;
            }

                .page-header .d-flex {
                    align-items: flex-start !important;
                }

                .page-header h2 {
                    font-size: 22px;
                }

                .page-header p {
                    font-size: 13px;
                }

            .notification-item {
                padding: 15px;
            }

            .notification-time {
                display: block;
                margin-left: 0;
                margin-top: 5px;
            }

            .notification-icon {
                width: 42px;
                min-width: 42px;
                height: 42px;
                font-size: 17px;
            }

            .page-header .d-flex.gap-2 {
                flex-direction: column;
            }

            .mark-all-btn,
            .back-btn {
                width: 100%;
                text-align: center;
            }
        }

    </style>

</head>

<body>


    <div class="page-header">

        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center gap-3">

                <div>

                    <h2>

                        <i class="bi bi-bell me-2"></i>

                        Notifications

                    </h2>

                    <p>

                        Important system activities and alerts.

                    </p>

                </div>

                <div class="d-flex gap-2">



                    <form asp-controller="Admin"
                          asp-action="MarkAllNotificationsRead"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="mark-all-btn"
                                @(unreadCount == 0 ? "disabled" : "")>

                            <i class="bi bi-check2-all me-1"></i>

                            Mark All Read

                        </button>

                    </form>


                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="back-btn">

                        <i class="bi bi-arrow-left me-1"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>


    <div class="container-fluid">


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle me-1"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-circle me-1"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <div class="card">


            <div class="card-header d-flex justify-content-between align-items-center">

                <div>

                    <i class="bi bi-list-ul me-2"></i>

                    System Notifications

                </div>



                @if (unreadCount > 0)
                {
                    <span class="unread-badge">

                        @unreadCount Unread

                    </span>
                }
                else
                {
                    <span class="text-muted"
                          style="font-size:12px;">

                        All notifications read

                    </span>
                }

            </div>


            <div class="card-body p-0">

                @if (notifications.Any())
                {

                    foreach (var notification in notifications)
                    {

                        <div class="notification-item
                                     @(notification.IsRead ? "" : "unread")">

                            <div class="d-flex align-items-start">


                                <div class="notification-icon me-3">

                                    @if (string.Equals(
                                                                notification.Type,
                                                                "Chat",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="bi bi-chat-dots"></i>
                                    }
                                    else if (string.Equals(
                                    notification.Type,
                                    "Order",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="bi bi-bag-check"></i>
                                    }
                                    else if (string.Equals(
                                    notification.Type,
                                    "Payment",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="bi bi-credit-card"></i>
                                    }
                                    else if (string.Equals(
                                    notification.Type,
                                    "Delivery",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="bi bi-truck"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-bell"></i>
                                    }

                                </div>


                                <div class="flex-grow-1">


                                    <div class="d-flex justify-content-between align-items-start">

                                        <div>

                                            <span class="notification-title">

                                                @notification.Title

                                            </span>

                                            @if (!notification.IsRead)
                                            {
                                                <span class="unread-badge ms-2">

                                                    New

                                                </span>
                                            }

                                        </div>


                                        <span class="notification-time">

                                            @notification.CreatedDate.ToString(
                                            "dd MMM yyyy, hh:mm tt")

                                </span>

                            </div>



                            <div class="notification-message">

                                @notification.Message

                            </div>




                            @if (!string.IsNullOrWhiteSpace(notification.Type))
                                    {
                                        <span class="type-badge">

                                            @notification.Type

                                        </span>
                                    }



                                    @if (notification.OrderId.HasValue)
                                    {
                                        <div>

                                            <span class="order-reference">

                                                <i class="bi bi-receipt me-1"></i>

                                                Order #@notification.OrderId

                                            </span>

                                        </div>
                                    }




                                    @if (!notification.IsRead)
                                    {

                                        <form asp-controller="Admin"
                                              asp-action="MarkNotificationRead"
                                              method="post"
                                              class="mt-2">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@notification.NotificationId" />

                                            <button type="submit"
                                                    class="read-btn">

                                                <i class="bi bi-check me-1"></i>

                                                Mark as Read

                                            </button>

                                        </form>

                                    }

                                </div>

                            </div>

                        </div>

                    }

                }
                else
                {

                    <div class="empty-state">

                        <i class="bi bi-bell-slash"></i>

                        <h5 class="mt-3">

                            No notifications

                        </h5>

                        <p>

                            New system notifications will appear here.

                        </p>

                    </div>

                }

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>