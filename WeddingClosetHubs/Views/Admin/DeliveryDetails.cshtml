@model WeddingClosetHubs.Models.DeliveryBoy

@{
    ViewData["Title"] = "Delivery Boy Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Delivery Boy Details - Wedding Closet Hubs</title>

    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-wrapper {
            padding: 30px;
        }

      

        .page-header {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 0;
        }

       

        .custom-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 25px;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .custom-card-header {
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 600;
            color: white;
        }

        .header-primary {
            background: #0d6efd;
        }

        .header-warning {
            background: #ffc107;
            color: #212529;
        }

        .header-dark {
            background: #212529;
        }

        .header-info {
            background: #0dcaf0;
            color: #212529;
        }

        .header-secondary {
            background: #6c757d;
        }

        .header-success {
            background: #198754;
        }

        .custom-card-body {
            padding: 25px;
        }

       

        .info-group {
            margin-bottom: 20px;
        }

        .info-label {
            display: block;
            font-weight: 600;
            color: #555;
            margin-bottom: 7px;
            font-size: 14px;
        }

        .info-value {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 7px;
            padding: 11px 14px;
            min-height: 45px;
            display: flex;
            align-items: center;
        }

       

        .form-label {
            font-weight: 600;
            color: #555;
        }

        .form-control,
        .form-select {
            border-radius: 7px;
            border: 1px solid #d9dee3;
            padding: 11px 14px;
        }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15);
        }

        textarea.form-control {
            min-height: 130px;
            resize: vertical;
        }

       

        .document-box {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            height: 100%;
        }

        .document-title {
            font-weight: 600;
            margin-bottom: 15px;
        }

        .cnic-image {
            width: 100%;
            max-width: 500px;
            max-height: 350px;
            object-fit: contain;
            border-radius: 8px;
            border: 1px solid #ddd;
            background: white;
            padding: 5px;
        }

        .no-image {
            min-height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: #777;
        }

        .no-image i {
            font-size: 45px;
            margin-bottom: 10px;
        }


        .status-box {
            display: flex;
            align-items: center;
        }

        .status-badge {
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        

        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .action-buttons .btn {
            padding: 10px 18px;
            border-radius: 7px;
        }

        .btn i {
            margin-right: 5px;
        }

       

        .rejection-box {
            border-radius: 8px;
            padding: 15px;
        }

      

        @@media (max-width: 768px) {

            .page-wrapper {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 23px;
            }

            .page-header .btn {
                margin-top: 15px;
            }

            .custom-card-body {
                padding: 18px;
            }

        }

    </style>

</head>

<body>

<div class="page-wrapper">


    <div class="page-header">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h2 class="page-title">

                    <i class="bi bi-bicycle"></i>

                    Delivery Boy Details

                </h2>

                <p class="page-subtitle">

                    Review delivery boy information and manage verification.

                </p>

            </div>

            <div class="col-md-4 text-md-end">

                <a asp-controller="Admin"
                   asp-action="DeliveryBoys"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back to Delivery Boys

                </a>

            </div>

        </div>

    </div>

    <div class="custom-card">

        <div class="custom-card-header header-primary">

            <i class="bi bi-person"></i>

            Personal Information

        </div>

        <div class="custom-card-body">

            <div class="row">

               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Full Name
                        </label>

                        <div class="info-value">

                            @(Model.User?.Name ?? "N/A")

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Email
                        </label>

                        <div class="info-value">

                            @(Model.User?.Email ?? "N/A")

                        </div>

                    </div>

                </div>


              

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Phone Number
                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.User?.Phone)
                                ? "N/A"
                                : Model.User.Phone)

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Address
                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.User?.Address)
                                ? "N/A"
                                : Model.User.Address)

                        </div>

                    </div>

                </div>


              

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            User ID
                        </label>

                        <div class="info-value">

                            @Model.UserId

                        </div>

                    </div>

                </div>



                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Delivery Boy ID
                        </label>

                        <div class="info-value">

                            @Model.DeliveryBoyId

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


  

    <div class="custom-card">

        <div class="custom-card-header header-warning">

            <i class="bi bi-bicycle"></i>

            Delivery Information

        </div>

        <div class="custom-card-body">

            <div class="row">


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            CNIC Number
                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.CNIC)
                                ? "N/A"
                                : Model.CNIC)

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Motorbike Registration Number
                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.MotorbikeNumber)
                                ? "N/A"
                                : Model.MotorbikeNumber)

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Preferred Delivery Zone
                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.PreferredZone)
                                ? "N/A"
                                : Model.PreferredZone)

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Current Assigned Zone
                        </label>

                        <div class="info-value">

                            @(string.IsNullOrEmpty(Model.AssignedZone)
                                ? "Not Assigned"
                                : Model.AssignedZone)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="custom-card">

        <div class="custom-card-header header-dark">

            <i class="bi bi-card-image"></i>

            CNIC Verification Documents

        </div>

        <div class="custom-card-body">

            <div class="row">

             

                <div class="col-md-6 mb-4 mb-md-0">

                    <div class="document-box">

                        <div class="document-title">

                            <i class="bi bi-credit-card"></i>

                            CNIC Front Image

                        </div>

                        @if (!string.IsNullOrEmpty(Model.CNICFrontImage))
                        {

                            <img src="@Model.CNICFrontImage"
                                 class="cnic-image"
                                 alt="CNIC Front Image" />

                        }
                        else
                        {

                            <div class="no-image">

                                <i class="bi bi-image"></i>

                                <span>
                                    CNIC Front Image Not Available
                                </span>

                            </div>

                        }

                    </div>

                </div>



                <div class="col-md-6">

                    <div class="document-box">

                        <div class="document-title">

                            <i class="bi bi-credit-card-2-front"></i>

                            CNIC Back Image

                        </div>

                        @if (!string.IsNullOrEmpty(Model.CNICBackImage))
                        {

                            <img src="@Model.CNICBackImage"
                                 class="cnic-image"
                                 alt="CNIC Back Image" />

                        }
                        else
                        {

                            <div class="no-image">

                                <i class="bi bi-image"></i>

                                <span>
                                    CNIC Back Image Not Available
                                </span>

                            </div>

                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="custom-card">

        <div class="custom-card-header header-info">

            <i class="bi bi-shield-check"></i>

            Verification Information

        </div>

        <div class="custom-card-body">

            <div class="row">


                

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Verification Status
                        </label>

                        <div class="info-value status-box">

                            @if (Model.VerificationStatus == "Approved")
                            {

                                <span class="status-badge bg-success text-white">

                                    <i class="bi bi-check-circle"></i>

                                    Approved

                                </span>

                            }
                            else if (Model.VerificationStatus == "Rejected")
                            {

                                <span class="status-badge bg-danger text-white">

                                    <i class="bi bi-x-circle"></i>

                                    Rejected

                                </span>

                            }
                            else
                            {

                                <span class="status-badge bg-warning text-dark">

                                    <i class="bi bi-clock"></i>

                                    Pending

                                </span>

                            }

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Approved Date
                        </label>

                        <div class="info-value">

                            @(Model.ApprovedDate.HasValue
                                ? Model.ApprovedDate.Value.ToString("dd MMMM yyyy")
                                : "Not Approved")

                        </div>

                    </div>

                </div>


               

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Registration Date
                        </label>

                        <div class="info-value">

                            @Model.CreatedDate.ToString("dd MMMM yyyy")

                        </div>

                    </div>

                </div>


               

                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {

                    <div class="col-md-12">

                        <div class="info-group">

                            <label class="info-label text-danger">

                                Rejection Reason

                            </label>

                            <div class="alert alert-danger rejection-box">

                                <i class="bi bi-exclamation-triangle"></i>

                                @Model.RejectionReason

                            </div>

                        </div>

                    </div>

                }

            </div>

        </div>

    </div>


    <div class="custom-card">

        <div class="custom-card-header header-success">

            <i class="bi bi-gear"></i>

            Admin Management

        </div>

        <div class="custom-card-body">


            <form asp-controller="Admin"
                  asp-action="UpdateDeliveryDetails"
                  method="post">

                @Html.AntiForgeryToken()

               

                <input type="hidden"
                       name="UserId"
                       value="@Model.UserId" />


                <div class="row">


                   

                    <div class="col-md-6">

                        <div class="info-group">

                            <label class="form-label">

                                <i class="bi bi-geo-alt"></i>

                                Assign Delivery Zone

                            </label>

                            <select name="AssignedZone"
                                    class="form-select">

                                <option value="">
                                    -- Select Zone --
                                </option>

                                <option value="Saddar"
                                        selected="@(Model.AssignedZone == "Saddar")">

                                    Saddar

                                </option>

                                <option value="6th Road"
                                        selected="@(Model.AssignedZone == "6th Road")">

                                    6th Road

                                </option>

                                <option value="Askari 7"
                                        selected="@(Model.AssignedZone == "Askari 7")">

                                    Askari 7

                                </option>

                                
                            </select>

                        </div>

                    </div>



                    <div class="col-md-6">

                        <div class="info-group">

                            <label class="form-label">

                                Current Assigned Zone

                            </label>

                            <div class="info-value">

                                @(string.IsNullOrEmpty(Model.AssignedZone)
                                    ? "Not Assigned"
                                    : Model.AssignedZone)

                            </div>

                        </div>

                    </div>


                  

                    <div class="col-md-12">

                        <div class="info-group">

                            <label class="form-label">

                                <i class="bi bi-pencil-square"></i>

                                Admin Notes

                            </label>

                            <textarea name="AdminNotes"
                                      class="form-control"
                                      placeholder="Write notes about this delivery boy...">@Model.AdminNotes</textarea>

                            <small class="text-muted">

                                These notes are written by the administrator.

                            </small>

                        </div>

                    </div>


                   

                    <div class="col-md-12">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-save"></i>

                            Save Zone & Notes

                        </button>

                    </div>

                </div>

            </form>


            <hr class="my-4" />


           

            <div class="action-buttons">


               

                <a asp-controller="Admin"
                   asp-action="DeliveryBoys"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>


               

                @if (Model.VerificationStatus == "Pending")
                {

                    <form asp-controller="Admin"
                          asp-action="ApproveDelivery"
                          asp-route-id="@Model.UserId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirm('Are you sure you want to approve this delivery boy?');">

                            <i class="bi bi-check-circle"></i>

                            Approve

                        </button>

                    </form>


                   

                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#rejectModal">

                        <i class="bi bi-x-circle"></i>

                        Reject

                    </button>

                }


                @if (Model.User != null && Model.User.Status)
                {

                    <form asp-controller="Admin"
                          asp-action="DisableDelivery"
                          asp-route-id="@Model.UserId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger"
                                onclick="return confirm('Are you sure you want to disable this delivery boy account?');">

                            <i class="bi bi-person-x"></i>

                            Disable Account

                        </button>

                    </form>

                }
                else
                {

                    <form asp-controller="Admin"
                          asp-action="EnableDelivery"
                          asp-route-id="@Model.UserId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-success">

                            <i class="bi bi-person-check"></i>

                            Enable Account

                        </button>

                    </form>

                }

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="rejectModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    <i class="bi bi-x-circle"></i>

                    Reject Delivery Boy

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">

                </button>

            </div>


            <form asp-controller="Admin"
                  asp-action="RejectDelivery"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-body">

                  

                    <input type="hidden"
                           name="id"
                           value="@Model.UserId" />


                    <div class="mb-3">

                        <label class="form-label">

                            Rejection Reason

                        </label>

                        <textarea name="rejectionReason"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Write the reason for rejecting this delivery boy..."
                                  required></textarea>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-x-circle"></i>

                        Reject Delivery Boy

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>