@model IEnumerable<WeddingClosetHubs.Models.Payment>

@{
    ViewData["Title"] = "Commissions";
    Layout = null;

    decimal totalProductAmount = Model?.Sum(x => x.ProductAmount) ?? 0;
    decimal totalCommission = Model?.Sum(x => x.Commission) ?? 0;
    decimal totalDeliveryCharges = Model?.Sum(x => x.DeliveryCharges) ?? 0;
    decimal totalAmount = Model?.Sum(x => x.TotalAmount) ?? 0;
    decimal totalShopkeeperAmount = Model?.Sum(x => x.ShopkeeperAmount) ?? 0;

    int totalPayments = Model?.Count() ?? 0;
    int paidShopkeepers = Model?.Count(x => x.ShopkeeperPaymentStatus == "Paid") ?? 0;
    int pendingShopkeepers = Model?.Count(x => x.ShopkeeperPaymentStatus != "Paid") ?? 0;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Commissions - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f6fa;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-container {
            padding: 30px;
        }

        .page-header {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
            color: #343a40;
        }

        .page-header p {
            margin-top: 7px;
            color: #777;
            margin-bottom: 0;
        }

        .back-btn {
            border-radius: 8px;
            padding: 9px 16px;
        }

        

        .summary-card {
            background: white;
            border-radius: 12px;
            padding: 22px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.07);
            height: 100%;
        }

        .summary-icon {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 15px;
        }

        .summary-title {
            color: #777;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .summary-value {
            font-size: 24px;
            font-weight: 700;
            color: #343a40;
        }

        .commission-icon {
            background: #fff3cd;
            color: #856404;
        }

        .sales-icon {
            background: #d1e7dd;
            color: #198754;
        }

        .delivery-icon {
            background: #cff4fc;
            color: #055160;
        }

        .shopkeeper-icon {
            background: #e2e3e5;
            color: #41464b;
        }


        .custom-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .card-header-custom {
            background: #ffc107;
            color: #212529;
            padding: 17px 22px;
        }

        .card-header-custom h5 {
            margin: 0;
            font-weight: 700;
        }

        .table-container {
            padding: 20px;
        }

        .table thead th {
            background: #212529;
            color: white;
            border: none;
            padding: 13px 10px;
            white-space: nowrap;
            font-size: 14px;
        }

        .table tbody td {
            padding: 13px 10px;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background: #f8f9fa;
        }

        .badge {
            padding: 7px 10px;
            border-radius: 6px;
            font-size: 12px;
        }

        .amount {
            font-weight: 600;
        }

        .commission-amount {
            color: #198754;
            font-weight: 700;
        }

        .empty-box {
            text-align: center;
            padding: 70px 20px;
            color: #777;
        }

        .empty-box i {
            font-size: 65px;
            color: #adb5bd;
        }

        .empty-box h5 {
            margin-top: 20px;
            font-weight: 600;
        }

        @@media (max-width: 768px) {

            .page-container {
                padding: 15px;
            }

            .page-header {
                padding: 18px;
            }

            .page-header-content {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .back-btn {
                width: 100%;
            }

        }

    </style>

</head>

<body>

<div class="page-container">

   

    <div class="page-header">

        <div class="page-header-content d-flex justify-content-between align-items-center">

            <div>

                <h2>

                    <i class="bi bi-percent"></i>

                    Commission Management

                </h2>

                <p>
                    Monitor platform commission, delivery charges and shopkeeper payments.
                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-secondary back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>

    </div>


    

    <div class="row">

        

        <div class="col-md-3 mb-4">

            <div class="summary-card">

                <div class="summary-icon sales-icon">

                    <i class="bi bi-cart-check"></i>

                </div>

                <div class="summary-title">

                    Total Product Amount

                </div>

                <div class="summary-value">

                    Rs. @totalProductAmount.ToString("N2")

                </div>

            </div>

        </div>


        

        <div class="col-md-3 mb-4">

            <div class="summary-card">

                <div class="summary-icon commission-icon">

                    <i class="bi bi-percent"></i>

                </div>

                <div class="summary-title">

                    Total Commission

                </div>

                <div class="summary-value">

                    Rs. @totalCommission.ToString("N2")

                </div>

            </div>

        </div>


        
        <div class="col-md-3 mb-4">

            <div class="summary-card">

                <div class="summary-icon delivery-icon">

                    <i class="bi bi-truck"></i>

                </div>

                <div class="summary-title">

                    Delivery Charges

                </div>

                <div class="summary-value">

                    Rs. @totalDeliveryCharges.ToString("N2")

                </div>

            </div>

        </div>


       

        <div class="col-md-3 mb-4">

            <div class="summary-card">

                <div class="summary-icon shopkeeper-icon">

                    <i class="bi bi-shop"></i>

                </div>

                <div class="summary-title">

                    Shopkeeper Payable

                </div>

                <div class="summary-value">

                    Rs. @totalShopkeeperAmount.ToString("N2")

                </div>

            </div>

        </div>

    </div>


   

    <div class="custom-card">

        <div class="card-header-custom">

            <h5>

                <i class="bi bi-table"></i>

                Commission Records

            </h5>

        </div>


        <div class="table-container">

            @if (Model != null && Model.Any())
            {

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Payment ID</th>

                                <th>Order ID</th>

                                <th>Payment Method</th>

                                <th>Product Amount</th>

                                <th>Commission</th>

                                <th>Delivery Charges</th>

                                <th>Customer Total</th>

                                <th>Shopkeeper Amount</th>

                                <th>Shopkeeper Payment</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var payment in Model)
                            {

                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        #@payment.PaymentId
                                    </td>

                                    <td>
                                        #@payment.OrderId
                                    </td>

                                    <td>

                                        @if (payment.PaymentMethod == "COD")
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-cash"></i>
                                                COD
                                            </span>
                                        }
                                        else if (payment.PaymentMethod == "JazzCash")
                                        {
                                            <span class="badge bg-danger">
                                                JazzCash
                                            </span>
                                        }
                                        else if (payment.PaymentMethod == "Easypaisa")
                                        {
                                            <span class="badge bg-success">
                                                Easypaisa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @payment.PaymentMethod
                                            </span>
                                        }

                                    </td>

                                    <td class="amount">

                                        Rs. @payment.ProductAmount.ToString("N2")

                                    </td>

                                    <td class="commission-amount">

                                        Rs. @payment.Commission.ToString("N2")

                                    </td>

                                    <td class="amount">

                                        Rs. @payment.DeliveryCharges.ToString("N2")

                                    </td>

                                    <td class="amount">

                                        Rs. @payment.TotalAmount.ToString("N2")

                                    </td>

                                    <td class="amount">

                                        Rs. @payment.ShopkeeperAmount.ToString("N2")

                                    </td>

                                    <td>

                                        @if (payment.ShopkeeperPaymentStatus == "Paid")
                                        {

                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>

                                                Paid

                                            </span>

                                        }
                                        else if (payment.ShopkeeperPaymentStatus == "Processed")
                                        {

                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-clock"></i>

                                                Processed

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-hourglass-split"></i>

                                                Pending

                                            </span>

                                        }

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                        <tfoot>

                            <tr class="table-light fw-bold">

                                <td colspan="4">

                                    TOTAL

                                </td>

                                <td>

                                    Rs. @totalProductAmount.ToString("N2")

                                </td>

                                <td class="text-success">

                                    Rs. @totalCommission.ToString("N2")

                                </td>

                                <td>

                                    Rs. @totalDeliveryCharges.ToString("N2")

                                </td>

                                <td>

                                    Rs. @totalAmount.ToString("N2")

                                </td>

                                <td>

                                    Rs. @totalShopkeeperAmount.ToString("N2")

                                </td>

                                <td></td>

                            </tr>

                        </tfoot>

                    </table>

                </div>

            }
            else
            {

                <div class="empty-box">

                    <i class="bi bi-percent"></i>

                    <h5>
                        No Commission Records
                    </h5>

                    <p>
                        Commission records will appear here when payments are created.
                    </p>

                </div>

            }

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>