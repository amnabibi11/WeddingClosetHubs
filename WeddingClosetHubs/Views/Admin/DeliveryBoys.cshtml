@model IEnumerable<WeddingClosetHubs.Models.DeliveryBoy>

@{
    ViewData["Title"] = "Manage Delivery Boys";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WeddingClosetHubs</title>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f6fa;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-container {
            padding: 30px;
        }

        .page-header {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

            .page-header h2 {
                margin: 0;
                font-weight: 700;
                color: #343a40;
            }

            .page-header p {
                margin-top: 7px;
                color: #777;
            }

        .back-btn {
            border-radius: 8px;
            padding: 9px 16px;
            font-weight: 500;
        }

        .delivery-card {
            background: white;
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .delivery-card-header {
            background: #ffc107;
            color: #212529;
            padding: 17px 22px;
        }

            .delivery-card-header h5 {
                margin: 0;
                font-weight: 700;
            }

        .table-container {
            padding: 20px;
        }

        .table {
            margin-bottom: 0;
        }

            .table thead th {
                background: #212529;
                color: white;
                border: none;
                padding: 13px 10px;
                white-space: nowrap;
                font-size: 14px;
            }

            .table tbody td {
                padding: 13px 10px;
                vertical-align: middle;
            }

            .table tbody tr:hover {
                background: #f8f9fa;
            }

        .delivery-name {
            font-weight: 600;
            color: #343a40;
        }

        .badge {
            font-size: 12px;
            padding: 7px 10px;
            border-radius: 6px;
        }

        .btn-details {
            background: #0d6efd;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 6px;
            font-size: 13px;
        }

            .btn-details:hover {
                background: #0b5ed7;
                color: white;
            }

        .empty-box {
            text-align: center;
            padding: 70px 20px;
            color: #777;
        }

            .empty-box i {
                font-size: 65px;
                color: #adb5bd;
            }

            .empty-box h5 {
                margin-top: 20px;
                font-weight: 600;
                color: #555;
            }

        .alert {
            border-radius: 8px;
        }

        @@media (max-width: 768px) {

            .page-container {
                padding: 15px;
            }

            .page-header {
                padding: 18px;
            }

            .page-header-content {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .back-btn {
                width: 100%;
            }
        }

    </style>

</head>

<body>

    <div class="page-container">

        <div class="page-header">

            <div class="page-header-content d-flex justify-content-between align-items-center">

                <div>

                    <h2>
                        <i class="bi bi-bicycle"></i>
                        Delivery Boys
                    </h2>

                    <p class="mb-0">
                        Manage registered delivery boys and verify their accounts.
                    </p>

                </div>

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="btn btn-secondary back-btn">

                    <i class="bi bi-arrow-left"></i>
                    Back to Dashboard

                </a>

            </div>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle-fill"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <div class="delivery-card">

            <div class="delivery-card-header">

                <h5>

                    <i class="bi bi-bicycle"></i>

                    Registered Delivery Boys

                </h5>

            </div>


            <div class="table-container">

                @if (Model != null && Model.Any())
                {

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle">

                            <thead>

                                <tr>

                                    <th>#</th>

                                    <th>Name</th>

                                    <th>Email</th>

                                    <th>Phone</th>

                                    <th>CNIC</th>

                                    <th>Motorbike No.</th>

                                    <th>Preferred Zone</th>

                                    <th>Assigned Zone</th>

                                    <th>Verification</th>

                                    <th>Account</th>

                                    <th>Action</th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int count = 1;
                                }

                                @foreach (var delivery in Model)
                                {

                                    <tr>



                                        <td>
                                            @count
                                        </td>




                                        <td>

                                            <span class="delivery-name">

                                                @(delivery.User?.Name ?? "N/A")

                                            </span>

                                        </td>



                                        <td>

                                            @(delivery.User?.Email ?? "N/A")

                                        </td>



                                        <td>

                                            @(string.IsNullOrEmpty(delivery.User?.Phone)
                                                                                ? "N/A"
                                                                                : delivery.User.Phone)

                                        </td>




                                        <td>

                                            @(string.IsNullOrEmpty(delivery.CNIC)
                                                                                ? "N/A"
                                                                                : delivery.CNIC)

                                        </td>



                                        <td>

                                            @(string.IsNullOrEmpty(delivery.MotorbikeNumber)
                                                                                ? "N/A"
                                                                                : delivery.MotorbikeNumber)

                                        </td>




                                        <td>

                                            @(string.IsNullOrEmpty(delivery.PreferredZone)
                                                                                ? "N/A"
                                                                                : delivery.PreferredZone)

                                </td>




                                        <td>

                                    @if (string.IsNullOrEmpty(delivery.AssignedZone))
                                            {
                                                <span class="badge bg-secondary">
                                                    Not Assigned
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">
                                                    @delivery.AssignedZone
                                                </span>
                                            }

                                        </td>




                                        <td>

                                            @if (delivery.VerificationStatus == "Approved")
                                            {
                                                <span class="badge bg-success">

                                                    <i class="bi bi-check-circle"></i>

                                                    Approved

                                                </span>
                                            }
                                            else if (delivery.VerificationStatus == "Rejected")
                                            {
                                                <span class="badge bg-danger">

                                                    <i class="bi bi-x-circle"></i>

                                                    Rejected

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">

                                                    <i class="bi bi-clock"></i>

                                                    Pending

                                                </span>
                                            }

                                        </td>




                                        <td>

                                            @if (delivery.User != null &&
                                                                                delivery.User.Status)
                                            {
                                                <span class="badge bg-success">

                                                    <i class="bi bi-person-check"></i>

                                                    Active

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">

                                                    <i class="bi bi-person-x"></i>

                                                    Disabled

                                                </span>
                                            }

                                        </td>




                                        <td>

                                            <a asp-controller="Admin"
                                               asp-action="DeliveryDetails"
                                               asp-route-id="@delivery.DeliveryBoyId"
                                               class="btn btn-details">

                                                <i class="bi bi-eye-fill"></i>

                                                Details

                                            </a>

                                        </td>

                                    </tr>

                                    count++;

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="empty-box">

                        <i class="bi bi-bicycle"></i>

                        <h5>
                            No Delivery Boys Found
                        </h5>

                        <p>
                            There are currently no registered delivery boys.
                        </p>

                    </div>

                }

            </div>

        </div>

    </div>




    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>