@model IEnumerable<WeddingClosetHubs.Models.User>

@{
    ViewData["Title"] = "User Accounts";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>User Accounts - Wedding Closet Hubs</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f6fa;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-container {
            padding: 30px;
        }

        /* =====================================================
           PAGE HEADER
        ====================================================== */

        .page-header {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
            color: #343a40;
        }

        .page-header p {
            margin-top: 7px;
            color: #777;
        }

        .back-btn {
            border-radius: 8px;
            padding: 9px 16px;
            font-weight: 500;
        }

        /* =====================================================
           USER CARD
        ====================================================== */

        .user-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .user-card-header {
            background: #212529;
            color: white;
            padding: 17px 22px;
        }

        .user-card-header h5 {
            margin: 0;
            font-weight: 700;
        }

        .table-container {
            padding: 20px;
        }

        /* =====================================================
           TABLE
        ====================================================== */

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #343a40;
            color: white;
            border: none;
            padding: 13px 10px;
            white-space: nowrap;
            font-size: 14px;
        }

        .table tbody td {
            padding: 13px 10px;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background: #f8f9fa;
        }

        .user-name {
            font-weight: 600;
            color: #343a40;
        }

        /* =====================================================
           BADGES
        ====================================================== */

        .badge {
            padding: 7px 10px;
            border-radius: 6px;
            font-size: 12px;
        }

        /* =====================================================
           DETAILS BUTTON
        ====================================================== */

        .btn-details {
            background: #0d6efd;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 6px;
            font-size: 13px;
        }

        .btn-details:hover {
            background: #0b5ed7;
            color: white;
        }

        /* =====================================================
           EMPTY
        ====================================================== */

        .empty-box {
            text-align: center;
            padding: 70px 20px;
            color: #777;
        }

        .empty-box i {
            font-size: 65px;
            color: #adb5bd;
        }

        .empty-box h5 {
            margin-top: 20px;
            font-weight: 600;
            color: #555;
        }

        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @@media (max-width: 768px) {

            .page-container {
                padding: 15px;
            }

            .page-header {
                padding: 18px;
            }

            .page-header-content {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .back-btn {
                width: 100%;
            }

        }

    </style>

</head>


<body>

<div class="page-container">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="page-header">

        <div class="page-header-content d-flex justify-content-between align-items-center">

            <div>

                <h2>

                    <i class="bi bi-people-fill"></i>

                    User Accounts

                </h2>

                <p class="mb-0">

                    View and manage all registered user accounts.

                </p>

            </div>


            <div>

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="btn btn-secondary back-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back to Dashboard

                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SUCCESS MESSAGE
    ====================================================== -->

    @if (TempData["Success"] != null)
    {

        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>

    }


    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->

    @if (TempData["Error"] != null)
    {

        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>

    }


    <!-- =====================================================
         USER ACCOUNTS CARD
    ====================================================== -->

    <div class="user-card">


        <!-- CARD HEADER -->

        <div class="user-card-header">

            <h5>

                <i class="bi bi-person-lines-fill"></i>

                All Registered Users

            </h5>

        </div>


        <!-- CARD BODY -->

        <div class="table-container">


            @if (Model != null && Model.Any())
            {

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">


                        <!-- =================================================
                             TABLE HEADER
                        ================================================== -->

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Name</th>

                                <th>Email</th>

                                <th>Phone</th>

                                <th>Address</th>

                                <th>Role</th>

                                <th>Status</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <!-- =================================================
                             TABLE BODY
                        ================================================== -->

                        <tbody>

                            @{
                                int count = 1;
                            }


                            @foreach (var user in Model)
                            {

                                <tr>


                                    <!-- =====================================
                                         NUMBER
                                    ====================================== -->

                                    <td>

                                        @count

                                    </td>


                                    <!-- =====================================
                                         NAME
                                    ====================================== -->

                                    <td>

                                        <span class="user-name">

                                            @(string.IsNullOrEmpty(user.Name)
                                                ? "N/A"
                                                : user.Name)

                                        </span>

                                    </td>


                                    <!-- =====================================
                                         EMAIL
                                    ====================================== -->

                                    <td>

                                        @(string.IsNullOrEmpty(user.Email)
                                            ? "N/A"
                                            : user.Email)

                                    </td>


                                    <!-- =====================================
                                         PHONE
                                    ====================================== -->

                                    <td>

                                        @(string.IsNullOrEmpty(user.Phone)
                                            ? "N/A"
                                            : user.Phone)

                                    </td>


                                    <!-- =====================================
                                         ADDRESS
                                    ====================================== -->

                                    <td>

                                        @(string.IsNullOrEmpty(user.Address)
                                            ? "N/A"
                                            : user.Address)

                                    </td>


                                    <!-- =====================================
                                         ROLE
                                    ====================================== -->

                                    <td>

                                        @if (user.Role != null &&
                                             user.Role.RoleName == "Customer")
                                        {

                                            <span class="badge bg-primary">

                                                <i class="bi bi-person"></i>

                                                Customer

                                            </span>

                                        }
                                        else if (user.Role != null &&
                                                 user.Role.RoleName == "Shopkeeper")
                                        {

                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-shop"></i>

                                                Shopkeeper

                                            </span>

                                        }
                                        else if (user.Role != null &&
                                                 user.Role.RoleName == "Delivery")
                                        {

                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-bicycle"></i>

                                                Delivery

                                            </span>

                                        }
                                        else if (user.Role != null &&
                                                 user.Role.RoleName == "Admin")
                                        {

                                            <span class="badge bg-dark text-white">

                                                <i class="bi bi-shield-check"></i>

                                                Admin

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary">

                                                @(user.Role?.RoleName ?? "No Role")

                                            </span>

                                        }

                                    </td>


                                    <!-- =====================================
                                         STATUS
                                    ====================================== -->

                                    <td>

                                        @if (user.Status)
                                        {

                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>

                                                Active

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle"></i>

                                                Disabled

                                            </span>

                                        }

                                    </td>


                                    <!-- =====================================
                                         DETAILS
                                    ====================================== -->

                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="UserDetails"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-details">

                                            <i class="bi bi-eye-fill"></i>

                                            Details

                                        </a>

                                    </td>


                                </tr>


                                count++;

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <!-- =====================================================
                     NO USERS
                ====================================================== -->

                <div class="empty-box">

                    <i class="bi bi-people"></i>

                    <h5>

                        No Users Found

                    </h5>

                    <p>

                        There are currently no registered users.

                    </p>

                </div>

            }


        </div>

    </div>


</div>


<!-- =====================================================
     BOOTSTRAP JS
====================================================== -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


</body>

</html>