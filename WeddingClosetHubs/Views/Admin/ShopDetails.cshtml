@model WeddingClosetHubs.Models.Shop

@{
    ViewData["Title"] = "Shop Details";

    string verificationStatus =
        string.IsNullOrWhiteSpace(Model.VerificationStatus)
            ? "Pending"
            : Model.VerificationStatus;
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Shop Details
            </h2>

            <p class="text-muted mb-0">
                Review shopkeeper information and verification evidence.
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="Shops"
           class="btn btn-secondary">

            Back to Shops

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h4 class="mb-0">
                @Model.ShopName
            </h4>

        </div>


        <div class="card-body">

            <div class="row">

                <div class="col-md-4 text-center mb-4">

                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <img src="@Model.Logo"
                             alt="@Model.ShopName Logo"
                             class="img-fluid"
                             style="width:220px;
                                    height:220px;
                                    object-fit:cover;
                                    border-radius:12px;
                                    border:1px solid #ddd;" />
                    }
                    else
                    {
                        <div class="border rounded p-5 text-muted">

                            <h5>
                                No Logo
                            </h5>

                            <p class="mb-0">
                                Shop logo is not available.
                            </p>

                        </div>
                    }

                </div>


                <div class="col-md-8">

                    <h5 class="fw-bold border-bottom pb-2 mb-3">
                        Shop Information
                    </h5>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Shop ID:
                        </div>

                        <div class="col-sm-8">
                            @Model.ShopId
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Shop Name:
                        </div>

                        <div class="col-sm-8">
                            @Model.ShopName
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Shop Category:
                        </div>

                        <div class="col-sm-8">
                            @Model.ShopCategory
                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Description:
                        </div>

                        <div class="col-sm-8">

                            @if (!string.IsNullOrEmpty(Model.ShopDescription))
                            {
                                @Model.ShopDescription
                            }
                            else
                            {
                                <span class="text-muted">
                                    No description provided.
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Verification:
                        </div>

                        <div class="col-sm-8">

                            @if (verificationStatus.Equals(
                                "Approved",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (verificationStatus.Equals(
                                "Rejected",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else if (verificationStatus.Equals(
                                "More Evidence Required",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-info text-dark">
                                    More Evidence Required
                                </span>
                            }
                            else if (verificationStatus.Equals(
                                "Under Review",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary">
                                    Under Review
                                </span>
                            }
                            else if (verificationStatus.Equals(
                                "Suspended",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-dark">
                                    Suspended
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Shop Status:
                        </div>

                        <div class="col-sm-8">

                            @if (!Model.IsApproved)
                            {
                                <span class="badge bg-warning text-dark">
                                    Not Approved
                                </span>
                            }
                            else if (Model.Status)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Disabled
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Verification Submitted:
                        </div>

                        <div class="col-sm-8">

                            @if (Model.VerificationSubmittedDate.HasValue)
                            {
                                @Model.VerificationSubmittedDate.Value.ToString(
                                    "dd-MM-yyyy hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Available
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Verified Date:
                        </div>

                        <div class="col-sm-8">

                            @if (Model.VerifiedDate.HasValue)
                            {
                                @Model.VerifiedDate.Value.ToString(
                                    "dd-MM-yyyy hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Verified
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Approved Date:
                        </div>

                        <div class="col-sm-8">

                            @if (Model.ApprovedDate.HasValue)
                            {
                                @Model.ApprovedDate.Value.ToString(
                                    "dd-MM-yyyy hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Approved
                                </span>
                            }

                        </div>

                    </div>


                    <div class="row mb-3">

                        <div class="col-sm-4 fw-bold">
                            Created Date:
                        </div>

                        <div class="col-sm-8">
                            @Model.CreatedDate.ToString(
                                "dd-MM-yyyy hh:mm tt")
                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <h5 class="fw-bold border-bottom pb-2 mb-3">
                Shopkeeper Information
            </h5>


            @if (Model.Shopkeeper != null)
            {

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="fw-bold">
                            Shopkeeper ID
                        </label>

                        <div class="form-control bg-light">
                            @Model.Shopkeeper.UserId
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="fw-bold">
                            Shopkeeper Name
                        </label>

                        <div class="form-control bg-light">
                            @Model.Shopkeeper.Name
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="fw-bold">
                            Email
                        </label>

                        <div class="form-control bg-light">
                            @Model.Shopkeeper.Email
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="fw-bold">
                            Phone
                        </label>

                        <div class="form-control bg-light">

                            @if (!string.IsNullOrEmpty(
                                Model.Shopkeeper.Phone))
                            {
                                @Model.Shopkeeper.Phone
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Provided
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-12 mb-3">

                        <label class="fw-bold">
                            Shopkeeper Address
                        </label>

                        <div class="form-control bg-light">

                            @if (!string.IsNullOrEmpty(
                                Model.Shopkeeper.Address))
                            {
                                @Model.Shopkeeper.Address
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Provided
                                </span>
                            }

                        </div>

                    </div>

                </div>

            }
            else
            {

                <div class="alert alert-warning">

                    <strong>
                        No Shopkeeper Found.
                    </strong>

                    <br />

                    This shop is not currently associated with a shopkeeper.

                </div>

            }


            @if (Model.Shopkeeper != null)
            {

                <hr class="my-4" />


                <h5 class="fw-bold border-bottom pb-2 mb-3">
                    Identity Verification
                </h5>


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="fw-bold">
                            CNIC Number
                        </label>

                        <div class="form-control bg-light">

                            @if (!string.IsNullOrEmpty(
                                Model.Shopkeeper.CNIC))
                            {
                                @Model.Shopkeeper.CNIC
                            }
                            else
                            {
                                <span class="text-danger">
                                    Not Provided
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="fw-bold">
                            Identity Status
                        </label>

                        <div class="form-control bg-light">

                            @if (!string.IsNullOrEmpty(
                                Model.Shopkeeper.CNIC) &&
                                !string.IsNullOrEmpty(
                                    Model.Shopkeeper.CNICFrontImage) &&
                                !string.IsNullOrEmpty(
                                    Model.Shopkeeper.CNICBackImage))
                            {
                                <span class="text-success fw-bold">
                                    Complete
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">
                                    Incomplete
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <div class="row">

                    <div class="col-md-6 text-center mb-4">

                        <h6 class="fw-bold">
                            CNIC Front
                        </h6>

                        @if (!string.IsNullOrEmpty(
                            Model.Shopkeeper.CNICFrontImage))
                        {
                            <a href="@Model.Shopkeeper.CNICFrontImage"
                               target="_blank">

                                <img src="@Model.Shopkeeper.CNICFrontImage"
                                     alt="CNIC Front"
                                     class="img-fluid rounded border"
                                     style="height:240px;
                                            width:100%;
                                            object-fit:contain;
                                            background:#f8f9fa;" />

                            </a>
                        }
                        else
                        {
                            <div class="border rounded p-5 text-danger">
                                CNIC Front Not Provided
                            </div>
                        }

                    </div>


                    <div class="col-md-6 text-center mb-4">

                        <h6 class="fw-bold">
                            CNIC Back
                        </h6>

                        @if (!string.IsNullOrEmpty(
                            Model.Shopkeeper.CNICBackImage))
                        {
                            <a href="@Model.Shopkeeper.CNICBackImage"
                               target="_blank">

                                <img src="@Model.Shopkeeper.CNICBackImage"
                                     alt="CNIC Back"
                                     class="img-fluid rounded border"
                                     style="height:240px;
                                            width:100%;
                                            object-fit:contain;
                                            background:#f8f9fa;" />

                            </a>
                        }
                        else
                        {
                            <div class="border rounded p-5 text-danger">
                                CNIC Back Not Provided
                            </div>
                        }

                    </div>

                </div>

            }


            <hr class="my-4" />


            <h5 class="fw-bold border-bottom pb-2 mb-3">
                Shop Contact Information
            </h5>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="fw-bold">
                        Shop Email
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            @Model.Email
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Provided
                            </span>
                        }

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label class="fw-bold">
                        Shop Phone
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrEmpty(Model.ShopPhone))
                        {
                            @Model.ShopPhone
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Provided
                            </span>
                        }

                    </div>

                </div>


                <div class="col-md-12 mb-3">

                    <label class="fw-bold">
                        Shop Address
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrEmpty(Model.ShopAddress))
                        {
                            @Model.ShopAddress
                        }
                        else
                        {
                            <span class="text-muted">
                                Not Provided
                            </span>
                        }

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <h5 class="fw-bold border-bottom pb-2 mb-3">
                Shop Verification Photos
            </h5>


            <div class="row">

                <div class="col-md-4 text-center mb-4">

                    <h6 class="fw-bold">
                        Shop Front
                    </h6>

                    @if (!string.IsNullOrEmpty(Model.ShopFrontPhoto))
                    {
                        <a href="@Model.ShopFrontPhoto"
                           target="_blank">

                            <img src="@Model.ShopFrontPhoto"
                                 alt="Shop Front"
                                 class="img-fluid rounded border"
                                 style="height:220px;
                                        width:100%;
                                        object-fit:cover;" />

                        </a>
                    }
                    else
                    {
                        <div class="border rounded p-5 text-danger">
                            No Photo
                        </div>
                    }

                </div>


                <div class="col-md-4 text-center mb-4">

                    <h6 class="fw-bold">
                        Shop Inside
                    </h6>

                    @if (!string.IsNullOrEmpty(Model.ShopInsidePhoto))
                    {
                        <a href="@Model.ShopInsidePhoto"
                           target="_blank">

                            <img src="@Model.ShopInsidePhoto"
                                 alt="Shop Inside"
                                 class="img-fluid rounded border"
                                 style="height:220px;
                                        width:100%;
                                        object-fit:cover;" />

                        </a>
                    }
                    else
                    {
                        <div class="border rounded p-5 text-danger">
                            No Photo
                        </div>
                    }

                </div>


                <div class="col-md-4 text-center mb-4">

                    <h6 class="fw-bold">
                        Shop Signboard
                    </h6>

                    @if (!string.IsNullOrEmpty(Model.ShopSignboardPhoto))
                    {
                        <a href="@Model.ShopSignboardPhoto"
                           target="_blank">

                            <img src="@Model.ShopSignboardPhoto"
                                 alt="Shop Signboard"
                                 class="img-fluid rounded border"
                                 style="height:220px;
                                        width:100%;
                                        object-fit:cover;" />

                        </a>
                    }
                    else
                    {
                        <div class="border rounded p-5 text-danger">
                            No Photo
                        </div>
                    }

                </div>

            </div>


            <hr class="my-4" />


            <h5 class="fw-bold border-bottom pb-2 mb-3">
                Shop Association Verification
            </h5>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="fw-bold">
                        Verification Proof Type
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrEmpty(
                            Model.ShopProofType))
                        {
                            @Model.ShopProofType
                        }
                        else
                        {
                            <span class="text-danger">
                                Not Provided
                            </span>
                        }

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label class="fw-bold">
                        Verification Proof Status
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrEmpty(
                            Model.ShopProofDocument))
                        {
                            <span class="text-success fw-bold">
                                Document Uploaded
                            </span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold">
                                Document Not Provided
                            </span>
                        }

                    </div>

                </div>

            </div>


            <div class="row">

                <div class="col-md-12 mb-3">

                    <label class="fw-bold">
                        Verification Proof Document
                    </label>

                    @if (!string.IsNullOrEmpty(
                        Model.ShopProofDocument))
                    {
                        <div class="border rounded p-3 bg-light">

                            <a href="@Model.ShopProofDocument"
                               target="_blank"
                               class="btn btn-primary">

                                View Verification Document

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="border rounded p-3 text-danger">
                            No verification document uploaded.
                        </div>
                    }

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
            {

                <div class="alert alert-info">

                    <strong>
                        Admin Notes:
                    </strong>

                    <div class="mt-2">
                        @Model.AdminNotes
                    </div>

                </div>

            }


            @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
            {

                <div class="alert alert-danger">

                    <strong>
                        Rejection Reason:
                    </strong>

                    <div class="mt-2">
                        @Model.RejectionReason
                    </div>

                </div>

            }


            <hr class="my-4" />


            <h5 class="fw-bold border-bottom pb-2 mb-3">
                Admin Verification Decision
            </h5>


            @if (!Model.IsApproved)
            {

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <form asp-controller="Admin"
                              asp-action="ApproveShop"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.ShopId" />

                            <button type="submit"
                                    class="btn btn-success w-100">

                                Approve Shop

                            </button>

                        </form>

                    </div>


                    <div class="col-md-4 mb-3">

                        <button type="button"
                                class="btn btn-info text-dark w-100"
                                data-bs-toggle="modal"
                                data-bs-target="#moreEvidenceModal">

                            Request More Evidence

                        </button>

                    </div>


                    <div class="col-md-4 mb-3">

                        <button type="button"
                                class="btn btn-danger w-100"
                                data-bs-toggle="modal"
                                data-bs-target="#rejectShopModal">

                            Reject Shop

                        </button>

                    </div>

                </div>

            }


            @if (Model.IsApproved && Model.Status)
            {

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <form asp-controller="Admin"
                              asp-action="DisableShop"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.ShopId" />

                            <button type="submit"
                                    class="btn btn-warning w-100">

                                Disable Shop

                            </button>

                        </form>

                    </div>


                    <div class="col-md-6 mb-3">

                        <div class="alert alert-success mb-0 text-center">
                            This shop is verified, approved and active.
                        </div>

                    </div>

                </div>

            }


            @if (Model.IsApproved && !Model.Status)
            {

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <form asp-controller="Admin"
                              asp-action="EnableShop"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.ShopId" />

                            <button type="submit"
                                    class="btn btn-success w-100">

                                Enable Shop

                            </button>

                        </form>

                    </div>


                    <div class="col-md-6 mb-3">

                        <div class="alert alert-warning mb-0 text-center">
                            This shop is approved but currently disabled.
                        </div>

                    </div>

                </div>

            }


            <div class="mt-3">

                <a asp-controller="Admin"
                   asp-action="Shops"
                   class="btn btn-secondary">

                    Back to Shops

                </a>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="moreEvidenceModal"
     tabindex="-1"
     aria-labelledby="moreEvidenceModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="moreEvidenceModalLabel">

                    Request More Evidence

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-controller="Admin"
                  asp-action="RequestMoreShopEvidence"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           name="id"
                           value="@Model.ShopId" />

                    <label class="form-label fw-bold">
                        What additional evidence is required?
                    </label>

                    <textarea name="adminNotes"
                              class="form-control"
                              rows="5"
                              required
                              placeholder="Example: Please provide a clearer CNIC back image or a recent utility bill matching the shop address."></textarea>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-info text-dark">

                        Request Evidence

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<div class="modal fade"
     id="rejectShopModal"
     tabindex="-1"
     aria-labelledby="rejectShopModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="rejectShopModalLabel">

                    Reject Shop Application

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-controller="Admin"
                  asp-action="RejectShop"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           name="id"
                           value="@Model.ShopId" />

                    <label class="form-label fw-bold">
                        Rejection Reason
                    </label>

                    <textarea name="rejectionReason"
                              class="form-control"
                              rows="5"
                              required
                              placeholder="Enter the reason for rejecting this shop application."></textarea>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        Reject Shop

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>