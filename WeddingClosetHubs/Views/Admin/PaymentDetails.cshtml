                }
                else
                {
                    <div class="text-center text-danger">

                        <i class="bi bi-person-x fs-2"></i>

                        <h5 class="mt-2">

                            No Delivery Boy Assigned

                        </h5>

                        <p class="mb-0">

                            A delivery boy must be assigned before
                            delivery payment can be made.

                        </p>

                    </div>
                }

            </div>

        </div>

    </div>


    

    <!-- ================================================= -->
    <!-- MANUAL PAYMENT PROCEDURE -->
    <!-- ================================================= -->

    <div class="custom-card">

        <div class="custom-card-header header-dark">

            <i class="bi bi-info-circle"></i>

            Manual Payment Procedure

        </div>

        <div class="custom-card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <div class="amount-box h-100">

                        <div class="amount-label">

                            <strong>Step 1</strong>

                        </div>

                        <div class="mt-2">

                            Confirm that the customer payment
                            has actually been received.

                            For COD, Admin must first confirm
                            cash handover.

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="amount-box h-100">

                        <div class="amount-label">

                            <strong>Step 2</strong>

                        </div>

                        <div class="mt-2">

                            Open Easypaisa or JazzCash outside
                            this website and manually transfer
                            the shopkeeper or delivery payout.

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="amount-box h-100">

                        <div class="amount-label">

                            <strong>Step 3</strong>

                        </div>

                        <div class="mt-2">

                            Enter the actual transaction/reference
                            ID and record the payment.

                        </div>

                    </div>

                </div>

            </div>


            <div class="alert alert-warning mt-3 mb-0">

                <i class="bi bi-shield-check"></i>

                <strong>Important:</strong>

                Wedding Closet Hubs does not automatically transfer
                money through Easypaisa or JazzCash.

                The website only stores the payment record,
                account information and transaction/reference ID.

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- ACTION BUTTONS -->
    <!-- ================================================= -->

    <div class="custom-card">

        <div class="custom-card-header header-primary">

            <i class="bi bi-arrow-left-right"></i>

            Navigation

        </div>

        <div class="custom-card-body">

            <div class="action-buttons">

                <a asp-controller="Admin"
                   asp-action="Payments"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back to Payments

                </a>

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="btn btn-outline-dark">

                    <i class="bi bi-speedometer2"></i>

                    Dashboard

                </a>

            </div>

        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>