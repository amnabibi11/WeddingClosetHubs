    <!-- ================================================= -->
    <!-- SHOPKEEPER SETTLEMENT -->
    <!-- ================================================= -->

    <div class="custom-card">

        <div class="custom-card-header header-success">

            <i class="bi bi-shop"></i>

            Shopkeeper Settlement

        </div>

        <div class="custom-card-body">

            <div class="shopkeeper-box">

                <div class="row">

                    <div class="col-md-7">

                        <h5>

                            <i class="bi bi-shop"></i>

                            @(Model.Shop?.ShopName ?? "N/A")

                        </h5>

                        <p class="mb-2">

                            Shopkeeper:

                            <strong>
                                @(Model.Shop?.Shopkeeper?.Name ?? "N/A")
                            </strong>

                        </p>

                        <p class="mb-2">

                            Product Amount Payable:

                            <strong>

                                Rs. @Model.ShopkeeperAmount.ToString("N2")

                            </strong>

                        </p>

                        <p class="mb-0">

                            Platform Service Fee:

                            <strong>

                                Rs. @Model.ServiceFee.ToString("N2")

                            </strong>

                        </p>

                    </div>


                    <div class="col-md-5">

                        <div class="account-box">

                            <div class="account-title">

                                <i class="bi bi-phone"></i>

                                Shopkeeper Payment Account

                            </div>

                            @if (Model.Shop?.Shopkeeper != null)
                            {
                                @if (!string.IsNullOrWhiteSpace(
                                    Model.Shop.Shopkeeper.PaymentAccount))
                                {
                                    <div class="account-row">

                                        <span class="account-label">
                                            Payment Method
                                        </span>

                                        <span class="account-number">

                                            @(Model.Shop.Shopkeeper.PaymentMethod
                                                ?? "Not Added")

                                        </span>

                                    </div>

                                    <div class="account-row">

                                        <span class="account-label">
                                            Account
                                        </span>

                                        <span class="account-number">

                                            @Model.Shop.Shopkeeper.PaymentAccount

                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="text-danger">

                                        <i class="bi bi-exclamation-circle"></i>

                                        Payment account not added by shopkeeper.

                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted">

                                    Shopkeeper information not available.

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <hr />


                <!-- SHOPKEEPER STATUS -->

                <div class="row align-items-center">

                    <div class="col-md-8">

                        <strong>

                            Shopkeeper Payout:

                            Rs. @Model.ShopkeeperAmount.ToString("N2")

                        </strong>

                    </div>

                    <div class="col-md-4 text-md-end">

                        @if (shopkeeperPaid)
                        {
                            <span class="status-badge bg-success text-white">

                                <i class="bi bi-check-circle"></i>

                                Paid

                            </span>
                        }
                        else if (!customerPaymentReceived)
                        {
                            <span class="status-badge bg-secondary text-white">

                                <i class="bi bi-lock"></i>

                                Awaiting Customer Payment

                            </span>
                        }
                        else
                        {
                            <span class="status-badge bg-warning text-dark">

                                <i class="bi bi-clock"></i>

                                Payout Pending

                            </span>
                        }

                    </div>

                </div>


                <!-- ALREADY PAID DETAILS -->

                @if (shopkeeperPaid)
                {
                    <div class="already-paid-box">

                        <div class="already-paid-title">

                            <i class="bi bi-check-circle-fill"></i>

                            Shopkeeper Payment Recorded

                        </div>

                        <div class="payment-record-row">

                            <span class="payment-record-label">
                                Amount Paid
                            </span>

                            <span class="payment-record-value">
                                Rs. @Model.ShopkeeperPaidAmount.ToString("N2")
                            </span>

                        </div>

                        <div class="payment-record-row">

                            <span class="payment-record-label">
                                Payment Method
                            </span>

                            <span class="payment-record-value">
                                @(Model.ShopkeeperPaymentMethod ?? "N/A")
                            </span>

                        </div>

                        <div class="payment-record-row">

                            <span class="payment-record-label">
                                Account
                            </span>

                            <span class="payment-record-value">
                                @(Model.ShopkeeperPaymentAccount ?? "N/A")
                            </span>

                        </div>

                        <div class="payment-record-row">

                            <span class="payment-record-label">
                                Transaction / Reference ID
                            </span>

                            <span class="payment-record-value">
                                @(Model.ShopkeeperTransactionId ?? "N/A")
                            </span>

                        </div>

                        <div class="payment-record-row">

                            <span class="payment-record-label">
                                Payment Date
                            </span>

                            <span class="payment-record-value">

                                @(Model.ShopkeeperPaymentDate.HasValue
                                    ? Model.ShopkeeperPaymentDate.Value.ToString("dd MMMM yyyy hh:mm tt")
                                    : "N/A")

                            </span>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            Model.ShopkeeperPaymentNotes))
                        {
                            <div class="payment-record-row">

                                <span class="payment-record-label">
                                    Admin Notes
                                </span>

                                <span class="payment-record-value">
                                    @Model.ShopkeeperPaymentNotes
                                </span>

                            </div>
                        }

                    </div>
                }


                <!-- MANUAL SHOPKEEPER PAYMENT -->

                @if (customerPaymentReceived &&
                     !shopkeeperPaid)
                {
                    @if (Model.Shop?.Shopkeeper != null &&
                         !string.IsNullOrWhiteSpace(
                             Model.Shop.Shopkeeper.PaymentAccount))
                    {
                        <div class="manual-payment-box">

                            <div class="manual-payment-title">

                                <i class="bi bi-send"></i>

                                Record Manual Shopkeeper Payment

                            </div>

                            <div class="manual-payment-text">

                                First send the amount manually through
                                the shopkeeper's Easypaisa or JazzCash account.
                                After the transfer is completed, enter the
                                transaction/reference ID below and record it
                                in the website.

                            </div>


                            <form asp-controller="Admin"
                                  asp-action="RecordShopkeeperPayment"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="orderId"
                                       value="@Model.OrderId" />

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Amount Paid
                                        </label>

                                        <input type="number"
                                               class="form-control"
                                               name="paidAmount"
                                               value="@Model.ShopkeeperAmount.ToString("0.00")"
                                               min="0.01"
                                               step="0.01"
                                               required />

                                        <small class="text-muted">

                                            Expected:
                                            Rs. @Model.ShopkeeperAmount.ToString("N2")

                                        </small>

                                    </div>


                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Payment Method
                                        </label>

                                        <select name="paymentMethod"
                                                class="form-select"
                                                required>

                                            <option value="">
                                                Select Method
                                            </option>

                                            <option value="Easypaisa"
                                                    selected="@(string.Equals(
                                                        Model.Shop.Shopkeeper.PaymentMethod,
                                                        "Easypaisa",
                                                        StringComparison.OrdinalIgnoreCase))">

                                                Easypaisa

                                            </option>

                                            <option value="JazzCash"
                                                    selected="@(string.Equals(
                                                        Model.Shop.Shopkeeper.PaymentMethod,
                                                        "JazzCash",
                                                        StringComparison.OrdinalIgnoreCase))">

                                                JazzCash

                                            </option>

                                        </select>

                                    </div>


                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Payment Account
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="paymentAccount"
                                               value="@Model.Shop.Shopkeeper.PaymentAccount"
                                               readonly />

                                    </div>


                                    <div class="col-md-6">

                                        <label class="form-label">

                                            Transaction / Reference ID

                                            <span class="text-danger">*</span>

                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="transactionId"
                                               maxlength="100"
                                               placeholder="Enter Easypaisa/JazzCash transaction ID"
                                               required />

                                    </div>


                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Payment Date
                                        </label>

                                        <input type="datetime-local"
                                               class="form-control"
                                               name="paymentDate"
                                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                               required />

                                    </div>


                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Admin Notes
                                        </label>

                                        <input type="text"
                                               class="form-control"
                                               name="notes"
                                               maxlength="500"
                                               placeholder="Optional payment notes" />

                                    </div>


                                    <div class="col-md-12">

                                        <div class="warning-box">

                                            <i class="bi bi-exclamation-triangle-fill"></i>

                                            <strong>Important:</strong>

                                            This button does not send money.
                                            Make the actual transfer through
                                            Easypaisa/JazzCash first, then click
                                            <strong>Record Payment</strong>.

                                        </div>

                                    </div>


                                    <div class="col-md-12">

                                        <button type="submit"
                                                class="btn btn-success record-btn"
                                                onclick="return confirm('Confirm that you have already transferred the shopkeeper amount through Easypaisa or JazzCash and entered the correct transaction ID?');">

                                            <i class="bi bi-check-circle"></i>

                                            Record Shopkeeper Payment

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </div>
                    }
                    else
                    {
                        <div class="danger-box">

                            <i class="bi bi-exclamation-triangle-fill"></i>

                            <strong>Cannot Record Payment:</strong>

                            The shopkeeper has not added a valid
                            Easypaisa/JazzCash payment account.

                        </div>
                    }
                }

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- DELIVERY BOY SETTLEMENT -->
    <!-- ================================================= -->

    <div class="custom-card">

        <div class="custom-card-header header-primary">

            <i class="bi bi-bicycle"></i>

            Delivery Boy Settlement

        </div>

        <div class="custom-card-body">

            <div class="delivery-box">

                @if (Model.Delivery != null)
                {
                    <div class="row">

                        <div class="col-md-7">

                            <h5>

                                <i class="bi bi-person-badge"></i>

                                @(Model.Delivery.Name ?? "N/A")

                            </h5>

                            <p class="mb-2">

