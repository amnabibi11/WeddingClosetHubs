                                            <input type="number"
                                                   class="form-control"
                                                   value="@Model.DeliveryCharges.ToString("0.00")"
                                                   min="0.01"
                                                   step="0.01"
                                                   readonly />

                                            <small class="text-muted">

                                                Delivery payout:
                                                Rs. @Model.DeliveryCharges.ToString("N2")

                                            </small>

                                        </div>


                                        <!-- ================================================= -->
                                        <!-- PAYMENT METHOD - READONLY -->
                                        <!-- ================================================= -->

                                        <div class="col-md-6">

                                            <label class="form-label">

                                                Payment Method

                                            </label>

                                            <input type="text"
                                                   class="form-control"
                                                   value="@deliveryPaymentMethod"
                                                   readonly />

                                            <small class="text-muted">

                                                This payment method was saved
                                                by the delivery boy.

                                            </small>

                                        </div>


                                        <!-- ================================================= -->
                                        <!-- PAYMENT ACCOUNT - READONLY -->
                                        <!-- ================================================= -->

                                        <div class="col-md-6">

                                            <label class="form-label">

                                                Payment Account

                                            </label>

                                            <input type="text"
                                                   class="form-control"
                                                   value="@deliveryPaymentAccount"
                                                   readonly />

                                            <small class="text-muted">

                                                This account was saved by the
                                                delivery boy.

                                            </small>

                                        </div>


                                        <!-- ================================================= -->
                                        <!-- TRANSACTION ID -->
                                        <!-- ================================================= -->

                                        <div class="col-md-6">

                                            <label class="form-label">

