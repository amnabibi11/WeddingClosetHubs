                                                first.

                                                Then enter the actual
                                                transaction ID and click

                                                <strong>
                                                    Record Delivery Payment
                                                </strong>.

                                            </div>

                                        </div>


                                        <!-- ================================================= -->
                                        <!-- RECORD BUTTON -->
                                        <!-- ================================================= -->

                                        <div class="col-md-12">

                                            <button type="submit"
                                                    class="btn btn-primary record-btn"
                                                    onclick="return confirm('Confirm that you have already transferred the delivery boy amount through Easypaisa or JazzCash and entered the correct transaction ID?');">

                                                <i class="bi bi-check-circle"></i>

                                                Record Delivery Payment

                                            </button>

                                        </div>

                                    </div>

                                </form>

                            </div>
                        }
                        else
                        {
                            <div class="danger-box">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                <strong>Cannot Record Payment:</strong>

                                The delivery boy has not added a valid
