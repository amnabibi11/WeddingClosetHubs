@model WeddingClosetHubs.Models.Order

@{
    ViewData["Title"] = "Payment Details";
    Layout = null;

    bool isCod =
        string.Equals(
            Model.PaymentMethod,
            "Cash on Delivery",
            StringComparison.OrdinalIgnoreCase);

    bool isCancelled =
        string.Equals(
            Model.OrderStatus,
            "Cancelled",
            StringComparison.OrdinalIgnoreCase);

    bool codCollected =
        Model.DeliveryCollectedAmount > 0;

    bool codHandedOver =
        Model.DeliveryCashHandedToAdmin;

    bool customerPaymentReceived =
        Model.PaymentReceived &&
        string.Equals(
            Model.PaymentStatus,
            "Paid",
            StringComparison.OrdinalIgnoreCase);

    bool shopkeeperPaid =
        string.Equals(
            Model.ShopkeeperPaymentStatus,
            "Paid",
            StringComparison.OrdinalIgnoreCase);

    bool deliveryPaid =
        string.Equals(
            Model.DeliveryPaymentStatus,
            "Paid",
            StringComparison.OrdinalIgnoreCase);


    // =========================================================
    // DELIVERY BOY SAVED PAYMENT SETTINGS
    // These values come from DeliveryBoy table through
    // AdminController.PaymentDetails()
    // =========================================================

    string deliveryPaymentMethod =
        ViewBag.DeliveryPaymentMethod as string ?? "";

    string deliveryPaymentAccount =
        ViewBag.DeliveryPaymentAccount as string ?? "";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Payment Details - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-wrapper {
            padding: 30px;
        }

        .page-header {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 0;
        }

        .custom-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 25px;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .custom-card-header {
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 600;
            color: white;
        }

        .header-primary {
            background: #0d6efd;
        }

        .header-success {
            background: #198754;
        }

        .header-warning {
            background: #ffc107;
            color: #212529;
        }

        .header-danger {
            background: #dc3545;
        }

        .header-info {
            background: #0dcaf0;
            color: #212529;
        }

        .header-dark {
            background: #212529;
        }

        .custom-card-body {
            padding: 25px;
        }

        .info-group {
            margin-bottom: 20px;
        }

        .info-label {
            display: block;
            font-weight: 600;
            color: #555;
            margin-bottom: 7px;
            font-size: 14px;
        }

        .info-value {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 7px;
            padding: 11px 14px;
            min-height: 45px;
            display: flex;
            align-items: center;
            word-break: break-word;
        }

        .amount-box {
            background: #f8f9fa;
            border: 1px solid #e1e5ea;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 12px;
        }

        .amount-label {
            color: #666;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .amount-value {
            font-weight: 700;
            font-size: 18px;
        }

        .total-box {
            background: #212529;
            color: white;
            border-radius: 8px;
            padding: 18px;
            margin-top: 15px;
        }

        .total-box .amount-value {
            font-size: 24px;
        }

        .commission-box {
            background: #fff8e1;
            border: 1px solid #ffe69c;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 12px;
        }

        .shopkeeper-box {
            background: #eaf7ef;
            border: 1px solid #b7e4c7;
            border-radius: 10px;
            padding: 20px;
        }

        .delivery-box {
            background: #eef5ff;
            border: 1px solid #b8d4ff;
            border-radius: 10px;
            padding: 20px;
        }

        .cod-box {
            background: #fff8e1;
            border: 1px solid #ffe69c;
            border-radius: 10px;
            padding: 20px;
        }

        .cod-pending-box {
            background: #fff3cd;
            border: 1px solid #ffe69c;
            border-radius: 10px;
            padding: 20px;
        }

        .cod-confirmed-box {
            background: #e8f7ee;
            border: 1px solid #b7e4c7;
            border-radius: 10px;
            padding: 20px;
        }

        .account-box {
            background: white;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
        }

        .account-title {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .account-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
            gap: 15px;
        }

        .account-row:last-child {
            border-bottom: none;
        }

        .account-label {
            color: #666;
            font-size: 14px;
        }

        .account-number {
            font-weight: 700;
            font-size: 15px;
            word-break: break-word;
            text-align: right;
        }

        .status-badge {
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .payment-instruction {
            background: #fff3cd;
            border: 1px solid #ffe69c;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .payment-instruction i {
            margin-right: 7px;
        }

        .manual-payment-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
        }

        .manual-payment-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #343a40;
        }

        .manual-payment-text {
            color: #666;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .form-label {
            font-weight: 600;
            font-size: 14px;
            color: #495057;
        }

        .form-control,
        .form-select {
            border-radius: 7px;
            min-height: 45px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .15rem rgba(13,110,253,.15);
        }

        .record-btn {
            padding: 10px 18px;
            border-radius: 7px;
            font-weight: 600;
        }

        .already-paid-box {
            background: #e8f7ee;
            border: 1px solid #b7e4c7;
            border-radius: 10px;
            padding: 18px;
            margin-top: 20px;
        }

        .already-paid-title {
            color: #198754;
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .payment-record-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(0,0,0,.08);
        }

        .payment-record-row:last-child {
            border-bottom: none;
        }

        .payment-record-label {
            color: #666;
            font-size: 14px;
        }

        .payment-record-value {
            font-weight: 600;
            text-align: right;
            word-break: break-word;
        }

        .warning-box {
            background: #fff3cd;
            border: 1px solid #ffe69c;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
            color: #664d03;
        }

        .danger-box {
            background: #f8d7da;
            border: 1px solid #f1aeb5;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
            color: #842029;
        }

        .success-box {
            background: #d1e7dd;
            border: 1px solid #a3cfbb;
            border-radius: 15px;
            padding: 15px;
            margin-top: 15px;
            color: #0f5132;
        }

        .info-box {
            background: #cff4fc;
            border: 1px solid #9eeaf9;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
            color: #055160;
        }

        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .action-buttons .btn {
            padding: 10px 18px;
            border-radius: 7px;
        }

        .cod-flow-step {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            height: 100%;
            background: #fff;
        }

        .cod-flow-number {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background: #800020;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            margin-bottom: 10px;
        }

        @@media (max-width: 768px) {

            .page-wrapper {
                padding: 15px;
            }

            .page-header {
                padding: 20px;
            }

            .page-title {
                font-size: 23px;
            }

            .account-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 3px;
            }

            .account-number {
                text-align: left;
            }

            .payment-record-row {
                flex-direction: column;
                gap: 3px;
            }

            .payment-record-value {
                text-align: left;
            }

        }

    </style>

</head>

<body>

<div class="page-wrapper">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="page-header">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h2 class="page-title">

                    <i class="bi bi-credit-card"></i>

                    Payment Details

                </h2>

                <p class="page-subtitle">

                    Manage customer payments and manually record
                    shopkeeper and delivery boy payouts.

                </p>

            </div>

            <div class="col-md-4 text-md-end">

                <a asp-controller="Admin"
                   asp-action="Payments"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back to Payments

                </a>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ================================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================================================= -->
    <!-- CANCELLED ORDER WARNING -->
    <!-- ================================================= -->

    @if (isCancelled)
    {
        <div class="alert alert-danger">

            <i class="bi bi-x-circle-fill"></i>

            <strong>Cancelled Order:</strong>

            This order is cancelled and must not be included
            in payment or payout settlement.

        </div>
    }


    <!-- ================================================= -->
    <!-- ORDER INFORMATION -->
    <!-- ================================================= -->

    <div class="custom-card">

        <div class="custom-card-header header-primary">

            <i class="bi bi-receipt"></i>

            Order & Customer Information

        </div>

        <div class="custom-card-body">

            <div class="row">

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Order ID
                        </label>

                        <div class="info-value">

                            #@Model.OrderId

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Order Date
                        </label>

                        <div class="info-value">

                            @Model.CreatedDate.ToString("dd MMMM yyyy hh:mm tt")

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Customer
                        </label>

                        <div class="info-value">

                            @(Model.Customer?.Name ?? "N/A")

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Shop
                        </label>

                        <div class="info-value">

                            @(Model.Shop?.ShopName ?? "N/A")

                        </div>

                    </div>

                </div>


                <div class="col-md-12">

                    <div class="info-group">

                        <label class="info-label">
                            Delivery Address
                        </label>

                        <div class="info-value">

                            @(Model.DeliveryAddress ?? "N/A")

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- CUSTOMER PAYMENT -->
    <!-- ================================================= -->

    <div class="custom-card">

        <div class="custom-card-header header-warning">

            <i class="bi bi-wallet2"></i>

            Customer Payment

        </div>

        <div class="custom-card-body">

            <div class="row">

                <!-- PAYMENT METHOD -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Payment Method
                        </label>

                        <div class="info-value">

                            @if (isCod)
                            {
                                <span class="status-badge bg-warning text-dark">

                                    <i class="bi bi-cash"></i>

                                    Cash on Delivery

                                </span>
                            }
                            else if (string.Equals(
                                Model.PaymentMethod,
                                "JazzCash",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-badge bg-danger text-white">

                                    <i class="bi bi-phone"></i>

                                    JazzCash

                                </span>
                            }
                            else if (string.Equals(
                                Model.PaymentMethod,
                                "Easypaisa",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-badge bg-success text-white">

                                    <i class="bi bi-phone"></i>

                                    Easypaisa

                                </span>
                            }
                            else
                            {
                                <span>
                                    @(Model.PaymentMethod ?? "N/A")
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- PAYMENT STATUS -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Payment Status
                        </label>

                        <div class="info-value">

                            @if (customerPaymentReceived)
                            {
                                <span class="status-badge bg-success text-white">

                                    <i class="bi bi-check-circle"></i>

                                    Paid / Received

                                </span>
                            }
                            else if (isCod && codCollected && !codHandedOver)
                            {
                                <span class="status-badge bg-warning text-dark">

                                    <i class="bi bi-hourglass-split"></i>

                                    COD Collected - Awaiting Admin

                                </span>
                            }
                            else
                            {
                                <span class="status-badge bg-warning text-dark">

                                    <i class="bi bi-clock"></i>

                                    Payment Pending

                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- PAYMENT DATE -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Payment Confirmation Date
                        </label>

                        <div class="info-value">

                            @(Model.PaymentDate.HasValue
                                ? Model.PaymentDate.Value.ToString("dd MMMM yyyy hh:mm tt")
                                : "Not Confirmed")

                        </div>

                    </div>

                </div>


                <!-- CUSTOMER TRANSACTION ID -->

                @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                {
                    <div class="col-md-6">

                        <div class="info-group">

                            <label class="info-label">
                                Customer Transaction ID
                            </label>

                            <div class="info-value">

                                @Model.TransactionId

                            </div>

                        </div>

                    </div>
                }


                <!-- TRANSACTION IMAGE -->

                @if (!string.IsNullOrWhiteSpace(Model.TransactionImage))
                {
                    <div class="col-md-12">

                        <div class="info-group">

                            <label class="info-label">
                                Payment Screenshot
                            </label>

                            <div class="info-value">

                                <a href="@Model.TransactionImage"
                                   target="_blank"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-image"></i>

                                    View Payment Screenshot

                                </a>

                            </div>

                        </div>

                    </div>
                }


                <!-- ORDER STATUS -->

                <div class="col-md-6">

                    <div class="info-group">

                        <label class="info-label">
                            Order Status
                        </label>

                        <div class="info-value">

                            @(Model.OrderStatus ?? "N/A")

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- COD COLLECTION INFORMATION -->
            <!-- ================================================= -->

            @if (isCod)
            {
                <hr class="my-4" />

                <div class="cod-box">

                    <h5 class="mb-3">

                        <i class="bi bi-cash-stack"></i>

                        COD Cash Collection

                    </h5>

                    @if (codCollected)
                    {
                        <div class="row">

                            <div class="col-md-6">

                                <div class="amount-box">

                                    <div class="amount-label">
                                        Cash Collected by Delivery Boy
                                    </div>

                                    <div class="amount-value">

                                        Rs. @Model.DeliveryCollectedAmount.ToString("N2")

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-6">

                                <div class="amount-box">

                                    <div class="amount-label">
                                        Collection Date
                                    </div>

                                    <div class="amount-value">

                                        @(Model.DeliveryCollectionDate.HasValue
                                            ? Model.DeliveryCollectionDate.Value.ToString("dd MMMM yyyy hh:mm tt")
                                            : "N/A")

                                    </div>

                                </div>

                            </div>


                            <div class="col-md-12">

                                @if (codHandedOver)
                                {
                                    <div class="cod-confirmed-box">

                                        <h5 class="text-success">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Cash Handed Over to Admin

                                        </h5>

                                        <div class="payment-record-row">

                                            <span class="payment-record-label">
                                                Handover Status
                                            </span>

                                            <span class="payment-record-value text-success">
                                                Confirmed
                                            </span>

                                        </div>

                                        <div class="payment-record-row">

                                            <span class="payment-record-label">
                                                Handover Date
                                            </span>

                                            <span class="payment-record-value">

                                                @(Model.DeliveryCashHandoverDate.HasValue
                                                    ? Model.DeliveryCashHandoverDate.Value.ToString("dd MMMM yyyy hh:mm tt")
                                                    : "N/A")

                                            </span>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            Model.DeliveryCashHandoverNotes))
                                        {
                                            <div class="payment-record-row">

                                                <span class="payment-record-label">
                                                    Admin Handover Notes
                                                </span>

                                                <span class="payment-record-value">
                                                    @Model.DeliveryCashHandoverNotes
                                                </span>

                                            </div>
                                        }

                                        <div class="alert alert-success mt-3 mb-0">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Admin has confirmed receipt of the
                                            COD cash. Customer payment is now
                                            officially marked as <strong>Paid</strong>.

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <div class="cod-pending-box">

                                        <h5 class="text-warning">

                                            <i class="bi bi-hourglass-split"></i>

                                            COD Cash Awaiting Admin Confirmation

                                        </h5>

                                        <p class="mb-3">

                                            The delivery boy has collected the
                                            customer's cash, but this does
                                            <strong>not</strong> mean that the
                                            customer payment has been received
                                            by Admin yet.

                                        </p>

                                        <div class="alert alert-warning">

                                            <i class="bi bi-exclamation-triangle-fill"></i>

                                            <strong>Important:</strong>

                                            Customer Payment remains

                                            <strong>Pending</strong>

                                            until the delivery boy hands the
                                            cash to Admin and Admin confirms
                                            the handover.

                                        </div>


                                        @if (!isCancelled)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ConfirmCODHandover"
                                                  method="post"
                                                  class="mt-3">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@Model.OrderId" />

                                                <div class="row g-3">

                                                    <div class="col-md-8">

                                                        <label class="form-label">

                                                            Admin Handover Notes

                                                        </label>

                                                        <input type="text"
                                                               name="notes"
                                                               class="form-control"
                                                               maxlength="500"
                                                               placeholder="Optional note about COD cash handover" />

                                                    </div>

                                                    <div class="col-md-4 d-flex align-items-end">

                                                        <button type="submit"
                                                                class="btn btn-success record-btn w-100"
                                                                onclick="return confirm('Confirm that the delivery boy has handed over the COD cash to Admin and you have physically received it?');">

                                                            <i class="bi bi-check-circle-fill"></i>

                                                            Confirm Cash Handover

                                                        </button>

                                                    </div>

                                                </div>

                                            </form>
                                        }

                                    </div>
                                }

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="warning-box">

                            <i class="bi bi-clock"></i>

                            <strong>COD Cash Not Yet Collected</strong>

                            <p class="mb-0 mt-2">

                                The delivery boy has not recorded collection
                                of the customer's COD amount yet.

                            </p>

                        </div>
                    }

                </div>
            }


            <!-- ================================================= -->
            <!-- GENERAL PAYMENT INFORMATION -->
            <!-- ================================================= -->

            @if (!customerPaymentReceived)
            {
                <div class="payment-instruction">

                    <i class="bi bi-info-circle-fill"></i>

                    @if (isCod && codCollected && !codHandedOver)
                    {
                        <strong>Admin Action Required:</strong>

                        <span>

                            COD cash has been collected by the delivery boy.
                            Confirm the cash handover above only after Admin
                            physically receives the cash.

                        </span>
                    }
                    else
                    {
                        <strong>Admin Action:</strong>

                        <span>

                            Customer payment has not yet been confirmed.
                            Shopkeeper and delivery boy payouts remain locked.

                        </span>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-success mb-0">

                    <i class="bi bi-check-circle-fill"></i>

