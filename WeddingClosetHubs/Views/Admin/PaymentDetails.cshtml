                            <strong>

                                Delivery Boy Payout:

                                Rs. @Model.DeliveryCharges.ToString("N2")

                            </strong>

                        </div>

                        <div class="col-md-4 text-md-end">

                            @if (deliveryPaid)
                            {
                                <span class="status-badge bg-success text-white">

                                    <i class="bi bi-check-circle"></i>

                                    Paid

                                </span>
                            }
                            else if (!customerPaymentReceived)
                            {
                                <span class="status-badge bg-secondary text-white">

                                    <i class="bi bi-lock"></i>

                                    Awaiting Customer Payment

                                </span>
                            }
                            else
                            {
                                <span class="status-badge bg-warning text-dark">

                                    <i class="bi bi-clock"></i>

                                    Payout Pending

                                </span>
                            }

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ACTUAL DELIVERY PAYMENT RECORD -->
                    <!-- ================================================= -->

                    @if (deliveryPaid)
                    {
                        <div class="already-paid-box">

                            <div class="already-paid-title">

                                <i class="bi bi-check-circle-fill"></i>

                                Delivery Boy Payment Recorded

                            </div>

                            <div class="payment-record-row">

                                <span class="payment-record-label">
                                    Amount Paid
                                </span>

                                <span class="payment-record-value">
                                    Rs. @Model.DeliveryPaidAmount.ToString("N2")
                                </span>

                            </div>

                            <div class="payment-record-row">

                                <span class="payment-record-label">
                                    Payment Method
                                </span>

                                <span class="payment-record-value">

                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.DeliveryPaymentMethod))
                                    {
                                        @Model.DeliveryPaymentMethod
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Not Recorded
                                        </span>
                                    }

                                </span>

                            </div>

                            <div class="payment-record-row">

                                <span class="payment-record-label">
                                    Account Paid To
                                </span>

                                <span class="payment-record-value">

                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.DeliveryPaymentAccount))
                                    {
                                        @Model.DeliveryPaymentAccount
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Not Recorded
                                        </span>
                                    }

                                </span>

                            </div>

                            <div class="payment-record-row">

                                <span class="payment-record-label">
                                    Transaction / Reference ID
                                </span>

                                <span class="payment-record-value">

                                    @if (!string.IsNullOrWhiteSpace(
                                        Model.DeliveryTransactionId))
                                    {
                                        @Model.DeliveryTransactionId
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Not Recorded
                                        </span>
                                    }

                                </span>

                            </div>

                            <div class="payment-record-row">

                                <span class="payment-record-label">
                                    Payment Date
                                </span>

                                <span class="payment-record-value">

                                    @(Model.DeliveryPaymentDate.HasValue
                                        ? Model.DeliveryPaymentDate.Value.ToString("dd MMMM yyyy hh:mm tt")
                                        : "N/A")

                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                Model.DeliveryPaymentNotes))
                            {
                                <div class="payment-record-row">

                                    <span class="payment-record-label">
                                        Admin Notes
                                    </span>

                                    <span class="payment-record-value">
                                        @Model.DeliveryPaymentNotes
                                    </span>

                                </div>
                            }

                        </div>
                    }


                    <!-- ================================================= -->
                    <!-- MANUAL DELIVERY PAYMENT -->
                    <!-- ================================================= -->

                    @if (customerPaymentReceived &&
                         !deliveryPaid)
                    {
                        @if (!string.IsNullOrWhiteSpace(
                            deliveryPaymentMethod) &&
                            !string.IsNullOrWhiteSpace(
                                deliveryPaymentAccount))
                        {
                            <div class="manual-payment-box">

                                <div class="manual-payment-title">

                                    <i class="bi bi-send"></i>

