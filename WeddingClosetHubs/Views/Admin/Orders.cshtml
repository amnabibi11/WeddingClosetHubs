@model IEnumerable<WeddingClosetHubs.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Manage Orders - Wedding Closet Hubs</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f5f6fa;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-container {
            padding: 30px;
        }

        /* HEADER */

        .page-header {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
            color: #343a40;
        }

        .page-header p {
            margin-top: 7px;
            color: #777;
        }

        .back-btn {
            border-radius: 8px;
            padding: 9px 16px;
        }

        /* CARD */

        .orders-card {
            background: white;
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .orders-card-header {
            background: #212529;
            color: white;
            padding: 17px 22px;
        }

        .orders-card-header h5 {
            margin: 0;
            font-weight: 700;
        }

        .table-container {
            padding: 20px;
        }

        /* TABLE */

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #343a40;
            color: white;
            border: none;
            padding: 13px 10px;
            white-space: nowrap;
            font-size: 13px;
        }

        .table tbody td {
            padding: 13px 10px;
            vertical-align: middle;
            font-size: 14px;
        }

        .table tbody tr:hover {
            background: #f8f9fa;
        }

        .order-id {
            font-weight: 700;
            color: #0d6efd;
        }

        .customer-name {
            font-weight: 600;
        }

        .amount {
            font-weight: 700;
            white-space: nowrap;
        }

        .badge {
            font-size: 12px;
            padding: 7px 10px;
            border-radius: 6px;
        }

        /* BUTTON */

        .btn-details {
            background: #0d6efd;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 6px;
            font-size: 13px;
        }

        .btn-details:hover {
            background: #0b5ed7;
            color: white;
        }

        /* EMPTY */

        .empty-box {
            text-align: center;
            padding: 70px 20px;
            color: #777;
        }

        .empty-box i {
            font-size: 65px;
            color: #adb5bd;
        }

        .empty-box h5 {
            margin-top: 20px;
            font-weight: 600;
            color: #555;
        }

        .alert {
            border-radius: 8px;
        }

        @@media (max-width: 768px) {

            .page-container {
                padding: 15px;
            }

            .page-header {
                padding: 18px;
            }

            .page-header-content {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start !important;
            }

            .back-btn {
                width: 100%;
            }

        }

    </style>

</head>

<body>

<div class="page-container">

    <!-- ================================================= -->
    <!-- PAGE HEADER -->
    <!-- ================================================= -->

    <div class="page-header">

        <div class="page-header-content d-flex justify-content-between align-items-center">

            <div>

                <h2>

                    <i class="bi bi-cart-check"></i>

                    Orders

                </h2>

                <p class="mb-0">

                    View and manage all customer orders.

                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-secondary back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Dashboard

            </a>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ================================================= -->

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ================================================= -->
    <!-- ORDERS CARD -->
    <!-- ================================================= -->

    <div class="orders-card">

        <div class="orders-card-header">

            <h5>

                <i class="bi bi-receipt"></i>

                Customer Orders

            </h5>

        </div>


        <div class="table-container">

            @if (Model != null && Model.Any())
            {

                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Order ID</th>

                                <th>Customer</th>

                                <th>Shop</th>

                                <th>Order Date</th>

                                <th>Total Amount</th>

                                <th>Payment</th>

                                <th>Payment Status</th>

                                <th>Order Status</th>

                                <th>Delivery</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var order in Model)
                            {

                                <tr>

                                    <!-- NUMBER -->

                                    <td>
                                        @count
                                    </td>


                                    <!-- ORDER ID -->

                                    <td>

                                        <span class="order-id">

                                            #@order.OrderId

                                        </span>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td>

                                        <div class="customer-name">

                                            @(order.Customer?.Name ?? "N/A")

                                        </div>

                                        <small class="text-muted">

                                            @(order.Customer?.Email ?? "N/A")

                                        </small>

                                    </td>


                                    <!-- SHOP -->

                                    <td>

                                        @(order.Shop?.ShopName ?? "N/A")

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        @order.CreatedDate.ToString("dd MMM yyyy")

                                        <br />

                                        <small class="text-muted">

                                            @order.CreatedDate.ToString("hh:mm tt")

                                        </small>

                                    </td>


                                    <!-- TOTAL -->

                                    <td>

                                        <span class="amount">

                                            Rs. @order.TotalAmount.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- PAYMENT METHOD -->

                                    <td>

                                        @if (order.PaymentMethod == "Cash on Delivery")
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-cash"></i>

                                                COD

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-credit-card"></i>

                                                @order.PaymentMethod

                                            </span>
                                        }

                                    </td>


                                    <!-- PAYMENT STATUS -->

                                    <td>

                                        @if (order.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>

                                                Paid

                                            </span>
                                        }
                                        else if (order.PaymentStatus == "Failed")
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle"></i>

                                                Failed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock"></i>

                                                @order.PaymentStatus

                                            </span>
                                        }

                                    </td>


                                    <!-- ORDER STATUS -->

                                    <td>

                                        @if (order.OrderStatus == "Delivered")
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>

                                                Delivered

                                            </span>
                                        }
                                        else if (order.OrderStatus == "Cancelled")
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle"></i>

                                                Cancelled

                                            </span>
                                        }
                                        else if (order.OrderStatus == "Shipped")
                                        {
                                            <span class="badge bg-primary">

                                                <i class="bi bi-truck"></i>

                                                Shipped

                                            </span>
                                        }
                                        else if (order.OrderStatus == "Processing")
                                        {
                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-gear"></i>

                                                Processing

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock"></i>

                                                @order.OrderStatus

                                            </span>
                                        }

                                    </td>


                                    <!-- DELIVERY -->

                                    <td>

                                        @if (order.Delivery != null)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-bicycle"></i>

                                                @order.Delivery.Name

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                Not Assigned

                                            </span>
                                        }

                                    </td>


                                    <!-- DETAILS -->

                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="OrderDetails"
                                           asp-route-id="@order.OrderId"
                                           class="btn btn-details">

                                            <i class="bi bi-eye-fill"></i>

                                            Details

                                        </a>

                                    </td>

                                </tr>

                                count++;

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <!-- ================================================= -->
                <!-- NO ORDERS -->
                <!-- ================================================= -->

                <div class="empty-box">

                    <i class="bi bi-cart-x"></i>

                    <h5>
                        No Orders Found
                    </h5>

                    <p>
                        There are currently no customer orders.
                    </p>

                </div>

            }

        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>