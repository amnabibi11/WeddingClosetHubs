@model IEnumerable<WeddingClosetHubs.Models.Review>

@{
    ViewData["Title"] = "Feedback & Reviews";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Feedback - Wedding Closet Hub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f7f7f7;
            font-family: Arial, sans-serif;
        }

        .page-header {
            background: #800020;
            color: white;
            padding: 25px 30px;
            margin-bottom: 25px;
        }

        .page-header h2 {
            margin: 0;
            font-weight: 600;
        }

        .page-header p {
            margin: 5px 0 0;
            opacity: .85;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #eee;
            color: #800020;
            font-weight: 600;
            padding: 16px 20px;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead th {
            background: #800020;
            color: white;
            font-weight: 600;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        .rating {
            color: #d4af37;
            font-size: 17px;
            white-space: nowrap;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-approved {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-hidden {
            background: #f8d7da;
            color: #842029;
        }

        .approve-btn {
            background: #198754;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 7px 12px;
        }

        .approve-btn:hover {
            background: #157347;
            color: white;
        }

        .hide-btn {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 7px 12px;
        }

        .hide-btn:hover {
            background: #bb2d3b;
            color: white;
        }

        .back-btn {
            background: white;
            color: #800020;
            border: none;
            border-radius: 7px;
            padding: 9px 18px;
            text-decoration: none;
        }

        .back-btn:hover {
            background: #f1f1f1;
            color: #650019;
        }

        .comment {
            max-width: 300px;
            white-space: normal;
            color: #555;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #777;
        }

        .empty-state i {
            font-size: 55px;
            color: #d4af37;
        }

        @@media(max-width: 768px) {

            .page-header {
                padding: 20px;
            }

            .table {
                font-size: 13px;
            }

        }

    </style>

</head>

<body>

    <!-- HEADER -->

    <div class="page-header">

        <div class="container-fluid">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2>

                        <i class="bi bi-chat-square-heart"></i>

                        Feedback & Reviews

                    </h2>

                    <p>

                        Review customer feedback and manage published reviews.

                    </p>

                </div>

                <div>

                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="back-btn">

                        <i class="bi bi-arrow-left"></i>

                        Dashboard

                    </a>

                </div>

            </div>

        </div>

    </div>


    <div class="container-fluid">

        <!-- ALERTS -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                <i class="bi bi-check-circle"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                <i class="bi bi-exclamation-circle"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <div class="card">

            <div class="card-header">

                <i class="bi bi-list-stars me-2"></i>

                Customer Feedback

            </div>

            <div class="card-body p-0">

                @if (Model != null && Model.Any())
                {

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>

                                <tr>

                                    <th>#</th>

                                    <th>Customer</th>

                                    <th>Product</th>

                                    <th>Shop</th>

                                    <th>Rating</th>

                                    <th>Comment</th>

                                    <th>Type</th>

                                    <th>Status</th>

                                    <th>Date</th>

                                    <th>Action</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var review in Model)
                                {

                                    <tr>

                                        <td>
                                            @review.ReviewId
                                        </td>

                                        <td>

                                            @review.UserId

                                        </td>

                                        <td>

                                            @review.ProductId

                                        </td>

                                        <td>

                                            @review.ShopId

                                        </td>

                                        <td>

                                            <span class="rating">

                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= review.Rating)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star"></i>
                                                    }
                                                }

                                            </span>

                                        </td>

                                        <td>

                                            <div class="comment">

                                                @review.Comment

                                            </div>

                                        </td>

                                        <td>

                                            @review.ReviewType

                                        </td>

                                        <td>

                                            @if (review.IsApproved)
                                            {
                                                <span class="status-badge status-approved">

                                                    Approved

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-pending">

                                                    Pending

                                                </span>
                                            }

                                        </td>

                                        <td>

                                            @review.CreatedAt.ToString("dd MMM yyyy")

                                        </td>

                                        <td>

                                            <div class="d-flex gap-1">

                                                @if (!review.IsApproved)
                                                {

                                                    <form asp-controller="Admin"
                                                          asp-action="ApproveFeedback"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@review.ReviewId" />

                                                        <button type="submit"
                                                                class="approve-btn">

                                                            <i class="bi bi-check-lg"></i>

                                                            Approve

                                                        </button>

                                                    </form>

                                                }
                                                else
                                                {

                                                    <form asp-controller="Admin"
                                                          asp-action="RejectFeedback"
                                                          method="post">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@review.ReviewId" />

                                                        <button type="submit"
                                                                class="hide-btn">

                                                            <i class="bi bi-eye-slash"></i>

                                                            Hide

                                                        </button>

                                                    </form>

                                                }

                                            </div>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="empty-state">

                        <i class="bi bi-chat-square-heart"></i>

                        <h5 class="mt-3">
                            No feedback available
                        </h5>

                        <p>
                            Customer reviews will appear here.
                        </p>

                    </div>

                }

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>

