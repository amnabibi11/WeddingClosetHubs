@model WeddingClosetHubs.Models.Order

@{
    ViewData["Title"] = "Order Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Order Details - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f7f4f2;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .page-wrapper {
            padding: 30px;
        }

        .page-header {
            background: white;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            color: #800020;
            margin-bottom: 5px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 0;
        }

        .custom-card {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 25px;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .card-header-custom {
            background: #800020;
            color: white;
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 600;
        }

        .card-body-custom {
            padding: 25px;
        }

        .info-box {
            background: #fafafa;
            border: 1px solid #e5e5e5;
            border-radius: 9px;
            padding: 13px 15px;
            margin-bottom: 15px;
        }

        .info-label {
            display: block;
            color: #777;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 15px;
            font-weight: 600;
        }

        .status-badge {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .product-card {
            border: 1px solid #e5e5e5;
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 15px;
        }

        .product-card:last-child {
            margin-bottom: 0;
        }

        .product-image {
            width: 100px;
            height: 120px;
            object-fit: cover;
            border-radius: 9px;
            border: 1px solid #ddd;
        }

        .product-name {
            font-size: 18px;
            font-weight: 700;
            color: #800020;
        }

        .product-detail {
            color: #666;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .measurement-box {
            background: #fff8e8;
            border: 1px solid #f0d78c;
            border-radius: 9px;
            padding: 15px;
            margin-top: 12px;
        }

        .measurement-title {
            font-weight: 700;
            color: #8a6500;
            margin-bottom: 10px;
        }

        .measurement-text {
            white-space: pre-line;
            color: #555;
        }

        .rental-box {
            background: #fffaf0;
            border: 1px solid #ead9a7;
            border-radius: 10px;
            padding: 18px;
            margin-top: 15px;
        }

        .rental-title {
            color: #800020;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .rental-info {
            background: white;
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 12px;
            height: 100%;
        }

        .rental-label {
            display: block;
            color: #777;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .rental-value {
            color: #333;
            font-size: 14px;
            font-weight: 600;
        }

        .rental-status {
            display: inline-block;
            padding: 7px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .rental-awaiting {
            background: #fff3cd;
            color: #856404;
        }

        .rental-requested {
            background: #fff3cd;
            color: #856404;
        }

        .rental-returned {
            background: #cff4fc;
            color: #055160;
        }

        .rental-inspected {
            background: #e2e3ff;
            color: #373a8a;
        }

        .rental-refunded {
            background: #d1e7dd;
            color: #0f5132;
        }

        .rental-forfeited {
            background: #f8d7da;
            color: #842029;
        }

        .refund-box {
            background: #f4fbf7;
            border: 1px solid #cce8d7;
            border-radius: 9px;
            padding: 15px;
            margin-top: 15px;
        }

        .refund-title {
            color: #198754;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .refund-value {
            font-weight: 600;
            color: #333;
        }

        .refund-preference-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 9px;
            padding: 15px;
            margin-top: 15px;
        }

        .refund-preference-title {
            color: #800020;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .return-process-box {
            background: #f8f4f5;
            border-left: 4px solid #800020;
            border-radius: 8px;
            padding: 16px;
            margin-top: 15px;
        }

        .return-process-title {
            color: #800020;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .return-process-box ol {
            margin-bottom: 0;
            padding-left: 20px;
        }

        .return-process-box li {
            margin-bottom: 6px;
            color: #555;
        }

        .damage-box {
            background: #fff3cd;
            border: 1px solid #ffda6a;
            border-radius: 9px;
            padding: 15px;
            margin-top: 15px;
        }

        .damage-title {
            color: #856404;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .price-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .price-row:last-child {
            border-bottom: none;
        }

        .price-label {
            color: #666;
        }

        .price-value {
            font-weight: 600;
        }

        .security-row {
            background: #fffaf0;
            margin: 8px -10px;
            padding: 10px;
            border-radius: 7px;
            border-bottom: none;
        }

        .security-label {
            color: #8a6500;
            font-weight: 600;
        }

        .security-value {
            color: #8a6500;
            font-weight: 700;
        }

        .total-box {
            background: #800020;
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-top: 15px;
        }

        .total-label {
            font-size: 16px;
        }

        .total-value {
            font-size: 25px;
            font-weight: 700;
        }

        .payment-box {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 18px;
        }

        .address-box {
            background: #fafafa;
            border-left: 4px solid #d4af37;
            border-radius: 8px;
            padding: 18px;
            line-height: 1.7;
        }

        .shop-box {
            background: #fff;
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 18px;
        }

        .shop-name {
            color: #800020;
            font-size: 20px;
            font-weight: 700;
        }

        .btn-maroon {
            background: #800020;
            color: white;
            border: none;
        }

        .btn-maroon:hover {
            background: #650019;
            color: white;
        }

        .empty-text {
            color: #888;
            font-style: italic;
        }

        @@media (max-width: 768px) {

            .page-wrapper {
                padding: 15px;
            }

            .page-title {
                font-size: 23px;
            }

            .product-image {
                width: 80px;
                height: 100px;
            }

        }

    </style>

</head>

<body>

<div class="page-wrapper">

    <div class="page-header">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h2 class="page-title">

                    <i class="bi bi-receipt"></i>

                    Order Details

                </h2>

                <p class="page-subtitle">

                    View complete information about your order.

                </p>

            </div>

            <div class="col-md-4 text-md-end">

                <a asp-controller="Customer"
                   asp-action="MyOrders"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Back to My Orders

                </a>

            </div>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="custom-card">

        <div class="card-header-custom">

            <i class="bi bi-receipt-cutoff"></i>

            Order Summary

        </div>

        <div class="card-body-custom">

            <div class="row">

                <div class="col-md-4">

                    <div class="info-box">

                        <span class="info-label">
                            Order ID
                        </span>

                        <span class="info-value">
                            #@Model.OrderId
                        </span>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-box">

                        <span class="info-label">
                            Order Date
                        </span>

                        <span class="info-value">

                            @Model.CreatedDate.ToString("dd MMMM yyyy")

                        </span>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-box">

                        <span class="info-label">
                            Order Status
                        </span>

                        <span class="info-value">

                            @if (Model.OrderStatus == "Pending")
                            {
                                <span class="status-badge bg-warning text-dark">
                                    <i class="bi bi-clock"></i>
                                    Pending
                                </span>
                            }
                            else if (Model.OrderStatus == "Confirmed")
                            {
                                <span class="status-badge bg-primary text-white">
                                    <i class="bi bi-check-circle"></i>
                                    Confirmed
                                </span>
                            }
                            else if (Model.OrderStatus == "Processing")
                            {
                                <span class="status-badge bg-info text-dark">
                                    <i class="bi bi-box-seam"></i>
                                    Processing
                                </span>
                            }
                            else if (Model.OrderStatus == "Shipped")
                            {
                                <span class="status-badge bg-primary text-white">
                                    <i class="bi bi-truck"></i>
                                    Shipped
                                </span>
                            }
                            else if (Model.OrderStatus == "Delivered")
                            {
                                <span class="status-badge bg-success text-white">
                                    <i class="bi bi-check-circle-fill"></i>
                                    Delivered
                                </span>
                            }
                            else if (Model.OrderStatus == "Cancelled")
                            {
                                <span class="status-badge bg-danger text-white">
                                    <i class="bi bi-x-circle"></i>
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="status-badge bg-secondary text-white">
                                    @Model.OrderStatus
                                </span>
                            }

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="custom-card">

        <div class="card-header-custom">

            <i class="bi bi-shop"></i>

            Shop Information

        </div>

        <div class="card-body-custom">

            <div class="shop-box">

                <div class="shop-name">

                    @(Model.Shop?.ShopName ?? "Shop Not Available")

                </div>

                @if (Model.Shop != null)
                {
                    <div class="mt-2">

                        @if (!string.IsNullOrEmpty(Model.Shop.ShopCategory))
                        {
                            <p class="mb-1">

                                <strong>Category:</strong>

                                @Model.Shop.ShopCategory

                            </p>
                        }

                        @if (!string.IsNullOrEmpty(Model.Shop.ShopAddress))
                        {
                            <p class="mb-1">

                                <strong>Address:</strong>

                                @Model.Shop.ShopAddress

                            </p>
                        }

                        @if (!string.IsNullOrEmpty(Model.Shop.ShopPhone))
                        {
                            <p class="mb-0">

                                <strong>Phone:</strong>

                                @Model.Shop.ShopPhone

                            </p>
                        }

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="custom-card">

        <div class="card-header-custom">

            <i class="bi bi-bag-check"></i>

            Ordered Products

        </div>

        <div class="card-body-custom">

            @if (Model.OrderDetails != null &&
                 Model.OrderDetails.Any())
            {
                foreach (var item in Model.OrderDetails)
                {
                    <div class="product-card">

                        <div class="row align-items-start">

                            <div class="col-md-2 col-4 text-center">

                                @if (!string.IsNullOrEmpty(item.Product?.Image))
                                {
                                    <img src="@item.Product.Image"
                                         class="product-image"
                                         alt="@item.Product.ProductName" />
                                }
                                else
                                {
                                    <div class="product-image d-flex align-items-center justify-content-center bg-light">

                                        <i class="bi bi-image fs-2 text-secondary"></i>

                                    </div>
                                }

                            </div>

                            <div class="col-md-7 col-8">

                                <div class="product-name">

                                    @(item.Product?.ProductName ?? "Product")

                                </div>

                                @if (!string.IsNullOrEmpty(item.Product?.Category))
                                {
                                    <div class="product-detail">

                                        <strong>Category:</strong>

                                        @item.Product.Category

                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.Product?.Subcategory))
                                {
                                    <div class="product-detail">

                                        <strong>Subcategory:</strong>

                                        @item.Product.Subcategory

                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.Product?.Color))
                                {
                                    <div class="product-detail">

                                        <strong>Color:</strong>

                                        @item.Product.Color

                                    </div>
                                }

                                <div class="product-detail">

                                    <strong>Purchase Type:</strong>

                                    @item.PurchaseType

                                </div>

                                <div class="product-detail">

                                    <strong>Quantity:</strong>

                                    @item.Quantity

                                </div>

                            </div>

                            <div class="col-md-3 text-md-end mt-3 mt-md-0">

                                <div class="product-detail">
                                    Price
                                </div>

                                <strong>

                                    Rs. @item.UnitPrice.ToString("N2")

                                </strong>

                                <div class="mt-2">

                                    <small class="text-muted">
                                        Total:
                                    </small>

                                    <strong class="text-dark">

                                        Rs. @item.SubTotal.ToString("N2")

                                    </strong>

                                </div>

                            </div>

                        </div>

                        @if (string.Equals(
                            item.PurchaseType,
                            "Rent",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="rental-box">

                                <div class="rental-title">

                                    <i class="bi bi-arrow-return-left"></i>

                                    Rental & Security Information

                                </div>

                                <div class="row g-3">

                                    <div class="col-md-3">

                                        <div class="rental-info">

                                            <span class="rental-label">
                                                Rental Security
                                            </span>

                                            <span class="rental-value">

                                                Rs.
                                                @((item.RentalSecurity * item.Quantity).ToString("N2"))

                                            </span>

                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="rental-info">

                                            <span class="rental-label">
                                                Rental Duration
                                            </span>

                                            <span class="rental-value">

                                                @(item.RentalDuration ?? "Not specified")

                                            </span>

                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="rental-info">

                                            <span class="rental-label">
                                                Return Status
                                            </span>

                                            @if (string.Equals(
                                                item.RentalReturnStatus,
                                                "Return Requested",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="rental-status rental-requested">

                                                    <i class="bi bi-send-check"></i>

                                                    Return Requested

                                                </span>
                                            }
                                            else if (string.Equals(
                                                item.RentalReturnStatus,
                                                "Returned",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="rental-status rental-returned">

                                                    <i class="bi bi-box-arrow-in-left"></i>

                                                    Returned

                                                </span>
                                            }
                                            else if (string.Equals(
                                                item.RentalReturnStatus,
                                                "Inspected",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="rental-status rental-inspected">

                                                    <i class="bi bi-search"></i>

                                                    Inspected

                                                </span>
                                            }
                                            else if (string.Equals(
                                                item.RentalReturnStatus,
                                                "Refunded",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="rental-status rental-refunded">

                                                    <i class="bi bi-check-circle-fill"></i>

                                                    Refunded

                                                </span>
                                            }
                                            else if (string.Equals(
                                                item.RentalReturnStatus,
                                                "Security Forfeited",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="rental-status rental-forfeited">

                                                    <i class="bi bi-exclamation-triangle"></i>

                                                    Security Forfeited

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="rental-status rental-awaiting">

                                                    <i class="bi bi-clock"></i>

                                                    @(item.RentalReturnStatus ?? "Awaiting Return")

                                                </span>
                                            }

                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="rental-info">

                                            <span class="rental-label">
                                                Security Status
                                            </span>

                                            @if (item.SecurityRefunded)
                                            {
                                                <span class="text-success fw-semibold">

                                                    <i class="bi bi-check-circle-fill"></i>

                                                    Refund Completed

                                                </span>
                                            }
                                            else if (string.Equals(
                                                item.RentalReturnStatus,
                                                "Security Forfeited",
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-danger fw-semibold">

                                                    <i class="bi bi-x-circle-fill"></i>

                                                    Security Withheld

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-warning fw-semibold">

                                                    <i class="bi bi-hourglass-split"></i>

                                                    Refund Pending

                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                                @if (item.DressReturnedDate.HasValue)
                                {
                                    <div class="row g-3 mt-1">

                                        <div class="col-md-4">

                                            <div class="rental-info">

                                                <span class="rental-label">
                                                    Dress Received Date
                                                </span>

                                                <span class="rental-value">

                                                    @item.DressReturnedDate.Value.ToString("dd MMM yyyy hh:mm tt")

                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                                <div class="return-process-box">

                                    <div class="return-process-title">

                                        <i class="bi bi-info-circle"></i>

                                        Rental Return Process

                                    </div>

                                    <ol>

                                        <li>
                                            Submit your rental return request.
                                        </li>

                                        <li>
                                            Return the rented dress directly to the shopkeeper.
                                        </li>

                                        <li>
                                            The shopkeeper confirms that the dress has been received.
                                        </li>

                                        <li>
                                            Admin inspects the returned dress.
                                        </li>

                                        <li>
                                            If approved, Admin refunds the security through your selected Easypaisa or JazzCash account.
                                        </li>

                                    </ol>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.RefundPreferenceMethod))
                                {
                                    <div class="refund-preference-box">

                                        <div class="refund-preference-title">

                                            <i class="bi bi-wallet2"></i>

                                            Selected Security Refund Method

                                        </div>

                                        <div class="row g-3">

                                            <div class="col-md-6">

                                                <span class="rental-label">
                                                    Refund Method
                                                </span>

                                                <span class="refund-value">

                                                    @item.RefundPreferenceMethod

                                                </span>

                                            </div>

                                            <div class="col-md-6">

                                                <span class="rental-label">
                                                    Refund Account
                                                </span>

                                                <span class="refund-value">

                                                    @(item.RefundPreferenceAccount ?? "N/A")

                                                </span>

                                            </div>

                                        </div>

                                        <div class="small text-muted mt-3">

                                            <i class="bi bi-info-circle"></i>

                                            Your security will be refunded through this Easypaisa or JazzCash account after the returned dress has been inspected and approved by Admin.

                                        </div>

                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.InspectionResult))
                                {
                                    <div class="row g-3 mt-1">

                                        <div class="col-md-6">

                                            <div class="rental-info">

                                                <span class="rental-label">
                                                    Inspection Result
                                                </span>

                                                <span class="rental-value">

                                                    @item.InspectionResult

                                                </span>

                                            </div>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.InspectionNotes))
                                        {
                                            <div class="col-md-6">

                                                <div class="rental-info">

                                                    <span class="rental-label">
                                                        Inspection Notes
                                                    </span>

                                                    <span class="rental-value">

                                                        @item.InspectionNotes

                                                    </span>

                                                </div>

                                            </div>
                                        }

                                    </div>
                                }

                                @if (item.DamageDeduction > 0)
                                {
                                    <div class="damage-box">

                                        <div class="damage-title">

                                            <i class="bi bi-exclamation-triangle"></i>

                                            Damage Deduction

                                        </div>

                                        <div class="row g-3">

                                            <div class="col-md-6">

                                                <span class="rental-label">
                                                    Deduction
                                                </span>

                                                <span class="refund-value">

                                                    Rs. @item.DamageDeduction.ToString("N2")

                                                </span>

                                            </div>

                                            <div class="col-md-6">

                                                <span class="rental-label">
                                                    Refundable Amount
                                                </span>

                                                <span class="refund-value">

                                                    Rs. @item.RefundAmount.ToString("N2")

                                                </span>

                                            </div>

                                        </div>

                                    </div>
                                }

                                @if (item.SecurityRefunded)
                                {
                                    <div class="refund-box">

                                        <div class="refund-title">

                                            <i class="bi bi-wallet2"></i>

                                            Security Refund Completed

                                        </div>

                                        <div class="row g-3">

                                            <div class="col-md-3">

                                                <span class="rental-label">
                                                    Refund Amount
                                                </span>

                                                <span class="refund-value">

                                                    Rs. @item.RefundAmount.ToString("N2")

                                                </span>

                                            </div>

                                            <div class="col-md-3">

                                                <span class="rental-label">
                                                    Refund Method
                                                </span>

                                                <span class="refund-value">

                                                    @(item.SecurityRefundMethod ?? "N/A")

                                                </span>

                                            </div>

                                            <div class="col-md-3">

                                                <span class="rental-label">
                                                    Refund Date
                                                </span>

                                                <span class="refund-value">

                                                    @(item.SecurityRefundDate?.ToString("dd MMM yyyy hh:mm tt") ?? "N/A")

                                                </span>

                                            </div>

                                            <div class="col-md-3">

                                                <span class="rental-label">
                                                    Transaction ID
                                                </span>

                                                <span class="refund-value">

                                                    @(item.SecurityRefundTransactionId ?? "N/A")

                                                </span>

                                            </div>

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.SecurityRefundAccount))
                                        {
                                            <div class="mt-3">

                                                <span class="rental-label">
                                                    Refund Account
                                                </span>

                                                <span class="refund-value">

                                                    @item.SecurityRefundAccount

                                                </span>

                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.SecurityRefundNotes))
                                        {
                                            <div class="mt-3">

                                                <span class="rental-label">
                                                    Refund Notes
                                                </span>

                                                <span class="refund-value">

                                                    @item.SecurityRefundNotes

                                                </span>

                                            </div>
                                        }

                                    </div>
                                }

                                @if (string.Equals(
                                    item.RentalReturnStatus,
                                    "Security Forfeited",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="damage-box">

                                        <div class="damage-title">

                                            <i class="bi bi-shield-x"></i>

                                            Security Refund Not Available

                                        </div>

                                        <p class="mb-0">

                                            The rental security has been withheld according to the Admin's inspection decision.

                                        </p>

                                    </div>
                                }

                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.CustomMeasurements))
                        {
                            <div class="measurement-box">

                                <div class="measurement-title">

                                    <i class="bi bi-rulers"></i>

                                    Custom Measurements

                                </div>

                                <div class="measurement-text">

                                    @item.CustomMeasurements

                                </div>

                            </div>
                        }

                    </div>
                }

            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-bag-x fs-1 text-secondary"></i>

                    <p class="empty-text mt-2">

                        No product details found for this order.

                    </p>

                </div>
            }

        </div>

    </div>

    <div class="custom-card">

        <div class="card-header-custom">

            <i class="bi bi-truck"></i>

            Delivery Information

        </div>

        <div class="card-body-custom">

            <div class="row">

                <div class="col-md-8">

                    <label class="info-label">
                        Delivery Address
                    </label>

                    <div class="address-box">

                        <i class="bi bi-geo-alt-fill text-danger"></i>

                        @Model.DeliveryAddress

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-box mt-3 mt-md-0">

                        <span class="info-label">
                            Delivery Charges
                        </span>

                        <span class="info-value">

                            Rs. @Model.DeliveryCharges.ToString("N2")

                        </span>

                    </div>

                    <div class="info-box">

                        <span class="info-label">
                            Delivery Boy
                        </span>

                        <span class="info-value">

                            @(Model.Delivery?.Name ?? "Not Assigned Yet")

                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="custom-card">

        <div class="card-header-custom">

            <i class="bi bi-credit-card"></i>

            Payment Information

        </div>

        <div class="card-body-custom">

            <div class="payment-box">

                <div class="row">

                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                Payment Method
                            </span>

                            <span class="info-value">

                                @if (Model.PaymentMethod == "Cash on Delivery")
                                {
                                    <span class="status-badge bg-warning text-dark">

                                        <i class="bi bi-cash"></i>

                                        Cash on Delivery

                                    </span>
                                }
                                else if (Model.PaymentMethod == "Easypaisa")
                                {
                                    <span class="status-badge bg-success text-white">

                                        <i class="bi bi-phone"></i>

                                        Easypaisa

                                    </span>
                                }
                                else if (Model.PaymentMethod == "JazzCash")
                                {
                                    <span class="status-badge bg-danger text-white">

                                        <i class="bi bi-phone"></i>

                                        JazzCash

                                    </span>
                                }
                                else
                                {
                                    @Model.PaymentMethod
                                }

                            </span>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                Payment Status
                            </span>

                            <span class="info-value">

                                @if (Model.PaymentReceived)
                                {
                                    <span class="status-badge bg-success text-white">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Payment Received

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge bg-warning text-dark">

                                        <i class="bi bi-clock"></i>

                                        Payment Pending

                                    </span>
                                }

                            </span>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="info-box">

                            <span class="info-label">
                                Payment Date
                            </span>

                            <span class="info-value">

                                @(Model.PaymentDate.HasValue
                                    ? Model.PaymentDate.Value.ToString("dd MMM yyyy hh:mm tt")
                                    : "Not Received Yet")

                            </span>

                        </div>

                    </div>

                </div>

                @if (Model.PaymentMethod == "Easypaisa" ||
                     Model.PaymentMethod == "JazzCash")
                {
                    <div class="row mt-2">

                        @if (!string.IsNullOrEmpty(Model.TransactionId))
                        {
                            <div class="col-md-6">

                                <div class="info-box">

                                    <span class="info-label">
                                        Transaction ID
                                    </span>

                                    <span class="info-value">

                                        @Model.TransactionId

                                    </span>

                                </div>

                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.TransactionImage))
                        {
                            <div class="col-md-6">

                                <div class="info-box">

                                    <span class="info-label">
                                        Payment Proof
                                    </span>

                                    <span class="info-value">

                                        <a href="@Model.TransactionImage"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-image"></i>

                                            View Payment Screenshot

                                        </a>

                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="custom-card">

        <div class="card-header-custom">

            <i class="bi bi-calculator"></i>

            Price Breakdown

        </div>

        <div class="card-body-custom">

            <div class="price-row">

                <span class="price-label">
                     Product Total
                </span>

                <span class="price-value">

                    Rs. @Model.ProductTotal.ToString("N2")

                </span>

            </div>

            <div class="price-row">

                <span class="price-label">
                    Delivery Charges
                </span>

                <span class="price-value">

                    Rs. @Model.DeliveryCharges.ToString("N2")

                </span>

            </div>

            <div class="price-row">

                <span class="price-label">
                    Platform Service Fee (10%)
                </span>

                <span class="price-value">

                    Rs. @Model.ServiceFee.ToString("N2")

                </span>

            </div>

            @if (Model.RefundableSecurity > 0)
            {
                <div class="price-row security-row">

                    <span class="security-label">

                        <i class="bi bi-shield-check"></i>

                        Refundable Rental Security

                    </span>

                    <span class="security-value">

                        Rs. @Model.RefundableSecurity.ToString("N2")

                    </span>

                </div>

                <div class="small text-muted mt-2">

                    <i class="bi bi-info-circle"></i>

                    This security amount is separate from the rental price and is refundable after the rented dress is returned and inspected.

                </div>
            }

            <div class="total-box">

                <div class="d-flex justify-content-between align-items-center">

                    <span class="total-label">

                        Final Total Paid / Payable

                    </span>

                    <span class="total-value">

                        Rs. @Model.TotalAmount.ToString("N2")

                    </span>

                </div>

            </div>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="custom-card">

            <div class="card-header-custom">

                <i class="bi bi-chat-left-text"></i>

                Order Notes

            </div>

            <div class="card-body-custom">

                <div class="info-box mb-0">

                    @Model.Notes

                </div>

            </div>

        </div>
    }

    <div class="custom-card">

        <div class="card-body-custom">

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Customer"
                   asp-action="MyOrders"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>

                    My Orders

                </a>

                @if (Model.OrderStatus == "Delivered")
                {
                    <a asp-controller="Customer"
                       asp-action="Reviews"
                       asp-route-orderId="@Model.OrderId"
                       class="btn btn-maroon">

                        <i class="bi bi-star"></i>

                        Give Feedback

                    </a>
                }

                @if (Model.Shop != null)
                {
                    <a asp-controller="Customer"
                       asp-action="Chat"
                       asp-route-shopId="@Model.Shop.ShopId"
                       class="btn btn-outline-primary">

                        <i class="bi bi-chat-dots"></i>

                        Chat with Shop

                    </a>
                }

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>