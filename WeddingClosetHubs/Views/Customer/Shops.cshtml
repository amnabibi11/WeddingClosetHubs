@model IEnumerable<WeddingClosetHubs.Models.Shop>

@{
    ViewData["Title"] = "Browse Shops";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>


    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Browse Shops - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            background: #f8f6f4;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

       

        .navbar-custom {
            background: #800020;
            padding: 14px 30px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        }

        .navbar-brand {
            color: #d4af37 !important;
            font-size: 23px;
            font-weight: 700;
        }

            .navbar-brand i {
                margin-right: 7px;
            }

        .nav-link {
            color: white !important;
            margin-left: 12px;
            font-weight: 500;
        }

            .nav-link:hover {
                color: #d4af37 !important;
            }


        

        .page-wrapper {
            padding: 40px 30px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 35px;
        }

            .page-header h1 {
                color: #800020;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .page-header p {
                color: #777;
                font-size: 16px;
                margin-bottom: 0;
            }


      

        .shop-card {
            background: white;
            border: none;
            border-radius: 15px;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
        }

            .shop-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.14);
            }


        

        .shop-image-container {
            height: 220px;
            background: #f1eeee;
            overflow: hidden;
        }

        .shop-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .no-image {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            color: #999;
        }

            .no-image i {
                font-size: 50px;
                margin-bottom: 8px;
            }


      

        .shop-body {
            padding: 22px;
        }

        .shop-name {
            color: #800020;
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .shop-category {
            display: inline-block;
            background: #f5e8eb;
            color: #800020;
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 13px;
        }

        .shop-description {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
            min-height: 45px;
            margin-bottom: 15px;
        }

        .shop-info {
            margin-bottom: 15px;
        }

        .shop-info-row {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 8px;
            color: #666;
            font-size: 14px;
        }

            .shop-info-row i {
                color: #d4af37;
                font-size: 16px;
                margin-top: 2px;
            }


       

        .btn-view-shop {
            width: 100%;
            background: #800020;
            color: white;
            border: none;
            padding: 11px 15px;
            border-radius: 8px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-view-shop:hover {
                background: #5f0018;
                color: white;
            }


        

        .empty-box {
            background: white;
            border-radius: 15px;
            padding: 60px 25px;
            text-align: center;
            box-shadow: 0 5px 18px rgba(0,0,0,0.06);
        }

            .empty-box i {
                font-size: 60px;
                color: #d4af37;
                margin-bottom: 15px;
            }

            .empty-box h4 {
                color: #800020;
                font-weight: 700;
            }

            .empty-box p {
                color: #777;
            }



        footer {
            background: #800020;
            color: white;
            text-align: center;
            padding: 18px;
            margin-top: 40px;
        }

            footer span {
                color: #d4af37;
                font-weight: 600;
            }


        

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 12px 15px;
            }

            .page-wrapper {
                padding: 30px 15px;
            }

            .page-header h1 {
                font-size: 28px;
            }

            .shop-image-container {
                height: 200px;
            }
        }

    </style>


</head>

<body>

    

    <nav class="navbar navbar-expand-lg navbar-custom">


        <div class="container-fluid">

            <a class="navbar-brand"
               asp-controller="Customer"
               asp-action="Dashboard">

                <i class="bi bi-heart-fill"></i>

                Wedding Closet Hubs

            </a>


            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#customerNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse"
                 id="customerNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Dashboard">

                            <i class="bi bi-house"></i>
                            Dashboard

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Shops">

                            <i class="bi bi-shop"></i>
                            Shops

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Cart">

                            <i class="bi bi-cart3"></i>
                            Cart

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="MyOrders">

                            <i class="bi bi-bag-check"></i>
                            My Orders

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Customer"
                           asp-action="Notifications">

                            <i class="bi bi-bell"></i>
                            Notifications

                        </a>

                    </li>

                </ul>

            </div>

        </div>


    </nav>

   

    <div class="page-wrapper">


        <div class="container-fluid">


            

            <div class="page-header">

                <h1>

                    <i class="bi bi-shop"></i>

                    Browse Shops

                </h1>

                <p>

                    Explore our approved bridal and fashion shops
                    and find the perfect dress for your special occasion.

                </p>

            </div>


            @if (Model != null && Model.Any())
            {

                <div class="row g-4">

                    @foreach (var shop in Model)
                    {

                        <div class="col-xl-4 col-lg-4 col-md-6">

                            <div class="shop-card">


                               

                                <div class="shop-image-container">

                                    @if (!string.IsNullOrEmpty(shop.Logo))
                                    {

                                        <img src="@shop.Logo"
                                             alt="@shop.ShopName"
                                             class="shop-image" />

                                    }
                                    else if (!string.IsNullOrEmpty(shop.ShopFrontPhoto))
                                    {

                                        <img src="@shop.ShopFrontPhoto"
                                             alt="@shop.ShopName"
                                             class="shop-image" />

                                    }
                                    else
                                    {

                                        <div class="no-image">

                                            <i class="bi bi-shop"></i>

                                            <span>No Shop Image</span>

                                        </div>

                                    }

                                </div>


                               

                                <div class="shop-body">


                                    <div class="shop-name">

                                        @shop.ShopName

                                    </div>


                                    @if (!string.IsNullOrWhiteSpace(shop.ShopCategory))
                                    {

                                        <span class="shop-category">

                                            <i class="bi bi-tag"></i>

                                            @shop.ShopCategory

                                        </span>

                                    }


                                    <p class="shop-description">

                                        @if (!string.IsNullOrWhiteSpace(shop.ShopDescription))
                                        {
                                            @shop.ShopDescription
                                        }
                                        else
                                        {
                                            <span>
                                                Welcome to @shop.ShopName.
                                            </span>
                                        }

                                    </p>


                                    

                                    <div class="shop-info">


                                        @if (!string.IsNullOrWhiteSpace(shop.ShopAddress))
                                        {

                                            <div class="shop-info-row">

                                                <i class="bi bi-geo-alt-fill"></i>

                                                <span>
                                                    @shop.ShopAddress
                                                </span>

                                            </div>

                                        }


                                        @if (!string.IsNullOrWhiteSpace(shop.ShopPhone))
                                        {

                                            <div class="shop-info-row">

                                                <i class="bi bi-telephone-fill"></i>

                                                <span>
                                                    @shop.ShopPhone
                                                </span>

                                            </div>

                                        }


                                        @if (!string.IsNullOrWhiteSpace(shop.Email))
                                        {

                                            <div class="shop-info-row">

                                                <i class="bi bi-envelope-fill"></i>

                                                <span>
                                                    @shop.Email
                                                </span>

                                            </div>

                                        }

                                    </div>


                                    

                                    <a asp-controller="Customer"
                                       asp-action="ShopDetails"
                                       asp-route-id="@shop.ShopId"
                                       class="btn btn-view-shop">

                                        <i class="bi bi-eye"></i>

                                        View Shop & Products

                                    </a>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="empty-box">

                    <i class="bi bi-shop-window"></i>

                    <h4>
                        No Shops Available
                    </h4>

                    <p>
                        There are currently no approved shops available.
                        Please check again later.
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Dashboard"
                       class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Back to Dashboard

                    </a>

                </div>

            }

        </div>


    </div>



    <footer>


        <div>

            © @DateTime.Now.Year

            <span>Wedding Closet Hubs</span>

            — All Rights Reserved.

        </div>


    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
