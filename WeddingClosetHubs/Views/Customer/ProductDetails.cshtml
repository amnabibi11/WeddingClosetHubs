@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Product Details";
    Layout = null;

    bool isOnSale =
        Model.IsOnSale &&
        Model.SalePrice.HasValue &&
        Model.SalePrice.Value > 0 &&
        Model.SalePrice.Value < Model.Price;

    bool isAvailableForRent =
        Model.IsAvailableForRent &&
        Model.RentPrice.HasValue &&
        Model.RentPrice.Value > 0;

    bool canNegotiate = Model.AllowNegotiation;

    decimal displayBuyPrice =
        isOnSale ? Model.SalePrice!.Value : Model.Price;

    bool negotiatedAlreadyInCart =
        ViewBag.NegotiatedAlreadyInCart ?? false;

    bool hasAcceptedNegotiation =
        ViewBag.HasAcceptedNegotiation ?? false;

    decimal? acceptedNegotiatedPrice =
        ViewBag.AcceptedNegotiatedPrice as decimal?;

    if (!acceptedNegotiatedPrice.HasValue &&
        ViewBag.AcceptedNegotiatedPrice != null)
    {
        if (decimal.TryParse(
            ViewBag.AcceptedNegotiatedPrice.ToString(),
            out decimal parsedNegotiatedPrice))
        {
            acceptedNegotiatedPrice = parsedNegotiatedPrice;
        }
    }

    var variants =
        Model.ProductVariants?
            .OrderBy(v => v.Size)
            .ToList()
        ?? new List<WeddingClosetHubs.Models.ProductVariant>();

    bool hasSizeVariants = variants.Any();

    int totalVariantStock =
        hasSizeVariants
            ? variants.Sum(v => v.StockQuantity)
            : Model.StockQuantity;

    bool productInStock = totalVariantStock > 0;

    var galleryImages = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.Image))
    {
        galleryImages.Add(Model.Image);
    }

    if (Model.ProductImages != null)
    {
        foreach (var productImage in Model.ProductImages)
        {
            if (!string.IsNullOrWhiteSpace(productImage.ImagePath) &&
                !galleryImages.Any(x =>
                    string.Equals(
                        x,
                        productImage.ImagePath,
                        StringComparison.OrdinalIgnoreCase)))
            {
                galleryImages.Add(productImage.ImagePath);
            }
        }
    }

    if (!string.IsNullOrWhiteSpace(Model.AdditionalImages))
    {
        var additionalImages =
            Model.AdditionalImages.Split(
                '|',
                StringSplitOptions.RemoveEmptyEntries);

        foreach (var image in additionalImages)
        {
            string imagePath = image.Trim();

            if (!string.IsNullOrWhiteSpace(imagePath) &&
                !galleryImages.Any(x =>
                    string.Equals(
                        x,
                        imagePath,
                        StringComparison.OrdinalIgnoreCase)))
            {
                galleryImages.Add(imagePath);
            }
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Model.ProductName - Wedding Closet Hubs
