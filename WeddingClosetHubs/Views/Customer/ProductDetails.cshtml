@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Product Details";
    Layout = null;

    bool isOnSale =
        Model.IsOnSale &&
        Model.SalePrice.HasValue &&
        Model.SalePrice.Value > 0;

    bool isAvailableForRent =
        Model.IsAvailableForRent &&
        Model.RentPrice.HasValue &&
        Model.RentPrice.Value > 0;

    bool canNegotiate =
        Model.AllowNegotiation;

    decimal displayBuyPrice =
        isOnSale
            ? Model.SalePrice!.Value
            : Model.Price;

    bool negotiatedAlreadyInCart =
ViewBag.NegotiatedAlreadyInCart ?? false;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Model.ProductName - Wedding Closet Hubs
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f5f6;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        
        .navbar-custom {
            background: #800020;
            padding: 15px 35px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        }

        .brand {
            color: white;
            font-size: 24px;
            font-weight: 700;
            text-decoration: none;
        }

            .brand span {
                color: #d4af37;
            }

        .nav-link-custom {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-weight: 500;
        }

            .nav-link-custom:hover {
                color: #d4af37;
            }

        .logout-btn {
            border: 1px solid #d4af37;
            color: white;
            padding: 7px 15px;
            border-radius: 6px;
            text-decoration: none;
            margin-left: 20px;
        }

            .logout-btn:hover {
                background: #d4af37;
                color: #800020;
            }

        
        .page-wrapper {
            padding: 35px;
            max-width: 1250px;
            margin: auto;
        }

        
        .back-section {
            margin-bottom: 20px;
        }

        .product-container {
            background: white;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        
        .product-image-wrapper {
            width: 100%;
            height: 520px;
            background: #f3eef0;
            border-radius: 15px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .no-image {
            text-align: center;
            color: #999;
        }

            .no-image i {
                font-size: 90px;
                display: block;
                margin-bottom: 10px;
            }

        
        .product-name {
            color: #800020;
            font-size: 34px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .shop-name {
            color: #666;
            font-size: 15px;
            margin-bottom: 18px;
        }

            .shop-name i {
                color: #800020;
            }

        .price-area {
            margin-bottom: 22px;
        }

        .original-price-label {
            color: #777;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .original-price {
            color: #777;
            font-size: 18px;
            text-decoration: line-through;
            margin-right: 10px;
        }

        .sale-price {
            color: #800020;
            font-size: 32px;
            font-weight: 700;
        }

        .normal-price {
            color: #800020;
            font-size: 32px;
            font-weight: 700;
        }

        .sale-badge {
            display: inline-block;
            background: #dc3545;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-left: 8px;
            vertical-align: middle;
        }

        .sale-details {
            margin-top: 8px;
            color: #666;
            font-size: 14px;
            line-height: 1.5;
        }

        
        .description-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .description {
            color: #666;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        
        .product-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 25px;
        }

        .info-badge {
            background: #f8f5f6;
            border: 1px solid #e5dfe1;
            color: #555;
            padding: 8px 12px;
            border-radius: 7px;
            font-size: 13px;
        }

            .info-badge i {
                color: #800020;
                margin-right: 4px;
            }

        .custom-badge {
            background: #fff4d6;
            border: 1px solid #d4af37;
            color: #705900;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .available-badge {
            background: #e8f7ef;
            color: #198754;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .unavailable-badge {
            background: #fdeaea;
            color: #dc3545;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .sale-feature-badge {
            background: #fff0f1;
            border: 1px solid #f1b0b7;
            color: #b02a37;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .rent-feature-badge {
            background: #f1edff;
            border: 1px solid #c8b8ff;
            color: #5936a3;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        .negotiation-feature-badge {
            background: #fff8e1;
            border: 1px solid #d4af37;
            color: #705900;
            padding: 8px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 700;
        }

        
        .details-section {
            margin-top: 25px;
        }

        .details-title {
            color: #800020;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 11px 0;
            border-bottom: 1px solid #eee;
        }

        .detail-label {
            color: #777;
            font-weight: 600;
        }

        .detail-value {
            font-weight: 600;
            text-align: right;
        }

       
        .rental-box {
            margin-top: 25px;
            background: #f5f1ff;
            border: 1px solid #d8ccff;
            border-radius: 12px;
            padding: 20px;
        }

            .rental-box h5 {
                color: #5936a3;
                font-weight: 700;
                margin-bottom: 15px;
            }

        .rental-price {
            color: #5936a3;
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .rental-detail {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            padding: 8px 0;
            border-bottom: 1px solid #ddd5f5;
        }

            .rental-detail:last-child {
                border-bottom: none;
            }

        .rental-label {
            color: #6f6590;
            font-weight: 600;
        }

        .rental-value {
            color: #3f3560;
            font-weight: 600;
            text-align: right;
        }

        .rental-note {
            margin-top: 12px;
            margin-bottom: 0;
            color: #665c7a;
            font-size: 13px;
            line-height: 1.6;
        }

        
        .measurement-box {
            margin-top: 25px;
            background: #fff8e1;
            border: 1px solid #ffe69c;
            border-radius: 12px;
            padding: 20px;
        }

            .measurement-box h5 {
                color: #806000;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .measurement-box p {
                color: #665c35;
                margin-bottom: 0;
                line-height: 1.6;
            }

        .negotiation-box {
            margin-top: 25px;
            background: #fffaf0;
            border: 1px solid #d4af37;
            border-radius: 12px;
            padding: 20px;
        }

            .negotiation-box h5 {
                color: #705900;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .negotiation-box p {
                color: #665c35;
                margin-bottom: 15px;
                line-height: 1.6;
            }

        .negotiation-btn {
            background: #d4af37;
            color: #800020;
            border: none;
            padding: 11px 22px;
            border-radius: 7px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
        }

            .negotiation-btn:hover {
                background: #c19b2e;
                color: #800020;
            }

        .action-area {
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #eee;
        }

        .quantity-label {
            font-weight: 700;
            margin-bottom: 7px;
        }

        .quantity-input {
            width: 120px;
        }

        .add-cart-btn {
            background: #800020;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 7px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }

            .add-cart-btn:hover {
                background: #650018;
                color: white;
            }

        .disabled-btn {
            background: #999;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 7px;
            font-weight: 600;
        }

        .cart-btn {
            border: 1px solid #800020;
            color: #800020;
            padding: 12px 25px;
            border-radius: 7px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            margin-left: 8px;
        }

            .cart-btn:hover {
                background: #800020;
                color: white;
            }

       
        .alert {
            border-radius: 8px;
        }

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 15px;
            }

            .page-wrapper {
                padding: 15px;
            }

            .product-container {
                padding: 20px;
            }

            .product-image-wrapper {
                height: 350px;
                margin-bottom: 25px;
            }

            .product-name {
                font-size: 26px;
            }

            .sale-price,
            .normal-price {
                font-size: 27px;
            }

            .nav-link-custom {
                margin-left: 8px;
            }

            .cart-btn {
                margin-left: 0;
                margin-top: 10px;
            }

            .detail-row {
                flex-direction: column;
                gap: 4px;
            }

            .detail-value {
                text-align: left;
            }

            .rental-detail {
                flex-direction: column;
                gap: 3px;
            }

            .rental-value {
                text-align: left;
            }
        }

    </style>

</head>


<body>


    <nav class="navbar-custom">

        <div class="container-fluid d-flex align-items-center justify-content-between">

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="brand">

                Wedding Closet <span>Hubs</span>

            </a>


            <div class="d-flex align-items-center">

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="nav-link-custom">

                    <i class="bi bi-house"></i>

                    Dashboard

                </a>


                <a asp-controller="Customer"
                   asp-action="Shops"
                   class="nav-link-custom">

                    <i class="bi bi-shop"></i>

                    Shops

                </a>


                <a asp-controller="Customer"
                   asp-action="Cart"
                   class="nav-link-custom">

                    <i class="bi bi-cart3"></i>

                    Cart

                </a>


                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-btn">

                    <i class="bi bi-box-arrow-right"></i>

                    Logout

                </a>

            </div>

        </div>

    </nav>


    <div class="page-wrapper">


        <div class="back-section">

            <a asp-controller="Customer"
               asp-action="ShopProducts"
               asp-route-id="@Model.ShopId"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Back to Shop Products

            </a>

        </div>


        @if (TempData["Success"] != null)
        {

            <div class="alert alert-success alert-dismissible fade show">

                <i class="bi bi-check-circle-fill"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        }


        @if (TempData["Error"] != null)
        {

            <div class="alert alert-danger alert-dismissible fade show">

                <i class="bi bi-exclamation-triangle-fill"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>

        }



        <div class="product-container">

            <div class="row g-5">



                <div class="col-lg-6">

                    <div class="product-image-wrapper">

                        @if (!string.IsNullOrEmpty(Model.Image))
                        {

                            <img src="@Model.Image"
                                 alt="@Model.ProductName"
                                 class="product-image" />

                        }
                        else
                        {

                            <div class="no-image">

                                <i class="bi bi-image"></i>

                                <div>
                                    No Image Available
                                </div>

                            </div>

                        }

                    </div>

                </div>


                <div class="col-lg-6">




                    <h1 class="product-name">

                        @Model.ProductName

                    </h1>




                    @if (Model.Shop != null)
                    {

                        <div class="shop-name">

                            <i class="bi bi-shop"></i>

                            Sold by:

                            <strong>
                                @Model.Shop.ShopName
                            </strong>

                        </div>

                    }



                    <div class="price-area">

                        @if (isOnSale)
                        {

                            <div class="original-price-label">
                                Original Price
                            </div>

                            <div>

                                <span class="original-price">
                                    Rs. @Model.Price.ToString("N2")
                                </span>

                                <span class="sale-price">
                                    Rs. @Model.SalePrice!.Value.ToString("N2")
                                </span>

                                <span class="sale-badge">
                                    SALE
                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.SaleDetails))
                            {

                                <div class="sale-details">

                                    <i class="bi bi-tag-fill"></i>

                                    @Model.SaleDetails

                                </div>

                            }

                        }
                        else
                        {

                            <div class="original-price-label">
                                Price
                            </div>

                            <div class="normal-price">

                                Rs. @Model.Price.ToString("N2")

                            </div>

                        }

                    </div>



                    <div class="description-title">

                        Description

                    </div>

                    <div class="description">

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {

                            @Model.Description

                        }
                        else
                        {

                            <span>
                                No description available.
                            </span>

                        }

                    </div>



                    <div class="product-badges">


                        @if (!string.IsNullOrWhiteSpace(Model.Category))
                        {

                            <span class="info-badge">

                                <i class="bi bi-tags"></i>

                                Category:

                                @Model.Category

                            </span>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Subcategory))
                        {

                            <span class="info-badge">

                                <i class="bi bi-diagram-3"></i>

                                @Model.Subcategory

                            </span>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Occasion))
                        {

                            <span class="info-badge">

                                <i class="bi bi-calendar-event"></i>

                                @Model.Occasion

                            </span>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Color))
                        {

                            <span class="info-badge">

                                <i class="bi bi-palette"></i>

                                @Model.Color

                            </span>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Size))
                        {

                            <span class="info-badge">

                                <i class="bi bi-rulers"></i>

                                Size:

                                @Model.Size

                            </span>

                        }


                        @if (Model.HasCustomMeasurement)
                        {

                            <span class="custom-badge">

                                <i class="bi bi-rulers"></i>

                                Custom Measurement Available

                            </span>

                        }


                        @if (isOnSale)
                        {

                            <span class="sale-feature-badge">

                                <i class="bi bi-tag-fill"></i>

                                Sale Available

                            </span>

                        }


                        @if (isAvailableForRent)
                        {

                            <span class="rent-feature-badge">

                                <i class="bi bi-arrow-repeat"></i>

                                Available for Rent

                            </span>

                        }


                        @if (canNegotiate)
                        {

                            <span class="negotiation-feature-badge">

                                <i class="bi bi-handshake"></i>

                                Price Negotiation Available

                            </span>

                        }

                    </div>



                    <div class="details-section">

                        <div class="details-title">

                            <i class="bi bi-info-circle"></i>

                            Product Information

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.Category))
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Category
                                </span>

                                <span class="detail-value">
                                    @Model.Category
                                </span>

                            </div>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Subcategory))
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Subcategory
                                </span>

                                <span class="detail-value">
                                    @Model.Subcategory
                                </span>

                            </div>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Occasion))
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Occasion
                                </span>

                                <span class="detail-value">
                                    @Model.Occasion
                                </span>

                            </div>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Color))
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Color
                                </span>

                                <span class="detail-value">
                                    @Model.Color
                                </span>

                            </div>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.Size))
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Standard Size
                                </span>

                                <span class="detail-value">
                                    @Model.Size
                                </span>

                            </div>

                        }


                        @if (!string.IsNullOrWhiteSpace(Model.SizeType))
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Size Type
                                </span>

                                <span class="detail-value">
                                    @Model.SizeType
                                </span>

                            </div>

                        }


                        <div class="detail-row">

                            <span class="detail-label">
                                Stock
                            </span>

                            <span class="detail-value">

                                @if (Model.StockQuantity > 0)
                                {

                                    <span class="available-badge">

                                        <i class="bi bi-check-circle"></i>

                                        @Model.StockQuantity Available

                                    </span>

                                }
                                else
                                {

                                    <span class="unavailable-badge">

                                        <i class="bi bi-x-circle"></i>

                                        Out of Stock

                                    </span>

                                }

                            </span>

                        </div>




                        @if (Model.StockQuantity > 0)
                        {

                            <div class="detail-row">

                                <span class="detail-label">
                                    Current Buy Price
                                </span>

                                <span class="detail-value"
                                      style="color:#800020;">

                                    Rs. @displayBuyPrice.ToString("N2")

                                </span>

                            </div>

                        }

                    </div>


                    @if (isAvailableForRent)
                    {

                        <div class="rental-box">

                            <h5>

                                <i class="bi bi-arrow-repeat"></i>

                                Rental Option

                            </h5>


                            <div class="rental-price">

                                Rs. @Model.RentPrice!.Value.ToString("N2")

                            </div>


                            <div class="rental-detail">

                                <span class="rental-label">
                                    Rental Price
                                </span>

                                <span class="rental-value">
                                    Rs. @Model.RentPrice!.Value.ToString("N2")
                                </span>

                            </div>


                            @if (Model.RentalSecurity.HasValue)
                            {

                                <div class="rental-detail">

                                    <span class="rental-label">
                                        Refundable Security
                                    </span>

                                    <span class="rental-value">
                                        Rs. @Model.RentalSecurity.Value.ToString("N2")
                                    </span>

                                </div>

                            }


                            @if (!string.IsNullOrWhiteSpace(Model.RentalDuration))
                            {

                                <div class="rental-detail">

                                    <span class="rental-label">
                                        Rental Duration
                                    </span>

                                    <span class="rental-value">
                                        @Model.RentalDuration
                                    </span>

                                </div>

                            }


                            @if (!string.IsNullOrWhiteSpace(Model.RentalConditions))
                            {

                                <div class="rental-detail">

                                    <span class="rental-label">
                                        Rental Conditions
                                    </span>

                                    <span class="rental-value">
                                        @Model.RentalConditions
                                    </span>

                                </div>

                            }


                            <p class="rental-note">

                                <i class="bi bi-info-circle"></i>

                                The security amount is refundable according to
                                the shopkeeper's rental conditions.

                            </p>

                        </div>

                    }



                    @if (Model.HasCustomMeasurement)
                    {

                        <div class="measurement-box">

                            <h5>

                                <i class="bi bi-rulers"></i>

                                Custom Measurement Available

                            </h5>

                            <p>

                                This product supports custom measurements.
                                You can provide your measurements during checkout
                                according to the requirements of this dress.

                            </p>

                        </div>

                    }


                    @if (canNegotiate)
                    {
                        <div class="negotiation-box">

                            <h5>
                                <i class="bi bi-handshake"></i>
                                Negotiate Price
                            </h5>

                            @if (negotiatedAlreadyInCart)
                            {
                                <p>
                                    <strong>
                                        This negotiated product is already in your cart.
                                    </strong>
                                    A negotiated product can only be added once.
                                </p>

                                <button type="button"
                                        class="disabled-btn"
                                        disabled>

                                    <i class="bi bi-check-circle"></i>

                                    Already Added to Cart

                                </button>
                            }
                            else
                            {
                                <p>

                                    You can send your own price offer directly to
                                    the shopkeeper. The shopkeeper may accept your
                                    offer, reject it, or send you a counter offer.

                                    <strong>
                                        Price negotiation is separate from Chat.
                                    </strong>

                                </p>

                                <a asp-controller="Customer"
                                   asp-action="Negotiate"
                                   asp-route-productId="@Model.ProductId"
                                   class="negotiation-btn">

                                    <i class="bi bi-handshake"></i>

                                    Negotiate Price

                                </a>
                            }

                        </div>
                    }


                    <div class="action-area">


                        @if (Model.StockQuantity > 0)
                        {

                            <div class="quantity-label">

                                Quantity

                            </div>


                            <div class="mb-3">

                                <input type="number"
                                       id="quantity"
                                       name="quantity"
                                       class="form-control quantity-input"
                                       value="1"
                                       min="1"
                                       max="@Model.StockQuantity" />

                            </div>


                            <form asp-controller="Customer"
                                  asp-action="AddToCart"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="productId"
                                       value="@Model.ProductId" />

                                <input type="hidden"
                                       name="quantity"
                                       id="cartQuantity"
                                       value="1" />


                                <button type="submit"
                                        class="add-cart-btn">

                                    <i class="bi bi-cart-plus"></i>

                                    Add to Cart

                                </button>


                                <a asp-controller="Customer"
                                   asp-action="Cart"
                                   class="cart-btn">

                                    <i class="bi bi-cart3"></i>

                                    View Cart

                                </a>

                            </form>

                        }
                        else
                        {

                            <button type="button"
                                    class="disabled-btn"
                                    disabled>

                                <i class="bi bi-x-circle"></i>

                                Product Out of Stock

                            </button>

                        }

                    </div>

                </div>

            </div>

        </div>

    </div>



    <script>

        const quantityInput =
            document.getElementById("quantity");

        const cartQuantity =
            document.getElementById("cartQuantity");


        if (quantityInput && cartQuantity) {

            quantityInput.addEventListener("input", function () {

                let quantity =
                    parseInt(this.value);


                if (isNaN(quantity) || quantity < 1) {

                    quantity = 1;

                    this.value = 1;

                }


                const maxQuantity =
                    parseInt(this.max);


                if (quantity > maxQuantity) {

                    quantity = maxQuantity;

                    this.value = maxQuantity;

                }


                cartQuantity.value =
                    quantity;

            });

        }

    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>