        @@media (max-width: 991px) {

            .gallery-area {
                position: static;
            }

            .main-image-wrapper {
                height: 500px;
            }
        }

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 14px 15px;
            }

            .brand {
                font-size: 20px;
            }

            .nav-link-custom {
                margin-left: 8px;
                font-size: 13px;
            }

            .logout-btn {
                margin-left: 8px;
                padding: 6px 10px;
                font-size: 12px;
            }

            .page-wrapper {
                padding: 18px 12px 40px;
            }

            .product-container {
                padding: 18px;
                border-radius: 15px;
            }

            .main-image-wrapper {
                height: 380px;
            }

            .product-name {
                font-size: 27px;
            }

            .sale-price,
            .normal-price {
                font-size: 27px;
            }

            .detail-row {
                flex-direction: column;
                gap: 4px;
            }

            .detail-value {
                text-align: left;
            }

            .rental-detail {
                flex-direction: column;
                gap: 3px;
            }

            .rental-value {
                text-align: left;
            }

            .multi-size-table {
                font-size: 12px;
            }

            .multi-size-table th,
            .multi-size-table td {
                padding: 8px;
            }

            .size-quantity-input {
                width: 80px;
            }
        }

        @@media (max-width: 500px) {

            .nav-link-custom {
                display: none;
            }

            .main-image-wrapper {
                height: 330px;
            }

            .thumbnail-btn {
                flex-basis: 65px;
                width: 65px;
                height: 75px;
            }
        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="container-fluid d-flex align-items-center justify-content-between">

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="brand">

                Wedding Closet <span>Hubs</span>

            </a>

            <div class="d-flex align-items-center">

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="nav-link-custom">

                    <i class="bi bi-house"></i>
                    Dashboard

                </a>

                <a asp-controller="Customer"
                   asp-action="Shops"
                   class="nav-link-custom">

                    <i class="bi bi-shop"></i>
                    Shops

                </a>

                <a asp-controller="Customer"
                   asp-action="Cart"
                   class="nav-link-custom">

                    <i class="bi bi-cart3"></i>
                    Cart

                </a>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-btn">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout

                </a>

            </div>

        </div>

    </nav>

    <div class="page-wrapper">

        <div class="back-section">

            <a asp-controller="Customer"
               asp-action="ShopProducts"
               asp-route-id="@Model.ShopId"
               class="back-btn">

                <i class="bi bi-arrow-left"></i>
                Back to Products

            </a>

        </div>

        <div class="product-container">

            <div class="row g-5">

                <div class="col-lg-6">

                    <div class="gallery-area">

                        <div class="main-image-wrapper">

                            @if (galleryImages.Count > 0)
                            {
                                <img id="mainProductImage"
                                     src="@galleryImages[0]"
                                     alt="@Model.ProductName"
                                     class="main-product-image" />

                                @if (galleryImages.Count > 1)
                                {
                                    <div class="gallery-count">

                                        <i class="bi bi-images"></i>
                                        @galleryImages.Count Photos

                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-image">

                                    <i class="bi bi-image"></i>

                                    <div>
                                        No Image Available
                                    </div>

                                </div>
                            }

                        </div>

                        @if (galleryImages.Count > 1)
                        {
                            <div class="thumbnail-area">

                                @for (int i = 0; i < galleryImages.Count; i++)
                                {
                                    <button type="button"
                                            class="thumbnail-btn @(i == 0 ? "active" : "")"
                                            data-image="@galleryImages[i]"
                                            onclick="changeProductImage(this.dataset.image, this)">

                                        <img src="@galleryImages[i]"
                                             alt="@Model.ProductName image @(i + 1)" />

