                                            <button type="submit"
                                                    class="add-cart-btn">

                                                <i class="bi bi-cart-plus"></i>

                                                Add to Cart

                                            </button>

                                        </form>

                                    </div>
                                }

                                @if (isAvailableForRent)
                                {
                                    <div class="purchase-option rent-option">

                                        <div class="purchase-option-title">

                                            <i class="bi bi-arrow-repeat"></i>
                                            Rent Product

                                        </div>

                                        <div class="purchase-option-price">

                                            Rs.
                                            @Model.RentPrice!.Value.ToString("N2")

                                        </div>

                                        <form asp-controller="Customer"
                                              asp-action="AddToCart"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@Model.ProductId" />

                                            <input type="hidden"
                                                   name="quantity"
                                                   id="normalRentQuantity"
                                                   value="1" />

                                            <input type="hidden"
                                                   name="purchaseType"
                                                   value="Rent" />

                                            <button type="submit"
                                                    class="rent-cart-btn">

                                                <i class="bi bi-cart-plus"></i>

                                                Add Rental to Cart

                                            </button>

                                        </form>

                                    </div>
                                }
                            }

                            <div class="option-divider"></div>

                            <a asp-controller="Customer"
                               asp-action="Cart"
                               class="cart-btn">

                                <i class="bi bi-cart3"></i>

                                View Cart

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="action-area">

                            <button type="button"
                                    class="disabled-btn"
                                    disabled>

                                <i class="bi bi-x-circle"></i>

                                Product Out of Stock

                            </button>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <script>

        function changeProductImage(imagePath, button) {

            const mainImage =
                document.getElementById("mainProductImage");

            if (mainImage) {

                mainImage.style.opacity = "0.3";

                setTimeout(function () {

                    mainImage.src = imagePath;
                    mainImage.style.opacity = "1";

                }, 100);
            }

            document
                .querySelectorAll(".thumbnail-btn")
                .forEach(function (item) {

                    item.classList.remove("active");

                });

            if (button) {
                button.classList.add("active");
            }
        }


        const variantInputs =
            document.querySelectorAll(".variant-quantity");

        const selectedSizeSummary =
            document.getElementById("selectedSizeSummary");

        const multiSizeError =
            document.getElementById("multiSizeError");


        function updateSelectedSizeSummary() {

            let totalQuantity = 0;
            let selectedSizes = [];

            variantInputs.forEach(function (input) {

                let quantity =
                    parseInt(input.value, 10);

                if (isNaN(quantity) || quantity < 0) {
                    quantity = 0;
                    input.value = 0;
                }

                const max =
                    parseInt(
                        input.dataset.stock,
                        10);

                if (!isNaN(max) &&
                    quantity > max) {

                    quantity = max;
                    input.value = max;
                }

                if (quantity > 0) {

                    const size =
                        input.dataset.size;

                    totalQuantity += quantity;

                    selectedSizes.push(
                        size + " × " + quantity);
                }

                const row =
                    input.closest(
                        ".size-selection-row");

                if (row) {

                    if (quantity > 0) {
                        row.classList.add(
                            "selected-size-row");
                    }
                    else {
                        row.classList.remove(
                            "selected-size-row");
                    }
                }
            });


            if (selectedSizeSummary) {

                if (selectedSizes.length === 0) {

                    selectedSizeSummary.innerHTML =
                        "No sizes selected yet.";

                }
                else {

                    selectedSizeSummary.innerHTML =
                        "<strong>" +
                        totalQuantity +
                        " piece(s) selected:</strong> " +
                        selectedSizes.join(", ");
                }
            }

            syncAllPurchaseForms();
        }


        function syncAllPurchaseForms() {

            const buyHiddenInputs =
                document.querySelectorAll(
                    ".multi-size-form input[name='VariantQuantities']");

            const saleHiddenInputs =
                document.querySelectorAll(
                    ".sale-hidden-quantity");

            const rentHiddenInputs =
                document.querySelectorAll(
                    ".rent-hidden-quantity");


            variantInputs.forEach(function (input) {

                const size =
                    input.dataset.size;

                const quantity =
                    input.value;


                buyHiddenInputs.forEach(
                    function (hidden) {

                        const form =
                            hidden.form;

                        if (!form ||
                            form.id !== "multiSizeBuyForm") {
                            return;
                        }

                        const sizeInputs =
                            form.querySelectorAll(
                                "input[name='VariantSizes']");

                        const index =
                            Array.from(sizeInputs)
                                .findIndex(function (sizeInput) {

                                    return sizeInput.value
                                        .toLowerCase() ===
                                        size.toLowerCase();

                                });

                        const quantityInputs =
                            form.querySelectorAll(
                                "input[name='VariantQuantities']");

                        if (index >= 0 &&
                            quantityInputs[index]) {

                            quantityInputs[index].value =
                                quantity;
                        }

                    });


                saleHiddenInputs.forEach(
                    function (hidden) {

                        if (
                            hidden.dataset.size.toLowerCase() ===
                            size.toLowerCase()
                        ) {

                            hidden.value =
                                quantity;
                        }

                    });


                rentHiddenInputs.forEach(
                    function (hidden) {

                        if (
                            hidden.dataset.size.toLowerCase() ===
                            size.toLowerCase()
                        ) {

                            hidden.value =
                                quantity;
                        }

                    });

            });
        }


        function validateMultiSizeForm(event) {

            let totalQuantity = 0;

            variantInputs.forEach(function (input) {

                let quantity =
                    parseInt(input.value, 10);

                if (isNaN(quantity) ||
                    quantity < 0) {

                    quantity = 0;
                    input.value = 0;
                }

                const stock =
                    parseInt(
                        input.dataset.stock,
                        10);

                if (quantity > stock) {

                    quantity = stock;
                    input.value = stock;
                }

                totalQuantity += quantity;
            });


            if (totalQuantity <= 0) {

                event.preventDefault();

                if (multiSizeError) {

                    multiSizeError.style.display =
                        "block";

                }

                if (selectedSizeSummary) {

                    selectedSizeSummary.innerHTML =
                        "Please select at least one size and quantity.";

                }

                return false;
            }

            if (multiSizeError) {
                multiSizeError.style.display =
                    "none";
            }

            syncAllPurchaseForms();

            return true;
        }


        variantInputs.forEach(function (input) {

            input.addEventListener(
                "input",
                function () {

                    let value =
                        parseInt(this.value, 10);

                    if (isNaN(value) ||
                        value < 0) {

                        value = 0;
                    }

                    const stock =
                        parseInt(
                            this.dataset.stock,
                            10);

                    if (!isNaN(stock) &&
                        value > stock) {

                        value = stock;
                    }

                    this.value =
                        value;

                    updateSelectedSizeSummary();

                });

        });


        document
            .querySelectorAll(".multi-size-form")
            .forEach(function (form) {

                form.addEventListener(
                    "submit",
                    validateMultiSizeForm);

            });


        const negotiatedForm =
            document.getElementById(
                "negotiatedForm");

        const negotiatedSelectedSize =
            document.getElementById(
                "negotiatedSelectedSize");


        if (negotiatedForm) {

            negotiatedForm.addEventListener(
                "submit",
                function (event) {

                    if (variantInputs.length === 0) {
                        return;
                    }

                    let selectedSize = "";

                    variantInputs.forEach(
                        function (input) {

                            const quantity =
                                parseInt(
                                    input.value,
                                    10);

                            if (quantity > 0 &&
                                !selectedSize) {

                                selectedSize =
                                    input.dataset.size;
                            }

                        });

                    if (!selectedSize) {

                        event.preventDefault();

                        if (selectedSizeSummary) {

                            selectedSizeSummary.innerHTML =
                                "Please select one size for the negotiated product.";

                        }

                        return;
                    }

                    if (negotiatedSelectedSize) {

                        negotiatedSelectedSize.value =
                            selectedSize;

                    }

                });

        }


        const normalQuantity =
            document.getElementById(
                "normalQuantity");

        const normalBuyQuantity =
            document.getElementById(
                "normalBuyQuantity");

        const normalSaleQuantity =
            document.getElementById(
                "normalSaleQuantity");

        const normalRentQuantity =
            document.getElementById(
                "normalRentQuantity");


        if (normalQuantity) {

            normalQuantity.addEventListener(
                "input",
                function () {

                    let value =
                        parseInt(
                            this.value,
                            10);

                    if (isNaN(value) ||
                        value < 1) {

                        value = 1;
                    }

                    const max =
                        parseInt(
                            this.max,
                            10);

                    if (!isNaN(max) &&
                        value > max) {

                        value = max;
                    }

                    this.value =
                        value;

                    if (normalBuyQuantity) {
                        normalBuyQuantity.value =
                            value;
                    }

                    if (normalSaleQuantity) {
                        normalSaleQuantity.value =
                            value;
                    }

                    if (normalRentQuantity) {
                        normalRentQuantity.value =
                            value;
                    }

                });

        }


        updateSelectedSizeSummary();

    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>