@model IEnumerable<WeddingClosetHubs.Models.Notification>

@{
ViewData["Title"] = "Notifications";
Layout = null;


var notifications = Model?
    .OrderByDescending(x => x.CreatedDate)
    .ToList()
    ?? new List<WeddingClosetHubs.Models.Notification>();

var unreadCount = notifications.Count(x => !x.IsRead);


}

<!DOCTYPE html>

<html lang="en">

<head>


<meta charset="utf-8" />

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<title>Notifications - Wedding Closet Hubs</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>

    body {
        background: #f5f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #333;
    }

    .page-wrapper {
        padding: 30px;
        max-width: 1200px;
        margin: auto;
    }

  

    .back-button {
        margin-bottom: 20px;
    }

    .back-button .btn {
        border-radius: 8px;
    }

 

    .page-header {
        background: white;
        border-radius: 15px;
        padding: 25px 30px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #777;
        margin-bottom: 0;
    }

    

    .alert {
        border-radius: 10px;
        margin-bottom: 20px;
    }

  

    .notification-container {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    .notification-header {
        padding: 18px 25px;
        border-bottom: 1px solid #eee;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .notification-header h5 {
        margin: 0;
        font-weight: 700;
    }

  

    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;

        padding: 20px 25px;

        border-bottom: 1px solid #eee;

        text-decoration: none;
        color: inherit;

        transition: background 0.2s ease;
    }

    .notification-item:hover {
        background: #fafafa;
    }

    .notification-item:last-child {
        border-bottom: none;
    }


    .notification-unread {
        background: #fff8e1;
    }

    .notification-unread:hover {
        background: #fff4d6;
    }

   

    .notification-icon {
        min-width: 48px;
        width: 48px;
        height: 48px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 21px;
    }

    .icon-order {
        background: #e7f1ff;
        color: #0d6efd;
    }

    .icon-payment {
        background: #e8f7ef;
        color: #198754;
    }

    .icon-warning {
        background: #fff3cd;
        color: #856404;
    }

    .icon-chat {
        background: #f0e7ff;
        color: #6f42c1;
    }

    .icon-review {
        background: #ffe8ed;
        color: #dc3545;
    }

    .icon-info {
        background: #e9ecef;
        color: #495057;
    }

   

    .notification-content {
        flex: 1;
        min-width: 0;
    }

    .notification-title {
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .notification-message {
        color: #666;
        font-size: 14px;
        line-height: 1.5;
        margin-bottom: 7px;
    }

    .notification-date {
        color: #999;
        font-size: 12px;
    }

    

    .order-badge {
        display: inline-block;

        background: #e7f1ff;
        color: #0d6efd;

        padding: 4px 9px;

        border-radius: 12px;

        font-size: 11px;
        font-weight: 600;

        margin-top: 6px;
    }

   

    .notification-action {
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .mark-read-btn {
        border: 1px solid #198754;
        color: #198754;
        background: white;

        border-radius: 7px;

        padding: 5px 9px;

        font-size: 12px;

        transition: 0.2s;
    }

    .mark-read-btn:hover {
        background: #198754;
        color: white;
    }



    .unread-dot {
        width: 10px;
        height: 10px;

        background: #dc3545;

        border-radius: 50%;

        margin-top: 8px;

        flex-shrink: 0;
    }

    

    .unread-count {
        background: #dc3545;
        color: white;

        border-radius: 20px;

        padding: 5px 11px;

        font-size: 12px;
        font-weight: 600;
    }

   

    .empty-notification {
        text-align: center;
        padding: 70px 20px;
    }

    .empty-notification i {
        font-size: 65px;
        color: #bbb;
    }

    .empty-notification h5 {
        margin-top: 20px;
        font-weight: 700;
    }

    .empty-notification p {
        color: #888;
    }

  

    @@media (max-width: 768px) {

        .page-wrapper {
            padding: 15px;
        }

        .page-header {
            padding: 20px;
        }

        .page-title {
            font-size: 23px;
        }

        .notification-header {
            padding: 15px;
        }

        .notification-item {
            padding: 17px 15px;
            gap: 10px;
        }

        .notification-icon {
            min-width: 42px;
            width: 42px;
            height: 42px;
            font-size: 18px;
        }

        .notification-title {
            font-size: 15px;
        }

        .notification-message {
            font-size: 13px;
        }

        .notification-action {
            min-width: auto;
        }

        .mark-read-btn {
            font-size: 11px;
            padding: 4px 7px;
        }

    }

    @@media (max-width: 500px) {

        .notification-item {
            flex-wrap: wrap;
        }

        .notification-content {
            width: calc(100% - 55px);
        }

        .notification-action {
            width: 100%;
            justify-content: flex-end;
            padding-left: 55px;
        }

    }

</style>


</head>

<body>

<div class="page-wrapper">




<div class="back-button">

    <a asp-controller="Customer"
       asp-action="Dashboard"
       class="btn btn-secondary">

        <i class="bi bi-arrow-left"></i>

        Back to Dashboard

    </a>

</div>




<div class="page-header">

    <div class="row align-items-center">

        <div class="col-md-8">

            <h2 class="page-title">

                <i class="bi bi-bell"></i>

                Notifications

            </h2>

            <p class="page-subtitle">

                Stay updated about your orders, payments,
                messages and other activities.

            </p>

        </div>


        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            @if (unreadCount > 0)
            {

                <form asp-controller="Customer"
                      asp-action="MarkAllNotificationsRead"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-primary">

                        <i class="bi bi-check2-all"></i>

                        Mark All as Read

                    </button>

                </form>

            }
            else
            {

                <span class="text-success">

                    <i class="bi bi-check-circle-fill"></i>

                    All notifications are read

                </span>

            }

        </div>

    </div>

</div>



@if (TempData["Success"] != null)
{

    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>

}




@if (TempData["Error"] != null)
{

    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle-fill"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>

}




<div class="notification-container">



    <div class="notification-header">

        <h5>

            <i class="bi bi-bell-fill"></i>

            Your Notifications

        </h5>


        @if (unreadCount > 0)
        {

            <span class="unread-count">

                @unreadCount Unread

            </span>

        }
        else
        {

            <span class="badge bg-success">

                All Read

            </span>

        }

    </div>



    @if (notifications.Any())
    {

        foreach (var notification in notifications)
        {

           

            string notificationType =
                notification.Type?.Trim().ToLower()
                ?? "general";


            string iconClass = "icon-info";

            string icon = "bi-info-circle";


            switch (notificationType)
            {

                case "order":

                case "orderstatus":

                case "order_status":

                case "neworder":

                case "new_order":

                    iconClass = "icon-order";

                    icon = "bi-box-seam";

                    break;


                case "payment":

                case "paymentstatus":

                case "payment_status":

                    iconClass = "icon-payment";

                    icon = "bi-credit-card";

                    break;


                case "warning":

                case "rejected":

                case "cancelled":

                    iconClass = "icon-warning";

                    icon = "bi-exclamation-triangle";

                    break;


                case "chat":

                case "message":

                case "messages":

                    iconClass = "icon-chat";

                    icon = "bi-chat-dots";

                    break;


                case "review":

                case "feedback":

                case "rating":

                    iconClass = "icon-review";

                    icon = "bi-star";

                    break;


                case "general":

                case "info":

                default:

                    iconClass = "icon-info";

                    icon = "bi-info-circle";

                    break;

            }


           

            <div class="notification-item
                        @(notification.IsRead
                            ? ""
                            : "notification-unread")">



                <div class="notification-icon @iconClass">

                    <i class="bi @icon"></i>

                </div>


                

                <div class="notification-content">



                    <div class="notification-title">

                        @(notification.Title ?? "Notification")

                    </div>


                    

                    <div class="notification-message">

                        @(notification.Message ?? "")

                    </div>


                    

                    <div class="notification-date">

                        <i class="bi bi-clock"></i>

                        @notification.CreatedDate.ToString(
                            "dd MMMM yyyy hh:mm tt"
                        )

                    </div>



                    @if (notification.OrderId.HasValue)
                    {

                        <span class="order-badge">

                            <i class="bi bi-receipt"></i>

                            Order #@notification.OrderId.Value

                        </span>

                    }

                </div>



                <div class="notification-action">

                    @if (!notification.IsRead)
                    {

                        <form asp-controller="Customer"
                              asp-action="MarkNotificationRead"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@notification.NotificationId" />

                            <button type="submit"
                                    class="mark-read-btn"
                                    title="Mark as read">

                                <i class="bi bi-check2"></i>

                                Read

                            </button>

                        </form>


                        <div class="unread-dot ms-2"
                             title="Unread">
                        </div>

                    }
                    else
                    {

                        <span class="text-success small">

                            <i class="bi bi-check-circle-fill"></i>

                            Read

                        </span>

                    }

                </div>

            </div>

        }

    }
    else
    {

        

        <div class="empty-notification">

            <i class="bi bi-bell-slash"></i>

            <h5>

                No Notifications

            </h5>

            <p>

                You don't have any notifications yet.

            </p>

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="btn btn-primary mt-2">

                <i class="bi bi-house"></i>

                Go to Dashboard

            </a>

        </div>

    }

</div>


</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>
