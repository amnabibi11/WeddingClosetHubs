@{
    ViewData["Title"] = "Create Custom Product";
    Layout = null;

    var shop = ViewBag.Shop as WeddingClosetHubs.Models.Shop;

    if (shop == null)
    {
        throw new InvalidOperationException("Shop information is required.");
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Customize Your Product - Wedding Closet Hubs
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #faf7f8;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 35px;
            box-shadow: 0 4px 18px rgba(0,0,0,.12);
        }

        .brand {
            color: white;
            font-size: 25px;
            font-weight: 700;
            text-decoration: none;
        }

            .brand span {
                color: #d4af37;
            }

        .nav-link-custom {
            color: white;
            text-decoration: none;
            margin-left: 22px;
            font-weight: 500;
            transition: .2s;
        }

            .nav-link-custom:hover {
                color: #d4af37;
            }

        .logout-btn {
            border: 1px solid #d4af37;
            color: white;
            padding: 8px 16px;
            border-radius: 7px;
            text-decoration: none;
            margin-left: 20px;
            transition: .2s;
        }

            .logout-btn:hover {
                background: #d4af37;
                color: #800020;
            }

        .page-wrapper {
            max-width: 1150px;
            margin: auto;
            padding: 35px 20px 60px;
        }

        .back-section {
            margin-bottom: 20px;
        }

        .back-btn {
            border: 1px solid #800020;
            color: #800020;
            background: white;
            border-radius: 8px;
            padding: 9px 17px;
            font-weight: 600;
            text-decoration: none;
            transition: .2s;
        }

            .back-btn:hover {
                background: #800020;
                color: white;
            }

        .hero-card {
            background: linear-gradient( 135deg, #800020, #5f0018 );
            color: white;
            border-radius: 20px;
            padding: 35px;
            margin-bottom: 25px;
            box-shadow: 0 10px 30px rgba(128,0,32,.18);
        }

        .hero-icon {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            background: rgba(212,175,55,.18);
            border: 1px solid rgba(212,175,55,.5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            color: #d4af37;
            margin-bottom: 18px;
        }

        .hero-title {
            font-size: 34px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .hero-text {
            color: #f7e9ed;
            line-height: 1.7;
            margin: 0;
            max-width: 850px;
        }

        .shop-name {
            margin-top: 18px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            padding: 9px 15px;
            border-radius: 20px;
            font-weight: 600;
        }

        .main-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 8px 30px rgba(72,24,38,.08);
            border: 1px solid #eee5e8;
        }

        .section-title {
            color: #800020;
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .section-subtitle {
            color: #777;
            font-size: 13px;
            margin-bottom: 22px;
        }

        .form-section {
            background: #fcfafb;
            border: 1px solid #eadfe3;
            border-radius: 15px;
            padding: 22px;
            margin-bottom: 22px;
        }

        .form-label {
            color: #555;
            font-weight: 700;
            font-size: 14px;
        }

        .form-control,
        .form-select {
            border: 1px solid #d9cdd1;
            border-radius: 9px;
            padding: 11px 13px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #800020;
                box-shadow: 0 0 0 .2rem rgba(128,0,32,.1);
            }

        .measurement-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .measurement-row {
            background: white;
            border: 1px solid #e7dfe2;
            border-radius: 11px;
            padding: 13px;
            margin-bottom: 10px;
        }

            .measurement-row .form-control {
                padding: 9px 11px;
            }

        .remove-measurement {
            border: none;
            background: #fdeaea;
            color: #dc3545;
            border-radius: 8px;
            width: 40px;
            height: 40px;
        }

            .remove-measurement:hover {
                background: #dc3545;
                color: white;
            }

        .add-measurement-btn {
            background: #fffaf0;
            border: 1px solid #d4af37;
            color: #705900;
            border-radius: 8px;
            padding: 8px 14px;
            font-weight: 700;
        }

            .add-measurement-btn:hover {
                background: #d4af37;
                color: #800020;
            }

        .measurement-note {
            background: #fffaf0;
            border: 1px solid #ead9a4;
            color: #665c35;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 18px;
        }

            .measurement-note i {
                color: #d4af37;
                margin-right: 5px;
            }

        .upload-area {
            background: white;
            border: 2px dashed #d8c4ca;
            border-radius: 13px;
            padding: 25px;
            text-align: center;
            transition: .2s;
        }

            .upload-area:hover {
                border-color: #d4af37;
                background: #fffdf8;
            }

        .upload-icon {
            font-size: 42px;
            color: #800020;
            margin-bottom: 10px;
        }

        .upload-title {
            color: #800020;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .upload-text {
            color: #777;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .reference-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 15px;
        }

        .preview-item {
            position: relative;
            width: 105px;
            height: 105px;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #ddd;
        }

            .preview-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .preview-remove {
            position: absolute;
            right: 5px;
            top: 5px;
            width: 25px;
            height: 25px;
            border: none;
            border-radius: 50%;
            background: rgba(128,0,32,.9);
            color: white;
            font-size: 13px;
        }

        .process-card {
            background: #f8e9ed;
            border: 1px solid #e2c8d0;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 22px;
        }

        .process-title {
            color: #800020;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .process-step {
            display: flex;
            gap: 12px;
            margin-bottom: 13px;
        }

            .process-step:last-child {
                margin-bottom: 0;
            }

        .step-number {
            flex: 0 0 30px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #800020;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
        }

        .step-text {
            color: #555;
            font-size: 14px;
            line-height: 1.5;
            padding-top: 4px;
        }

        .submit-area {
            border-top: 1px solid #eee;
            padding-top: 22px;
            margin-top: 10px;
        }

        .submit-btn {
            background: #800020;
            color: white;
            border: none;
            border-radius: 9px;
            padding: 13px 25px;
            font-weight: 700;
            font-size: 15px;
            transition: .2s;
        }

            .submit-btn:hover {
                background: #650018;
                color: white;
                transform: translateY(-1px);
            }

        .cancel-btn {
            border: 1px solid #800020;
            color: #800020;
            background: white;
            border-radius: 9px;
            padding: 12px 22px;
            font-weight: 700;
            text-decoration: none;
        }

            .cancel-btn:hover {
                background: #800020;
                color: white;
            }

        .required-star {
            color: #dc3545;
        }

        .validation-message {
            color: #dc3545;
            font-size: 13px;
            font-weight: 600;
            display: none;
            margin-top: 10px;
        }

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 14px 15px;
            }

            .brand {
                font-size: 20px;
            }

            .nav-link-custom {
                display: none;
            }

            .logout-btn {
                margin-left: 8px;
                padding: 6px 10px;
                font-size: 12px;
            }

            .page-wrapper {
                padding: 20px 12px 40px;
            }

            .hero-card {
                padding: 25px 20px;
            }

            .hero-title {
                font-size: 27px;
            }

            .main-card {
                padding: 18px;
            }

            .form-section {
                padding: 17px;
            }

            .measurement-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="container-fluid d-flex align-items-center justify-content-between">

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="brand">

                Wedding Closet <span>Hubs</span>

            </a>

            <div class="d-flex align-items-center">

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="nav-link-custom">

                    <i class="bi bi-house"></i>
                    Dashboard

                </a>

                <a asp-controller="Customer"
                   asp-action="Shops"
                   class="nav-link-custom">

                    <i class="bi bi-shop"></i>
                    Shops

                </a>

                <a asp-controller="Customer"
                   asp-action="Cart"
                   class="nav-link-custom">

                    <i class="bi bi-cart3"></i>
                    Cart

                </a>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-btn">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout

                </a>

            </div>

        </div>

    </nav>


    <div class="page-wrapper">

        <div class="back-section">

            <a asp-controller="Customer"
               asp-action="ShopProducts"
               asp-route-id="@shop.ShopId"
               class="back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Shop

            </a>

        </div>


        <div class="hero-card">

            <div class="hero-icon">

                <i class="bi bi-magic"></i>

            </div>

            <div class="hero-title">

                Create Your Own Custom Product

            </div>

            <p class="hero-text">

                Tell the shopkeeper exactly what you want to create.
                You can provide your own measurements, design requirements,
                preferred style, colors, fabric details and reference images.
                The shopkeeper will review your request and discuss the price
                with you before anything is added to your cart.

            </p>

            <div class="shop-name">

                <i class="bi bi-shop"></i>

                @shop.ShopName

            </div>

        </div>


        <div class="main-card">

            <div class="process-card">

                <div class="process-title">

                    <i class="bi bi-arrow-right-circle"></i>

                    How Customization Works

                </div>

                <div class="process-step">

                    <div class="step-number">
                        1
                    </div>

                    <div class="step-text">

                        Submit your own product design,
                        measurements and requirements.

                    </div>

                </div>

                <div class="process-step">

                    <div class="step-number">
                        2
                    </div>

                    <div class="step-text">

                        The shopkeeper reviews your request
                        and discusses the customized product with you.

                    </div>

                </div>

                <div class="process-step">

                    <div class="step-number">
                        3
                    </div>

                    <div class="step-text">

                        The shopkeeper provides or negotiates
                        the customized price.

                    </div>

                </div>

                <div class="process-step">

                    <div class="step-number">
                        4
                    </div>

                    <div class="step-text">

                        You accept the final offer.

                    </div>

                </div>

                <div class="process-step">

                    <div class="step-number">
                        5
                    </div>

                    <div class="step-text">

                        Only after you accept the final offer,
                        the customized item is added to your cart.

                    </div>

                </div>

            </div>


            <form asp-controller="Customer"
                  asp-action="SaveCustomMeasurements"
                  method="post"
                  enctype="multipart/form-data"
                  id="customizationForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="shopId"
                       value="@shop.ShopId" />


                <div class="form-section">

                    <div class="section-title">

                        <i class="bi bi-scissors"></i>

                        Custom Product Details

                    </div>

                    <div class="section-subtitle">

                        Describe the product you want the shopkeeper
                        to create for you.

                    </div>


                    <div class="mb-3">

                        <label class="form-label">

                            Product / Design Name
                            <span class="required-star">*</span>

                        </label>

                        <input type="text"
                               name="ProductName"
                               class="form-control"
                               maxlength="150"
                               placeholder="Example: Custom Bridal Maxi Dress"
                               required />

                    </div>


                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">

                                Category
                                <span class="required-star">*</span>

                            </label>

                            <select name="Category"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select Category
                                </option>

                                <option value="Bridal Wear">
                                    Bridal Wear
                                </option>

                                <option value="Groom Wear">
                                    Groom Wear
                                </option>

                                <option value="Formal Wear">
                                    Formal Wear
                                </option>

                                <option value="Wedding Guest Wear">
                                    Wedding Guest Wear
                                </option>

                                <option value="Footwear">
                                    Footwear
                                </option>

                                <option value="Jewellery">
                                    Jewellery
                                </option>

                                <option value="Accessories">
                                    Accessories
                                </option>

                                <option value="Bridal Jewellery">
                                    Bridal Jewellery
                                </option>

                                <option value="Bridal Accessories">
                                    Bridal Accessories
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Preferred Color
                            </label>

                            <select name="Color" class="form-select">
                                <option value="">Select Color</option>
                                <option value="Maroon">Maroon</option>
                                <option value="Red">Red</option>
                                <option value="Burgundy">Burgundy</option>
                                <option value="Wine">Wine</option>
                                <option value="Pink">Pink</option>
                                <option value="Rose Pink">Rose Pink</option>
                                <option value="Blush Pink">Blush Pink</option>
                                <option value="Baby Pink">Baby Pink</option>
                                <option value="Peach">Peach</option>
                                <option value="Coral">Coral</option>
                                <option value="Orange">Orange</option>
                                <option value="Yellow">Yellow</option>
                                <option value="Mustard">Mustard</option>
                                <option value="Gold">Gold</option>
                                <option value="Silver">Silver</option>
                                <option value="White">White</option>
                                <option value="Ivory">Ivory</option>
                                <option value="Off White">Off White</option>
                                <option value="Cream">Cream</option>
                                <option value="Beige">Beige</option>
                                <option value="Black">Black</option>
                                <option value="Navy Blue">Navy Blue</option>
                                <option value="Royal Blue">Royal Blue</option>
                                <option value="Sky Blue">Sky Blue</option>
                                <option value="Turquoise">Turquoise</option>
                                <option value="Teal">Teal</option>
                                <option value="Green">Green</option>
                                <option value="Bottle Green">Bottle Green</option>
                                <option value="Olive Green">Olive Green</option>
                                <option value="Purple">Purple</option>
                                <option value="Lavender">Lavender</option>
                                <option value="Plum">Plum</option>
                                <option value="Brown">Brown</option>
                                <option value="Chocolate Brown">Chocolate Brown</option>
                                <option value="Grey">Grey</option>
                                <option value="Charcoal">Charcoal</option>
                                <option value="Other">Other</option>
                            </select>

                        </div>


                    </div>

                </div>


                <div class="form-section">

                    <div class="section-title">

                        <i class="bi bi-rulers"></i>

                        Your Measurements

                    </div>

                    <div class="section-subtitle">

                        Enter your measurements in inches.
                        You can add as many measurements as required.

                    </div>

                    <div class="measurement-note">

                        <i class="bi bi-info-circle"></i>

                        Please enter accurate measurements.
                        For example: Bust, Waist, Hip, Shoulder,
                        Sleeve Length, Shirt Length, Trouser Length, etc.

                    </div>


                    <div class="measurement-header">

                        <div class="fw-bold text-dark">

                            Measurement Details

                        </div>

                        <button type="button"
                                class="add-measurement-btn"
                                id="addMeasurementBtn">

                            <i class="bi bi-plus-circle"></i>

                            Add Measurement

                        </button>

                    </div>


                    <div id="measurementsContainer">

                        <div class="measurement-row">

                            <div class="row g-2 align-items-center">

                                <div class="col-md-6">

                                    <input type="text"
                                           class="form-control measurement-name"
                                           placeholder="Example: Bust"
                                           maxlength="80" />

                                </div>

                                <div class="col-md-5">

                                    <input type="number"
                                           class="form-control measurement-value"
                                           placeholder="Example: 36"
                                           min="0.1"
                                           max="200"
                                           step="0.1" />

                                </div>

                                <div class="col-md-1 text-end">

                                    <button type="button"
                                            class="remove-measurement"
                                            onclick="removeMeasurement(this)">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div id="measurementError"
                         class="validation-message">

                        <i class="bi bi-exclamation-circle"></i>

                        Please enter at least one valid measurement.

                    </div>

                    <input type="hidden"
                           name="CustomMeasurements"
                           id="customMeasurements" />

                </div>


                <div class="form-section">

                    <div class="section-title">

                        <i class="bi bi-image"></i>

                        Reference Images

                    </div>

                    <div class="section-subtitle">

                        Upload pictures showing the design, style,
                        embroidery, fabric, shape or any other details
                        you want.

                    </div>


                    <div class="upload-area">

                        <div class="upload-icon">

                            <i class="bi bi-cloud-arrow-up"></i>

                        </div>

                        <div class="upload-title">

                            Upload Your Design References

                        </div>

                        <div class="upload-text">

                            JPG, JPEG, PNG or WEBP.
                            Maximum 10 images.
                            Maximum 5 MB per image.

                        </div>

                        <input type="file"
                               name="ReferenceImages"
                               id="referenceImages"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               multiple />

                        <div id="referencePreview"
                             class="reference-preview">
                        </div>

                        <div id="imageError"
                             class="validation-message">

                            Please select valid image files only.
                            Maximum 10 images and 5 MB per image.

                        </div>

                    </div>

                </div>


                <div class="form-section">

                    <div class="section-title">

                        <i class="bi bi-chat-left-text"></i>

                        Additional Requirements

                    </div>

                    <div class="section-subtitle">

                        Tell the shopkeeper anything else about your
                        customized product.

                    </div>


                    <textarea name="Notes"
                              class="form-control"
                              rows="7"
                              maxlength="2000"
                              placeholder="Example: I want a heavily embroidered maroon bridal maxi with gold detailing. Please use a soft fabric and keep the sleeves full length. I want the neckline similar to the reference image."></textarea>

                    <div class="text-end mt-2">

                        <small class="text-muted">

                            Maximum 2000 characters

                        </small>

                    </div>

                </div>


                <div class="submit-area">

                    <div class="d-flex flex-wrap gap-2">

                        <button type="submit"
                                class="submit-btn">

                            <i class="bi bi-send"></i>

                            Send Customization Request

                        </button>

                        <a asp-controller="Customer"
                           asp-action="ShopProducts"
                           asp-route-id="@shop.ShopId"
                           class="cancel-btn">

                            <i class="bi bi-arrow-left"></i>

                            Cancel

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <script>

        const measurementsContainer =
            document.getElementById("measurementsContainer");

        const addMeasurementBtn =
            document.getElementById("addMeasurementBtn");

        const customizationForm =
            document.getElementById("customizationForm");

        const customMeasurements =
            document.getElementById("customMeasurements");

        const measurementError =
            document.getElementById("measurementError");

        const referenceImages =
            document.getElementById("referenceImages");

        const referencePreview =
            document.getElementById("referencePreview");

        const imageError =
            document.getElementById("imageError");


        addMeasurementBtn.addEventListener(
            "click",
            function () {

                const row =
                    document.createElement("div");

                row.className =
                    "measurement-row";

                row.innerHTML = `
                    <div class="row g-2 align-items-center">

                        <div class="col-md-6">

                            <input type="text"
                                   class="form-control measurement-name"
                                   placeholder="Example: Waist"
                                   maxlength="80" />

                        </div>

                        <div class="col-md-5">

                            <input type="number"
                                   class="form-control measurement-value"
                                   placeholder="Example: 30"
                                   min="0.1"
                                   max="200"
                                   step="0.1" />

                        </div>

                        <div class="col-md-1 text-end">

                            <button type="button"
                                    class="remove-measurement"
                                    onclick="removeMeasurement(this)">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>

                    </div>
                `;

                measurementsContainer.appendChild(row);

            });


        function removeMeasurement(button) {

            const rows =
                measurementsContainer.querySelectorAll(
                    ".measurement-row");

            if (rows.length <= 1) {

                const nameInput =
                    rows[0].querySelector(
                        ".measurement-name");

                const valueInput =
                    rows[0].querySelector(
                        ".measurement-value");

                nameInput.value = "";
                valueInput.value = "";

                return;
            }

            button.closest(".measurement-row").remove();

        }


        function collectMeasurements() {

            const rows =
                measurementsContainer.querySelectorAll(
                    ".measurement-row");

            const measurements = [];

            rows.forEach(function (row) {

                const nameInput =
                    row.querySelector(
                        ".measurement-name");

                const valueInput =
                    row.querySelector(
                        ".measurement-value");

                const name =
                    nameInput.value.trim();

                const value =
                    valueInput.value.trim();

                if (name !== "" &&
                    value !== "" &&
                    !isNaN(parseFloat(value)) &&
                    parseFloat(value) > 0) {

                    measurements.push(
                        name +
                        ": " +
                        parseFloat(value).toFixed(1) +
                        " inches"
                    );

                }

            });

            customMeasurements.value =
                measurements.join(" | ");

            return measurements;

        }


        referenceImages.addEventListener(
            "change",
            function () {

                referencePreview.innerHTML = "";
                imageError.style.display = "none";

                const files =
                    Array.from(this.files);

                if (files.length > 10) {

                    imageError.textContent =
                        "You can upload a maximum of 10 images.";

                    imageError.style.display =
                        "block";

                    this.value = "";

                    return;
                }

                for (const file of files) {

                    if (!file.type.startsWith("image/")) {

                        imageError.textContent =
                            "Only image files are allowed.";

                        imageError.style.display =
                            "block";

                        this.value = "";

                        referencePreview.innerHTML = "";

                        return;
                    }

                    if (file.size > 5 * 1024 * 1024) {

                        imageError.textContent =
                            "Each image must be 5 MB or smaller.";

                        imageError.style.display =
                            "block";

                        this.value = "";

                        referencePreview.innerHTML = "";

                        return;
                    }

                    const reader =
                        new FileReader();

                    reader.onload =
                        function (event) {

                            const wrapper =
                                document.createElement("div");

                            wrapper.className =
                                "preview-item";

                            const image =
                                document.createElement("img");

                            image.src =
                                event.target.result;

                            wrapper.appendChild(image);

                            referencePreview.appendChild(wrapper);

                        };

                    reader.readAsDataURL(file);

                }

            });


        customizationForm.addEventListener(
            "submit",
            function (event) {

                const measurements =
                    collectMeasurements();

                if (measurements.length === 0) {

                    event.preventDefault();

                    measurementError.style.display =
                        "block";

                    measurementsContainer.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    return;
                }

                measurementError.style.display =
                    "none";


                const files =
                    Array.from(referenceImages.files);

                if (files.length > 10) {

                    event.preventDefault();

                    imageError.textContent =
                        "You can upload a maximum of 10 images.";

                    imageError.style.display =
                        "block";

                    return;
                }

                for (const file of files) {

                    if (!file.type.startsWith("image/") ||
                        file.size > 5 * 1024 * 1024) {

                        event.preventDefault();

                        imageError.textContent =
                            "Each reference image must be a valid image and 5 MB or smaller.";

                        imageError.style.display =
                            "block";

                        return;
                    }

                }

            });


        document
            .querySelectorAll(".measurement-name, .measurement-value")
            .forEach(function (input) {

                input.addEventListener(
                    "input",
                    function () {

                        measurementError.style.display =
                            "none";

                    });

            });

    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>