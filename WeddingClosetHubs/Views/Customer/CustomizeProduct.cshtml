@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Customize Product";
    Layout = null;

    string measurementType =
        (ViewBag.MeasurementType as string ?? "general")
        .Trim()
        .ToLowerInvariant();

    string displaySubcategory =
        string.IsNullOrWhiteSpace(Model.Subcategory)
            ? "Dress"
            : Model.Subcategory;

    string selectedSize =
        ViewBag.SelectedSize as string ?? "";

    string existingMeasurements =
        ViewBag.CustomMeasurements as string ?? "";

    var measurements =
        ViewBag.Measurements as
        List<(string Name, bool Required, decimal Min, decimal Max)>
        ?? new List<(string Name, bool Required, decimal Min, decimal Max)>();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Customize @Model.ProductName - Wedding Closet Hubs
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f7f4f5;
            font-family: Arial, sans-serif;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 30px;
        }

        .brand {
            color: #d4af37;
            font-size: 23px;
            font-weight: bold;
        }

        .main-container {
            max-width: 1050px;
            margin: 35px auto;
        }

        .card-custom {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
        }

        .page-title {
            color: #800020;
            font-weight: bold;
        }

        .section-title {
            color: #800020;
            font-weight: bold;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 8px;
            margin-top: 25px;
            margin-bottom: 20px;
        }

        .product-image {
            width: 100%;
            max-width: 330px;
            height: 360px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;
        }

        .product-info {
            background: #f8e9ed;
            border-radius: 10px;
            padding: 20px;
        }

        .price {
            color: #800020;
            font-size: 24px;
            font-weight: bold;
        }

        .measurement-box {
            background: #fffaf0;
            border: 1px solid #d4af37;
            border-radius: 12px;
            padding: 25px;
        }

        .measurement-note {
            background: #f8e9ed;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
            color: #333;
        }

        .required-badge {
            background: #800020;
            color: white;
            font-size: 10px;
            padding: 3px 7px;
            border-radius: 10px;
            margin-left: 5px;
        }

        .optional-badge {
            background: #6c757d;
            color: white;
            font-size: 10px;
            padding: 3px 7px;
            border-radius: 10px;
            margin-left: 5px;
        }

        .measurement-input {
            height: 45px;
            border: 1px solid #ced4da;
        }

        .measurement-input:focus {
            border-color: #800020;
            box-shadow: 0 0 0 0.2rem rgba(128, 0, 32, .12);
        }

        .measurement-input.is-invalid {
            border-color: #dc3545;
        }

        .measurement-item {
            background: white;
            padding: 15px;
            border-radius: 9px;
            border: 1px solid #e1d8db;
            height: 100%;
        }

        .measurement-item:hover {
            border-color: #d4af37;
        }

        .range-note {
            display: block;
            color: #777;
            font-size: 12px;
            margin-top: 5px;
        }

        .btn-customize {
            background: #800020;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 7px;
        }

        .btn-customize:hover {
            background: #5f0018;
            color: white;
        }

        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
        }

        .btn-back:hover {
            background: #555b60;
            color: white;
        }

        .dress-badge {
            background: #800020;
            color: white;
            padding: 7px 12px;
            border-radius: 20px;
            display: inline-block;
            font-size: 13px;
        }

        .measurement-count {
            color: #666;
            font-size: 13px;
            margin-top: 8px;
        }

        .selected-size-box {
            background: #fffaf0;
            border: 1px solid #d4af37;
            border-radius: 8px;
            padding: 10px 15px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .selected-size-label {
            color: #800020;
            font-weight: 600;
        }

        .no-measurements {
            background: #f8e9ed;
            border-radius: 10px;
            padding: 20px;
            color: #800020;
            text-align: center;
        }

        @@media(max-width:768px) {

            .main-container {
                margin: 20px 10px;
            }

            .card-custom {
                padding: 20px;
            }

            .navbar-custom {
                padding: 15px;
            }

            .brand {
                font-size: 18px;
            }

            .product-image {
                height: 300px;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center">

            <span class="brand">
                Wedding Closet Hubs
            </span>

            <a asp-controller="Customer"
               asp-action="ProductDetails"
               asp-route-id="@Model.ProductId"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Back to Product

            </a>

        </div>

    </nav>


    <div class="main-container">

        <div class="card-custom">

            <h2 class="page-title mb-2">

                <i class="bi bi-rulers"></i>

                Customize Your @displaySubcategory

            </h2>

            <p class="text-muted">

                Enter the measurements normally taken by a tailor.
                All measurements are in inches.

            </p>


            @if (!string.IsNullOrWhiteSpace(selectedSize))
            {
                <div class="selected-size-box mt-3">

                    <span class="selected-size-label">
                        <i class="bi bi-tag"></i>
                        Selected Size:
                    </span>

                    <span class="badge bg-secondary">
                        @selectedSize
                    </span>

                </div>
            }


            <div class="row mt-4">

                <div class="col-md-5 text-center">

                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Url.Content(Model.Image)"
                             class="product-image"
                             alt="@Model.ProductName" />
                    }
                    else
                    {
                        <div class="product-image d-flex align-items-center justify-content-center bg-light">

                            <i class="bi bi-image fs-1 text-muted"></i>

                        </div>
                    }

                </div>


                <div class="col-md-7">

                    <div class="product-info">

                        <h3 class="mb-3">
                            @Model.ProductName
                        </h3>

                        <span class="dress-badge">
                            @displaySubcategory
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mt-3">
                                @Model.Description
                            </p>
                        }

                        <div class="price mt-3">
                            Rs. @Model.Price.ToString("N2")
                        </div>

                        <p class="text-muted mt-2">

                            <i class="bi bi-shop"></i>

                            Shop:
                            @(Model.Shop?.ShopName ?? "Shop")

                        </p>

                    </div>

                </div>

            </div>


            <form asp-controller="Customer"
                  asp-action="SaveCustomMeasurements"
                  method="post"
                  id="customizationForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="productId"
                       value="@Model.ProductId" />

                <input type="hidden"
                       name="size"
                       value="@selectedSize" />

                <input type="hidden"
                       name="customMeasurements"
                       id="customMeasurements"
                       value="@existingMeasurements" />


                <div class="measurement-box mt-4">

                    <h4 class="section-title">

                        <i class="bi bi-rulers"></i>

                        @displaySubcategory Measurement Chart

                    </h4>


                    <div class="measurement-note">

                        <strong>

                            <i class="bi bi-info-circle"></i>

                            Measurement Instructions

                        </strong>

                        <div class="mt-2">

                            Use a soft measuring tape.
                            Keep the tape comfortable and do not pull it
                            too tightly or leave it too loose.

                            <br />

                            <strong>
                                Enter only values within the displayed range.
                            </strong>

                        </div>

                    </div>


                    @if (measurements.Any())
                    {
                        <div class="row">

                            @foreach (var measurement in measurements)
                            {
                                <div class="col-md-6 mb-3">

                                    <div class="measurement-item">

                                        <label class="form-label">

                                            @measurement.Name

                                            @if (measurement.Required)
                                            {
                                                <span class="required-badge">
                                                    Required
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="optional-badge">
                                                    Optional
                                                </span>
                                            }

                                        </label>


                                        <div class="input-group">

                                            <input type="number"
                                                   step="0.1"
                                                   min="@measurement.Min"
                                                   max="@measurement.Max"
                                                   inputmode="decimal"
                                                   class="form-control measurement-input"
                                                   data-name="@measurement.Name"
                                                   data-required="@measurement.Required.ToString().ToLowerInvariant()"
                                                   data-min="@measurement.Min"
                                                   data-max="@measurement.Max" />

                                            <span class="input-group-text">
                                                inches
                                            </span>

                                        </div>


                                        <small class="range-note">

                                            Allowed range:

                                            @measurement.Min.ToString("0.#")

                                            -

                                            @measurement.Max.ToString("0.#")

                                            inches

                                        </small>


                                        <div class="text-danger small measurement-error">
                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="no-measurements">

                            <i class="bi bi-info-circle fs-4"></i>

                            <div class="mt-2">
                                No customization measurements are available
                                for this product.
                            </div>

                        </div>
                    }


                    @if (measurements.Any())
                    {
                        <div class="measurement-count">

                            <i class="bi bi-info-circle"></i>

                            Only the measurements required for

                            <strong>
                                @displaySubcategory
                            </strong>

                            are available.

                            Values outside the displayed ranges
                            cannot be saved.

                        </div>


                        <div class="mt-4 d-flex gap-2 flex-wrap">

                            <button type="submit"
                                    class="btn btn-customize">

                                <i class="bi bi-check-circle"></i>

                                Save Measurements

                            </button>


                            <a asp-controller="Customer"
                               asp-action="Cart"
                               class="btn btn-back">

                                <i class="bi bi-cart"></i>

                                Back to Cart

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="mt-4">

                            <a asp-controller="Customer"
                               asp-action="Cart"
                               class="btn btn-back">

                                <i class="bi bi-cart"></i>

                                Back to Cart

                            </a>

                        </div>
                    }

                </div>

            </form>

        </div>

    </div>


    <script>

        document
            .getElementById("customizationForm")
            .addEventListener("submit", function (event) {

                const inputs =
                    document.querySelectorAll(".measurement-input");

                const measurements = [];

                const missingRequired = [];

                const invalidMeasurements = [];


                inputs.forEach(function (input) {

                    const name =
                        input.getAttribute("data-name");

                    const value =
                        input.value.trim();

                    const isRequired =
                        input.getAttribute("data-required") === "true";

                    const min =
                        parseFloat(
                            input.getAttribute("data-min")
                        );

                    const max =
                        parseFloat(
                            input.getAttribute("data-max")
                        );


                    input.classList.remove("is-invalid");


                    if (isRequired && value === "") {

                        missingRequired.push(name);

                        input.classList.add("is-invalid");

                        return;
                    }


                    if (value === "") {
                        return;
                    }


                    const numericValue =
                        parseFloat(value);


                    if (isNaN(numericValue)) {

                        invalidMeasurements.push(
                            name + " must contain a valid number."
                        );

                        input.classList.add("is-invalid");

                        return;
                    }


                    if (numericValue < min ||
                        numericValue > max) {

                        invalidMeasurements.push(
                            name +
                            " must be between " +
                            min +
                            " and " +
                            max +
                            " inches."
                        );

                        input.classList.add("is-invalid");

                        return;
                    }


                    measurements.push(
                        name +
                        ": " +
                        numericValue.toFixed(1) +
                        " inches"
                    );

                });


                if (missingRequired.length > 0) {

                    event.preventDefault();

                    alert(
                        "Please enter the required measurements:\n\n" +
                        missingRequired.join("\n")
                    );

                    return;
                }


                if (invalidMeasurements.length > 0) {

                    event.preventDefault();

                    alert(
                        "Please correct the following measurements:\n\n" +
                        invalidMeasurements.join("\n")
                    );

                    return;
                }


                if (measurements.length === 0) {

                    event.preventDefault();

                    alert(
                        "Please enter your measurements."
                    );

                    return;
                }


                document.getElementById(
                    "customMeasurements"
                ).value =
                    measurements.join(" | ");

            });


        document
            .querySelectorAll(".measurement-input")
            .forEach(function (input) {

                input.addEventListener("input", function () {

                    const value =
                        parseFloat(this.value);

                    const min =
                        parseFloat(
                            this.getAttribute("data-min")
                        );

                    const max =
                        parseFloat(
                            this.getAttribute("data-max")
                        );


                    if (this.value === "") {

                        this.classList.remove("is-invalid");

                        return;
                    }


                    if (isNaN(value) ||
                        value < min ||
                        value > max) {

                        this.classList.add("is-invalid");

                    }
                    else {

                        this.classList.remove("is-invalid");

                    }

                });

            });

    </script>

</body>

</html>