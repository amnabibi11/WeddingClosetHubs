                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Bust <span class="required">*</span>
                                </label>

                                <input type="number"
                                       step="0.1"
                                       min="0"
                                       class="form-control measurement-input"
                                       data-name="Bust"
                                       required />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">
                                    Waist <span class="required">*</span>
                                </label>

                                <input type="number"
                                       step="0.1"
                                       min="0"
                                       class="form-control measurement-input"
