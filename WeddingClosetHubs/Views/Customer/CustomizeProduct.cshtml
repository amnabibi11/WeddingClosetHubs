    <script>

        document
            .getElementById("customizationForm")
            .addEventListener("submit", function (event) {

                const inputs =
                    document.querySelectorAll(".measurement-input");

                const measurements = [];

                inputs.forEach(function (input) {

                    const name =
                        input.getAttribute("data-name");

                    const value =
                        input.value.trim();

                    if (value !== "") {

                        measurements.push(
                            name + ": " + value + " inches"
                        );

                    }

                });

                if (measurements.length === 0) {

                    event.preventDefault();

                    alert("Please enter your measurements.");

                    return;
                }

                document.getElementById(
                    "customMeasurements"
                ).value =
                    measurements.join(" | ");

            });

    </script>

