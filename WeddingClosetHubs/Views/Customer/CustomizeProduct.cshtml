@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Customize Product";
    Layout = null;

    string selectedSize =
        ViewBag.SelectedSize as string ?? "";

    string existingMeasurements =
        ViewBag.CustomMeasurements as string ?? "";

    string displaySubcategory =
        string.IsNullOrWhiteSpace(Model.Subcategory)
            ? "Dress"
            : Model.Subcategory;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Customize @Model.ProductName - Wedding Closet Hubs
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            background:
                linear-gradient(
                    135deg,
                    #f8f3f5 0%,
                    #fffaf0 100%
                );
            font-family: Arial, sans-serif;
            color: #333;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 30px;
            box-shadow: 0 3px 12px rgba(0,0,0,.12);
        }

        .brand {
            color: #d4af37;
            font-size: 23px;
            font-weight: bold;
        }

        .main-container {
            max-width: 1150px;
            margin: 35px auto 60px;
            padding: 0 15px;
        }

        .card-custom {
            background: white;
            border-radius: 18px;
            padding: 32px;
            box-shadow: 0 8px 30px rgba(128,0,32,.08);
            border: 1px solid #eee;
        }

        .page-title {
            color: #800020;
            font-weight: 700;
            font-size: 30px;
        }

        .page-subtitle {
            color: #6c757d;
            font-size: 15px;
            line-height: 1.7;
        }

        .section-title {
            color: #800020;
            font-weight: 700;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 10px;
            margin-top: 30px;
            margin-bottom: 20px;
        }

        .product-image {
            width: 100%;
            max-width: 350px;
            height: 390px;
            object-fit: cover;
            border-radius: 15px;
            border: 1px solid #ddd;
            box-shadow: 0 5px 18px rgba(0,0,0,.08);
        }

        .product-placeholder {
            width: 100%;
            max-width: 350px;
            height: 390px;
            border-radius: 15px;
            background: #f5f1f2;
            border: 1px solid #ddd;
            color: #aaa;
        }

        .product-info {
            background: #fdf6f8;
            border-radius: 14px;
            padding: 25px;
            border-left: 4px solid #d4af37;
        }

        .product-name {
            color: #800020;
            font-weight: 700;
        }

        .price {
            color: #800020;
            font-size: 25px;
            font-weight: bold;
        }

        .dress-badge {
            background: #800020;
            color: white;
            padding: 7px 14px;
            border-radius: 20px;
            display: inline-block;
            font-size: 13px;
        }

        .selected-size-box {
            background: #fffaf0;
            border: 1px solid #d4af37;
            border-radius: 10px;
            padding: 11px 16px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .selected-size-label {
            color: #800020;
            font-weight: 600;
        }

        .info-banner {
            background: linear-gradient(
                135deg,
                #fdf0f4,
                #fffaf0
            );
            border: 1px solid #ead8dd;
            border-radius: 12px;
            padding: 18px 20px;
            margin-top: 25px;
        }

        .info-banner i {
            color: #d4af37;
            font-size: 21px;
        }

        .custom-section {
            background: #fffdf9;
            border: 1px solid #eadfc7;
            border-radius: 15px;
            padding: 25px;
            margin-top: 25px;
        }

        .section-heading {
            color: #800020;
            font-weight: 700;
            font-size: 20px;
            margin-bottom: 5px;
        }

        .section-description {
            color: #777;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .measurement-row {
            background: white;
            border: 1px solid #e1d8db;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 12px;
            transition: .2s ease;
        }

        .measurement-row:hover {
            border-color: #d4af37;
            box-shadow: 0 3px 12px rgba(0,0,0,.05);
        }

        .form-label {
            font-weight: 600;
            color: #444;
        }

        .form-control,
        .form-select {
            min-height: 45px;
            border: 1px solid #ced4da;
            border-radius: 8px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #800020;
            box-shadow: 0 0 0 .2rem rgba(128,0,32,.10);
        }

        .measurement-value-group {
            display: flex;
            gap: 8px;
        }

        .measurement-value-group .form-control {
            flex: 1;
        }

        .unit-box {
            min-width: 82px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3edf0;
            border: 1px solid #ddd;
            border-radius: 8px;
            color: #800020;
            font-weight: 600;
        }

        .remove-measurement {
            height: 45px;
            width: 45px;
            border-radius: 8px;
            border: 1px solid #dc3545;
            color: #dc3545;
            background: white;
        }

        .remove-measurement:hover {
            background: #dc3545;
            color: white;
        }

        .add-measurement {
            border: 1px dashed #800020;
            color: #800020;
            background: #fff;
            border-radius: 9px;
            padding: 10px 18px;
            font-weight: 600;
        }

        .add-measurement:hover {
            background: #800020;
            color: white;
        }

        .measurement-help {
            background: #f8e9ed;
            border-radius: 10px;
            padding: 15px;
            color: #6b4a53;
            font-size: 13px;
            line-height: 1.7;
        }

        .upload-box {
            border: 2px dashed #d4af37;
            border-radius: 14px;
            padding: 28px;
            text-align: center;
            background: #fffaf0;
            cursor: pointer;
            transition: .2s ease;
        }

        .upload-box:hover {
            background: #fff6dc;
            border-color: #800020;
        }

        .upload-icon {
            font-size: 42px;
            color: #800020;
        }

        .upload-title {
            color: #800020;
            font-weight: 700;
            font-size: 17px;
        }

        .upload-text {
            color: #777;
            font-size: 13px;
        }

        #referenceImages {
            display: none;
        }

        .preview-container {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 18px;
        }

        .preview-item {
            position: relative;
            width: 120px;
            height: 120px;
        }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #ddd;
        }

        .preview-remove {
            position: absolute;
            top: -8px;
            right: -8px;
            width: 28px;
            height: 28px;
            border: none;
            border-radius: 50%;
            background: #800020;
            color: white;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .preview-remove:hover {
            background: #5f0018;
        }

        .note-area {
            min-height: 130px;
            resize: vertical;
        }

        .char-count {
            color: #777;
            font-size: 12px;
            text-align: right;
            margin-top: 5px;
        }

        .submit-area {
            background: linear-gradient(
                135deg,
                #800020,
                #650018
            );
            color: white;
            border-radius: 15px;
            padding: 25px;
            margin-top: 30px;
        }

        .submit-area h5 {
            color: #d4af37;
            font-weight: 700;
        }

        .btn-submit {
            background: #d4af37;
            color: #3f3000;
            border: none;
            padding: 13px 30px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 15px;
        }

        .btn-submit:hover {
            background: #e1bd4a;
            color: #3f3000;
        }

        .btn-back {
            background: white;
            color: #800020;
            border: 1px solid #800020;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
        }

        .btn-back:hover {
            background: #800020;
            color: white;
        }

        .empty-measurement {
            text-align: center;
            background: #f8f4f5;
            border-radius: 12px;
            padding: 25px;
            color: #777;
        }

        .measurement-error {
            color: #dc3545;
            font-size: 13px;
            margin-top: 5px;
            display: none;
        }

        .invalid-row {
            border-color: #dc3545 !important;
        }

        @@media(max-width:768px) {

            .main-container {
                margin: 20px 10px 40px;
                padding: 0;
            }

            .card-custom {
                padding: 20px;
            }

            .navbar-custom {
                padding: 13px 15px;
            }

            .brand {
                font-size: 18px;
            }

            .page-title {
                font-size: 24px;
            }

            .product-image,
            .product-placeholder {
                max-width: 100%;
                height: 320px;
                margin-bottom: 20px;
            }

            .measurement-value-group {
                flex-wrap: wrap;
            }

            .unit-box {
                width: 100%;
                height: 40px;
            }

            .remove-measurement {
                width: 100%;
            }

            .submit-area {
                padding: 20px;
            }

        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center gap-3">

            <span class="brand">
                <i class="bi bi-gem"></i>
                Wedding Closet Hubs
            </span>

            <a asp-controller="Customer"
               asp-action="ProductDetails"
               asp-route-id="@Model.ProductId"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Back to Product

            </a>

        </div>

    </nav>


    <div class="main-container">

        <div class="card-custom">

            <div class="text-center mb-4">

                <h1 class="page-title">

                    <i class="bi bi-magic"></i>

                    Customize Your @displaySubcategory

                </h1>

                <p class="page-subtitle mb-0">

                    Tell the shopkeeper exactly how you want your dress
                    customized. Enter the measurements that are relevant
                    to you and share reference pictures if needed.

                </p>

            </div>


            @if (!string.IsNullOrWhiteSpace(selectedSize))
            {
                <div class="selected-size-box mb-4">

                    <span class="selected-size-label">

                        <i class="bi bi-tag"></i>

                        Selected Size:

                    </span>

                    <span class="badge bg-secondary">

                        @selectedSize

                    </span>

                </div>
            }


            <div class="row g-4">

                <div class="col-lg-5 text-center">

                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Url.Content(Model.Image)"
                             class="product-image"
                             alt="@Model.ProductName" />
                    }
                    else
                    {
                        <div class="product-placeholder d-flex align-items-center justify-content-center">

                            <i class="bi bi-image fs-1"></i>

                        </div>
                    }

                </div>


                <div class="col-lg-7">

                    <div class="product-info">

                        <span class="dress-badge mb-3">

                            <i class="bi bi-stars"></i>

                            Customization Available

                        </span>

                        <h3 class="product-name mt-3">

                            @Model.ProductName

                        </h3>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="text-muted mt-3 mb-3">

                                @Model.Description

                            </p>
                        }

                        <div class="price">

                            Rs. @Model.Price.ToString("N2")

                        </div>

                        <p class="text-muted mt-3 mb-0">

                            <i class="bi bi-shop"></i>

                            Shop:

                            <strong>
                                @(Model.Shop?.ShopName ?? "Shop")
                            </strong>

                        </p>

                    </div>

                </div>

            </div>


            <div class="info-banner">

                <div class="d-flex gap-3">

                    <i class="bi bi-lightbulb-fill"></i>

                    <div>

                        <strong>
                            How customization works
                        </strong>

                        <div class="mt-1">

                            Enter your own measurements below.
                            You can add as many measurements as you need
                            because different dresses may require different
                            measurements.

                            You can also upload reference pictures and
                            explain your requirements.

                        </div>

                    </div>

                </div>

            </div>


            <form asp-controller="Customer"
                  asp-action="SaveCustomMeasurements"
                  method="post"
                  enctype="multipart/form-data"
                  id="customizationForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="productId"
                       value="@Model.ProductId" />


                <input type="hidden"
                       name="size"
                       value="@selectedSize" />


                <input type="hidden"
                       name="customMeasurements"
                       id="customMeasurements"
                       value="@existingMeasurements" />


                <div class="custom-section">

                    <div class="section-heading">

                        <i class="bi bi-rulers"></i>

                        Your Measurements

                    </div>

                    <div class="section-description">

                        Add only the measurements you need.
                        There are no fixed measurement types.

                    </div>


                    <div class="measurement-help mb-4">

                        <i class="bi bi-info-circle me-1"></i>

                        <strong>Example:</strong>

                        You can enter measurements such as
                        Chest, Shoulder, Waist, Hip, Sleeve Length,
                        Shirt Length, Trouser Length, Lehenga Length,
                        or any other measurement required for your dress.

                        Enter the value in inches.

                    </div>


                    <div id="measurementContainer"></div>


                    <div id="noMeasurementMessage"
                         class="empty-measurement mb-3">

                        <i class="bi bi-rulers fs-3 d-block mb-2"></i>

                        No measurements added yet.

                        <br />

                        Click <strong>Add Measurement</strong> to enter
                        your measurements.

                    </div>


                    <button type="button"
                            class="btn add-measurement"
                            id="addMeasurementBtn">

                        <i class="bi bi-plus-circle"></i>

                        Add Measurement

                    </button>

                </div>


                <div class="custom-section">

                    <div class="section-heading">

                        <i class="bi bi-images"></i>

                        Reference Pictures

                    </div>

                    <div class="section-description">

                        Upload pictures showing the design, sleeves,
                        embroidery, neckline, color, fitting or any other
                        detail you want the shopkeeper to understand.

                    </div>


                    <label for="referenceImages"
                           class="upload-box d-block">

                        <div class="upload-icon">

                            <i class="bi bi-cloud-arrow-up"></i>

                        </div>

                        <div class="upload-title mt-2">

                            Upload Reference Pictures

                        </div>

                        <div class="upload-text mt-1">

                            JPG, JPEG, PNG or WEBP

                            <br />

                            You can select multiple pictures.

                        </div>

                        <div class="btn btn-sm btn-outline-dark mt-3">

                            <i class="bi bi-image"></i>

                            Choose Pictures

                        </div>

                    </label>


                    <input type="file"
                           id="referenceImages"
                           name="referenceImages"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           multiple />


                    <div id="imagePreview"
                         class="preview-container">
                    </div>

                    <div id="imageError"
                         class="text-danger small mt-2">
                    </div>

                </div>


                <div class="custom-section">

                    <div class="section-heading">

                        <i class="bi bi-chat-left-text"></i>

                        Additional Requirements

                        <span class="badge bg-secondary ms-2">
                            Optional
                        </span>

                    </div>

                    <div class="section-description">

                        Tell the shopkeeper anything else about your
                        customization.

                    </div>


                    <textarea name="customerNotes"
                              id="customerNotes"
                              class="form-control note-area"
                              maxlength="2000"
                              placeholder="Example: I want the sleeves similar to the reference picture, heavy embroidery around the neckline, and a comfortable fitting."></textarea>


                    <div class="char-count">

                        <span id="characterCount">0</span>
                        / 2000

                    </div>

                </div>


                <div class="submit-area">

                    <div class="row align-items-center g-3">

                        <div class="col-lg-7">

                            <h5>

                                <i class="bi bi-send"></i>

                                Send Your Customization Request

                            </h5>

                            <p class="mb-0">

                                Your measurements, reference pictures and
                                requirements will be sent to the shopkeeper.
                                The shopkeeper will review your request and
                                provide the customized price.

                            </p>

                        </div>

                        <div class="col-lg-5">

                            <div class="d-flex justify-content-lg-end gap-2 flex-wrap">

                                <a asp-controller="Customer"
                                   asp-action="Cart"
                                   class="btn btn-back">

                                    <i class="bi bi-cart"></i>

                                    Back to Cart

                                </a>

                                <button type="submit"
                                        class="btn btn-submit"
                                        id="submitBtn">

                                    <i class="bi bi-send-fill"></i>

                                    Send Request

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <script>

        const measurementContainer =
            document.getElementById("measurementContainer");

        const noMeasurementMessage =
            document.getElementById("noMeasurementMessage");

        const addMeasurementBtn =
            document.getElementById("addMeasurementBtn");

        const customMeasurementsInput =
            document.getElementById("customMeasurements");

        const customizationForm =
            document.getElementById("customizationForm");

        const referenceImages =
            document.getElementById("referenceImages");

        const imagePreview =
            document.getElementById("imagePreview");

        const imageError =
            document.getElementById("imageError");

        const customerNotes =
            document.getElementById("customerNotes");

        const characterCount =
            document.getElementById("characterCount");


        let measurementIndex = 0;


        function updateMeasurementMessage() {

            const rows =
                measurementContainer.querySelectorAll(
                    ".measurement-row"
                );

            if (rows.length === 0) {

                noMeasurementMessage.style.display = "block";

            }
            else {

                noMeasurementMessage.style.display = "none";

            }

        }


        function createMeasurementRow(
            name = "",
            value = "") {

            measurementIndex++;


            const row =
                document.createElement("div");

            row.className =
                "measurement-row";


            row.innerHTML = `

                <div class="row g-2 align-items-end">

                    <div class="col-md-5">

                        <label class="form-label">

                            Measurement Name

                        </label>

                        <input type="text"
                               class="form-control measurement-name"
                               placeholder="e.g. Chest, Shoulder, Sleeve Length"
                               maxlength="100"
                               value="${escapeHtml(name)}">

                        <div class="measurement-error name-error">
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            Measurement Value

                        </label>

                        <div class="measurement-value-group">

                            <input type="number"
                                   class="form-control measurement-value"
                                   placeholder="e.g. 38"
                                   min="0.1"
                                   max="999"
                                   step="0.1"
                                   inputmode="decimal"
                                   value="${escapeHtml(value)}">

                            <div class="unit-box">

                                inches

                            </div>

                        </div>

                        <div class="measurement-error value-error">
                        </div>

                    </div>


                    <div class="col-md-1">

                        <button type="button"
                                class="remove-measurement"
                                title="Remove measurement">

                            <i class="bi bi-trash"></i>

                        </button>

                    </div>

                </div>
            `;


            const removeButton =
                row.querySelector(
                    ".remove-measurement"
                );


            removeButton.addEventListener(
                "click",
                function () {

                    row.remove();

                    updateMeasurementMessage();

                });


            measurementContainer.appendChild(row);

            updateMeasurementMessage();

        }


        function escapeHtml(value) {

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        function loadExistingMeasurements() {

            const existing =
                customMeasurementsInput.value.trim();


            if (!existing)
                return;


            const parts =
                existing.split("|");


            parts.forEach(function (part) {

                const text =
                    part.trim();


                if (!text)
                    return;


                const separator =
                    text.indexOf(":");


                if (separator <= 0)
                    return;


                const name =
                    text
                        .substring(0, separator)
                        .trim();


                let value =
                    text
                        .substring(separator + 1)
                        .trim();


                value =
                    value
                        .replace(
                            /inches/gi,
                            ""
                        )
                        .trim();


                if (name && value) {

                    createMeasurementRow(
                        name,
                        value
                    );

                }

            });

        }


        addMeasurementBtn.addEventListener(
            "click",
            function () {

                createMeasurementRow();

                const rows =
                    measurementContainer.querySelectorAll(
                        ".measurement-row"
                    );

                if (rows.length > 0) {

                    const lastRow =
                        rows[rows.length - 1];

                    lastRow
                        .querySelector(
                            ".measurement-name"
                        )
                        .focus();

                }

            });


        customizationForm.addEventListener(
            "submit",
            function (event) {

                const rows =
                    measurementContainer.querySelectorAll(
                        ".measurement-row"
                    );


                if (rows.length === 0) {

                    event.preventDefault();

                    alert(
                        "Please add at least one measurement."
                    );

                    return;

                }


                const measurements = [];

                const names =
                    new Set();

                let hasError = false;


                rows.forEach(function (row) {

                    const nameInput =
                        row.querySelector(
                            ".measurement-name"
                        );

                    const valueInput =
                        row.querySelector(
                            ".measurement-value"
                        );

                    const nameError =
                        row.querySelector(
                            ".name-error"
                        );

                    const valueError =
                        row.querySelector(
                            ".value-error"
                        );


                    nameError.style.display = "none";
                    valueError.style.display = "none";

                    row.classList.remove(
                        "invalid-row"
                    );


                    const name =
                        nameInput.value.trim();

                    const value =
                        valueInput.value.trim();


                    if (!name) {

                        nameError.textContent =
                            "Please enter the measurement name.";

                        nameError.style.display =
                            "block";

                        row.classList.add(
                            "invalid-row"
                        );

                        hasError = true;

                        return;

                    }


                    if (!value) {

                        valueError.textContent =
                            "Please enter the measurement value.";

                        valueError.style.display =
                            "block";

                        row.classList.add(
                            "invalid-row"
                        );

                        hasError = true;

                        return;

                    }


                    const numericValue =
                        parseFloat(value);


                    if (
                        isNaN(numericValue) ||
                        numericValue <= 0 ||
                        numericValue > 999
                    ) {

                        valueError.textContent =
                            "Please enter a valid measurement.";

                        valueError.style.display =
                            "block";

                        row.classList.add(
                            "invalid-row"
                        );

                        hasError = true;

                        return;

                    }


                    const normalizedName =
                        name.toLowerCase();


                    if (
                        names.has(
                            normalizedName
                        )
                    ) {

                        nameError.textContent =
                            "This measurement has already been added.";

                        nameError.style.display =
                            "block";

                        row.classList.add(
                            "invalid-row"
                        );

                        hasError = true;

                        return;

                    }


                    names.add(
                        normalizedName
                    );


                    measurements.push(
                        name +
                        ": " +
                        numericValue.toFixed(1) +
                        " inches"
                    );

                });


                if (hasError) {

                    event.preventDefault();

                    const firstError =
                        document.querySelector(
                            ".invalid-row"
                        );

                    if (firstError) {

                        firstError.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                    }

                    return;

                }


                customMeasurementsInput.value =
                    measurements.join(" | ");


                const files =
                    referenceImages.files;


                if (files.length > 10) {

                    event.preventDefault();

                    imageError.textContent =
                        "You can upload a maximum of 10 reference pictures.";

                    referenceImages.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    return;

                }


                for (
                    let i = 0;
                    i < files.length;
                    i++
                ) {

                    const file =
                        files[i];

                    const maxSize =
                        5 * 1024 * 1024;


                    if (file.size > maxSize) {

                        event.preventDefault();

                        imageError.textContent =
                            file.name +
                            " is larger than 5 MB.";

                        referenceImages.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                        return;

                    }


                    const allowedTypes = [
                        "image/jpeg",
                        "image/png",
                        "image/webp"
                    ];


                    if (
                        !allowedTypes.includes(
                            file.type
                        )
                    ) {

                        event.preventDefault();

                        imageError.textContent =
                            file.name +
                            " is not a supported image.";

                        return;

                    }

                }

            });


        referenceImages.addEventListener(
            "change",
            function () {

                imagePreview.innerHTML = "";
                imageError.textContent = "";


                const files =
                    this.files;


                if (files.length > 10) {

                    imageError.textContent =
                        "You can upload a maximum of 10 pictures.";

                    this.value = "";

                    return;

                }


                Array.from(files).forEach(
                    function (file) {

                        if (
                            !file.type.startsWith(
                                "image/"
                            )
                        )
                            return;


                        const reader =
                            new FileReader();


                        reader.onload =
                            function (event) {

                                const preview =
                                    document.createElement(
                                        "div"
                                    );

                                preview.className =
                                    "preview-item";


                                preview.innerHTML = `

                                    <img src="${event.target.result}"
                                         alt="Reference image">

                                `;


                                imagePreview.appendChild(
                                    preview
                                );

                            };


                        reader.readAsDataURL(
                            file
                        );

                    }
                );

            });


        customerNotes.addEventListener(
            "input",
            function () {

                characterCount.textContent =
                    this.value.length;

            });


        loadExistingMeasurements();

        updateMeasurementMessage();

    </script>

</body>

</html>