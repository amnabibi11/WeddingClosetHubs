@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Customize Product";
    Layout = null;

    string measurementType =
        (ViewBag.MeasurementType as string ?? "general")
        .Trim()
        .ToLowerInvariant();

    string displaySubcategory =
        string.IsNullOrWhiteSpace(Model.Subcategory)
            ? "Dress"
            : Model.Subcategory;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Customize @Model.ProductName - Wedding Closet Hubs
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f7f4f5;
            font-family: Arial, sans-serif;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 30px;
        }

        .brand {
            color: #d4af37;
            font-size: 23px;
            font-weight: bold;
        }

        .main-container {
            max-width: 1050px;
            margin: 35px auto;
        }

        .card-custom {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
        }

        .page-title {
            color: #800020;
            font-weight: bold;
        }

        .section-title {
            color: #800020;
            font-weight: bold;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 8px;
            margin-top: 25px;
            margin-bottom: 20px;
        }

        .product-image {
            width: 100%;
            max-width: 330px;
            height: 360px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;
        }

        .product-info {
            background: #f8e9ed;
            border-radius: 10px;
            padding: 20px;
        }

        .price {
            color: #800020;
            font-size: 24px;
            font-weight: bold;
        }

        .measurement-box {
            background: #fffaf0;
            border: 1px solid #d4af37;
            border-radius: 12px;
            padding: 25px;
        }

        .measurement-note {
            background: #f8e9ed;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
        }

        .required {
            color: red;
        }

        .btn-customize {
            background: #800020;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 7px;
        }

        .btn-customize:hover {
            background: #5f0018;
            color: white;
        }

        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
        }

        .btn-back:hover {
            background: #555b60;
            color: white;
        }

        .dress-badge {
            background: #800020;
            color: white;
            padding: 7px 12px;
            border-radius: 20px;
            display: inline-block;
            font-size: 13px;
        }

        .measurement-count {
            color: #666;
            font-size: 13px;
            margin-top: 8px;
        }

        @@media(max-width:768px) {

            .main-container {
                margin: 20px 10px;
            }

            .card-custom {
                padding: 20px;
            }

            .navbar-custom {
                padding: 15px;
            }
        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center">

            <span class="brand">
                Wedding Closet Hubs
            </span>

            <a asp-controller="Customer"
               asp-action="ProductDetails"
               asp-route-id="@Model.ProductId"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Back to Product

            </a>

        </div>

    </nav>

    <div class="main-container">

        <div class="card-custom">

            <h2 class="page-title mb-2">

                <i class="bi bi-rulers"></i>

                Customize Your @displaySubcategory

            </h2>

            <p class="text-muted">

                Enter your measurements carefully so the shopkeeper
                can prepare your dress according to your size.

            </p>

            <div class="row mt-4">

                <div class="col-md-5 text-center">

                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Url.Content(Model.Image)"
                             class="product-image"
                             alt="@Model.ProductName" />
                    }
                    else
                    {
                        <div class="product-image d-flex align-items-center justify-content-center bg-light">

                            <i class="bi bi-image fs-1 text-muted"></i>

                        </div>
                    }

                </div>

                <div class="col-md-7">

                    <div class="product-info">

                        <h3 class="mb-3">
                            @Model.ProductName
                        </h3>

                        <span class="dress-badge">
                            @displaySubcategory
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mt-3">
                                @Model.Description
                            </p>
                        }

                        <div class="price mt-3">
                            Rs. @Model.Price.ToString("N2")
                        </div>

                        <p class="text-muted mt-2">

                            <i class="bi bi-shop"></i>

                            Shop:
                            @(Model.Shop?.ShopName ?? "Shop")

                        </p>

                    </div>

                </div>

            </div>

            <form asp-controller="Customer"
                  asp-action="SaveCustomMeasurements"
                  method="post"
                  id="customizationForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="productId"
                       value="@Model.ProductId" />

                <input type="hidden"
                       name="customMeasurements"
                       id="customMeasurements" />

                <div class="measurement-box mt-4">

                    <h4 class="section-title">

                        <i class="bi bi-rulers"></i>

                        @displaySubcategory Measurements

                    </h4>

                    <div class="measurement-note">

                        <strong>
                            <i class="bi bi-info-circle"></i>
                            Important:
                        </strong>

                        Enter measurements in
                        <strong>inches</strong>.

                        Measure your body naturally without
                        pulling the measuring tape too tightly.

                    </div>

                    @if (measurementType == "general")
