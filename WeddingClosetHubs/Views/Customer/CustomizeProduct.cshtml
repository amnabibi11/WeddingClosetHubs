@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Customize Product";
    Layout = null;

    string measurementType =
        ViewBag.MeasurementType as string ?? "general";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Customize @Model.ProductName - Wedding Closet Hub
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f7f4f5;
            font-family: Arial, sans-serif;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 30px;
        }

        .brand {
            color: #d4af37;
            font-size: 23px;
            font-weight: bold;
        }

        .main-container {
            max-width: 1050px;
            margin: 35px auto;
        }

        .card-custom {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,.08);
        }

        .page-title {
            color: #800020;
            font-weight: bold;
        }

        .section-title {
            color: #800020;
            font-weight: bold;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 8px;
            margin-top: 25px;
            margin-bottom: 20px;
        }

        .product-image {
            width: 100%;
            max-width: 330px;
            height: 360px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;
        }

        .product-info {
            background: #f8e9ed;
            border-radius: 10px;
            padding: 20px;
        }

        .price {
            color: #800020;
            font-size: 24px;
            font-weight: bold;
        }

        .measurement-box {
            background: #fffaf0;
            border: 1px solid #d4af37;
            border-radius: 12px;
            padding: 25px;
        }

        .measurement-note {
            background: #f8e9ed;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 600;
        }

        .required {
            color: red;
        }

        .btn-customize {
            background: #800020;
            color: white;
            border: none;
            padding: 12px 28px;
            border-radius: 7px;
        }

        .btn-customize:hover {
            background: #5f0018;
            color: white;
        }

        .btn-back {
            background: #6c757d;
            color: white;
            border: none;
        }

        .btn-back:hover {
            background: #555b60;
            color: white;
        }

        .measurement-description {
            color: #666;
            font-size: 14px;
        }

        .dress-badge {
            background: #800020;
            color: white;
            padding: 7px 12px;
            border-radius: 20px;
            display: inline-block;
            font-size: 13px;
        }

        @@media(max-width:768px) {

            .main-container {
                margin: 20px 10px;
            }

            .card-custom {
                padding: 20px;
            }

            .navbar-custom {
                padding: 15px;
            }

        }

    </style>

</head>

<body>


<!-- =========================================================
     NAVBAR
========================================================= -->

<nav class="navbar-custom">

    <div class="d-flex justify-content-between align-items-center">

        <span class="brand">
            Wedding Closet Hub
        </span>

        <a asp-controller="Customer"
           asp-action="ProductDetails"
           asp-route-id="@Model.ProductId"
           class="btn btn-light">

            <i class="bi bi-arrow-left"></i>

            Back to Product

        </a>

    </div>

</nav>


<!-- =========================================================
     MAIN
========================================================= -->

<div class="main-container">

    <div class="card-custom">

        <h2 class="page-title mb-2">

            <i class="bi bi-rulers"></i>

            Customize Your Dress

        </h2>

        <p class="text-muted">

            Enter your measurements carefully so the shopkeeper
            can prepare your dress according to your size.

        </p>


        <!-- =====================================================
             PRODUCT INFORMATION
        ====================================================== -->

        <div class="row mt-4">

            <div class="col-md-5 text-center">

                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {
                    <img src="@Model.Image"
                         class="product-image"
                         alt="@Model.ProductName" />
                }
                else
                {
                    <div class="product-image d-flex
                                align-items-center
                                justify-content-center
                                bg-light">

                        <i class="bi bi-image fs-1 text-muted"></i>

                    </div>
                }

            </div>


            <div class="col-md-7">

                <div class="product-info">

                    <h3 class="mb-3">
                        @Model.ProductName
                    </h3>

                    <span class="dress-badge">

                        @Model.Subcategory

                    </span>

                    <p class="mt-3">

                        @Model.Description

                    </p>

                    <div class="price mt-3">

                        Rs. @Model.Price.ToString("N2")

                    </div>

                    <p class="text-muted mt-2">

                        <i class="bi bi-shop"></i>

                        Shop:
                        @(Model.Shop?.ShopName ?? "Shop")

                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-controller="Customer"
              asp-action="AddCustomizedToCart"
              method="post"
              id="customizationForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="productId"
                   value="@Model.ProductId" />

            <input type="hidden"
                   name="customMeasurements"
                   id="customMeasurements" />


            <!-- =================================================
                 MEASUREMENT SECTION
            ================================================== -->

            <div class="measurement-box mt-4">

                <h4 class="section-title">

                    <i class="bi bi-rulers"></i>

                    @Model.Subcategory Measurements

                </h4>


                <div class="measurement-note">

                    <strong>
                        <i class="bi bi-info-circle"></i>
                        Important:
                    </strong>

                    Enter measurements in
                    <strong>inches</strong>.

                    Measure your body naturally without
                    pulling the measuring tape too tightly.

                </div>


                <!-- =================================================
                     GENERAL WOMEN DRESS
                ================================================== -->

                @if (measurementType == "general")
                {
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Bust
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   step="0.1"
                                   class="form-control measurement-input"
                                   data-name="Bust"
                                   required />
                        </div>


                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Waist
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   step="0.1"
                                   class="form-control measurement-input"
                                   data-name="Waist"
                                   required />
                        </div>


                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Hips
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   step="0.1"
                                   class="form-control measurement-input"
                                   data-name="Hips"
                                   required />
                        </div>


                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Shoulder
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   step="0.1"
                                   class="form-control measurement-input"
                                   data-name="Shoulder"
                                   required />
                        </div>


                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Armhole
                            </label>

                            <input type="number"
                                   step="0.1"
                                   class="form-control measurement-input"
                                   data-name="Armhole" />
                        </div>


                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Sleeve Length
                            </label>

                            <input type="number"
                                   step="0.1"
                                   class="form-control measurement-input"
                                   data-name="Sleeve Length" />
                        </div>


                        <div class="col-md-6 mb-3">
