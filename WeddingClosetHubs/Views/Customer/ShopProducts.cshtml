@model IEnumerable<WeddingClosetHubs.Models.Product>

@{
    ViewData["Title"] = "Shop Products";
    Layout = null;

    var shop = ViewBag.Shop as WeddingClosetHubs.Models.Shop;

    var products = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Product>();

    bool offersBuy =
        shop?.OffersBuy == true;

    bool offersRent =
        shop?.OffersRent == true;

    bool offersCustomization =
        shop?.OffersCustomization == true;

    string? whatsappNumber =
        shop?.WhatsAppNumber;

    if (!string.IsNullOrWhiteSpace(whatsappNumber))
    {
        whatsappNumber = whatsappNumber
            .Replace("+", "")
            .Replace(" ", "")
            .Replace("-", "")
            .Replace("(", "")
            .Replace(")", "")
            .Replace(".", "");

        if (whatsappNumber.StartsWith("0"))
        {
            whatsappNumber =
                "92" + whatsappNumber.Substring(1);
        }
    }
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(shop?.ShopName ?? "Shop Products") - Wedding Closet Hubs
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f8f5f6;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 35px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        }

        .brand {
            color: white;
            font-size: 24px;
            font-weight: 700;
            text-decoration: none;
        }

        .brand span {
            color: #d4af37;
        }

        .nav-link-custom {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-weight: 500;
        }

        .nav-link-custom:hover {
            color: #d4af37;
        }

        .logout-btn {
            border: 1px solid #d4af37;
            color: white;
            padding: 7px 15px;
            border-radius: 6px;
            text-decoration: none;
            margin-left: 20px;
        }

        .logout-btn:hover {
            background: #d4af37;
            color: #800020;
        }

        .page-wrapper {
            max-width: 1450px;
            margin: 0 auto;
            padding: 35px;
        }

        .shop-header {
            background: white;
            border-radius: 18px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            border: 1px solid #eee4e7;
        }

        .shop-logo-wrapper {
            width: 110px;
            height: 110px;
            border-radius: 14px;
            overflow: hidden;
            background: #f3eef0;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .shop-logo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .shop-logo-placeholder {
            font-size: 45px;
            color: #800020;
        }

        .shop-name {
            color: #800020;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .shop-category {
            display: inline-block;
            background: #fff8e5;
            color: #806000;
            padding: 6px 13px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .shop-description {
            color: #666;
            margin-bottom: 8px;
            line-height: 1.6;
        }

        .shop-address {
            color: #555;
            font-size: 14px;
        }

        .shop-address i {
            color: #800020;
        }

        .shop-services {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 15px;
        }

        .service-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .service-buy {
            background: #edf8f1;
            color: #16733b;
            border: 1px solid #c7e7d2;
        }

        .service-rent {
            background: #f4effb;
            color: #5936a3;
            border: 1px solid #ddd0f0;
        }

        .service-customize {
            background: #fff8df;
            color: #715800;
            border: 1px solid #e6d18a;
        }

        .customize-shop-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #800020;
            color: white;
            border: 1px solid #800020;
            border-radius: 9px;
            padding: 11px 18px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: .25s ease;
            box-shadow: 0 4px 12px rgba(128,0,32,.18);
        }

        .customize-shop-btn:hover {
            background: #d4af37;
            border-color: #d4af37;
            color: #800020;
            transform: translateY(-2px);
        }

        .back-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border: 1px solid #800020;
            color: #800020;
            background: white;
            border-radius: 9px;
            padding: 10px 16px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: .25s ease;
        }

        .back-dashboard-btn:hover {
            background: #800020;
            color: white;
        }

        .shop-contact-section {
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid #eee;
        }

        .shop-contact-title {
            color: #800020;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .shop-contact-title i {
            color: #d4af37;
        }

        .shop-contact-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .shop-contact-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border: 1px solid #800020;
            border-radius: 7px;
            color: #800020;
            background: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .shop-contact-btn i {
            color: #d4af37;
            font-size: 15px;
        }

        .shop-contact-btn:hover {
            background: #800020;
            color: white;
        }

        .shop-contact-btn:hover i {
            color: #d4af37;
        }

        .products-heading {
            margin-bottom: 20px;
        }

        .products-heading h2 {
            color: #800020;
            font-size: 25px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .products-heading p {
            color: #777;
            margin: 0;
            font-size: 14px;
        }

        .product-card {
            background: white;
            border: 1px solid #eee4e7;
            border-radius: 16px;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(0,0,0,0.12);
        }

        .product-image-wrapper {
            height: 290px;
            background: #f3eef0;
            position: relative;
            overflow: hidden;
        }

        .clickable-product-image {
            display: block;
            width: 100%;
            height: 100%;
            cursor: pointer;
            position: relative;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }

        .clickable-product-image:hover .product-image {
            transform: scale(1.045);
        }

        .image-view-overlay {
            position: absolute;
            inset: 0;
            background: rgba(128, 0, 32, .40);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity .25s ease;
        }

        .clickable-product-image:hover .image-view-overlay {
            opacity: 1;
        }

        .image-view-overlay span {
            background: white;
            color: #800020;
            padding: 9px 15px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 3px 10px rgba(0,0,0,.2);
        }

        .image-view-overlay i {
            color: #d4af37;
            margin-right: 5px;
        }

        .no-image {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: #999;
        }

        .no-image i {
            font-size: 55px;
            margin-bottom: 8px;
        }

        .category-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(128, 0, 32, .94);
            color: white;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            max-width: 75%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .product-body {
            padding: 19px;
        }

        .product-name {
            color: #800020;
            font-size: 19px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 7px;
        }

        .product-description {
            color: #777;
            font-size: 13px;
            line-height: 1.5;
            min-height: 39px;
            margin-bottom: 12px;
        }

        .feature-row {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 13px;
        }

        .feature-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .feature-badge i {
            font-size: 11px;
        }

        .badge-buy {
            background: #edf8f1;
            color: #16733b;
            border: 1px solid #c7e7d2;
        }

        .badge-sale {
            background: #fff0f1;
            color: #b42333;
            border: 1px solid #f1c4c9;
        }

        .badge-rent {
            background: #f4effb;
            color: #5936a3;
            border: 1px solid #ddd0f0;
        }

        .badge-negotiate {
            background: #fff8df;
            color: #715800;
            border: 1px solid #e6d18a;
        }

        .badge-measurement {
            background: #f0f4ff;
            color: #38558f;
            border: 1px solid #ccd8f2;
        }

        .product-info {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 13px;
        }

        .info-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #fafafa;
            border: 1px solid #e7e2e3;
            color: #555;
            padding: 5px 8px;
            border-radius: 6px;
            font-size: 10px;
        }

        .info-badge i {
            color: #800020;
        }

        .price-section {
            padding: 12px 0;
            border-top: 1px solid #eee;
            border-bottom: 1px solid #eee;
        }

        .price-label {
            color: #777;
            font-size: 11px;
            margin-bottom: 2px;
        }

        .price {
            color: #800020;
            font-size: 23px;
            font-weight: 700;
        }

        .original-price {
            color: #888;
            font-size: 12px;
            text-decoration: line-through;
            margin-bottom: 2px;
        }

        .sale-price {
            color: #800020;
            font-size: 23px;
            font-weight: 700;
        }

        .sale-details {
            color: #b42333;
            font-size: 11px;
            margin-top: 3px;
            line-height: 1.4;
        }

        .rent-box {
            background: #f7f3fc;
            border: 1px solid #e2d8f0;
            border-radius: 9px;
            padding: 10px 12px;
            margin-top: 11px;
        }

        .rent-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
        }

        .rent-title {
            color: #5936a3;
            font-size: 11px;
            font-weight: 700;
        }

        .rent-price {
            color: #5936a3;
            font-size: 17px;
            font-weight: 700;
        }

        .rent-security,
        .rent-duration {
            color: #666;
            font-size: 10px;
            margin-top: 3px;
        }

        .stock-section {
            margin-top: 11px;
        }

        .stock {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #198754;
            font-size: 11px;
            font-weight: 600;
        }

        .stock-low {
            color: #dc3545;
        }

        .view-product-btn {
            display: block;
            width: 100%;
            background: #800020;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 11px;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            margin-top: 15px;
            transition: .25s ease;
        }

        .view-product-btn:hover {
            background: #650018;
            color: white;
        }

        .view-product-btn:disabled {
            background: #999;
            cursor: not-allowed;
        }

        .empty-box {
            background: white;
            border-radius: 20px;
            padding: 70px 30px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(128,0,32,0.08);
            border: 1px solid #eee4e7;
            max-width: 850px;
            margin: 20px auto 40px;
        }

        .empty-icon-wrapper {
            width: 105px;
            height: 105px;
            border-radius: 50%;
            background: #f8e9ed;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 22px;
        }

        .empty-icon-wrapper i {
            font-size: 48px;
            color: #800020;
        }

        .empty-box h3 {
            color: #800020;
            font-weight: 700;
            font-size: 27px;
            margin-bottom: 10px;
        }

        .empty-box p {
            color: #777;
            max-width: 600px;
            margin: 0 auto 25px;
            line-height: 1.7;
        }

        .empty-actions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .empty-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #800020;
            color: white;
            border-radius: 9px;
            padding: 11px 20px;
            text-decoration: none;
            font-weight: 600;
            transition: .25s ease;
        }

        .empty-dashboard-btn:hover {
            background: #650018;
            color: white;
            transform: translateY(-2px);
        }

        .empty-shops-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: white;
            color: #800020;
            border: 1px solid #800020;
            border-radius: 9px;
            padding: 11px 20px;
            text-decoration: none;
            font-weight: 600;
            transition: .25s ease;
        }

        .empty-shops-btn:hover {
            background: #800020;
            color: white;
        }

        .image-modal .modal-content {
            background: #212529;
            border: 2px solid #d4af37;
            border-radius: 12px;
            overflow: hidden;
        }

        .image-modal .modal-header {
            background: #800020;
            color: white;
            border-bottom: 1px solid #d4af37;
        }

        .image-modal .modal-title {
            font-weight: 700;
        }

        .image-modal .btn-close {
            filter: invert(1);
        }

        .full-product-image {
            width: 100%;
            max-height: 80vh;
            object-fit: contain;
            background: #212529;
        }

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 15px;
            }

            .page-wrapper {
                padding: 15px;
            }

            .shop-header {
                padding: 20px;
            }

            .shop-name {
                font-size: 24px;
            }

            .nav-link-custom {
                margin-left: 8px;
                font-size: 13px;
            }

            .product-image-wrapper {
                height: 270px;
            }

            .shop-contact-buttons {
                gap: 6px;
            }

            .shop-contact-btn {
                font-size: 12px;
                padding: 6px 9px;
            }

            .customize-shop-btn,
            .back-dashboard-btn {
                width: 100%;
            }

            .empty-box {
                padding: 50px 20px;
            }

            .empty-box h3 {
                font-size: 23px;
            }

            .full-product-image {
                max-height: 70vh;
            }
        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-3">

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="brand">

                Wedding Closet <span>Hubs</span>

            </a>

            <div class="d-flex align-items-center flex-wrap">

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="nav-link-custom">

                    <i class="bi bi-house"></i>
                    Dashboard

                </a>

                <a asp-controller="Customer"
                   asp-action="Shops"
                   class="nav-link-custom">

                    <i class="bi bi-shop"></i>
                    Shops

                </a>

                <a asp-controller="Customer"
                   asp-action="Cart"
                   class="nav-link-custom">

                    <i class="bi bi-cart3"></i>
                    Cart

                </a>

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-btn">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout

                </a>

            </div>

        </div>

    </nav>


    <div class="page-wrapper">

        @if (shop != null)
        {
            <div class="shop-header">

                <div class="row align-items-center">

                    <div class="col-md-2 text-center mb-3 mb-md-0">

                        <div class="shop-logo-wrapper mx-auto">

                            @if (!string.IsNullOrEmpty(shop.Logo))
                            {
                                <img src="@shop.Logo"
                                     alt="@shop.ShopName"
                                     class="shop-logo" />
                            }
                            else
                            {
                                <i class="bi bi-shop shop-logo-placeholder"></i>
                            }

                        </div>

                    </div>


                    <div class="col-md-7">

                        <h1 class="shop-name">
                            @shop.ShopName
                        </h1>

                        @if (!string.IsNullOrEmpty(shop.ShopCategory))
                        {
                            <span class="shop-category">

                                <i class="bi bi-tags"></i>
                                @shop.ShopCategory

                            </span>
                        }

                        @if (!string.IsNullOrEmpty(shop.ShopDescription))
                        {
                            <p class="shop-description">
                                @shop.ShopDescription
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(shop.ShopAddress))
                        {
                            <div class="shop-address">

                                <i class="bi bi-geo-alt-fill"></i>
                                @shop.ShopAddress

                            </div>
                        }

                        <div class="shop-services">

                            @if (offersBuy)
                            {
                                <span class="service-badge service-buy">
                                    <i class="bi bi-bag-check-fill"></i>
                                    Buy
                                </span>
                            }

                            @if (offersRent)
                            {
                                <span class="service-badge service-rent">
                                    <i class="bi bi-arrow-repeat"></i>
                                    Rent
                                </span>
                            }

                            @if (offersCustomization)
                            {
                                <span class="service-badge service-customize">
                                    <i class="bi bi-scissors"></i>
                                    Customize
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-3 text-md-end mt-3 mt-md-0">

                        <div class="mb-2">

                            <strong>@products.Count</strong>
                            Products Available

                        </div>

                        @if (offersCustomization)
                        {
                            <a asp-controller="Customer"
                               asp-action="Customize"
                               asp-route-shopId="@shop.ShopId"
                               class="customize-shop-btn mb-2">

                                <i class="bi bi-scissors"></i>
                                Customize

                            </a>
                        }

                        <a asp-controller="Customer"
                           asp-action="Dashboard"
                           class="back-dashboard-btn">

                            <i class="bi bi-house"></i>
                            Back to Dashboard

                        </a>

                    </div>

                </div>


                @if (!string.IsNullOrWhiteSpace(shop.ShopPhone) ||
                     !string.IsNullOrWhiteSpace(shop.Email) ||
                     !string.IsNullOrWhiteSpace(shop.WhatsAppNumber) ||
                     !string.IsNullOrWhiteSpace(shop.FacebookUrl) ||
                     !string.IsNullOrWhiteSpace(shop.InstagramUrl) ||
                     !string.IsNullOrWhiteSpace(shop.TikTokUrl) ||
                     !string.IsNullOrWhiteSpace(shop.WebsiteUrl))
                {
                    <div class="shop-contact-section">

                        <div class="shop-contact-title">

                            <i class="bi bi-person-lines-fill"></i>
                            Contact & Social Media

                        </div>

                        <div class="shop-contact-buttons">

                            @if (!string.IsNullOrWhiteSpace(shop.ShopPhone))
                            {
                                <a href="tel:@shop.ShopPhone"
                                   class="shop-contact-btn">

                                    <i class="bi bi-telephone-fill"></i>
                                    @shop.ShopPhone

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(shop.Email))
                            {
                                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=@Uri.EscapeDataString(shop.Email.Trim())"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shop-contact-btn">

                                    <i class="bi bi-envelope-fill"></i>
                                    Email

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(shop.WhatsAppNumber))
                            {
                                <a href="https://wa.me/@whatsappNumber"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shop-contact-btn">

                                    <i class="bi bi-whatsapp"></i>
                                    WhatsApp

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(shop.FacebookUrl))
                            {
                                <a href="@shop.FacebookUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shop-contact-btn">

                                    <i class="bi bi-facebook"></i>
                                    Facebook

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(shop.InstagramUrl))
                            {
                                <a href="@shop.InstagramUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shop-contact-btn">

                                    <i class="bi bi-instagram"></i>
                                    Instagram

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(shop.TikTokUrl))
                            {
                                <a href="@shop.TikTokUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shop-contact-btn">

                                    <i class="bi bi-tiktok"></i>
                                    TikTok

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(shop.WebsiteUrl))
                            {
                                <a href="@shop.WebsiteUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="shop-contact-btn">

                                    <i class="bi bi-globe2"></i>
                                    Website

                                </a>
                            }

                        </div>

                    </div>
                }

            </div>
        }


        @if (products.Any())
        {
            <div class="products-heading">

                <h2>
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    Products
                </h2>

                <p>
                    Browse the products available from this shop.
                </p>

            </div>

            <div class="row g-4">

                @foreach (var product in products)
                {
                    bool isOnSale =
                        offersBuy &&
                        product.IsAvailableForBuy &&
                        product.IsOnSale &&
                        product.SalePrice.HasValue &&
                        product.SalePrice.Value > 0 &&
                        product.SalePrice.Value < product.Price;

                    bool isAvailableForRent =
                        offersRent &&
                        product.IsAvailableForRent &&
                        product.RentPrice.HasValue &&
                        product.RentPrice.Value > 0;

                    bool canNegotiate =
                        offersBuy &&
                        product.IsAvailableForBuy &&
                        product.AllowNegotiation;

                    bool canBuy =
                        offersBuy &&
                        product.IsAvailableForBuy;

                    bool hasVariants =
                        product.ProductVariants != null &&
                        product.ProductVariants.Any();

                    int totalVariantStock =
                        hasVariants
                            ? product.ProductVariants!.Sum(v => v.StockQuantity)
                            : product.StockQuantity;

                    bool productInStock =
                        totalVariantStock > 0;

                    decimal displayBuyPrice =
                        isOnSale
                            ? product.SalePrice!.Value
                            : product.Price;

                    <div class="col-xl-3 col-lg-4 col-md-6">

                        <div class="product-card">

                            <div class="product-image-wrapper">

                                @if (!string.IsNullOrEmpty(product.Image))
                                {
                                    <a href="#"
                                       class="clickable-product-image"
                                       data-bs-toggle="modal"
                                       data-bs-target="#productImageModal"
                                       data-image="@product.Image"
                                       data-product-name="@product.ProductName">

                                        <img src="@product.Image"
                                             alt="@product.ProductName"
                                             class="product-image" />

                                        <div class="image-view-overlay">

                                            <span>

                                                <i class="bi bi-zoom-in"></i>
                                                View Full Image

                                            </span>

                                        </div>

                                    </a>
                                }
                                else
                                {
                                    <div class="no-image">

                                        <i class="bi bi-image"></i>

                                        <span>
                                            No Image Available
                                        </span>

                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(product.Category))
                                {
                                    <span class="category-badge">
                                        @product.Category
                                    </span>
                                }

                            </div>


                            <div class="product-body">

                                <div class="product-name">
                                    @product.ProductName
                                </div>


                                <p class="product-description">

                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        if (product.Description.Length > 100)
                                        {
                                            @product.Description.Substring(0, 100)
                                            <text>...</text>
                                        }
                                        else
                                        {
                                            @product.Description
                                        }
                                    }
                                    else
                                    {
                                        <span>
                                            No description available.
                                        </span>
                                    }

                                </p>


                                @if (canBuy ||
                                     isOnSale ||
                                     isAvailableForRent ||
                                     canNegotiate ||
                                     product.HasCustomMeasurement)
                                {
                                    <div class="feature-row">

                                        @if (canBuy)
                                        {
                                            <span class="feature-badge badge-buy">

                                                <i class="bi bi-bag-check-fill"></i>
                                                Buy Available

                                            </span>
                                        }

                                        @if (isOnSale)
                                        {
                                            <span class="feature-badge badge-sale">

                                                <i class="bi bi-tag-fill"></i>
                                                Sale

                                            </span>
                                        }

                                        @if (isAvailableForRent)
                                        {
                                            <span class="feature-badge badge-rent">

                                                <i class="bi bi-arrow-repeat"></i>
                                                Rent Available

                                            </span>
                                        }

                                        @if (canNegotiate)
                                        {
                                            <span class="feature-badge badge-negotiate">

                                                <i class="bi bi-handshake"></i>
                                                Negotiable

                                            </span>
                                        }

                                        @if (product.HasCustomMeasurement)
                                        {
                                            <span class="feature-badge badge-measurement">

                                                <i class="bi bi-rulers"></i>
                                                Custom Measurements

                                            </span>
                                        }

                                    </div>
                                }


                                <div class="product-info">

                                    @if (!string.IsNullOrEmpty(product.Subcategory))
                                    {
                                        <span class="info-badge">

                                            <i class="bi bi-diagram-3"></i>
                                            @product.Subcategory

                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(product.Occasion))
                                    {
                                        <span class="info-badge">

                                            <i class="bi bi-calendar-event"></i>
                                            @product.Occasion

                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(product.Color))
                                    {
                                        <span class="info-badge">

                                            <i class="bi bi-palette"></i>
                                            @product.Color

                                        </span>
                                    }

                                    @if (!string.IsNullOrEmpty(product.Size))
                                    {
                                        <span class="info-badge">

                                            <i class="bi bi-rulers"></i>
                                            Size: @product.Size

                                        </span>
                                    }

                                </div>


                                @if (canBuy)
                                {
                                    <div class="price-section">

                                        <div class="price-label">
                                            Purchase Price
                                        </div>

                                        @if (isOnSale)
                                        {
                                            <div class="original-price">

                                                Rs. @product.Price.ToString("N2")

                                            </div>

                                            <div class="sale-price">

                                                Rs. @displayBuyPrice.ToString("N2")

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(product.SaleDetails))
                                            {
                                                <div class="sale-details">

                                                    <i class="bi bi-tag-fill"></i>

                                                    @product.SaleDetails

                                                </div>
                                            }
                                            else
                                            {
                                                <div class="sale-details">

                                                    <i class="bi bi-tag-fill"></i>

                                                    Special sale price

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="price">

                                                Rs. @displayBuyPrice.ToString("N2")

                                            </div>
                                        }

                                    </div>
                                }


                                @if (isAvailableForRent)
                                {
                                    <div class="rent-box">

                                        <div class="rent-header">

                                            <div class="rent-title">

                                                <i class="bi bi-arrow-repeat"></i>
                                                RENTAL OPTION

                                            </div>

                                            <div class="rent-price">

                                                Rs. @product.RentPrice!.Value.ToString("N2")

                                            </div>

                                        </div>

                                        @if (product.RentalSecurity.HasValue &&
                                             product.RentalSecurity.Value > 0)
                                        {
                                            <div class="rent-security">

                                                <i class="bi bi-shield-check"></i>

                                                Refundable security:
                                                Rs. @product.RentalSecurity.Value.ToString("N2")

                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(product.RentalDuration))
                                        {
                                            <div class="rent-duration">

                                                <i class="bi bi-clock"></i>

                                                @product.RentalDuration

                                            </div>
                                        }

                                    </div>
                                }


                                <div class="stock-section">

                                    @if (productInStock)
                                    {
                                        if (totalVariantStock <= 5)
                                        {
                                            <span class="stock stock-low">

                                                <i class="bi bi-exclamation-circle"></i>

                                                Only @totalVariantStock available

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock">

                                                <i class="bi bi-check-circle"></i>

                                                @totalVariantStock available

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="stock stock-low">

                                            <i class="bi bi-x-circle"></i>

                                            Currently unavailable

                                        </span>
                                    }

                                </div>


                                @if (productInStock)
                                {
                                    <a asp-controller="Customer"
                                       asp-action="ProductDetails"
                                       asp-route-id="@product.ProductId"
                                       class="view-product-btn">

                                        <i class="bi bi-eye"></i>

                                        View Product

                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="view-product-btn"
                                            disabled>

                                        <i class="bi bi-x-circle"></i>

                                        Out of Stock

                                    </button>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-box">

                <div class="empty-icon-wrapper">

                    <i class="bi bi-bag-x"></i>

                </div>

                <h3>
                    No Products Available
                </h3>

                <p>
                    This shop does not currently have any active products
                    available to browse. You can return to your dashboard
                    or explore other shops to find your perfect wedding outfit.
                </p>

                <div class="empty-actions">

                    <a asp-controller="Customer"
                       asp-action="Dashboard"
                       class="empty-dashboard-btn">

                        <i class="bi bi-house-fill"></i>
                        Back to Dashboard

                    </a>

                    <a asp-controller="Customer"
                       asp-action="Shops"
                       class="empty-shops-btn">

                        <i class="bi bi-shop"></i>
                        Browse Other Shops

                    </a>

                </div>

            </div>
        }

    </div>


    <div class="modal fade image-modal"
         id="productImageModal"
         tabindex="-1"
         aria-labelledby="productImageModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-xl">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="productImageModalLabel">

                        Product Image

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body p-0 text-center">

                    <img id="fullProductImage"
                         src=""
                         alt="Product Image"
                         class="full-product-image" />

                </div>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const imageLinks =
                document.querySelectorAll(".clickable-product-image");

            const fullImage =
                document.getElementById("fullProductImage");

            const modalTitle =
                document.getElementById("productImageModalLabel");

            imageLinks.forEach(function (link) {

                link.addEventListener("click", function (event) {

                    event.preventDefault();

                    const image =
                        this.getAttribute("data-image");

                    const productName =
                        this.getAttribute("data-product-name");

                    if (image) {
                        fullImage.src = image;
                    }

                    if (productName) {
                        modalTitle.textContent =
                            productName + " - Full Image";
                    }

                });

            });

        });

    </script>

</body>

</html>
