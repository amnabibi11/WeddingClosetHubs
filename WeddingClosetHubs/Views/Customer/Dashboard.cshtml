@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = null;

    string customerName =
        Context.Session.GetString("UserName") ?? "Customer";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Customer Dashboard - Wedding Closet Hubs</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        /* ==========================================
           SIDEBAR
        ========================================== */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #800020;
            color: white;
            padding: 25px 15px;
            overflow-y: auto;
            z-index: 1000;
        }

        .brand {
            text-align: center;
            padding-bottom: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.2);
            margin-bottom: 20px;
        }

        .brand-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #d4af37;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            font-size: 28px;
        }

        .brand h4 {
            margin-top: 12px;
            margin-bottom: 3px;
            font-weight: 700;
        }

        .brand small {
            color: #f5d98b;
        }

        /* ==========================================
           NAVIGATION
        ========================================== */

        .nav-title {
            font-size: 11px;
            text-transform: uppercase;
            color: #e8c8cf;
            margin: 20px 10px 8px;
            letter-spacing: 1px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            margin-bottom: 5px;
            border-radius: 8px;
            color: white;
            text-decoration: none;
            transition: 0.2s;
        }

        .sidebar-link:hover {
            background: rgba(255,255,255,0.12);
            color: white;
            transform: translateX(2px);
        }

        .sidebar-link.active {
            background: #d4af37;
            color: #800020;
            font-weight: 700;
        }

        .sidebar-link i {
            font-size: 18px;
            width: 22px;
            text-align: center;
        }

        .logout-link {
            margin-top: 25px;
            border-top: 1px solid rgba(255,255,255,0.2);
            padding-top: 20px;
        }

        /* ==========================================
           MAIN CONTENT
        ========================================== */

        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }

        /* ==========================================
           TOPBAR
        ========================================== */

        .topbar {
            height: 75px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }

        .welcome-text {
            font-size: 15px;
            color: #777;
        }

        .welcome-text strong {
            color: #800020;
            font-size: 17px;
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .top-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #f8f1f3;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 19px;
            position: relative;
        }

        .top-icon:hover {
            background: #800020;
            color: white;
        }

        /* ==========================================
           PAGE CONTENT
        ========================================== */

        .content-wrapper {
            padding: 30px;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h2 {
            font-size: 28px;
            font-weight: 700;
            color: #333;
            margin-bottom: 5px;
        }

        .page-heading p {
            color: #777;
            margin-bottom: 0;
        }

        /* ==========================================
           WELCOME CARD
        ========================================== */

        .welcome-card {
            background: linear-gradient(135deg, #800020, #a52a48);
            color: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 25px;
            box-shadow: 0 5px 20px rgba(128,0,32,0.18);
        }

        .welcome-card h3 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .welcome-card p {
            color: #f5dfe5;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .shop-btn {
            background: #d4af37;
            border: none;
            color: #800020;
            font-weight: 700;
            padding: 11px 20px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-block;
        }

        .shop-btn:hover {
            background: #e5c451;
            color: #800020;
        }

        .welcome-icons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .welcome-product-icon {
            width: 70px;
            height: 70px;
            border-radius: 15px;
            background: rgba(255,255,255,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d4af37;
            font-size: 30px;
        }

        /* ==========================================
           CATEGORY SECTION
        ========================================== */

        .category-section {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .category-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .category-subtitle {
            color: #777;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .category-card {
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 20px 12px;
            text-align: center;
            height: 100%;
            transition: 0.25s;
        }

        .category-card:hover {
            transform: translateY(-4px);
            border-color: #d4af37;
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        }

        .category-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: #f8e8ed;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            font-size: 25px;
        }

        .category-card h6 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .category-card p {
            color: #777;
            font-size: 12px;
            margin: 0;
        }

        /* ==========================================
           QUICK CARDS
        ========================================== */

        .quick-card {
            background: white;
            border-radius: 13px;
            padding: 25px;
            height: 100%;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            text-decoration: none;
            color: inherit;
            display: block;
            transition: 0.25s;
        }

        .quick-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 22px rgba(0,0,0,0.10);
            color: inherit;
        }

        .quick-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            margin-bottom: 18px;
        }

        .icon-shop {
            background: #f8e8ed;
            color: #800020;
        }

        .icon-order {
            background: #e7f1ff;
            color: #0d6efd;
        }

        .icon-notification {
            background: #fff3cd;
            color: #856404;
        }

        .icon-chat {
            background: #eee6ff;
            color: #6f42c1;
        }

        .icon-feedback {
            background: #e8f7ef;
            color: #198754;
        }

        .icon-products {
            background: #fff0e6;
            color: #fd7e14;
        }

        .quick-card h5 {
            font-weight: 700;
            margin-bottom: 7px;
        }

        .quick-card p {
            color: #777;
            font-size: 14px;
            margin-bottom: 0;
            line-height: 1.5;
        }

        /* ==========================================
           HOW IT WORKS
        ========================================== */

        .section-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            margin-top: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .step {
            text-align: center;
            padding: 15px;
        }

        .step-number {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #800020;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto auto 12px;
            font-weight: 700;
            font-size: 18px;
        }

        .step h6 {
            font-weight: 700;
            margin-bottom: 5px;
        }

        .step p {
            color: #777;
            font-size: 13px;
            margin: 0;
            line-height: 1.5;
        }

        /* ==========================================
           PAYMENT INFORMATION
        ========================================== */

        .payment-box {
            background: #fafafa;
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 18px;
            height: 100%;
        }

        .payment-box h6 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .payment-box p {
            margin: 0;
            color: #777;
            font-size: 13px;
            line-height: 1.5;
        }

        /* ==========================================
           FOOTER
        ========================================== */

        .footer {
            text-align: center;
            color: #888;
            font-size: 13px;
            padding: 25px 0 5px;
        }

        /* ==========================================
           MOBILE
        ========================================== */

        @@media (max-width: 992px) {

            .sidebar {
                width: 220px;
            }

            .main-content {
                margin-left: 220px;
            }

            .content-wrapper {
                padding: 20px;
            }

        }

        @@media (max-width: 768px) {

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main-content {
                margin-left: 0;
            }

            .topbar {
                padding: 0 15px;
            }

            .content-wrapper {
                padding: 15px;
            }

            .page-heading h2 {
                font-size: 23px;
            }

            .welcome-card {
                padding: 22px;
            }

        }

    </style>

</head>

<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<div class="sidebar">

    <div class="brand">

        <div class="brand-icon">

            <i class="bi bi-gem"></i>

        </div>

        <h4>Wedding Closet</h4>

        <small>Customer Panel</small>

    </div>


    <!-- MAIN -->

    <div class="nav-title">
        Main
    </div>


    <a asp-controller="Customer"
       asp-action="Dashboard"
       class="sidebar-link active">

        <i class="bi bi-speedometer2"></i>

        Dashboard

    </a>


    <a asp-controller="Customer"
       asp-action="Shops"
       class="sidebar-link">

        <i class="bi bi-shop"></i>

        Browse Shops

    </a>


    <a asp-controller="Customer"
       asp-action="MyOrders"
       class="sidebar-link">

        <i class="bi bi-bag-check"></i>

        My Orders

    </a>

    <!-- NEGOTIATIONS -->

<div class="nav-title">
    Shopping
</div>

<a asp-controller="Customer"
   asp-action="MyNegotiations"
   class="sidebar-link">

    <i class="bi bi-chat-square-text"></i>

    My Negotiations

</a>
    <!-- COMMUNICATION -->

    <div class="nav-title">
        Communication
    </div>


    <a asp-controller="Customer"
       asp-action="Notifications"
       class="sidebar-link">

        <i class="bi bi-bell"></i>

        Notifications

    </a>


    <a asp-controller="Customer"
       asp-action="Chat"
       class="sidebar-link">

        <i class="bi bi-chat-dots"></i>

        Chat

    </a>


    <a asp-controller="Customer"
       asp-action="Feedback"
       class="sidebar-link">

        <i class="bi bi-star"></i>

        Feedback & Reviews

    </a>


    <!-- ACCOUNT -->

    <div class="nav-title">
        Account
    </div>


    <a asp-controller="Account"
       asp-action="Logout"
       class="sidebar-link logout-link">

        <i class="bi bi-box-arrow-right"></i>

        Logout

    </a>

</div>


<!-- =====================================================
     MAIN CONTENT
===================================================== -->

<div class="main-content">


    <!-- =================================================
         TOPBAR
    ================================================= -->

    <div class="topbar">

        <div class="welcome-text">

            Welcome back,

            <strong>
                @customerName
            </strong>

        </div>


        <div class="top-actions">

            <a asp-controller="Customer"
               asp-action="Notifications"
               class="top-icon"
               title="Notifications">

                <i class="bi bi-bell"></i>

            </a>


            <a asp-controller="Customer"
               asp-action="Chat"
               class="top-icon"
               title="Chat">

                <i class="bi bi-chat-dots"></i>

            </a>


            <a asp-controller="Account"
               asp-action="Logout"
               class="top-icon"
               title="Logout">

                <i class="bi bi-box-arrow-right"></i>

            </a>

        </div>

    </div>


    <!-- =================================================
         CONTENT
    ================================================= -->

    <div class="content-wrapper">


        


        <!-- =================================================
             WELCOME CARD
        ================================================= -->

        <div class="welcome-card">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h3>
                        Welcome, @customerName! 👋
                    </h3>

                    <p>
                        Explore our multi-vendor wedding marketplace
                        and discover dresses, wedding guest wear,
                        footwear, jewellery and accessories from
                        different verified shops.
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Shops"
                       class="shop-btn">

                        <i class="bi bi-shop"></i>

                        Explore Shops

                    </a>

                </div>


                <!-- PRODUCT CATEGORY ICONS -->

                <div class="col-md-4 d-none d-md-block">

                    <div class="welcome-icons">

                        <div class="welcome-product-icon"
                             title="Dresses">

                            <i class="bi bi-person-standing-dress"></i>

                        </div>

                        <div class="welcome-product-icon"
                             title="Footwear">

                            <i class="bi bi-person-walking"></i>

                        </div>

                        <div class="welcome-product-icon"
                             title="Jewellery">

                            <i class="bi bi-gem"></i>

                        </div>

                        <div class="welcome-product-icon"
                             title="Accessories">

                            <i class="bi bi-bag"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             SHOPPING CATEGORIES
        ================================================= -->

        <div class="category-section">

            
            <div class="row g-3">


                <!-- DRESS -->

                <div class="col-6 col-md-4 col-lg">

                    <div class="category-card">

                        <div class="category-icon">

                            <i class="bi bi-person-standing-dress"></i>

                        </div>

                        <h6>
                            Dress
                        </h6>

                        <p>
                            Wedding & formal dresses
                        </p>

                    </div>

                </div>


                <!-- WEDDING GUEST WEAR -->

                <div class="col-6 col-md-4 col-lg">

                    <div class="category-card">

                        <div class="category-icon">

                            <i class="bi bi-stars"></i>

                        </div>

                        <h6>
                            Wedding Guest Wear
                        </h6>

                        <p>
                            Stylish guest outfits
                        </p>

                    </div>

                </div>


                <!-- FOOTWEAR -->

                <div class="col-6 col-md-4 col-lg">

                    <div class="category-card">

                        <div class="category-icon">

                            <i class="bi bi-person-walking"></i>

                        </div>

                        <h6>
                            Footwear
                        </h6>

                        <p>
                            Wedding & formal footwear
                        </p>

                    </div>

                </div>


                <!-- JEWELLERY -->

                <div class="col-6 col-md-4 col-lg">

                    <div class="category-card">

                        <div class="category-icon">

                            <i class="bi bi-gem"></i>

                        </div>

                        <h6>
                            Jewellery
                        </h6>

                        <p>
                            Jewellery for special occasions
                        </p>

                    </div>

                </div>


                <!-- ACCESSORIES -->

                <div class="col-6 col-md-4 col-lg">

                    <div class="category-card">

                        <div class="category-icon">

                            <i class="bi bi-handbag"></i>

                        </div>

                        <h6>
                            Accessories
                        </h6>

                        <p>
                            Complete your wedding look
                        </p>

                    </div>

                </div>


            </div>

        </div>


        <!-- =================================================
             QUICK ACCESS
        ================================================= -->

        <div class="row g-4">


            <!-- BROWSE SHOPS -->

            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="Shops"
                   class="quick-card">

                    <div class="quick-icon icon-shop">

                        <i class="bi bi-shop"></i>

                    </div>

                    <h5>
                        Browse Shops
                    </h5>

                   

                </a>

            </div>


            <!-- MY ORDERS -->

            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="MyOrders"
                   class="quick-card">

                    <div class="quick-icon icon-order">

                        <i class="bi bi-bag-check"></i>

                    </div>

                    <h5>
                        My Orders
                    </h5>

                    

                </a>

            </div>


            <!-- NOTIFICATIONS -->

            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="Notifications"
                   class="quick-card">

                    <div class="quick-icon icon-notification">

                        <i class="bi bi-bell"></i>

                    </div>

                    <h5>
                        Notifications
                    </h5>


                </a>

            </div>


            <!-- CHAT -->

            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="Chat"
                   class="quick-card">

                    <div class="quick-icon icon-chat">

                        <i class="bi bi-chat-dots"></i>

                    </div>

                    <h5>
                        Chat
                    </h5>

                   

                </a>

            </div>


            <!-- FEEDBACK -->

            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="Feedback"
                   class="quick-card">

                    <div class="quick-icon icon-feedback">

                        <i class="bi bi-star"></i>

                    </div>

                    <h5>
                        Feedback & Reviews
                    </h5>


                </a>

            </div>


            <!-- PRODUCTS -->

            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="Shops"
                   class="quick-card">

                    <div class="quick-icon icon-products">

                        <i class="bi bi-grid-3x3-gap"></i>

                    </div>

                    <h5>
                        Explore Products
                    </h5>

                   

                </a>

            </div>


        </div>


       

        <!-- =================================================
             PAYMENT INFORMATION
        ================================================= -->

        <div class="section-card">

            <div class="section-title">

                <i class="bi bi-credit-card"></i>

                Available Payment Methods

            </div>


            <div class="row g-3">


                <!-- COD -->

                <div class="col-md-4">

                    <div class="payment-box">

                        <h6>

                            <i class="bi bi-cash-stack text-success"></i>

                            Cash on Delivery

                        </h6>

                        <p>

                            Pay the order amount in cash when
                            your order is delivered.

                        </p>

                    </div>

                </div>


                <!-- EASYPAISA -->

                <div class="col-md-4">

                    <div class="payment-box">

                        <h6>

                            <i class="bi bi-phone text-primary"></i>

                            Easypaisa

                        </h6>

                        <p>

                            Pay using Easypaisa and provide the
                            required payment information during checkout.

                        </p>

                    </div>

                </div>


                <!-- JAZZCASH -->

                <div class="col-md-4">

                    <div class="payment-box">

                        <h6>

                            <i class="bi bi-phone text-danger"></i>

                            JazzCash

                        </h6>

                        <p>

                            Pay using JazzCash and provide the
                            required payment information during checkout.

                        </p>

                    </div>

                </div>


            </div>

        </div>


        

        <!-- =================================================
             FOOTER
        ================================================= -->

        <div class="footer">

            © @DateTime.Now.Year Wedding Closet Hubs.
            All Rights Reserved.

        </div>


    </div>

</div>


<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>