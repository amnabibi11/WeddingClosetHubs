@model WeddingClosetHubs.Models.Product

@{
    ViewData["Title"] = "Negotiate Price";
    Layout = null;

    string customerName = ViewBag.CustomerName ?? "Customer";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Negotiate Price - WeddingClosetHubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>

        body {
            margin: 0;
            background: #f7f3f0;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #800020;
            position: fixed;
            left: 0;
            top: 0;
            padding: 25px 15px;
            color: white;
        }

        .brand {
            text-align: center;
            font-size: 23px;
            font-weight: bold;
            color: #d4af37;
            margin-bottom: 30px;
        }

        .customer-name {
            text-align: center;
            margin-bottom: 25px;
            color: white;
        }

        .sidebar a {
            display: block;
            text-decoration: none;
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            margin-bottom: 7px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #d4af37;
            color: #800020;
            font-weight: 600;
        }

        .main-content {
            margin-left: 250px;
            padding: 35px;
        }

        .negotiation-container {
            max-width: 900px;
            margin: auto;
        }

        .page-header {
            background: white;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
        }

        .page-header h2 {
            color: #800020;
            font-weight: 700;
            margin: 0;
        }

        .negotiation-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,.08);
        }

        .product-image {
            width: 220px;
            height: 270px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;
        }

        .product-name {
            color: #800020;
            font-size: 27px;
            font-weight: 700;
        }

        .shop-name {
            color: #666;
            font-size: 16px;
        }

        .original-label {
            color: #777;
            font-size: 14px;
            margin-top: 20px;
        }

        .original-price {
            color: #800020;
            font-size: 27px;
            font-weight: bold;
        }

        .info-box {
            background: #faf6ee;
            border-left: 4px solid #d4af37;
            padding: 15px;
            border-radius: 8px;
            margin: 25px 0;
        }

        .form-label {
            font-weight: 600;
            color: #444;
        }

        .btn-maroon {
            background: #800020;
            color: white;
            border: none;
            padding: 11px 25px;
        }

        .btn-maroon:hover {
            background: #650019;
            color: white;
        }

        .btn-back {
            padding: 11px 25px;
        }

        @@media (max-width: 768px) {

            .sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
                padding: 15px;
            }

            .product-image {
                width: 180px;
                height: 220px;
                margin-bottom: 20px;
            }

        }

    </style>

</head>

<body>

   
    <div class="sidebar">

        <div class="brand">

            <i class="bi bi-gem"></i>
            WeddingClosetHubs

        </div>

        <div class="customer-name">

            <i class="bi bi-person-circle"></i>

            <div>
                @customerName
            </div>

        </div>


        <a href="@Url.Action("Dashboard", "Customer")">

            <i class="bi bi-speedometer2 me-2"></i>
            Dashboard

        </a>


        <a href="@Url.Action("Shops", "Customer")">

            <i class="bi bi-shop me-2"></i>
            Shops

        </a>


        <a href="@Url.Action("Cart", "Customer")">

            <i class="bi bi-cart3 me-2"></i>
            Cart

        </a>


        <a href="@Url.Action("MyOrders", "Customer")">

            <i class="bi bi-bag-check me-2"></i>
            My Orders

        </a>


        <a href="@Url.Action("MyNegotiations", "Customer")"
           class="active">

            <i class="bi bi-chat-square-text me-2"></i>
            My Negotiations

        </a>


        <a href="@Url.Action("Notifications", "Customer")">

            <i class="bi bi-bell me-2"></i>
            Notifications

        </a>


        <a href="@Url.Action("Chat", "Customer")">

            <i class="bi bi-chat-dots me-2"></i>
            Chat

        </a>


        <a href="@Url.Action("Feedback", "Customer")">

            <i class="bi bi-star me-2"></i>
            Feedback

        </a>


        <hr />


        <a href="@Url.Action("Logout", "Customer")">

            <i class="bi bi-box-arrow-right me-2"></i>
            Logout

        </a>

    </div>


    
    <div class="main-content">

        <div class="negotiation-container">


            <div class="page-header">

                <h2>

                    <i class="bi bi-tags me-2"></i>

                    Negotiate Price

                </h2>

                <p class="text-muted mb-0 mt-2">

                    Make an offer to the shopkeeper for this dress.

                </p>

            </div>


            <div class="negotiation-card">


                
                <div class="row align-items-center">


                    <div class="col-md-4 text-center">

                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <img src="@Model.Image"
                                 alt="@Model.ProductName"
                                 class="product-image" />
                        }
                        else
                        {
                            <div class="product-image mx-auto d-flex
                                        align-items-center
                                        justify-content-center">

                                <i class="bi bi-image"
                                   style="font-size:60px;color:#ccc;">
                                </i>

                            </div>
                        }

                    </div>


                    <div class="col-md-8">

                        <div class="product-name">

                            @Model.ProductName

                        </div>


                        @if (Model.Shop != null)
                        {
                            <div class="shop-name mt-2">

                                <i class="bi bi-shop me-1"></i>

                                @Model.Shop.ShopName

                            </div>
                        }


                        <div class="original-label">

                            Original Price

                        </div>


                        <div class="original-price">

                            Rs. @Model.Price.ToString("N0")

                        </div>

                    </div>

                </div>


                <div class="info-box">

                    <i class="bi bi-info-circle me-2"></i>

                    <strong>How negotiation works:</strong>

                    <ul class="mb-0 mt-2">

                        <li>
                            Enter the price you are willing to pay.
                        </li>

                        <li>
                            The shopkeeper can accept your offer.
                        </li>

                        <li>
                            The shopkeeper can reject your offer.
                        </li>

                        <li>
                            The shopkeeper can send you a counter-offer.
                        </li>

                    </ul>

                </div>


                
                <form asp-action="MakeNegotiation"
                      asp-controller="Customer"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="productId"
                           value="@Model.ProductId" />


                  

                    <div class="mb-4">

                        <label class="form-label">

                            Your Offer Price

                        </label>


                        <div class="input-group">

                            <span class="input-group-text">

                                Rs.

                            </span>


                            <input type="number"
                                   name="requestedPrice"
                                   class="form-control"
                                   placeholder="Enter the price you want to offer"
                                   min="1"
                                   max="@(Model.Price - 1)"
                                   step="1"
                                   required />

                        </div>


                        <small class="text-muted">

                            Your offer must be lower than
                            Rs. @Model.Price.ToString("N0").

                        </small>

                    </div>


                    

                    <div class="mb-4">

                        <label class="form-label">

                            Message

                            <span class="text-muted fw-normal">

                                (Optional)

                            </span>

                        </label>


                        <textarea name="customerMessage"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Write a message to the shopkeeper..."></textarea>

                    </div>


                  

                    <div class="d-flex gap-2 flex-wrap">


                        <button type="submit"
                                class="btn btn-maroon">

                            <i class="bi bi-send me-1"></i>

                            Send Offer

                        </button>


                        <a href="@Url.Action("ProductDetails",
                                             "Customer",
                                             new { id = Model.ProductId })"
                           class="btn btn-outline-secondary btn-back">

                            <i class="bi bi-arrow-left me-1"></i>

                            Back to Dress

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

</html>

