@model IEnumerable<WeddingClosetHubs.Models.Product>

@{
    ViewData["Title"] = "My Cart";
    Layout = null;

    var products = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Product>();

    var cartItems = ViewBag.CartItems
        as List<WeddingClosetHubs.Controllers.CustomerCartItem>
        ?? new List<WeddingClosetHubs.Controllers.CustomerCartItem>();

    decimal productTotal = 0m;

    foreach (var item in cartItems)
    {
        var product = products.FirstOrDefault(
            p => p.ProductId == item.ProductId
        );

        if (product == null)
            continue;

        string purchaseType =
            string.IsNullOrWhiteSpace(item.PurchaseType)
                ? "Buy"
                : item.PurchaseType.Trim();

        decimal unitPrice = item.Price;

        if (purchaseType.Equals(
                "Sale",
                StringComparison.OrdinalIgnoreCase))
        {
            if (product.IsOnSale &&
                product.SalePrice.HasValue &&
                product.SalePrice.Value > 0 &&
                product.SalePrice.Value < product.Price)
            {
                unitPrice = product.SalePrice.Value;
            }
        }
        else if (purchaseType.Equals(
                     "Rent",
                     StringComparison.OrdinalIgnoreCase))
        {
            if (product.IsAvailableForRent &&
                product.RentPrice.HasValue &&
                product.RentPrice.Value > 0)
            {
                unitPrice = product.RentPrice.Value;
            }
        }
        else if (purchaseType.Equals(
                     "Buy",
                     StringComparison.OrdinalIgnoreCase))
        {
            unitPrice = product.Price;
        }

        productTotal += unitPrice * item.Quantity;
    }

    decimal deliveryCharges = cartItems.Any()
        ? 300m
        : 0m;

    decimal serviceFee =
        Math.Round(productTotal * 0.10m, 2);

    decimal grandTotal =
        productTotal +
        deliveryCharges +
        serviceFee;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>My Cart - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: linear-gradient(135deg, #faf7f5 0%, #f8f6f4 50%, #fdfaf8 100%);
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #800020, #650018);
            padding: 16px 35px;
            box-shadow: 0 4px 18px rgba(128, 0, 32, 0.20);
        }

        .navbar-brand {
            color: #d4af37 !important;
            font-size: 24px;
            font-weight: 700;
            text-decoration: none;
            letter-spacing: 0.3px;
        }

        .navbar-brand i {
            margin-right: 7px;
        }

        .navbar-custom a {
            color: white;
            text-decoration: none;
            margin-left: 22px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .navbar-custom a:hover {
            color: #d4af37;
        }

        .page-wrapper {
            padding: 40px 35px;
            min-height: calc(100vh - 70px);
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-title {
            color: #800020;
            font-weight: 700;
            margin-bottom: 7px;
            font-size: 30px;
        }

        .page-title i {
            color: #d4af37;
            margin-right: 7px;
        }

        .page-subtitle {
            color: #777;
            margin-bottom: 0;
            font-size: 15px;
        }

        .cart-card {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 15px;
            padding: 22px;
            margin-bottom: 20px;
            border: 1px solid #eee7e3;
            box-shadow: 0 5px 20px rgba(70, 30, 30, 0.07);
            transition: 0.25s ease;
        }

        .cart-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 25px rgba(70, 30, 30, 0.12);
        }

        .product-image {
            width: 120px;
            height: 140px;
            object-fit: cover;
            border-radius: 12px;
            border: 2px solid #f0e7df;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.07);
        }

        .product-image-placeholder {
            width: 120px;
            height: 140px;
            border-radius: 12px;
            border: 2px dashed #ddd;
            background: #faf8f6;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-image-placeholder i {
            font-size: 45px;
            color: #bbb;
        }

        .product-name {
            color: #800020;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .product-info {
            color: #666;
            font-size: 14px;
            margin-bottom: 6px;
        }

        .product-info strong {
            color: #555;
        }

        .product-price {
            color: #800020;
            font-size: 20px;
            font-weight: 700;
        }

        .sale-price {
            color: #c1121f;
            font-size: 21px;
            font-weight: 700;
        }

        .rent-price {
            color: #087f8c;
            font-size: 21px;
            font-weight: 700;
        }

        .negotiated-price {
            color: #198754;
            font-size: 21px;
            font-weight: 700;
        }

        .original-price {
            color: #999;
            text-decoration: line-through;
            font-size: 14px;
            margin-left: 7px;
        }

        .purchase-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            margin-top: 7px;
        }

        .purchase-buy {
            background: #f0f1f3;
            color: #495057;
        }

        .purchase-sale {
            background: #fff3cd;
            color: #856404;
        }

        .purchase-rent {
            background: #cff4fc;
            color: #055160;
        }

        .purchase-negotiated {
            background: #d1e7dd;
            color: #0f5132;
        }

        .price-note {
            font-size: 12px;
            margin-top: 4px;
            font-weight: 600;
        }

        .sale-note {
            color: #c1121f;
        }

        .rent-note {
            color: #087f8c;
        }

        .negotiated-note {
            color: #198754;
        }

        .buy-note {
            color: #666;
        }

        .quantity-box {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            background: #faf8f6;
            border: 1px solid #e4ddd8;
            border-radius: 9px;
            padding: 7px 11px;
        }

        .quantity-label {
            font-size: 13px;
            color: #666;
            font-weight: 600;
        }

        .quantity-value {
            color: #800020;
            font-size: 16px;
            font-weight: 700;
            min-width: 25px;
            text-align: center;
        }

        .subtotal-text {
            color: #800020;
            font-size: 15px;
            font-weight: 700;
            margin-top: 9px;
        }

        .custom-badge {
            display: inline-flex;
            align-items: center;
            background: #fff8df;
            color: #856404;
            border: 1px solid #f3df9a;
            padding: 6px 11px;
            border-radius: 18px;
            font-size: 12px;
            font-weight: 600;
        }

        .remove-btn {
            color: #dc3545;
            border: none;
            background: transparent;
            font-size: 14px;
            font-weight: 600;
            padding: 6px 9px;
            cursor: pointer;
            border-radius: 6px;
            transition: 0.25s ease;
        }

        .remove-btn:hover {
            color: white;
            background: #dc3545;
        }

        .measurement-btn {
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            border-color: #800020;
            color: #800020;
            transition: 0.25s ease;
        }

        .measurement-btn:hover {
            background: #800020;
            border-color: #800020;
            color: white;
        }

        .continue-btn {
            border: 1px solid #800020;
            color: #800020;
            background: white;
            padding: 10px 19px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 14px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .continue-btn:hover {
            background: #800020;
            color: white;
            transform: translateX(-2px);
        }

        .summary-card {
            background: white;
            border-radius: 15px;
            padding: 27px;
            border: 1px solid #eee7e3;
            box-shadow: 0 6px 22px rgba(70, 30, 30, 0.09);
            position: sticky;
            top: 20px;
        }

        .summary-title {
            color: #800020;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

        .summary-title i {
            color: #d4af37;
            margin-right: 6px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 13px 0;
            border-bottom: 1px solid #eee;
            gap: 10px;
        }

        .summary-label {
            color: #666;
            font-size: 14px;
        }

        .summary-value {
            font-weight: 600;
            color: #333;
            white-space: nowrap;
        }

        .grand-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 17px;
            padding: 17px 0 0;
            border-top: 2px solid #800020;
            color: #800020;
            font-size: 21px;
            font-weight: 700;
            gap: 10px;
        }

        .checkout-btn {
            width: 100%;
            background: linear-gradient(135deg, #800020, #650018);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 9px;
            font-size: 16px;
            font-weight: 700;
            margin-top: 21px;
            transition: 0.3s ease;
            box-shadow: 0 5px 14px rgba(128, 0, 32, 0.20);
        }

        .checkout-btn:hover {
            background: linear-gradient(135deg, #650018, #520014);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(128, 0, 32, 0.25);
        }

        .empty-cart {
            background: white;
            border-radius: 18px;
            padding: 80px 30px;
            text-align: center;
            border: 1px solid #eee7e3;
            box-shadow: 0 7px 25px rgba(70, 30, 30, 0.08);
            max-width: 900px;
            margin: 20px auto 0;
            position: relative;
            overflow: hidden;
        }

        .empty-cart::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #800020, #d4af37, #800020);
        }

        .empty-cart-icon {
            width: 105px;
            height: 105px;
            margin: 0 auto 24px;
            border-radius: 50%;
            background: #fff8f4;
            border: 2px solid #f1ddd2;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .empty-cart-icon i {
            font-size: 48px;
            color: #800020;
        }

        .empty-cart h3 {
            color: #800020;
            font-weight: 700;
            font-size: 27px;
            margin-bottom: 10px;
        }

        .empty-cart p {
            color: #777;
            font-size: 15px;
            margin-bottom: 25px;
        }

        .browse-shops-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-width: 190px;
            padding: 13px 25px;
            border-radius: 9px;
            background: linear-gradient(135deg, #800020, #650018);
            color: white !important;
            text-decoration: none;
            font-size: 15px;
            font-weight: 700;
            border: 1px solid #800020;
            box-shadow: 0 5px 15px rgba(128, 0, 32, 0.20);
            transition: all 0.3s ease;
        }

        .browse-shops-btn i {
            color: #d4af37;
            font-size: 18px;
            transition: 0.3s ease;
        }

        .browse-shops-btn:hover {
            color: white !important;
            background: linear-gradient(135deg, #650018, #520014);
            transform: translateY(-3px);
            box-shadow: 0 9px 20px rgba(128, 0, 32, 0.28);
        }

        .browse-shops-btn:hover i {
            color: #f0cf55;
            transform: scale(1.08);
        }

        .empty-cart-note {
            margin-top: 18px;
            color: #999;
            font-size: 12px;
        }

        .empty-cart-note i {
            color: #d4af37;
            margin-right: 4px;
        }

        .rental-security-note {
            background: #f0fbfd;
            border: 1px solid #bde7ee;
            color: #055160;
            border-radius: 8px;
            padding: 7px 10px;
            font-size: 12px;
            margin-top: 8px;
            display: inline-block;
        }

        .sale-saving {
            color: #c1121f;
            font-size: 12px;
            font-weight: 600;
            margin-top: 3px;
        }

        @@media (max-width: 992px) {

            .summary-card {
                position: static;
                margin-top: 10px;
            }
        }

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 15px;
            }

            .navbar-custom .d-flex {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 15px;
            }

            .navbar-custom a {
                margin-left: 0;
                margin-right: 15px;
            }

            .page-wrapper {
                padding: 25px 15px;
            }

            .page-title {
                font-size: 25px;
            }

            .product-image,
            .product-image-placeholder {
                width: 100%;
                height: 220px;
                margin-bottom: 15px;
            }

            .cart-card {
                padding: 17px;
            }

            .summary-card {
                margin-top: 15px;
                position: static;
            }

            .grand-total {
                font-size: 19px;
            }

            .empty-cart {
                padding: 60px 20px;
            }

            .empty-cart h3 {
                font-size: 23px;
            }

            .browse-shops-btn {
                width: 100%;
                max-width: 280px;
            }
        }

    </style>

</head>

<body>

    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="navbar-brand">

                    <i class="bi bi-heart-fill"></i>

                    Wedding Closet Hubs

                </a>

            </div>

            <div>

                <a asp-controller="Customer"
                   asp-action="Dashboard">

                    <i class="bi bi-house"></i>
                    Home

                </a>

                <a asp-controller="Customer"
                   asp-action="Shops">

                    <i class="bi bi-shop"></i>
                    Shops

                </a>

                <a asp-controller="Customer"
                   asp-action="Cart">

                    <i class="bi bi-cart3"></i>
                    Cart

                </a>

                <a asp-controller="Account"
                   asp-action="Logout">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout

                </a>

            </div>

        </div>

    </nav>

    <div class="page-wrapper">

        <div class="container-fluid">

            <div class="page-header">

                <h2 class="page-title">

                    <i class="bi bi-cart3"></i>

                    My Shopping Cart

                </h2>

                <p class="page-subtitle">

                    Review your selected dresses before proceeding to checkout.

                </p>

            </div>

            @if (!cartItems.Any())
            {

                <div class="empty-cart">

                    <div class="empty-cart-icon">

                        <i class="bi bi-cart-x"></i>

                    </div>

                    <h3>
                        Your Cart is Empty
                    </h3>

                    <p>
                        You have not added any dresses to your cart yet.
                        Explore our shops and find something beautiful for your special occasion.
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Shops"
                       class="browse-shops-btn">

                        <i class="bi bi-shop-window"></i>

                        Browse Shops

                        <i class="bi bi-arrow-right"></i>

                    </a>

                    <div class="empty-cart-note">

                        <i class="bi bi-heart-fill"></i>

                        Discover beautiful wedding dresses, accessories and more.

                    </div>

                </div>

            }
            else
            {

                <div class="row">

                    <div class="col-lg-8">

                        @foreach (var item in cartItems)
                        {

                            var product = products.FirstOrDefault(
                                p => p.ProductId == item.ProductId
                            );

                            if (product == null)
                            {
                                continue;
                            }

                            string purchaseType =
                                string.IsNullOrWhiteSpace(item.PurchaseType)
                                    ? "Buy"
                                    : item.PurchaseType.Trim();

                            bool isNegotiated =
                                purchaseType.Equals(
                                    "Negotiated",
                                    StringComparison.OrdinalIgnoreCase);

                            bool isSale =
                                purchaseType.Equals(
                                    "Sale",
                                    StringComparison.OrdinalIgnoreCase);

                            bool isRent =
                                purchaseType.Equals(
                                    "Rent",
                                    StringComparison.OrdinalIgnoreCase);

                            bool isBuy =
                                purchaseType.Equals(
                                    "Buy",
                                    StringComparison.OrdinalIgnoreCase);

                            decimal itemUnitPrice = item.Price;

                            decimal originalPrice = product.Price;

                            if (isSale)
                            {
                                if (product.IsOnSale &&
                                    product.SalePrice.HasValue &&
                                    product.SalePrice.Value > 0 &&
                                    product.SalePrice.Value < product.Price)
                                {
                                    itemUnitPrice =
                                        product.SalePrice.Value;
                                }
                            }
                            else if (isRent)
                            {
                                if (product.IsAvailableForRent &&
                                    product.RentPrice.HasValue &&
                                    product.RentPrice.Value > 0)
                                {
                                    itemUnitPrice =
                                        product.RentPrice.Value;
                                }
                            }
                            else if (isBuy)
                            {
                                itemUnitPrice =
                                    product.Price;
                            }

                            decimal itemSubtotal =
                                itemUnitPrice * item.Quantity;

                            decimal saleSaving =
                                isSale &&
                                originalPrice > itemUnitPrice
                                    ? originalPrice - itemUnitPrice
                                    : 0m;

                            string purchaseBadgeClass =
                                isNegotiated
                                    ? "purchase-negotiated"
                                    : isSale
                                        ? "purchase-sale"
                                        : isRent
                                            ? "purchase-rent"
                                            : "purchase-buy";

                            <div class="cart-card">

                                <div class="row align-items-center">

                                    <div class="col-md-3 text-center">

                                        @if (!string.IsNullOrWhiteSpace(product.Image))
                                        {

                                            <img src="@Url.Content(product.Image)"
                                                 class="product-image"
                                                 alt="@product.ProductName" />

                                        }
                                        else
                                        {

                                            <div class="product-image-placeholder mx-auto">

                                                <i class="bi bi-image"></i>

                                            </div>

                                        }

                                    </div>

                                    <div class="col-md-6">

                                        <div class="product-name">

                                            @product.ProductName

                                        </div>

                                        <div class="product-info">

                                            <strong>Category:</strong>

                                            @(string.IsNullOrWhiteSpace(product.Category)
                                                ? "N/A"
                                                : product.Category)

                                        </div>

                                        <div class="product-info">

                                            <strong>Subcategory:</strong>

                                            @(string.IsNullOrWhiteSpace(product.Subcategory)
                                                ? "N/A"
                                                : product.Subcategory)

                                        </div>

                                        <div class="product-info">

                                            <strong>Occasion:</strong>

                                            @(string.IsNullOrWhiteSpace(product.Occasion)
                                                ? "N/A"
                                                : product.Occasion)

                                        </div>

                                        <div>

                                            <span class="purchase-badge @purchaseBadgeClass">

                                                @if (isNegotiated)
                                                {
                                                    <i class="bi bi-chat-square-text me-1"></i>
                                                    <text>Negotiated Price</text>
                                                }
                                                else if (isSale)
                                                {
                                                    <i class="bi bi-tag me-1"></i>
                                                    <text>Sale Price</text>
                                                }
                                                else if (isRent)
                                                {
                                                    <i class="bi bi-arrow-repeat me-1"></i>
                                                    <text>Rental</text>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cart-check me-1"></i>
                                                    <text>Buy</text>
                                                }

                                            </span>

                                        </div>

                                        <div class="product-info mt-3">

                                            <strong>Unit Price:</strong>

                                            @if (isNegotiated)
                                            {

                                                <span class="negotiated-price">

                                                    Rs. @itemUnitPrice.ToString("N2")

                                                </span>

                                                @if (product.Price > itemUnitPrice)
                                                {

                                                    <span class="original-price">

                                                        Rs. @product.Price.ToString("N2")

                                                    </span>

                                                }

                                                <div class="price-note negotiated-note">

                                                    <i class="bi bi-check-circle me-1"></i>

                                                    Accepted negotiated price

                                                </div>

                                            }
                                            else if (isSale)
                                            {

                                                <span class="sale-price">

                                                    Rs. @itemUnitPrice.ToString("N2")

                                                </span>

                                                @if (product.Price > itemUnitPrice)
                                                {

                                                    <span class="original-price">

                                                        Rs. @product.Price.ToString("N2")

                                                    </span>

                                                }

                                                @if (saleSaving > 0)
                                                {

                                                    <div class="sale-saving">

                                                        <i class="bi bi-tag-fill me-1"></i>

                                                        You save Rs. @saleSaving.ToString("N2")

                                                    </div>

                                                }

                                            }
                                            else if (isRent)
                                            {

                                                <span class="rent-price">

                                                    Rs. @itemUnitPrice.ToString("N2")

                                                </span>

                                                <div class="price-note rent-note">

                                                    <i class="bi bi-arrow-repeat me-1"></i>

                                                    Rental price

                                                </div>

                                                <div class="rental-security-note">

                                                    <i class="bi bi-shield-check me-1"></i>

                                                    Refundable security deposit may apply at checkout.

                                                </div>

                                            }
                                            else
                                            {

                                                <span class="product-price">

                                                    Rs. @itemUnitPrice.ToString("N2")

                                                </span>

                                                <div class="price-note buy-note">

                                                    <i class="bi bi-cart-check me-1"></i>

                                                    Regular purchase price

                                                </div>

                                            }

                                        </div>

                                        <div class="quantity-box mt-2">

                                            <span class="quantity-label">
                                                Quantity:
                                            </span>

                                            <span class="quantity-value">

                                                @item.Quantity

                                            </span>

                                        </div>

                                        <div class="subtotal-text">

                                            Subtotal:

                                            Rs. @itemSubtotal.ToString("N2")

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.CustomMeasurements))
                                        {

                                            <div class="mt-2">

                                                <span class="custom-badge">

                                                    <i class="bi bi-rulers me-1"></i>

                                                    Custom Measurements Added

                                                </span>

                                            </div>

                                        }
                                        else if (product.HasCustomMeasurement)
                                        {

                                            <div class="mt-2">

                                                <span class="custom-badge">

                                                    <i class="bi bi-rulers me-1"></i>

                                                    Custom Measurement Available

                                                </span>

                                            </div>

                                        }

                                    </div>

                                    <div class="col-md-3 text-md-end mt-3 mt-md-0">

                                        @if (product.HasCustomMeasurement)
                                        {

                                            <a asp-controller="Customer"
                                               asp-action="CustomizeProduct"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-outline-primary btn-sm measurement-btn mb-2">

                                                <i class="bi bi-rulers me-1"></i>

                                                Measurements

                                            </a>

                                        }

                                        <form asp-controller="Customer"
                                              asp-action="RemoveFromCart"
                                              asp-route-id="@product.ProductId"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="remove-btn"
                                                    onclick="return confirm('Remove this product from your cart?');">

                                                <i class="bi bi-trash me-1"></i>

                                                Remove

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }

                        <div class="mt-3 mb-4">

                            <a asp-controller="Customer"
                               asp-action="Shops"
                               class="continue-btn">

                                <i class="bi bi-arrow-left"></i>

                                Continue Shopping

                            </a>

                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="summary-card">

                            <div class="summary-title">

                                <i class="bi bi-receipt"></i>

                                Order Summary

                            </div>

                            <div class="summary-row">

                                <span class="summary-label">

                                    Dress/Product Total

                                </span>

                                <span class="summary-value">

                                    Rs. @productTotal.ToString("N2")

                                </span>

                            </div>

                            <div class="summary-row">

                                <span class="summary-label">

                                    Delivery Charges

                                </span>

                                <span class="summary-value">

                                    Rs. @deliveryCharges.ToString("N2")

                                </span>

                            </div>

                            <div class="summary-row">

                                <span class="summary-label">

                                    Platform Service Fee (10%)

                                </span>

                                <span class="summary-value">

                                    Rs. @serviceFee.ToString("N2")

                                </span>

                            </div>

                            <div class="grand-total">

                                <span>
                                    Total
                                </span>

                                <span>

                                    Rs. @grandTotal.ToString("N2")

                                </span>

                            </div>

                            <a asp-controller="Customer"
                               asp-action="Checkout"
                               class="checkout-btn text-center d-block text-decoration-none">

                                <i class="bi bi-credit-card me-1"></i>

                                Proceed to Checkout

                            </a>

                            <div class="text-center mt-3">

                                <small class="text-muted">

                                    Delivery charges: Rs. 300

                                    <br />

                                    Platform service fee: 10% of actual product total

                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>