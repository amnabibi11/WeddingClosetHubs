@model WeddingClosetHubs.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Order Confirmation - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            margin: 0;
            background: #f7f5f3;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .navbar-custom {
            background: #800020;
            padding: 15px 30px;
        }

        .brand {
            color: #d4af37 !important;
            font-size: 23px;
            font-weight: 700;
            text-decoration: none;
        }

        .nav-link-custom {
            color: white;
            text-decoration: none;
            margin-left: 22px;
            font-size: 15px;
        }

            .nav-link-custom:hover {
                color: #d4af37;
            }

        .page-wrapper {
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .success-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
            margin-bottom: 25px;
        }

        .success-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: #198754;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 40px;
        }

        .success-title {
            color: #800020;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .success-text {
            color: #666;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .order-number {
            color: #800020;
            font-size: 20px;
            font-weight: 700;
        }

        .custom-card {
            background: white;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.06);
            overflow: hidden;
        }

        .card-header-custom {
            background: #800020;
            color: white;
            padding: 16px 20px;
            font-size: 18px;
            font-weight: 700;
        }

        .card-body-custom {
            padding: 25px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            padding: 13px 0;
            border-bottom: 1px solid #eee;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            color: #777;
            font-weight: 600;
        }

        .info-value {
            font-weight: 600;
            text-align: right;
        }

        .amount-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
        }

            .amount-row:last-child {
                border-bottom: none;
            }

        .total-row {
            background: #800020;
            color: white;
            border-radius: 8px;
            padding: 18px;
            margin-top: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 19px;
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-paid {
            background: #d1e7dd;
            color: #0f5132;
        }

        .payment-box {
            padding: 18px;
            border-radius: 10px;
            background: #fff8e1;
            border: 1px solid #ffe69c;
        }

            .payment-box h5 {
                color: #800020;
                font-weight: 700;
            }

        .address-box {
            background: #f8f9fa;
            border: 1px solid #e5e5e5;
            border-radius: 8px;
            padding: 15px;
            line-height: 1.6;
        }

        .button-area {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .btn-maroon {
            background: #800020;
            border: 1px solid #800020;
            color: white;
            padding: 11px 22px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
        }

            .btn-maroon:hover {
                background: #660019;
                color: white;
            }

        .btn-gold {
            background: #d4af37;
            border: 1px solid #d4af37;
            color: white;
            padding: 11px 22px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
        }

            .btn-gold:hover {
                background: #b8941f;
                color: white;
            }

        .btn-outline-maroon {
            background: white;
            border: 1px solid #800020;
            color: #800020;
            padding: 11px 22px;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
        }

            .btn-outline-maroon:hover {
                background: #800020;
                color: white;
            }

        .note-box {
            background: #eef5ff;
            border: 1px solid #b8d4ff;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
            color: #345;
        }

        @@media (max-width: 768px) {

            .navbar-custom {
                padding: 15px;
            }

            .nav-link-custom {
                margin-left: 10px;
            }

            .page-wrapper {
                margin-top: 25px;
            }

            .success-card {
                padding: 30px 20px;
            }

            .success-title {
                font-size: 24px;
            }

            .info-row,
            .amount-row,
            .total-row {
                flex-direction: column;
                gap: 5px;
            }

            .info-value {
                text-align: left;
            }
        }

    </style>
</head>

<body>


    <nav class="navbar-custom">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="brand">

                Wedding Closet Hubs

            </a>

            <div>

                <a asp-controller="Customer"
                   asp-action="Dashboard"
                   class="nav-link-custom">

                    <i class="bi bi-house"></i>
                    Home

                </a>

                <a asp-controller="Customer"
                   asp-action="Orders"
                   class="nav-link-custom">

                    <i class="bi bi-bag"></i>
                    My Orders

                </a>

            </div>

        </div>

    </nav>


    <div class="page-wrapper">


        <div class="success-card">

            <div class="success-icon">

                <i class="bi bi-check-lg"></i>

            </div>

            <h1 class="success-title">

                Order Placed Successfully!

            </h1>

            <p class="success-text">

                Thank you for shopping with Wedding Closet Hubs.

            </p>

            <p class="success-text">

                Your order has been successfully submitted.

            </p>

            <div class="mt-3">

                <span>

                    Order Number:

                </span>

                <span class="order-number">

                    #@Model.OrderId

                </span>

            </div>

        </div>



        <div class="custom-card">

            <div class="card-header-custom">

                <i class="bi bi-receipt"></i>

                Order Information

            </div>

            <div class="card-body-custom">

                <div class="row">

                    <div class="col-md-6">

                        <div class="info-row">

                            <span class="info-label">
                                Order ID
                            </span>

                            <span class="info-value">

                                #@Model.OrderId

                            </span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="info-row">

                            <span class="info-label">
                                Order Date
                            </span>

                            <span class="info-value">

                                @Model.CreatedDate.ToString("dd MMMM yyyy hh:mm tt")

                            </span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="info-row">

                            <span class="info-label">
                                Shop
                            </span>

                            <span class="info-value">

                                @(Model.Shop?.ShopName ?? "N/A")

                            </span>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="info-row">

                            <span class="info-label">
                                Order Status
                            </span>

                            <span class="info-value">

                                @if (Model.OrderStatus == "Delivered")
                                {
                                    <span class="status-badge status-paid">
                                        Delivered
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        @(Model.OrderStatus ?? "Pending")
                                    </span>
                                }

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="custom-card">

            <div class="card-header-custom">

                <i class="bi bi-credit-card"></i>

                Payment Information

            </div>

            <div class="card-body-custom">

                <div class="row">

                    <div class="col-md-6">

                        <div class="info-row">

                            <span class="info-label">
                                Payment Method
                            </span>

                            <span class="info-value">

                                @if (Model.PaymentMethod == "Cash on Delivery")
                                {
                                    <span class="status-badge status-pending">

                                        <i class="bi bi-cash"></i>

                                        Cash on Delivery

                                    </span>
                                }
                                else if (Model.PaymentMethod == "Easypaisa")
                                {
                                    <span class="status-badge status-paid">

                                        <i class="bi bi-phone"></i>

                                        Easypaisa

                                    </span>
                                }
                                else if (Model.PaymentMethod == "JazzCash")
                                {
                                    <span class="status-badge status-paid">

                                        <i class="bi bi-phone"></i>

                                        JazzCash

                                    </span>
                                }
                                else
                                {
                                    @(Model.PaymentMethod ?? "N/A")
                                }

                            </span>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="info-row">

                            <span class="info-label">
                                Payment Status
                            </span>

                            <span class="info-value">

                                @if (Model.PaymentReceived)
                                {
                                    <span class="status-badge status-paid">

                                        <i class="bi bi-check-circle"></i>

                                        Payment Received

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">

                                        <i class="bi bi-clock"></i>

                                        @Model.PaymentStatus

                                    </span>
                                }

                            </span>

                        </div>

                    </div>

                </div>


                @if (Model.PaymentMethod == "Cash on Delivery")
                {
                    <div class="payment-box mt-4">

                        <h5>

                            <i class="bi bi-cash-coin"></i>

                            Cash on Delivery

                        </h5>

                        <p class="mb-0">

                            Please keep the exact order amount available
                            when the delivery boy arrives.

                        </p>

                    </div>
                }
                else
                {
                    <div class="payment-box mt-4">

                        <h5>

                            <i class="bi bi-info-circle"></i>

                            Online Payment

                        </h5>

                        <p class="mb-0">

                            Your online payment has been submitted for
                            verification by the administrator.

                        </p>

                    </div>
                }

            </div>

        </div>



        <div class="custom-card">

            <div class="card-header-custom">

                <i class="bi bi-geo-alt"></i>

                Delivery Information

            </div>

            <div class="card-body-custom">

                <label class="fw-bold mb-2">

                    Delivery Address

                </label>

                <div class="address-box">

                    @(Model.DeliveryAddress ?? "N/A")

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3">

                        <label class="fw-bold mb-2">

                            Order Notes

                        </label>

                        <div class="address-box">

                            @Model.Notes

                        </div>

                    </div>
                }

            </div>

        </div>


        <div class="custom-card">

            <div class="card-header-custom">

                <i class="bi bi-calculator"></i>

                Order Summary

            </div>

            <div class="card-body-custom">

                <div class="amount-row">

                    <span>
                        Dress/Product Total
                    </span>

                    <strong>
                        Rs. @Model.ProductTotal.ToString("N2")
                    </strong>

                </div>


                <div class="amount-row">

                    <span>
                        Delivery Charges
                    </span>

                    <strong>
                        Rs. @Model.DeliveryCharges.ToString("N2")
                    </strong>

                </div>


                <div class="amount-row">

                    <span>
                        Platform Service Fee
                    </span>

                    <strong>
                        Rs. @Model.ServiceFee.ToString("N2")
                    </strong>

                </div>


                <div class="total-row">

                    <span>

                        Final Total

                    </span>

                    <span>

                        Rs. @Model.TotalAmount.ToString("N2")

                    </span>

                </div>


                <div class="note-box">

                    <i class="bi bi-info-circle"></i>

                    Your order total includes the product price,
                    Rs. 300 delivery charges, and the 10% platform
                    service fee.

                </div>

            </div>

        </div>



        <div class="button-area">

            <a asp-controller="Customer"
               asp-action="Orders"
               class="btn-maroon">

                <i class="bi bi-bag-check"></i>

                View My Orders

            </a>


            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="btn-gold">

                <i class="bi bi-shop"></i>

                Continue Shopping

            </a>


            <a asp-controller="Customer"
               asp-action="Notifications"
               class="btn-outline-maroon">

                <i class="bi bi-bell"></i>

                Notifications

            </a>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>