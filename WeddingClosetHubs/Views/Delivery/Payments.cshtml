@model IEnumerable<WeddingClosetHubs.Models.Order>

@{
    ViewData["Title"] = "Delivery Payments";
    Layout = null;

    var orders = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Order>();

    string deliveryName =
        ViewBag.DeliveryName as string ?? "Delivery Boy";

    string assignedZone =
        ViewBag.AssignedZone as string ?? "Not Assigned";



    string paymentMethod =
        ViewBag.PaymentMethod as string ?? "";

    string paymentAccount =
        ViewBag.PaymentAccount as string ?? "";

    bool paymentSettingsSaved =
        !string.IsNullOrWhiteSpace(paymentMethod) &&
        !string.IsNullOrWhiteSpace(paymentAccount);



    var paymentOrders = orders
        .Where(o => !string.Equals(
            o.OrderStatus,
            "Cancelled",
            StringComparison.OrdinalIgnoreCase))
        .ToList();



    decimal totalCharges =
        paymentOrders.Sum(o => o.DeliveryCharges);

    decimal totalPaid =
        paymentOrders
            .Where(o => string.Equals(
                o.DeliveryPaymentStatus,
                "Paid",
                StringComparison.OrdinalIgnoreCase))
            .Sum(o => o.DeliveryPaidAmount);

    decimal totalPending =
        paymentOrders
            .Where(o => !string.Equals(
                o.DeliveryPaymentStatus,
                "Paid",
                StringComparison.OrdinalIgnoreCase))
            .Sum(o => Math.Max(
                0m,
                o.DeliveryCharges - o.DeliveryPaidAmount));

    int paidOrders =
        paymentOrders.Count(o => string.Equals(
            o.DeliveryPaymentStatus,
            "Paid",
            StringComparison.OrdinalIgnoreCase));

    int pendingOrders =
        paymentOrders.Count(o => !string.Equals(
            o.DeliveryPaymentStatus,
            "Paid",
            StringComparison.OrdinalIgnoreCase));



    var codOrders = paymentOrders
        .Where(o => string.Equals(
            o.PaymentMethod,
            "COD",
            StringComparison.OrdinalIgnoreCase))
        .ToList();

    decimal totalCODCollected =
        codOrders.Sum(o => o.DeliveryCollectedAmount);

    decimal totalCODHandedOver =
        codOrders
            .Where(o => o.DeliveryCashHandedToAdmin)
            .Sum(o => o.DeliveryCollectedAmount);

    decimal totalCODAwaitingHandover =
        codOrders
            .Where(o => o.DeliveryCollectedAmount > 0 &&
                        !o.DeliveryCashHandedToAdmin)
            .Sum(o => o.DeliveryCollectedAmount);



    var paymentHistory = paymentOrders
        .Where(o =>
            string.Equals(
                o.DeliveryPaymentStatus,
                "Paid",
                StringComparison.OrdinalIgnoreCase)
            ||
            o.DeliveryPaidAmount > 0)
        .OrderByDescending(o =>
            o.DeliveryPaymentDate ?? o.CreatedDate)
        .ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Payments - Wedding Closet Hubs</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #f7f5f2;
            color: #333;
        }


        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #800020;
            color: white;
            padding-top: 20px;
            z-index: 1000;
            box-shadow: 3px 0 15px rgba(0,0,0,.12);
        }

        .brand {
            text-align: center;
            padding: 15px 10px 25px;
            border-bottom: 1px solid rgba(255,255,255,.15);
        }

        .brand-icon {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: #d4af37;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-size: 24px;
        }

        .brand h4 {
            margin: 0;
            font-weight: 700;
            color: #fff;
        }

        .brand small {
            color: #eadfb8;
        }

        .nav-menu {
            padding: 20px 12px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 13px;
            color: #fff;
            text-decoration: none;
            padding: 13px 15px;
            margin-bottom: 7px;
            border-radius: 8px;
            transition: .25s;
            font-size: 14px;
        }

            .nav-link i {
                width: 20px;
                text-align: center;
            }

            .nav-link:hover,
            .nav-link.active {
                background: #d4af37;
                color: #800020;
            }

        .logout-link {
            margin-top: 20px;
            border-top: 1px solid rgba(255,255,255,.15);
            padding-top: 20px;
        }


        .main-content {
            margin-left: 250px;
            min-height: 100vh;
        }


        .topbar {
            min-height: 75px;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 15px 30px;
            border-bottom: 1px solid #e7e2dc;
            box-shadow: 0 2px 10px rgba(0,0,0,.04);
        }

        .page-title h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #800020;
        }

        .page-title p {
            margin: 3px 0 0;
            color: #888;
            font-size: 12px;
        }

        .profile-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #800020;
            color: #d4af37;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 18px;
        }

        .profile-info strong {
            display: block;
            font-size: 14px;
            color: #333;
        }

        .profile-info span {
            font-size: 11px;
            color: #888;
        }


        .content {
            padding: 30px;
        }

        .page-header {
            background: #fff;
            border-radius: 14px;
            padding: 22px 25px;
            margin-bottom: 25px;
            border: 1px solid #eee7df;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

            .page-header h3 {
                margin: 0;
                color: #800020;
                font-size: 20px;
                font-weight: 700;
            }

            .page-header p {
                margin: 5px 0 0;
                color: #888;
                font-size: 12px;
            }

        .zone-badge {
            background: #f8f0d9;
            color: #806300;
            padding: 9px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }


        .settings-card {
            background: #fff;
            border: 1px solid #eee7df;
            border-radius: 14px;
            padding: 23px;
            margin-bottom: 25px;
            box-shadow: 0 4px 14px rgba(0,0,0,.04);
        }

        .settings-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .settings-header-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #f5e6eb;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
        }

        .settings-header h4 {
            margin: 0;
            color: #800020;
            font-size: 16px;
            font-weight: 700;
        }

        .settings-description {
            color: #888;
            font-size: 11px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .form-label-custom {
            display: block;
            color: #800020;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .custom-input,
        .custom-select {
            width: 100%;
            border: 1px solid #ddd4ca;
            border-radius: 8px;
            padding: 11px 12px;
            font-size: 12px;
            background: #fff;
            color: #333;
            outline: none;
            transition: .2s;
        }

            .custom-input:focus,
            .custom-select:focus {
                border-color: #d4af37;
                box-shadow: 0 0 0 3px rgba(212,175,55,.12);
            }

        .account-help {
            display: block;
            color: #999;
            font-size: 10px;
            margin-top: 5px;
        }

        .save-payment-btn {
            width: 100%;
            border: none;
            border-radius: 8px;
            background: #800020;
            color: #fff;
            padding: 11px 15px;
            font-size: 12px;
            font-weight: 600;
            transition: .25s;
        }

            .save-payment-btn:hover {
                background: #d4af37;
                color: #800020;
                transform: translateY(-1px);
            }

        .saved-payment {
            margin-top: 20px;
            padding: 13px 15px;
            background: #f8fbf8;
            border: 1px solid #dcefe1;
            border-radius: 9px;
        }

        .saved-payment-title {
            color: #198754;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .saved-payment-details {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .saved-payment-item {
            background: #fff;
            border: 1px solid #e4ebe5;
            border-radius: 7px;
            padding: 7px 10px;
            font-size: 10px;
            color: #555;
        }

            .saved-payment-item strong {
                color: #800020;
            }


        .summary-card {
            background: #fff;
            border: 1px solid #eee7df;
            border-radius: 13px;
            padding: 21px;
            height: 100%;
            box-shadow: 0 4px 14px rgba(0,0,0,.04);
            transition: .25s;
        }

            .summary-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 20px rgba(0,0,0,.07);
            }

        .summary-icon {
            width: 47px;
            height: 47px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            font-size: 18px;
        }

        .icon-maroon {
            background: #f5e6eb;
            color: #800020;
        }

        .icon-gold {
            background: #faf3d9;
            color: #9b7600;
        }

        .icon-green {
            background: #e5f6ec;
            color: #198754;
        }

        .icon-orange {
            background: #fce9dc;
            color: #c65c17;
        }

        .icon-blue {
            background: #e5f0fa;
            color: #1769aa;
        }

        .summary-card h6 {
            color: #888;
            font-size: 11px;
            margin: 0 0 6px;
        }

        .summary-card h3 {
            margin: 0;
            color: #333;
            font-size: 23px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .summary-card small {
            display: block;
            color: #aaa;
            font-size: 10px;
            margin-top: 5px;
        }


        .history-card {
            background: #fff;
            border: 1px solid #eee7df;
            border-radius: 14px;
            overflow: hidden;
            margin-top: 25px;
            box-shadow: 0 4px 14px rgba(0,0,0,.03);
        }

        .history-header {
            padding: 20px 22px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

            .history-header h4 {
                margin: 0;
                color: #800020;
                font-size: 16px;
                font-weight: 700;
            }

            .history-header p {
                margin: 4px 0 0;
                color: #999;
                font-size: 10px;
            }

        .history-count {
            background: #f8f0d9;
            color: #806300;
            padding: 7px 11px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .history-wrapper {
            overflow-x: auto;
        }

        .history-table {
            width: 100%;
            min-width: 1600px;
            border-collapse: collapse;
        }

            .history-table th {
                background: #faf7f3;
                color: #800020;
                padding: 13px 15px;
                font-size: 10px;
                font-weight: 700;
                text-align: left;
                white-space: nowrap;
            }

            .history-table td {
                padding: 15px;
                border-bottom: 1px solid #eee;
                font-size: 11px;
                vertical-align: middle;
            }

            .history-table tbody tr:hover {
                background: #fffcf8;
            }

        .order-number {
            color: #800020;
            font-weight: 700;
        }

        .order-date {
            display: block;
            margin-top: 4px;
            color: #999;
            font-size: 9px;
        }

        .customer-name {
            color: #444;
            font-weight: 600;
        }

        .amount {
            color: #333;
            font-weight: 700;
            white-space: nowrap;
        }

        .delivery-charge {
            color: #800020;
            font-weight: 700;
            white-space: nowrap;
        }

        .paid-amount {
            color: #198754;
            font-weight: 700;
            white-space: nowrap;
        }

        .method {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #666;
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

            .method i {
                color: #d4af37;
            }

        .account {
            color: #666;
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .transaction-id {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #800020;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

            .transaction-id i {
                color: #d4af37;
            }

        .not-set {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #999;
            font-size: 10px;
            font-style: italic;
        }

        .payment-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 10px;
            border-radius: 15px;
            font-size: 9px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-paid {
            background: #e5f6ec;
            color: #198754;
        }

        .status-pending {
            background: #fff4d6;
            color: #977000;
        }

        .status-collected {
            background: #e5f0fa;
            color: #1769aa;
        }

        .status-not-collected {
            background: #f1f1f1;
            color: #666;
        }

        .cod-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #e5f0fa;
            color: #1769aa;
            border-radius: 15px;
            padding: 6px 9px;
            font-size: 9px;
            font-weight: 700;
            white-space: nowrap;
        }

        .empty-state {
            text-align: center;
            padding: 65px 20px;
        }

        .empty-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #f5e6eb;
            color: #800020;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 28px;
        }

        .empty-state h4 {
            color: #800020;
            font-size: 18px;
            font-weight: 700;
        }

        .empty-state p {
            color: #999;
            font-size: 12px;
            margin: 0;
        }

        .info-note {
            margin-top: 20px;
            background: #fffaf0;
            border: 1px solid #f1e4bd;
            border-radius: 10px;
            padding: 15px 17px;
            color: #806300;
            font-size: 11px;
            line-height: 1.7;
        }

        .alert-custom {
            border-radius: 9px;
            font-size: 11px;
            border: none;
            margin-bottom: 20px;
        }

        @@media (max-width: 767px) {
            .sidebar {
                width: 70px;
            }

            .brand h4,
            .brand small,
            .nav-link span {
                display: none;
            }

            .brand {
                padding: 15px 5px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                font-size: 17px;
            }

            .nav-link {
                justify-content: center;
                padding: 13px 5px;
            }

            .main-content {
                margin-left: 70px;
            }

            .topbar {
                padding: 15px;
            }

            .profile-info {
                display: none;
            }

            .content {
                padding: 15px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .zone-badge {
                align-self: flex-start;
            }

            .history-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .saved-payment-details {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>


    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-motorcycle"></i>
            </div>

            <h4>Wedding Closet</h4>

            <small>Delivery Panel</small>

        </div>

        <div class="nav-menu">

            <a asp-controller="Delivery"
               asp-action="Dashboard"
               class="nav-link">

                <i class="fa-solid fa-gauge-high"></i>

                <span>Dashboard</span>

            </a>

            <a asp-controller="Delivery"
               asp-action="Orders"
               class="nav-link">

                <i class="fa-solid fa-box"></i>

                <span>Orders</span>

            </a>

            <a asp-controller="Delivery"
               asp-action="Payments"
               class="nav-link active">

                <i class="fa-solid fa-money-bill-wave"></i>

                <span>Payments</span>

            </a>

            <a asp-controller="Delivery"
               asp-action="Notifications"
               class="nav-link">

                <i class="fa-solid fa-bell"></i>

                <span>Notifications</span>

            </a>

            <a asp-controller="Delivery"
               asp-action="Chat"
               class="nav-link">

                <i class="fa-solid fa-comments"></i>

                <span>Chat</span>

            </a>

            <div class="logout-link">

                <a asp-controller="Account"
                   asp-action="Logout"
                   class="nav-link">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    <span>Logout</span>

                </a>

            </div>

        </div>

    </aside>



    <main class="main-content">


        <header class="topbar">

            <div class="page-title">

                <h2>Payments</h2>

                <p>
                    Manage your payment account and payment history
                </p>

            </div>

            <div class="profile-area">

                <div class="profile-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div class="profile-info">

                    <strong>@deliveryName</strong>

                    <span>Delivery Boy</span>

                </div>

            </div>

        </header>


        <div class="content">


            <div class="page-header">

                <div>

                    <h3>

                        <i class="fa-solid fa-wallet me-2"></i>

                        My Payments

                    </h3>

                    <p>
                        Manage your payment account and track delivery
                        payouts and COD cash handover.
                    </p>

                </div>

                <div class="zone-badge">

                    <i class="fa-solid fa-location-dot me-1"></i>

                    @assignedZone

                </div>

            </div>



            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-custom">

                    <i class="fa-solid fa-circle-check me-2"></i>

                    @TempData["Success"]

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-custom">

                    <i class="fa-solid fa-circle-exclamation me-2"></i>

                    @TempData["Error"]

                </div>
            }



            <div class="settings-card">

                <div class="settings-header">

                    <div class="settings-header-icon">

                        <i class="fa-solid fa-wallet"></i>

                    </div>

                    <h4>Payment Account Settings</h4>

                </div>

                <div class="settings-description">

                    Select the mobile wallet through which you want to
                    receive your delivery payments from Admin.

                    Only <strong>Easypaisa</strong> and
                    <strong>JazzCash</strong> are supported.

                </div>


                <form asp-controller="Delivery"
                      asp-action="SavePaymentSettings"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <div class="col-md-5">

                            <label class="form-label-custom">
                                Payment Method
                            </label>

                            <select name="paymentMethod"
                                    class="custom-select"
                                    required>

                                <option value="">
                                    Select Payment Method
                                </option>

                                <option value="Easypaisa"
                                        selected="@(paymentMethod.Equals(
                                                                                                                            "Easypaisa",
                                                                                                                            StringComparison.OrdinalIgnoreCase))">

                                    Easypaisa

                                </option>

                                <option value="JazzCash"
                                        selected="@(paymentMethod.Equals(
                                                                                                                            "JazzCash",
                                                                                                                            StringComparison.OrdinalIgnoreCase))">

                                    JazzCash

                                </option>

                            </select>

                        </div>


                        <div class="col-md-5">

                            <label class="form-label-custom">
                                Account / Mobile Number
                            </label>

                            <input type="text"
                                   name="paymentAccount"
                                   class="custom-input"
                                   value="@paymentAccount"
                                   placeholder="03XXXXXXXXX"
                                   maxlength="20"
                                   autocomplete="off"
                                   required />

                            <span class="account-help">

                                Enter the Easypaisa or JazzCash
                                mobile/account number where Admin
                                should send your payment.

                            </span>

                        </div>


                        <div class="col-md-2 d-flex align-items-end">

                            <button type="submit"
                                    class="save-payment-btn">

                                <i class="fa-solid fa-floppy-disk me-1"></i>

                                Save Payment

                            </button>

                        </div>

                    </div>

                </form>


                @if (paymentSettingsSaved)
                {
                    <div class="saved-payment">

                        <div class="saved-payment-title">

                            <i class="fa-solid fa-circle-check me-1"></i>

                            Payment account saved

                        </div>

                        <div class="saved-payment-details">

                            <div class="saved-payment-item">

                                <strong>Method:</strong>

                                @paymentMethod

                            </div>

                            <div class="saved-payment-item">

                                <strong>Account:</strong>

                                @paymentAccount

                            </div>

                        </div>

                    </div>
                }

            </div>




            <div class="row g-4">


                <div class="col-xl-3 col-md-6">

                    <div class="summary-card">

                        <div class="summary-icon icon-maroon">

                            <i class="fa-solid fa-truck"></i>

                        </div>

                        <h6>Total Delivery Charges</h6>

                        <h3>
                            Rs. @totalCharges.ToString("N2")
                        </h3>

                        <small>
                            Delivery charges from non-cancelled orders
                        </small>

                    </div>

                </div>



                <div class="col-xl-3 col-md-6">

                    <div class="summary-card">

                        <div class="summary-icon icon-green">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <h6>Paid by Admin</h6>

                        <h3>
                            Rs. @totalPaid.ToString("N2")
                        </h3>

                        <small>
                            @paidOrders payout(s) marked Paid
                        </small>

                    </div>

                </div>



                <div class="col-xl-3 col-md-6">

                    <div class="summary-card">

                        <div class="summary-icon icon-gold">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <h6>Delivery Payment Pending</h6>

                        <h3>
                            Rs. @totalPending.ToString("N2")
                        </h3>

                        <small>
                            @pendingOrders payout(s) not fully paid
                        </small>

                    </div>

                </div>



                <div class="col-xl-3 col-md-6">

                    <div class="summary-card">

                        <div class="summary-icon icon-orange">

                            <i class="fa-solid fa-money-bill-wave"></i>

                        </div>

                        <h6>COD Collected</h6>

                        <h3>
                            Rs. @totalCODCollected.ToString("N2")
                        </h3>

                        <small>
                            Cash recorded as collected from customers
                        </small>

                    </div>

                </div>



                <div class="col-xl-6 col-md-6">

                    <div class="summary-card">

                        <div class="summary-icon icon-blue">

                            <i class="fa-solid fa-hand-holding-dollar"></i>

                        </div>

                        <h6>COD Handed Over to Admin</h6>

                        <h3>
                            Rs. @totalCODHandedOver.ToString("N2")
                        </h3>

                        <small>
                            Cash handover confirmed by Admin
                        </small>

                    </div>

                </div>



                <div class="col-xl-6 col-md-6">

                    <div class="summary-card">

                        <div class="summary-icon icon-orange">

                            <i class="fa-solid fa-hourglass-half"></i>

                        </div>

                        <h6>
                            COD Awaiting Admin Handover Confirmation
                        </h6>

                        <h3>
                            Rs. @totalCODAwaitingHandover.ToString("N2")
                        </h3>

                        <small>
                            Collected cash not yet confirmed as received
                            by Admin
                        </small>

                    </div>

                </div>

            </div>



            <div class="history-card">

                <div class="history-header">

                    <div>

                        <h4>

                            <i class="fa-solid fa-clock-rotate-left me-2"></i>

                            Payment History

                        </h4>

                        <p>
                            Delivery payouts recorded by Admin
                        </p>

                    </div>

                    <span class="history-count">

                        @paymentHistory.Count record(s)

                    </span>

                </div>


                @if (paymentHistory.Any())
                {

                    <div class="history-wrapper">

                        <table class="history-table">

                            <thead>

                                <tr>

                                    <th>Order</th>

                                    <th>Customer</th>

                                    <th>Order Amount</th>

                                    <th>Delivery Charge</th>

                                    <th>Payment Method</th>

                                    <th>Payment Account</th>

                                    <th>Transaction ID</th>

                                    <th>Amount Paid</th>

                                    <th>Delivery Payout Status</th>

                                    <th>Payment Date</th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var order in paymentHistory)
                                {

                                    bool isPaid =
                                    string.Equals(
                                    order.DeliveryPaymentStatus,
                                    "Paid",
                                    StringComparison.OrdinalIgnoreCase);

                                    <tr>


                                        <td>

                                            <div class="order-number">
                                                #@order.OrderId
                                            </div>

                                            <span class="order-date">
                                                @order.CreatedDate.ToString(
                                                "dd MMM yyyy")
                                    </span>

                                </td>



                                <td>

                                    <span class="customer-name">

                                        @(order.Customer?.Name
                                                                                ?? "N/A")

                                    </span>

                                        </td>



                                        <td>

                                            <span class="amount">

                                                Rs.
                                                @order.TotalAmount.ToString(
                                                                                "N2")

                                    </span>

                                </td>



                                <td>

                                    <span class="delivery-charge">

                                        Rs.
                                        @order.DeliveryCharges.ToString(
                                                                                "N2")

                                    </span>

                                </td>



                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                        order.DeliveryPaymentMethod))
                                            {

                                                <span class="method">

                                                    <i class="fa-solid fa-wallet"></i>

                                                    @order.DeliveryPaymentMethod

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="not-set">

                                                    <i class="fa-solid fa-clock"></i>

                                                    Not recorded

                                                </span>

                                            }

                                        </td>



                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(
                                                                                order.DeliveryPaymentAccount))
                                            {

                                                <span class="account">

                                                    @order.DeliveryPaymentAccount

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="text-muted">
                                                    —
                                                </span>

                                            }

                                        </td>



                                        <td>

                                            @if (isPaid &&
                                                                                !string.IsNullOrWhiteSpace(
                                                                                order.DeliveryTransactionId))
                                            {

                                                <span class="transaction-id">

                                                    <i class="fa-solid fa-receipt"></i>

                                                    @order.DeliveryTransactionId

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="not-set">

                                                    <i class="fa-solid fa-clock"></i>

                                                    Not recorded

                                                </span>

                                            }

                                        </td>



                                        <td>

                                            @if (order.DeliveryPaidAmount > 0)
                                            {

                                                <span class="paid-amount">

                                                    Rs.
                                                    @order.DeliveryPaidAmount.ToString(
                                                    "N2")

                                    </span>

                                                                        }
                                            else
                                            {

                                                <span class="text-muted">

                                                    Rs. 0.00

                                                </span>

                                            }

                                        </td>



                                        <td>

                                            @if (isPaid)
                                            {

                                                <span class="payment-status status-paid">

                                                    <i class="fa-solid fa-circle-check"></i>

                                                    Paid

                                                </span>

                                            }
                                            else
                                            {

                                                <span class="payment-status status-pending">

                                                    <i class="fa-solid fa-clock"></i>

                                                    Pending

                                                </span>

                                            }

                                        </td>



                                        <td>

                                            @if (order.DeliveryPaymentDate.HasValue)
                                            {

                                                @order.DeliveryPaymentDate.Value.ToString(
                                                "dd MMM yyyy")

                                                                        }
                                            else
                                            {

                                                <span class="text-muted">

                                                    Not Paid Yet

                                                </span>

                                            }

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="empty-state">

                        <div class="empty-icon">

                            <i class="fa-solid fa-receipt"></i>

                        </div>

                        <h4>No Payment History</h4>

                        <p>

                            Your Admin payment transactions will appear
                            here after Admin records a delivery payout.

                        </p>

                    </div>

                }

            </div>



        </div>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>