@model IEnumerable<WeddingClosetHubs.Models.Order>

@{
    ViewData["Title"] = "COD Collections";
    Layout = null;

    var orders = Model?.ToList()
        ?? new List<WeddingClosetHubs.Models.Order>();

    string deliveryName = ViewBag.DeliveryName ?? "Delivery Boy";
    string assignedZone = ViewBag.AssignedZone ?? "Not Assigned";

    decimal totalCollected = orders.Sum(o => o.DeliveryCollectedAmount);
    decimal totalOrderAmount = orders.Sum(o => o.TotalAmount);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>COD Collections - Wedding Closet Hubs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f7f5f2;
            font-family: Arial, sans-serif;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
        }

        .page-title {
            color: #800020;
            font-weight: 700;
        }

        .summary-card {
            background: white;
            border: 1px solid #eee7df;
            border-radius: 12px;
            padding: 24px;
            height: 100%;
        }

        .summary-card h6 {
            color: #777;
        }

        .summary-card h3 {
            color: #800020;
            font-weight: 700;
        }

        .table thead th {
            background: #800020;
            color: white;
            white-space: nowrap;
        }

        .btn-maroon {
            background: #800020;
            color: white;
        }

        .btn-maroon:hover {
            background: #650018;
            color: white;
        }

        .info-text {
            color: #777;
            font-size: 13px;
        }
    </style>
</head>

<body>
    <div class="container">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title">COD Collections</h2>
                <p class="text-muted mb-1">
                    Cash collected from your assigned deliveries.
                </p>
                <div class="info-text">
                    Delivery Person: @deliveryName
                    <span class="mx-2">|</span>
                    Zone: @assignedZone
                </div>
            </div>

            <a asp-controller="Delivery"
               asp-action="Dashboard"
               class="btn btn-maroon">
                Back to Dashboard
            </a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="summary-card">
                    <h6>Orders With Collections</h6>
                    <h3>@orders.Count</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="summary-card">
                    <h6>Total Order Amount</h6>
                    <h3>Rs. @totalOrderAmount.ToString("N2")</h3>
                </div>
            </div>

            <div class="col-md-4">
                <div class="summary-card">
                    <h6>Total Cash Collected</h6>
                    <h3>Rs. @totalCollected.ToString("N2")</h3>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-3 shadow-sm p-3">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Order Total</th>
                            <th>Cash Collected</th>
                            <th>Collection Date</th>
                            <th>Handover to Admin</th>
                            <th>Order Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (orders.Any())
                        {
                            foreach (var order in orders)
                            {
                                <tr>
                                    <td>#@order.OrderId</td>

                                    <td>
                                        @(order.Customer?.Name ?? "Customer")
                                    </td>

                                    <td>
                                        Rs. @order.TotalAmount.ToString("N2")
                                    </td>

                                    <td>
                                        Rs. @order.DeliveryCollectedAmount.ToString("N2")
                                    </td>

                                    <td>
                                        @(order.DeliveryCollectionDate.HasValue
                                            ? order.DeliveryCollectionDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                                            : "Not recorded")
                                    </td>

                                    <td>
                                        @if (order.DeliveryCashHandedToAdmin)
                                        {
                                            <span class="badge bg-success">
                                                Handed Over
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Not Handed Over
                                            </span>
                                        }
                                    </td>

                                    <td>@order.OrderStatus</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No cash collections have been recorded yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</body>
</html>
